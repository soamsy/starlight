# The system OTP 29 at /usr/lib/erlang is a minimal install (compiler, crypto, erts, kernel, stdlib).
# This supplements it with full OTP 28 libs from Nix for public_key, ssl, asn1, inets, etc.
# Needed for: Hex (https), rebar3 (asn1), and any OTP app that uses those.
#
# Run once: direnv allow
# Or prefix commands: source .envrc && mix ...

NIX_OTP=/nix/store/ilmqgbhiraayfzkqwi0jvnrzzgkp3lz3-erlang-28.3/lib/erlang/lib

export ERL_LIBS=$NIX_OTP
export ERL_FLAGS="-pa ${NIX_OTP}/asn1-5.4.2/ebin \
  -pa ${NIX_OTP}/ssl-11.5/ebin \
  -pa ${NIX_OTP}/public_key-1.20/ebin \
  -pa ${NIX_OTP}/inets-9.5/ebin \
  -pa ${NIX_OTP}/xmerl-2.0/ebin"
