#!/bin/sh
set -e
cd "$(dirname "$0")/.."

for db in priv/data/base.db priv/data/user_seed.db; do
  mode=$(sqlite3 "$db" "PRAGMA busy_timeout=5000; PRAGMA journal_mode=WAL;" | tail -n 1)
  result=$(sqlite3 "$db" "PRAGMA busy_timeout=5000; PRAGMA wal_checkpoint(TRUNCATE);" | tail -n 1)
  if [ "${result%%|*}" != "0" ]; then
    result=$(sqlite3 "$db" "PRAGMA busy_timeout=5000; PRAGMA wal_checkpoint(PASSIVE);" | tail -n 1)
    echo "db-checkpoint: $db busy, fell back to PASSIVE (checkpoint=$result)" >&2
    frames=${result#*|}
    log=${frames%%|*}
    done_frames=${frames#*|}
    if [ "${result%%|*}" != "0" ] || [ "$log" != "$done_frames" ]; then
      echo "db-checkpoint: $db still has uncheckpointed WAL frames ($done_frames of $log)" >&2
      exit 1
    fi
  fi
  if [ "$mode" != "wal" ]; then
    echo "db-checkpoint: $db journal_mode=$mode, expected wal" >&2
    exit 1
  fi
done
