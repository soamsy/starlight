{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Starlight",
  "version": "0.1.0",
  "identifier": "com.soamsy.starlight",
  "build": {
    "beforeBuildCommand": "env MIX_ENV=prod mix do compile + assets.deploy + release --overwrite --path src-tauri/target/rel"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "target/rel": "rel"
    },
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
