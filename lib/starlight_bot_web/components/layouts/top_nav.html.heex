  <nav class="flex items-start gap-2 shrink-0 px-2 py-1 bg-base-100 border-b border-base-300">
    <% on_runner = @page == :runner %>
    <% on_teams = @page == :teams %>
    <% run_link = fn path -> if on_runner, do: [patch: path], else: [navigate: path] end %>
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-1 xl:flex-none">
      <.link {run_link.(~p"/mirror-dungeon")} data-hotkey="1"
             class={"btn btn-xs lg:btn-sm gap-1 " <> if(on_runner and @tab == :mirror_dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
             title="Mirror Dungeon">
        <img src={~p"/images/icons/mirror_dungeon.webp"} alt="" class="size-4 lg:size-5" />
        <span class="font-semibold">MD</span>
        <kbd class="kbd kbd-xs hidden lg:inline-flex">1</kbd>
        <.icon :if={@run_kind == :mirror_dungeon} name="lucide-filled-circle" class={["size-2", if(on_runner and @tab == :mirror_dungeon, do: "text-primary-content", else: "text-success")]} />
      </.link>
      <.link {run_link.(~p"/luxcavation")} data-hotkey="2"
             class={"btn btn-xs lg:btn-sm gap-1 " <> if(on_runner and @tab == :luxcavation, do: "btn-primary", else: "btn-ghost text-base-content/50")}
             title="Luxcavation">
        <img src={~p"/images/icons/luxcavation.webp"} alt="" class="size-4 lg:size-5" />
        <span class="font-semibold">Lux</span>
        <kbd class="kbd kbd-xs hidden lg:inline-flex">2</kbd>
        <.icon :if={@run_kind == :luxcavation} name="lucide-filled-circle" class={["size-2", if(on_runner and @tab == :luxcavation, do: "text-primary-content", else: "text-success")]} />
      </.link>
      <%= if nav = @team_nav do %>
        <TeamNav.team_selector nav={nav} on_page={on_teams} />
        <PlanPicker.pane_tabs team_id={nav.team_id} pane={nav.pane} counts={nav.counts} on_page={on_teams} />
      <% end %>
    </div>

    <% latest = @latest_log %>
    <% latest_class = ["min-w-0 truncate text-left font-mono text-xs hover:underline", latest && latest.kind in [:error, "error"] && "text-error" || "text-base-content/60"] %>
    <div class="hidden min-w-0 flex-1 items-center self-center xl:flex">
      <%= if latest && on_runner do %>
        <button type="button" phx-click={Phoenix.LiveView.JS.dispatch("starlight:log-bottom")} class={latest_class} title={latest.text}>{latest.text}</button>
      <% end %>
      <%= if latest && !on_runner do %>
        <.link navigate={~p"/"} class={latest_class} title={latest.text}>{latest.text}</.link>
      <% end %>
    </div>

    <div class="ml-auto flex shrink-0 items-center justify-end gap-1">
    <% overview = @scheduler_overview %>
    <% runs_on = overview && overview.runs_on %>
    <% charger_on = overview && overview.charger_on %>
    <% scheduler_on = runs_on || charger_on %>
    <% status = window_status(@game_window_rect) %>
    <% busy = @game_window_busy %>
    <% db_problems = @db_problems %>
    <% input_error = @input_error %>
    <% healthy = db_problems == [] and input_error == nil %>
    <details id="window-status-menu" phx-hook="FloatingDropdown" phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open"])} class="dropdown dropdown-end">
      <summary class="btn btn-ghost btn-xs lg:btn-sm gap-0 overflow-hidden p-0">
        <span
          class={[
            "flex size-6 lg:size-8 items-center justify-center",
            db_problems != [] && "bg-error text-error-content",
            db_problems == [] && input_error != nil && "bg-error text-error-content",
            healthy && status == :exact && "bg-success text-success-content",
            healthy && status == :scaled && "bg-warning text-warning-content",
            healthy && status == :bad_aspect && "bg-error text-error-content animate-pulse",
            healthy && status == :missing && "bg-neutral text-neutral-content"
          ]}
          title={cond do
            db_problems != [] -> "A data file looks damaged"
            input_error != nil -> "Mouse and keyboard control is not working"
            true -> window_status_title(status)
          end}>
          <%= cond do %>
            <% db_problems != [] -> %>
              <.icon name="lucide-database-zap" class="size-4 lg:size-5" />
            <% input_error != nil -> %>
              <.icon name="lucide-mouse-off" class="size-4 lg:size-5" />
            <% busy -> %>
              <span class="loading loading-spinner loading-xs"></span>
            <% status == :exact -> %>
              <.icon name="lucide-check" class="size-4 lg:size-5" />
            <% status == :missing -> %>
              <.icon name="lucide-monitor" class="size-4 lg:size-5" />
            <% true -> %>
              <.icon name="lucide-circle-exclamation-point" class="size-4 lg:size-5" />
          <% end %>
        </span>
        <span
          class={[
            "flex h-6 min-w-6 lg:h-8 lg:min-w-8 items-center justify-center gap-1 border-l border-base-100/40",
            @run_live && @run_timer_key && "px-1.5",
            if(runs_on or @run_live, do: "bg-success text-success-content", else: "bg-base-200 text-base-content/40")
          ]}
          title={cond do
            @run_live -> "Run in progress"
            runs_on -> "Runs scheduled"
            true -> "Runs not scheduled"
          end}>
          <.icon :if={@run_live} name="lucide-activity" class="size-4 lg:size-5" />
          <span
            :if={@run_live && @run_timer_key}
            id={"run-timer-#{elem(@run_timer_key, 0)}-#{elem(@run_timer_key, 1)}"}
            phx-hook="RunTimer"
            phx-update="ignore"
            data-elapsed={@run_timer_ms}
            data-running={to_string(elem(@run_timer_key, 1))}
            class="font-mono text-[11px] lg:text-xs tabular-nums"
          ></span>
          <%= unless @run_live do %>
          <.icon name={if runs_on, do: "lucide-clock", else: "lucide-timer-off"} class="size-4 lg:size-5" />
          <% end %>
        </span>
        <span
          class={[
            "flex size-6 lg:size-8 items-center justify-center border-l border-base-100/40",
            if(charger_on, do: "bg-success", else: "bg-base-200")
          ]}
          title={if(charger_on, do: "Enkephalin charging scheduled", else: "Enkephalin charging not scheduled")}>
          <img src={~p"/images/icons/enkephalin.webp"} alt="" class={["size-4 lg:size-5", !charger_on && "grayscale opacity-50"]} />
        </span>
      </summary>
      <div popover="manual" class={[
        "dropdown-content z-50 w-72 rounded-lg border bg-base-100 p-3 shadow-lg text-xs",
        db_problems != [] && "border-error",
        db_problems == [] && input_error != nil && "border-error",
        healthy && status == :exact && "border-success",
        healthy && status == :scaled && "border-warning",
        healthy && status == :bad_aspect && "border-error",
        healthy && status == :missing && "border-base-300"
      ]}>
        <div :if={input_error != nil} class="mb-3 rounded border border-error/50 bg-error/10 p-2">
          <div class="font-semibold text-error">
            {if input_error == :portal_denied, do: "Mouse and keyboard permission was denied", else: "Mouse and keyboard control is not working"}
          </div>
          <div class="mt-1 text-base-content/70">
            <%= if input_error == :portal_denied do %>
              Runs cannot click or type without it. Restart the app and approve the permission dialog when it appears.
            <% else %>
              Runs cannot click or type. Open the Linux Checks page to find out why, then restart the app.
            <% end %>
          </div>
        </div>
        <div :for={problem <- db_problems} class="mb-3 rounded border border-error/50 bg-error/10 p-2">
          <div class="font-semibold text-error">{problem.label} file looks damaged</div>
          <div class="mt-1 text-base-content/70">
            Some of it may be missing or wrong.
            <%= cond do %>
              <% problem.pending -> %>Restart the app to finish the repair.
              <% problem.backup -> %>The newest good backup is from {Calendar.strftime(problem.backup_at, "%b %-d, %H:%M")}.
              <% true -> %>There is no backup to restore.
            <% end %>
          </div>
          <details class="mt-1">
            <summary class="cursor-pointer text-base-content/60">Details</summary>
            <pre class="mt-1 whitespace-pre-wrap break-all font-mono text-[10px]">{Enum.join(problem.messages, "\n")}</pre>
          </details>
          <div :if={!problem.pending} class="mt-2 flex flex-col gap-1">
            <button :if={problem.backup} type="button" class="btn btn-error btn-xs w-full" phx-click="db_repair" phx-value-db={problem.name} phx-value-action="restore"
                    data-confirm="Restore the backup on next start? Anything saved after it was made is lost. The damaged file is kept aside.">Restore backup on next start</button>
            <button :if={problem.can_fresh?} type="button" class="btn btn-error btn-outline btn-xs w-full" phx-click="db_repair" phx-value-db={problem.name} phx-value-action="fresh"
                    data-confirm="Start fresh on next start? This file is reset to its defaults. The damaged file is kept aside.">Start fresh on next start</button>
          </div>
        </div>
        <button :if={@run_live} type="button" phx-click="run_cancel" data-dismiss class="btn btn-error btn-xs w-full mb-2">Cancel</button>
        <div class="flex items-center justify-between gap-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="toggle toggle-xs toggle-success" checked={runs_on} phx-click="scheduler_toggle" />
            <span class="font-semibold">Daily runs</span>
          </label>
          <button type="button" phx-click="settings_open" data-dismiss
                  class="btn btn-ghost btn-square btn-xs text-base-content/60">
            <.icon name="lucide-sliders-horizontal" class="size-4" />
          </button>
        </div>
        <label class="mt-2 flex items-center gap-2 cursor-pointer">
          <input type="checkbox" class="toggle toggle-xs toggle-success" checked={charger_on} phx-click="enkephalin_toggle" />
          <span class="font-semibold">Enkephalin charger</span>
        </label>
        <div class={["mt-2 font-mono", !scheduler_on && "text-base-content/30"]}>{overview && overview.label}</div>
        <div :if={overview && overview.runs_text} class="mt-1 text-base-content/60"><span class="font-semibold text-base-content/80">Runs:</span> {overview.runs_text}</div>
        <div :if={overview && overview.charge_text} class="mt-1 text-base-content/60"><span class="font-semibold text-base-content/80">Charger:</span> {overview.charge_text}</div>
        <div class="mt-2"><StarlightBotWeb.Components.SchedulerControls.scheduler_controls blocked={overview && overview.blocked} pending={overview && overview.runs_pending} /></div>
        <div class="divider my-2"></div>
        <div class={[
          "flex items-center justify-between gap-2 font-semibold mb-2",
          status == :exact && "text-success",
          status == :scaled && "text-warning",
          status == :bad_aspect && "text-error"
        ]}>
          <span>{window_status_title(status)}</span>
          <button :if={status != :missing} class="btn btn-xs font-normal text-base-content" phx-click="game_window_poke" disabled={busy != nil or @run_live == true}>Poke</button>
        </div>
        <%= if status == :missing do %>
          <%= if launch = @game_launch_label do %>
            <div class="text-base-content/70 mb-2">Launches <span class="font-mono break-all">{launch}</span> through {@game_launcher_label}.</div>
            <% missing = @game_launcher_missing || [] %>
            <div :if={missing != []} class="text-warning mb-2">Missing: <span class="font-mono">{Enum.join(missing, ", ")}</span></div>
            <button class="btn btn-primary btn-xs w-full" phx-click="game_window_launch" disabled={busy != nil or missing != [] or @game_update_pending == true}>
              <%= cond do %>
                <% busy -> %>{String.capitalize(busy)}…
                <% @game_update_pending -> %>Limbus update pending
                <% true -> %>Open Limbus
              <% end %>
            </button>
            <button type="button" phx-click="settings_open" data-dismiss class="link mt-2 block text-center">
              Launcher settings
            </button>
          <% else %>
            <div class="text-base-content/70">
              Launching is off. Set a launch mode in the <button type="button" phx-click="settings_open" class="link">Scheduler</button> settings to open Limbus from here.
            </div>
          <% end %>
        <% else %>
          <% {_x, _y, w, h} = @game_window_rect %>
          <table class="w-full">
            <tbody>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current size</td>
                <td class="font-mono">{w} × {h}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current ratio</td>
                <td class="font-mono">{aspect_label(w, h)}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Expected ratio</td>
                <td class="font-mono">16:9 (1.778)</td>
              </tr>
            </tbody>
          </table>
          <%= if status != :exact do %>
            <div class="mt-2 text-base-content/70">
              Resize the game window to <span class="font-mono font-semibold">1920 × 1080</span>. Detection and click coordinates assume 16:9.
            </div>
          <% end %>
          <%= if status != :exact do %>
            <button class="btn btn-xs w-full mt-2" phx-click="game_window_resize" disabled={busy != nil}>Resize to 1920 × 1080</button>
          <% end %>
          <%= if busy do %>
            <div class="mt-1 text-base-content/60">{String.capitalize(busy)}…</div>
          <% end %>
          <button :if={!@run_live} class="btn btn-error btn-outline btn-xs w-full mt-2" phx-click="game_window_close" data-confirm="Close Limbus? Any unsaved progress in the game will be lost." disabled={busy != nil}>
            Close Limbus
          </button>
        <% end %>
        <div class="divider my-2"></div>
        <form phx-change="cursor_speed_set" class="flex flex-col gap-1">
          <span class="flex items-baseline justify-between">
            <span class="font-semibold">Cursor speed</span>
            <span class="font-mono">{:erlang.float_to_binary(@cursor_speed, decimals: 2)}x</span>
          </span>
          <input type="range" name="cursor_speed" min="0.2" max="2.0" step="0.05" value={@cursor_speed} class="range range-xs range-info w-full" />
        </form>
        <form phx-change="hesitation_mult_set" class="mt-2 flex flex-col gap-1">
          <span class="flex items-baseline justify-between">
            <span>
              <span class="font-semibold">Hesitation duration</span>
              <span class="tooltip tooltip-top ml-1 font-normal before:w-44 before:whitespace-normal before:text-left" data-tip="Longer pause over a target before each click.">
                <.icon name="lucide-info" class="size-3.5 cursor-help text-base-content/50" />
              </span>
            </span>
            <span class="font-mono">{:erlang.float_to_binary(@hesitation_mult, decimals: 2)}x</span>
          </span>
          <input type="range" name="hesitation_mult" min="0.5" max="2.0" step="0.05" value={@hesitation_mult} class="range range-xs range-info w-full" />
        </form>
      </div>
    </details>

      <details id="page-menu" phx-hook="FloatingDropdown" phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open"])} data-close-on-click class="dropdown dropdown-end">
        <% profiles_on = on_teams and @team_nav != nil and @team_nav.pane == "profiles" %>
        <summary class={"tooltip tooltip-bottom btn btn-square btn-xs lg:btn-sm " <> if(profiles_on or @page in [:hooks, :battle, :dungeon, :gift_inspector, :theme_packs, :events, :shop_runner, :rewards, :linux_checks, :windows_checks, :data, :log], do: "btn-primary", else: "btn-ghost text-base-content/50")} data-tip="More">
          <.icon name="lucide-layout-grid" class="size-4 lg:size-5" />
        </summary>
        <div popover="manual" class="dropdown-content z-50 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg">
        <div class="grid grid-cols-4 gap-1">
    <%= if nav = @team_nav do %>
    <.link {if on_teams, do: [patch: TeamNav.team_path(nav.team_id, if(profiles_on, do: TeamNav.plan_pane(nav.pane), else: "profiles"))], else: [navigate: TeamNav.team_path(nav.team_id, "profiles")]}
           onclick="document.activeElement.blur()"
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(profiles_on, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-users" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">{if profiles_on, do: "Back to plans", else: "Sinner Profiles"}</span>
    </.link>
    <% end %>
    <%!-- Inspectors / debug tools --%>
    <.link navigate={~p"/hooks"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :hooks, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-crosshair" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Hook Editor</span>
    </.link>
    <.link navigate={~p"/data"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :data, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-database" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Data</span>
    </.link>
    <.link navigate={~p"/log"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :log, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-scroll-text" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Log</span>
    </.link>
    <div class="divider col-span-4 my-0 text-[10px]">Debug</div>
    <.link navigate={~p"/battle"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :battle, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-sword" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Battle Inspector</span>
    </.link>
    <.link navigate={~p"/dungeon"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-git-branch" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Dungeon Inspector</span>
    </.link>
    <%= if match?({:win32, _}, :os.type()) do %>
    <.link navigate={~p"/windows-checks"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :windows_checks, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-monitor-check" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Windows Checks</span>
    </.link>
    <% else %>
    <.link navigate={~p"/linux-checks"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :linux_checks, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-monitor-check" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Linux Checks</span>
    </.link>
    <% end %>
    <%= if StarlightBot.Data.authoring?() do %>
    <.link navigate={~p"/gift-inspector"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :gift_inspector, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-scan-search" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Gift Inspector</span>
    </.link>
    <.link navigate={~p"/theme-packs"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :theme_packs, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-layout-grid" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Theme Packs</span>
    </.link>
    <.link navigate={~p"/events"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :events, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-message-square" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Event Inspector</span>
    </.link>
    <.link navigate={~p"/shop-runner"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :shop_runner, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-shopping-bag" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Shop Runner</span>
    </.link>
    <.link navigate={~p"/rewards"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(@page == :rewards, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-gift" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Rewards</span>
    </.link>
    <% end %>
        </div>
        </div>
      </details>
    </div>
  </nav>
