<.flash_toasts flash={@flash} />

<div class="h-screen overflow-hidden flex flex-col">
  <nav class="flex items-start gap-2 shrink-0 px-2 py-1 bg-base-100 border-b border-base-300">
    <% on_runner = assigns[:page] == :runner %>
    <% on_teams = assigns[:page] == :teams %>
    <% run_link = fn path -> if on_runner, do: [patch: path], else: [navigate: path] end %>
    <div class="flex min-w-0 flex-1 flex-wrap items-center gap-1 xl:flex-none">
      <.link {run_link.(~p"/mirror-dungeon")} data-hotkey="1"
             class={"btn btn-xs lg:btn-sm gap-1 " <> if(on_runner and assigns[:tab] == :mirror_dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
             title="Mirror Dungeon">
        <img src={~p"/images/icons/mirror_dungeon.webp"} alt="" class="size-4 lg:size-5" />
        <span class="font-semibold">MD</span>
        <kbd class="kbd kbd-xs hidden lg:inline-flex">1</kbd>
        <span :if={assigns[:run_kind] == :mirror_dungeon} class="loading loading-spinner loading-xs"></span>
      </.link>
      <.link {run_link.(~p"/luxcavation")} data-hotkey="2"
             class={"btn btn-xs lg:btn-sm gap-1 " <> if(on_runner and assigns[:tab] == :luxcavation, do: "btn-primary", else: "btn-ghost text-base-content/50")}
             title="Luxcavation">
        <img src={~p"/images/icons/luxcavation.webp"} alt="" class="size-4 lg:size-5" />
        <span class="font-semibold">Lux</span>
        <kbd class="kbd kbd-xs hidden lg:inline-flex">2</kbd>
        <span :if={assigns[:run_kind] == :luxcavation} class="loading loading-spinner loading-xs"></span>
      </.link>
      <%= if nav = assigns[:team_nav] do %>
        <TeamNav.team_selector nav={nav} on_page={on_teams} />
        <PlanPicker.pane_tabs team_id={nav.team_id} pane={nav.pane} counts={nav.counts} on_page={on_teams} />
      <% end %>
    </div>

    <% latest = assigns[:latest_log] %>
    <% latest_class = ["min-w-0 truncate text-left font-mono text-xs hover:underline", latest && latest.kind in [:error, "error"] && "text-error" || "text-base-content/60"] %>
    <div class="hidden min-w-0 flex-1 items-center self-center xl:flex">
      <%= if latest && on_runner do %>
        <button type="button" phx-click={Phoenix.LiveView.JS.dispatch("starlight:log-bottom")} class={latest_class} title={latest.text}>{latest.text}</button>
      <% end %>
      <%= if latest && !on_runner do %>
        <.link navigate={~p"/"} class={latest_class} title={latest.text}>{latest.text}</.link>
      <% end %>
    </div>

    <div class="ml-auto flex shrink-0 items-center justify-end gap-1">
    <% overview = assigns[:scheduler_overview] %>
    <% runs_on = overview && overview.runs_on %>
    <% charger_on = overview && overview.charger_on %>
    <% scheduler_on = runs_on || charger_on %>
    <% status = window_status(assigns[:game_window_rect]) %>
    <% busy = assigns[:game_window_busy] %>
    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button"
           class={[
             "btn btn-square btn-xs lg:btn-sm",
             status == :exact && "btn-success",
             status == :scaled && "btn-warning",
             status == :bad_aspect && "btn-error animate-pulse",
             status == :missing && "btn-neutral"
           ]}
           title={window_status_title(status)}>
        <%= cond do %>
          <% busy -> %>
            <span class="loading loading-spinner loading-xs"></span>
          <% status == :exact -> %>
            <.icon name="lucide-check" class="size-4 lg:size-5" />
          <% status == :missing -> %>
            <.icon name="lucide-monitor" class="size-4 lg:size-5" />
          <% true -> %>
            <.icon name="lucide-circle-exclamation-point" class="size-4 lg:size-5" />
        <% end %>
      </div>
      <div tabindex="0" class={[
        "dropdown-content z-50 mt-2 w-72 rounded-lg border bg-base-100 p-3 shadow-lg text-xs",
        status == :exact && "border-success",
        status == :scaled && "border-warning",
        status == :bad_aspect && "border-error",
        status == :missing && "border-base-300"
      ]}>
        <div class={[
          "font-semibold mb-2",
          status == :exact && "text-success",
          status == :scaled && "text-warning",
          status == :bad_aspect && "text-error"
        ]}>
          {window_status_title(status)}
        </div>
        <%= if status == :missing do %>
          <%= if launch = assigns[:game_launch_label] do %>
            <div class="text-base-content/70 mb-2">Launches <span class="font-mono break-all">{launch}</span> through {assigns[:game_launcher_label]}.</div>
            <% missing = assigns[:game_launcher_missing] || [] %>
            <div :if={missing != []} class="text-warning mb-2">Missing: <span class="font-mono">{Enum.join(missing, ", ")}</span></div>
            <button class="btn btn-primary btn-xs w-full" phx-click="game_window_launch" disabled={busy != nil or missing != [] or assigns[:game_update_pending] == true}>
              <%= cond do %>
                <% busy -> %>{String.capitalize(busy)}…
                <% assigns[:game_update_pending] -> %>Limbus update pending
                <% true -> %>Open Limbus
              <% end %>
            </button>
            <button type="button" phx-click="settings_open" onclick="document.activeElement.blur()" class="link mt-2 block text-center">
              Launcher settings
            </button>
          <% else %>
            <div class="text-base-content/70">
              Launching is off. Set a launch mode in the <button type="button" phx-click="settings_open" class="link">Scheduler</button> settings to open Limbus from here.
            </div>
          <% end %>
        <% else %>
          <% {_x, _y, w, h} = @game_window_rect %>
          <button :if={!assigns[:run_live]} class="btn btn-error btn-outline btn-xs w-full mb-2" phx-click="game_window_close" data-confirm="Close Limbus? Any unsaved progress in the game will be lost." disabled={busy != nil}>
            Close Limbus
          </button>
          <table class="w-full">
            <tbody>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current size</td>
                <td class="font-mono">{w} × {h}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current ratio</td>
                <td class="font-mono">{aspect_label(w, h)}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Expected ratio</td>
                <td class="font-mono">16:9 (1.778)</td>
              </tr>
            </tbody>
          </table>
          <%= if status != :exact do %>
            <div class="mt-2 text-base-content/70">
              Resize the game window to <span class="font-mono font-semibold">1920 × 1080</span>. Detection and click coordinates assume 16:9.
            </div>
          <% end %>
          <%= if status != :exact do %>
            <button class="btn btn-xs w-full mt-2" phx-click="game_window_resize" disabled={busy != nil}>Resize to 1920 × 1080</button>
          <% end %>
          <%= if busy do %>
            <div class="mt-1 text-base-content/60">{String.capitalize(busy)}…</div>
          <% end %>
          <div class="mt-2 flex justify-end">
            <button class="btn btn-xs" phx-click="game_window_poke" disabled={busy != nil or assigns[:run_live] == true}>Poke</button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="dropdown dropdown-end">
      <div tabindex="0" role="button"
           class={["btn btn-square btn-xs lg:btn-sm", if(scheduler_on, do: "btn-success", else: "btn-ghost text-base-content/40")]}
           title={if(scheduler_on, do: "Scheduler on", else: "Scheduler off")}>
        <span :if={assigns[:run_live]} class="loading loading-spinner loading-xs lg:loading-sm"></span>
        <%= unless assigns[:run_live] do %>
        <.icon name={if scheduler_on, do: "lucide-clock", else: "lucide-timer-off"} class="size-4 lg:size-5" />
        <% end %>
      </div>
      <div tabindex="0" class={["dropdown-content z-50 mt-2 w-72 rounded-lg border bg-base-100 p-3 shadow-lg text-xs", if(scheduler_on, do: "border-success", else: "border-base-300")]}>
        <button :if={assigns[:run_live]} type="button" phx-click="run_cancel" onclick="document.activeElement.blur()" class="btn btn-error btn-xs w-full mb-2">Cancel</button>
        <div class="flex items-center justify-between gap-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="toggle toggle-xs toggle-success" checked={runs_on} phx-click="scheduler_toggle" />
            <span class="font-semibold">Daily runs</span>
          </label>
          <button type="button" phx-click="settings_open" onclick="document.activeElement.blur()"
                  class="btn btn-ghost btn-square btn-xs text-base-content/60">
            <.icon name="lucide-sliders-horizontal" class="size-4" />
          </button>
        </div>
        <label class="mt-2 flex items-center gap-2 cursor-pointer">
          <input type="checkbox" class="toggle toggle-xs toggle-success" checked={charger_on} phx-click="enkephalin_toggle" />
          <span class="font-semibold">Enkephalin charger</span>
        </label>
        <div class={["mt-2 font-mono", !scheduler_on && "text-base-content/30"]}>{overview && overview.label}</div>
        <div :if={overview && overview.runs_text} class="mt-1 text-base-content/60"><span class="font-semibold text-base-content/80">Runs:</span> {overview.runs_text}</div>
        <div :if={overview && overview.charge_text} class="mt-1 text-base-content/60"><span class="font-semibold text-base-content/80">Charger:</span> {overview.charge_text}</div>
        <div class="mt-2"><StarlightBotWeb.Components.SchedulerControls.scheduler_controls blocked={overview && overview.blocked} pending={overview && overview.runs_pending} /></div>
      </div>
    </div>

      <div class="dropdown dropdown-end">
        <% profiles_on = on_teams and assigns[:team_nav] != nil and @team_nav.pane == "profiles" %>
        <div tabindex="0" role="button" class={"tooltip tooltip-bottom btn btn-square btn-xs lg:btn-sm " <> if(profiles_on or assigns[:page] in [:hooks, :battle, :dungeon, :gift_inspector, :theme_packs, :events, :shop_runner, :rewards, :linux_checks, :data, :log], do: "btn-primary", else: "btn-ghost text-base-content/50")} data-tip="More">
          <.icon name="lucide-layout-grid" class="size-4 lg:size-5" />
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-2 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg">
        <div class="grid grid-cols-4 gap-1">
    <%= if nav = assigns[:team_nav] do %>
    <.link {if on_teams, do: [patch: TeamNav.team_path(nav.team_id, if(profiles_on, do: TeamNav.plan_pane(nav.pane), else: "profiles"))], else: [navigate: TeamNav.team_path(nav.team_id, "profiles")]}
           onclick="document.activeElement.blur()"
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(profiles_on, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-users" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">{if profiles_on, do: "Back to plans", else: "Sinner Profiles"}</span>
    </.link>
    <% end %>
    <%= cond do %>
      <% assigns[:run_phase] in [nil, :idle] -> %>
        <button type="button" phx-click="prepare_lineups" onclick="document.activeElement.blur()"
                title="Select each team in the Lux EXP team select and set its sinner order to the first lineup, then return home"
                class="btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 btn-ghost text-base-content/50">
          <.icon name="lucide-list-checks" class="size-4 lg:size-5" />
          <span class="text-[10px] font-normal leading-tight text-center">Prepare Lineups</span>
        </button>
      <% assigns[:run_kind] == :prepare_lineups -> %>
        <button type="button" phx-click="run_cancel" onclick="document.activeElement.blur()"
                class="btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 btn-ghost text-error">
          <span class="loading loading-spinner loading-xs"></span>
          <span class="text-[10px] font-normal leading-tight text-center">Cancel Lineups</span>
        </button>
      <% true -> %>
        <button type="button" disabled title="Another run is in progress"
                class="btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 btn-ghost">
          <.icon name="lucide-list-checks" class="size-4 lg:size-5" />
          <span class="text-[10px] font-normal leading-tight text-center">Prepare Lineups</span>
        </button>
    <% end %>
    <%!-- Inspectors / debug tools --%>
    <.link navigate={~p"/hooks"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :hooks, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-crosshair" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Hook Editor</span>
    </.link>
    <%= if StarlightBot.Data.authoring?() do %>
    <.link navigate={~p"/battle"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :battle, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-sword" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Battle Inspector</span>
    </.link>
    <.link navigate={~p"/dungeon"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-git-branch" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Dungeon Inspector</span>
    </.link>
    <.link navigate={~p"/gift-inspector"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :gift_inspector, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-scan-search" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Gift Inspector</span>
    </.link>
    <.link navigate={~p"/theme-packs"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :theme_packs, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-layout-grid" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Theme Packs</span>
    </.link>
    <.link navigate={~p"/events"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :events, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-message-square" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Event Inspector</span>
    </.link>
    <.link navigate={~p"/shop-runner"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :shop_runner, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-shopping-bag" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Shop Runner</span>
    </.link>
    <.link navigate={~p"/rewards"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :rewards, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-gift" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Rewards</span>
    </.link>
    <.link navigate={~p"/linux-checks"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :linux_checks, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-monitor-check" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Linux Checks</span>
    </.link>
    <% end %>
    <.link navigate={~p"/data"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :data, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-database" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Data</span>
    </.link>
    <.link navigate={~p"/log"}
           class={"btn btn-sm h-auto w-20 flex-col gap-0.5 py-1.5 " <> if(assigns[:page] == :log, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
      <.icon name="lucide-scroll-text" class="size-4 lg:size-5" />
      <span class="text-[10px] font-normal leading-tight text-center">Log</span>
    </.link>
        </div>
        </div>
      </div>
    </div>
  </nav>

  <main class="p-3 flex-1 min-w-0 overflow-hidden flex flex-col">
    <%= @inner_content %>
  </main>
</div>

<%= if assigns[:settings_open] do %>
  <div class="modal modal-open" phx-window-keydown="settings_close" phx-key="Escape">
    <div class="modal-box max-w-2xl" phx-click-away="settings_close">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h2 class="text-lg font-bold">Scheduler</h2>
        <form phx-change="enkephalin_save" class="flex items-center gap-2">
          <span class="tooltip tooltip-left normal-case before:w-64 before:whitespace-normal before:text-left" data-tip="Whenever enkephalin is collected, ensure this much lunacy has been spent">
            <.icon name="lucide-info" class="size-3.5 cursor-help text-base-content/50" />
          </span>
          <img src="/images/icons/lunacy.webp" title="Lunacy" class="size-6 shrink-0" />
          <span class="text-base-content/50">→</span>
          <img src="/images/icons/enkephalin.webp" title="Enkephalin" class="size-6 shrink-0" />
          <select name="enkephalin_convert_count" class="select select-sm select-bordered w-52">
            <%= for n <- 0..StarlightBot.Automation.EnkephalinCharger.max_convert_count() do %>
              <option value={n} selected={n == @enkephalin_convert_count}>
                {n}x ({StarlightBotWeb.Live.RunnerLive.enkephalin_cumulative_cost(n)} lunacy, {StarlightBotWeb.Live.RunnerLive.enkephalin_cumulative_cost(n) * 7}/week)
              </option>
            <% end %>
          </select>
        </form>
      </div>

      <div class="h-[40rem] max-h-[calc(100vh-14rem)] overflow-y-auto overflow-x-hidden">
      <div class="flex min-h-full flex-col">
        <div>
          {live_render(@socket, StarlightBotWeb.Live.SchedulerLive, id: "scheduler-banner", session: %{"part" => "banner"})}
        </div>
        <div class="flex items-end gap-1 border-b border-base-300">
          <div class={["flex shrink-0 items-center rounded-t-lg border px-3 py-2 -mb-px", @scheduler_view == "progress" && "bg-base-200 border-base-300 border-b-base-200", @scheduler_view != "progress" && "border-transparent hover:bg-base-200/50"]}>
            <button type="button" phx-click="scheduler_view" phx-value-view="progress" class={["flex items-center gap-2 text-left font-semibold", @scheduler_view != "progress" && "text-base-content/60"]}>
              <.icon name="lucide-chart-column" class="size-5" />
              Progress
            </button>
          </div>
          <div class={["flex flex-1 items-center gap-3 rounded-t-lg border px-3 py-2 -mb-px", @scheduler_view == "runners" && "bg-base-200 border-base-300 border-b-base-200", @scheduler_view != "runners" && "border-transparent hover:bg-base-200/50"]}>
            <button type="button" phx-click="scheduler_view" phx-value-view="runners" class={["flex flex-1 items-center gap-2 text-left font-semibold", @scheduler_view != "runners" && "text-base-content/60"]}>
              <span class="relative">
                <.icon name="lucide-swords" class={["size-5", @scheduler_settings.enabled && "text-success"]} />
                <span :if={@scheduler_settings.enabled} class="absolute -right-1 -top-1 size-2 rounded-full bg-success ring-2 ring-base-200"></span>
              </span>
              Runners
            </button>
            <input type="checkbox" class="toggle toggle-sm toggle-success" checked={@scheduler_settings.enabled} phx-click="scheduler_toggle" title="Enabled" />
            <span class={["badge font-bold", if(@scheduler_settings.enabled, do: "badge-success", else: "badge-ghost text-base-content/50")]}>{if @scheduler_settings.enabled, do: "ON", else: "OFF"}</span>
          </div>
          <div class={["flex flex-1 items-center gap-3 rounded-t-lg border px-3 py-2 -mb-px", @scheduler_view == "enkephalin" && "bg-base-200 border-base-300 border-b-base-200", @scheduler_view != "enkephalin" && "border-transparent hover:bg-base-200/50"]}>
            <button type="button" phx-click="scheduler_view" phx-value-view="enkephalin" class={["flex flex-1 items-center gap-2 text-left font-semibold", @scheduler_view != "enkephalin" && "text-base-content/60"]}>
              <span class="relative">
                <img src="/images/icons/enkephalin.webp" class={["size-5", !@enkephalin_schedule.enabled && "grayscale opacity-70"]} />
                <span :if={@enkephalin_schedule.enabled} class="absolute -right-1 -top-1 size-2 rounded-full bg-success ring-2 ring-base-200"></span>
              </span>
              Enkephalin
            </button>
            <input type="checkbox" class="toggle toggle-sm toggle-success" checked={@enkephalin_schedule.enabled} phx-click="enkephalin_toggle" title="Enabled" />
            <span class={["badge font-bold", if(@enkephalin_schedule.enabled, do: "badge-success", else: "badge-ghost text-base-content/50")]}>{if @enkephalin_schedule.enabled, do: "ON", else: "OFF"}</span>
          </div>
        </div>
        <div class="min-h-[18rem] rounded-b-lg border border-t-0 border-base-300 bg-base-200 p-3">
          <%= if @scheduler_view == "runners" do %>
            {live_render(@socket, StarlightBotWeb.Live.SchedulerLive, id: "scheduler-settings", session: %{"part" => "form"})}
          <% end %>
          <%= if @scheduler_view == "progress" do %>
            {live_render(@socket, StarlightBotWeb.Live.SchedulerLive, id: "scheduler-progress", session: %{"part" => "progress"})}
          <% end %>
          <%= if @scheduler_view == "enkephalin" do %>
          <% form = @enkephalin_form %>
          <form phx-change="enkephalin_schedule_save" class="flex flex-col gap-3">
            <div class="flex items-end gap-3">
              <div class="flex flex-col gap-1">
                <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
                  Interval
                  <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="Charge once this many hours have passed since the last charge, while the window is open.">
                    <.icon name="lucide-info" class="size-3.5 cursor-help" />
                  </span>
                </span>
                <select name="interval_hours" class="select select-sm select-bordered w-20">
                  <%= for hours <- 2..24 do %>
                    <option value={hours} selected={form["interval_hours"] == to_string(hours)}>{hours}h</option>
                  <% end %>
                </select>
              </div>

              <div class="flex flex-col gap-1 flex-1">
                <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
                  Daily window
                  <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="Charges only happen inside this window.">
                    <.icon name="lucide-info" class="size-3.5 cursor-help" />
                  </span>
                </span>
                <div class="flex items-center gap-2">
                  <input type="time" name="window_start" value={form["window_start"]} class="input input-sm input-bordered flex-1 min-w-0" />
                  <span class="text-base-content/40">to</span>
                  <input type="time" name="window_end" value={form["window_end"]} class="input input-sm input-bordered flex-1 min-w-0" />
                </div>
              </div>
            </div>

            <% timeline = StarlightBot.EnkephalinSchedule.day_timeline(String.slice(form["window_start"], 0, 5), String.slice(form["window_end"], 0, 5), String.to_integer(form["interval_hours"])) %>
            <%= if timeline do %>
              <div class="flex flex-col gap-1">
                <div id="window-drag-enkephalin" phx-hook="WindowDrag" data-start={String.slice(form["window_start"], 0, 5)} data-end={String.slice(form["window_end"], 0, 5)} class="relative h-6 rounded bg-base-200 touch-none select-none">
                  <%= for {from, to} <- timeline.windows do %>
                    <div data-window class="absolute inset-y-0 bg-success/20" style={"left: #{from / 14.4}%; width: #{(to - from) / 14.4}%"}></div>
                  <% end %>
                  <%= for span <- timeline.spans do %>
                    <% width = span.to - span.from %>
                    <div :if={width >= 120} class={["absolute inset-y-0 flex items-center justify-center gap-0.5 overflow-hidden whitespace-nowrap font-mono text-[10px] pointer-events-none", span.capped? && "text-warning"]} style={"left: #{span.from / 14.4}%; width: #{width / 14.4}%"}>
                      <%= if span.modules > 0 do %>{span.modules}<img src="/images/icons/enkephalin.webp" class="size-3" /><% end %>
                      <%= if span.modules > 0 and span.leftover > 0 and width >= 300 do %>,<% end %>
                      <%= if span.leftover > 0 and (span.modules == 0 or width >= 300) do %>{span.leftover}<img src="/images/icons/enkephalin_currency.webp" class="size-3" /><% end %>
                    </div>
                  <% end %>
                  <%= for span <- timeline.spans do %>
                    <div class="absolute inset-y-1 w-1 -ml-0.5 rounded-full bg-success pointer-events-none" style={"left: #{span.to / 14.4}%"}></div>
                  <% end %>
                  <div data-handle="start" class="absolute -inset-y-0.5 z-10 w-2 -ml-1 cursor-ew-resize rounded bg-success/70 hover:bg-success"></div>
                  <div data-handle="end" class="absolute -inset-y-0.5 z-10 w-2 -ml-1 cursor-ew-resize rounded bg-success/70 hover:bg-success"></div>
                </div>
                <div class="relative h-3 text-[10px] text-base-content/50 font-mono">
                  <%= for hour <- [0, 6, 12, 18, 24] do %>
                    <span class={["absolute", hour == 24 && "-translate-x-full", hour not in [0, 24] && "-translate-x-1/2"]} style={"left: #{hour / 0.24}%"}>{String.pad_leading(to_string(hour), 2, "0")}:00</span>
                  <% end %>
                </div>
                <span class="text-xs text-base-content/60">{length(timeline.charges)} {if length(timeline.charges) == 1, do: "charge", else: "charges"} a day</span>
              </div>
            <% end %>
            <label class="flex cursor-pointer items-center gap-2 text-sm">
              <input type="hidden" name="close_game_after_charge" value="false" />
              <input type="checkbox" name="close_game_after_charge" value="true" checked={form["close_game_after_charge"] == "true"} class="toggle toggle-sm toggle-primary" />
              <span>Close Limbus after opening it for a charge</span>
            </label>
            <span :if={@enkephalin_schedule_error} class="text-xs text-error">Not saved: {@enkephalin_schedule_error}</span>
          </form>
          <% end %>
        </div>

        <div class="divider my-5"></div>

        {live_render(@socket, StarlightBotWeb.Live.SchedulerLive, id: "scheduler-launch", session: %{"part" => "launch"})}
      </div>

      </div>

      <div class="modal-action">
        <button phx-click="settings_close" class="btn btn-sm">Close</button>
      </div>
    </div>
  </div>
<% end %>
