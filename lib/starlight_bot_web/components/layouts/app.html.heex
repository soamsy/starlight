<.flash_toasts flash={@flash} />

<div class="h-screen overflow-hidden flex">
  <nav class="flex flex-col items-center gap-1 w-8 lg:w-12 shrink-0 py-1 lg:py-3 bg-base-100 border-r border-base-300">
    <%!-- Runners --%>
    <.link navigate={~p"/mirror-dungeon"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :mirror_dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Mirror Dungeon Runner">
      <img src={~p"/images/icons/starlight.webp"} alt="Mirror Dungeon Runner" class="h-4 w-4 lg:h-5 lg:w-5" style="filter: drop-shadow(1px 0 0 var(--color-primary-content)) drop-shadow(-1px 0 0 var(--color-primary-content)) drop-shadow(0 1px 0 var(--color-primary-content)) drop-shadow(0 -1px 0 var(--color-primary-content));" />
    </.link>
    <.link navigate={~p"/luxcavation"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :luxcavation, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Luxcavation Runner">
      <img src={~p"/images/icons/luxcavation.webp"} alt="Luxcavation Runner" class="h-4 w-4 lg:h-5 lg:w-5" style="filter: drop-shadow(1px 0 0 var(--color-primary-content)) drop-shadow(-1px 0 0 var(--color-primary-content)) drop-shadow(0 1px 0 var(--color-primary-content)) drop-shadow(0 -1px 0 var(--color-primary-content));" />
    </.link>

    <div class="divider my-0 lg:my-1"></div>

    <%!-- Config --%>
    <.link navigate={~p"/teams"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :teams, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Teams">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
    </.link>

    <div class="divider my-0 lg:my-1"></div>

    <%!-- Inspectors / debug tools --%>
    <.link navigate={~p"/hooks"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :hooks, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Hook Editor">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <circle cx="12" cy="12" r="10" />
        <line x1="22" x2="18" y1="12" y2="12" />
        <line x1="6" x2="2" y1="12" y2="12" />
        <line x1="12" x2="12" y1="6" y2="2" />
        <line x1="12" x2="12" y1="22" y2="18" />
      </svg>
    </.link>
    <%= if StarlightBot.Data.authoring?() do %>
    <.link navigate={~p"/screenshots"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :screenshots, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Screenshots">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z" />
        <circle cx="12" cy="13" r="3" />
      </svg>
    </.link>
    <.link navigate={~p"/battle"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :battle, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Battle Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M14.5 17.5 3 6V3h3l11.5 11.5" />
        <path d="M13 19l6-6" />
        <path d="M16 16l4 4" />
        <path d="M19 21l2-2" />
      </svg>
    </.link>
    <.link navigate={~p"/dungeon"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Dungeon Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <line x1="6" x2="6" y1="3" y2="15" />
        <circle cx="18" cy="6" r="3" />
        <circle cx="6" cy="18" r="3" />
        <path d="M18 9a9 9 0 0 1-9 9" />
      </svg>
    </.link>
    <.link navigate={~p"/gift-inspector"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :gift_inspector, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Gift Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <rect x="3" y="3" width="10" height="10" rx="1" />
        <circle cx="17" cy="17" r="4" />
        <path d="M20 20l2 2" />
      </svg>
    </.link>
    <.link navigate={~p"/theme-packs"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :theme_packs, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Theme Packs">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
      </svg>
    </.link>
    <.link navigate={~p"/events"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :events, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Event Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
    </.link>
    <.link navigate={~p"/transitions"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :transitions, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Transitions">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <rect width="8" height="8" x="3" y="3" rx="2" />
        <path d="M7 11v4a2 2 0 0 0 2 2h4" />
        <rect width="8" height="8" x="13" y="13" rx="2" />
      </svg>
    </.link>
    <.link navigate={~p"/shop-runner"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :shop_runner, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Shop Runner">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
    </.link>
    <.link navigate={~p"/rewards"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :rewards, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Rewards">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <rect x="3" y="8" width="18" height="4" rx="1" />
        <path d="M12 8v13" />
        <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
        <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8" />
        <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8" />
      </svg>
    </.link>
    <% end %>
    <.link navigate={~p"/log"}
           class={"tooltip tooltip-right btn btn-square btn-xs lg:btn-sm " <> if(assigns[:page] == :log, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Log">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M15 12h-5" />
        <path d="M15 8h-5" />
        <path d="M19 17V5a2 2 0 0 0-2-2H4" />
        <path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3" />
      </svg>
    </.link>

    <div class="mt-auto"></div>

    <% scheduler_on = assigns[:scheduler_settings] && assigns[:scheduler_settings].enabled %>
    <div class="dropdown dropdown-right dropdown-end">
      <div tabindex="0" role="button"
           class={["btn btn-square btn-xs lg:btn-sm", if(scheduler_on, do: "btn-success", else: "btn-ghost text-base-content/40")]}
           title={if(scheduler_on, do: "Scheduler on", else: "Scheduler off")}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7v5l3 2" />
          <%= unless scheduler_on do %>
            <path d="M4 4l16 16" />
          <% end %>
        </svg>
      </div>
      <div tabindex="0" class={["dropdown-content z-50 ml-2 w-56 rounded-lg border bg-base-100 p-3 shadow-lg text-xs", if(scheduler_on, do: "border-success", else: "border-base-300")]}>
        <div class="flex items-center justify-between gap-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" class="toggle toggle-xs toggle-success" checked={scheduler_on} phx-click="scheduler_toggle" />
            <span class="font-semibold">Scheduler</span>
          </label>
          <button type="button" phx-click="settings_open" phx-value-tab="scheduler" onclick="document.activeElement.blur()"
                  class="btn btn-ghost btn-square btn-xs text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <line x1="4" x2="20" y1="7" y2="7" />
              <line x1="4" x2="20" y1="12" y2="12" />
              <line x1="4" x2="20" y1="17" y2="17" />
              <circle cx="9" cy="7" r="2" fill="var(--color-base-100)" />
              <circle cx="15" cy="12" r="2" fill="var(--color-base-100)" />
              <circle cx="8" cy="17" r="2" fill="var(--color-base-100)" />
            </svg>
          </button>
        </div>
        <div class={["mt-2 font-mono", !scheduler_on && "text-base-content/30"]}>{assigns[:scheduler_label]}</div>
        <div :if={assigns[:scheduler_outlook]} class="mt-1 text-base-content/60">{assigns[:scheduler_outlook]}</div>
        <div class="mt-2 flex flex-col gap-1">
          <span class="font-semibold text-base-content/50">Stop scheduling for</span>
          <div class="flex flex-wrap gap-1">
            <button :for={{label, value} <- [{"1h", "1"}, {"2h", "2"}, {"4h", "4"}, {"8h", "8"}, {"Rest of day", "day"}]} type="button" phx-click="scheduler_hold" phx-value-for={value} class="btn btn-xs">{label}</button>
          </div>
          <button :if={assigns[:scheduler_blocked]} type="button" phx-click="scheduler_hold" phx-value-for="clear" class="btn btn-xs btn-success mt-1">Resume now</button>
        </div>
      </div>
    </div>

    <% status = window_status(assigns[:game_window_rect]) %>
    <% busy = assigns[:game_window_busy] %>
    <div class="dropdown dropdown-right dropdown-end">
      <div tabindex="0" role="button"
           class={[
             "btn btn-square btn-xs lg:btn-sm",
             status == :exact && "btn-success",
             status == :scaled && "btn-warning",
             status == :bad_aspect && "btn-error animate-pulse",
             status == :missing && "btn-neutral"
           ]}
           title={window_status_title(status)}>
        <%= cond do %>
          <% busy -> %>
            <span class="loading loading-spinner loading-xs"></span>
          <% status == :exact -> %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
              <path d="M20 6 9 17l-5-5" />
            </svg>
          <% status == :missing -> %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
              <rect width="18" height="14" x="3" y="4" rx="2" />
              <path d="M8 21h8" />
              <path d="M12 18v3" />
            </svg>
          <% true -> %>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
              <line x1="12" x2="12" y1="4" y2="14" />
              <line x1="12" x2="12.01" y1="20" y2="20" />
            </svg>
        <% end %>
      </div>
      <div tabindex="0" class={[
        "dropdown-content z-50 ml-2 w-72 rounded-lg border bg-base-100 p-3 shadow-lg text-xs",
        status == :exact && "border-success",
        status == :scaled && "border-warning",
        status == :bad_aspect && "border-error",
        status == :missing && "border-base-300"
      ]}>
        <div class={[
          "font-semibold mb-2",
          status == :exact && "text-success",
          status == :scaled && "text-warning",
          status == :bad_aspect && "text-error"
        ]}>
          {window_status_title(status)}
        </div>
        <%= if status == :missing do %>
          <%= if launch = assigns[:game_launch_label] do %>
            <div class="text-base-content/70 mb-2">Launches <span class="font-mono break-all">{launch}</span> using the Runners settings.</div>
            <button class="btn btn-primary btn-xs w-full" phx-click="game_window_launch" disabled={busy != nil}>
              <%= if busy, do: String.capitalize(busy) <> "…", else: "Open Limbus" %>
            </button>
          <% else %>
            <div class="text-base-content/70">
              Launching is off. Set a launch mode in the <button type="button" phx-click="settings_open" phx-value-tab="scheduler" class="link">Runners</button> tab to open Limbus from here.
            </div>
          <% end %>
        <% else %>
          <% {_x, _y, w, h} = @game_window_rect %>
          <button class="btn btn-primary btn-xs w-full mb-2" disabled>Open Limbus</button>
          <table class="w-full">
            <tbody>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current size</td>
                <td class="font-mono">{w} × {h}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Current ratio</td>
                <td class="font-mono">{aspect_label(w, h)}</td>
              </tr>
              <tr>
                <td class="text-base-content/60 pr-2 py-0.5">Expected ratio</td>
                <td class="font-mono">16:9 (1.778)</td>
              </tr>
            </tbody>
          </table>
          <%= if status != :exact do %>
            <div class="mt-2 text-base-content/70">
              Resize the game window to <span class="font-mono font-semibold">1920 × 1080</span>. Detection and click coordinates assume 16:9.
            </div>
          <% end %>
          <%= if status != :exact do %>
            <button class="btn btn-xs w-full mt-2" phx-click="game_window_resize" disabled={busy != nil}>Resize to 1920 × 1080</button>
          <% end %>
          <%= if busy do %>
            <div class="mt-1 text-base-content/60">{String.capitalize(busy)}…</div>
          <% end %>
        <% end %>
      </div>
    </div>

    <button phx-click="settings_open" class="tooltip tooltip-right btn btn-ghost btn-square btn-xs lg:btn-sm text-base-content/50" data-tip="Settings">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 lg:h-5 lg:w-5">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
        <circle cx="12" cy="12" r="3" />
      </svg>
    </button>
  </nav>

  <main class="p-3 flex-1 min-w-0 overflow-hidden flex flex-col">
    <%= @inner_content %>
  </main>
</div>

<%= if assigns[:settings_open] && assigns[:app_settings] do %>
  <div class="modal modal-open" phx-window-keydown="settings_close" phx-key="Escape">
    <div class="modal-box max-w-2xl">
      <h3 class="font-bold text-lg mb-2">Settings</h3>
      <div role="tablist" class="tabs tabs-bordered mb-3">
        <button role="tab" phx-click="settings_tab" phx-value-tab="scheduler" class={["tab", @settings_tab == "scheduler" && "tab-active"]}>Runners</button>
        <button role="tab" phx-click="settings_tab" phx-value-tab="enkephalin" class={["tab", @settings_tab == "enkephalin" && "tab-active"]}>Enkephalin</button>
        <button role="tab" phx-click="settings_tab" phx-value-tab="data" class={["tab", @settings_tab == "data" && "tab-active"]}>Data</button>
      </div>

      <div class="h-[30rem] overflow-y-auto">
      <%= if @settings_tab == "scheduler" do %>
        {live_render(@socket, StarlightBotWeb.Live.SchedulerLive, id: "scheduler-settings")}
      <% end %>

      <%= if @settings_tab == "enkephalin" do %>
        <form phx-change="enkephalin_save" class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Lunacy → enkephalin conversions</span>
          <div class="flex items-center gap-2">
            <img src="/images/icons/lunacy.webp" title="Lunacy" class="size-6 shrink-0" />
            <span class="text-base-content/50">→</span>
            <img src="/images/icons/enkephalin.webp" title="Enkephalin" class="size-6 shrink-0" />
            <select name="enkephalin_convert_count" class="select select-sm select-bordered flex-1 min-w-0">
              <%= for n <- 0..StarlightBot.Automation.EnkephalinCharger.max_convert_count() do %>
                <option value={n} selected={n == @enkephalin_convert_count}>
                  {n}x ({StarlightBotWeb.Live.LuxcavationLive.enkephalin_cumulative_cost(n)} lunacy, {StarlightBotWeb.Live.LuxcavationLive.enkephalin_cumulative_cost(n) * 7}/week)
                </option>
              <% end %>
            </select>
          </div>
        </form>
        <p class="text-xs text-base-content/60 mt-2">Whenever enkephalin is collected, ensure this much lunacy has been spent</p>

        <% form = @enkephalin_form %>
        <form phx-change="enkephalin_schedule_save" class="flex flex-col gap-3 mt-5 border-t border-base-300 pt-4">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Enkephalin scheduler</span>
          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 cursor-pointer text-sm">
              <input type="hidden" name="enabled" value="false" />
              <input type="checkbox" name="enabled" value="true" checked={form["enabled"] == "true"} class="toggle toggle-sm toggle-success" />
              Enabled
            </label>
            <span :if={form["enabled"] == "true"} class="text-xs text-base-content/60">
              {last_charged_label(@enkephalin_schedule.last_converted_at, @enkephalin_now)}
            </span>
          </div>

          <div class="flex items-end gap-3">
            <div class="flex flex-col gap-1">
              <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
                Interval
                <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="Charge once this many hours have passed since the last charge, while the window is open.">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 cursor-help">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4" />
                  <path d="M12 8h.01" />
                </svg>
                </span>
              </span>
              <select name="interval_hours" class="select select-sm select-bordered w-20">
                <%= for hours <- 2..24 do %>
                  <option value={hours} selected={form["interval_hours"] == to_string(hours)}>{hours}h</option>
                <% end %>
              </select>
            </div>

            <div class="flex flex-col gap-1 flex-1">
              <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
                Daily window
                <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="Charges only happen inside this window.">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 cursor-help">
                  <circle cx="12" cy="12" r="10" />
                  <path d="M12 16v-4" />
                  <path d="M12 8h.01" />
                </svg>
                </span>
              </span>
              <div class="flex items-center gap-2">
                <input type="time" name="window_start" value={form["window_start"]} class="input input-sm input-bordered flex-1 min-w-0" />
                <span class="text-base-content/40">to</span>
                <input type="time" name="window_end" value={form["window_end"]} class="input input-sm input-bordered flex-1 min-w-0" />
              </div>
            </div>
          </div>

          <% timeline = StarlightBot.EnkephalinSchedule.day_timeline(String.slice(form["window_start"], 0, 5), String.slice(form["window_end"], 0, 5), String.to_integer(form["interval_hours"])) %>
          <%= if timeline do %>
            <div class="flex flex-col gap-1">
              <div class="relative h-6 rounded bg-base-200">
                <%= for {from, to} <- timeline.windows do %>
                  <div class="absolute inset-y-0 bg-success/20" style={"left: #{from / 14.4}%; width: #{(to - from) / 14.4}%"}></div>
                <% end %>
                <%= for span <- timeline.spans do %>
                  <% width = span.to - span.from %>
                  <div :if={width >= 120} class={["absolute inset-y-0 flex items-center justify-center gap-0.5 overflow-hidden whitespace-nowrap font-mono text-[10px] pointer-events-none", span.capped? && "text-warning"]} style={"left: #{span.from / 14.4}%; width: #{width / 14.4}%"}>
                    <%= if span.modules > 0 do %>{span.modules}<img src="/images/icons/enkephalin.webp" class="size-3" /><% end %>
                    <%= if span.modules > 0 and span.leftover > 0 and width >= 300 do %>,<% end %>
                    <%= if span.leftover > 0 and (span.modules == 0 or width >= 300) do %>{span.leftover}<img src="/images/icons/enkephalin_currency.webp" class="size-3" /><% end %>
                  </div>
                <% end %>
                <%= for span <- timeline.spans do %>
                  <div class="absolute inset-y-1 w-1 -ml-0.5 rounded-full bg-success tooltip" style={"left: #{span.to / 14.4}%"} data-tip={"#{timeline_clock(span.to)}: #{span.modules} modules, #{span.leftover} enkephalin left over after #{div(span.gap_minutes, 60)}h #{rem(span.gap_minutes, 60)}m#{if span.capped?, do: " (capped at 160)"}"}></div>
                <% end %>
              </div>
              <div class="relative h-3 text-[10px] text-base-content/50 font-mono">
                <%= for hour <- [0, 6, 12, 18, 24] do %>
                  <span class={["absolute", hour == 24 && "-translate-x-full", hour not in [0, 24] && "-translate-x-1/2"]} style={"left: #{hour / 0.24}%"}>{String.pad_leading(to_string(hour), 2, "0")}:00</span>
                <% end %>
              </div>
              <span class="text-xs text-base-content/60">{length(timeline.charges)} {if length(timeline.charges) == 1, do: "charge", else: "charges"} a day</span>
            </div>
          <% end %>
          <StarlightBotWeb.Components.LaunchFields.launch_fields
            launch_mode={form["launch_mode"]}
            steam_app_id={form["steam_app_id"]}
            exe_path={form["exe_path"]}
            launch_timeout_s={form["launch_timeout_s"]}
            reset_event="enkephalin_reset_steam_app_id"
          />

          <span :if={@enkephalin_schedule_error} class="text-xs text-error">Not saved: {@enkephalin_schedule_error}</span>
        </form>
      <% end %>

      <%= if @settings_tab == "data" do %>
        <p class="text-xs text-base-content/60 mb-3">Where Starlight keeps your data. Changes apply after restarting Starlight.</p>

        <form phx-submit="settings_save" class="flex flex-col gap-3">
          <div :if={StarlightBot.Data.authoring_allowed?()} class="form-control">
            <span class="label-text text-xs font-semibold mb-1">Mode</span>
            <label class="flex items-start gap-2 cursor-pointer">
              <input type="radio" name="mode" value="user" checked={@app_settings.mode == :user} class="radio radio-sm mt-0.5" />
              <span class="text-sm">User<span class="block text-xs text-base-content/60">Your teams, plans, hook overrides and run history live in your data folder. Shipped data is read-only.</span></span>
            </label>
            <label class="flex items-start gap-2 cursor-pointer mt-1">
              <input type="radio" name="mode" value="authoring" checked={@app_settings.mode == :authoring} class="radio radio-sm mt-0.5" />
              <span class="text-sm">Authoring (development)<span class="block text-xs text-base-content/60">Edits the shipped databases in the repository directly. Run history stays in <span class="font-mono">.starlight-dev/</span>.</span></span>
            </label>
          </div>

          <div class="form-control">
            <label class="label-text text-xs font-semibold mb-1" for="settings-data-dir">Data folder</label>
            <input id="settings-data-dir" type="text" name="data_dir" value={@app_settings.config["data_dir"]} placeholder="~/.starlight"
                   class="input input-bordered input-sm font-mono" />
          </div>

          <div class="flex gap-2 justify-end">
            <button type="button" phx-click="settings_open_folder" class="btn btn-sm btn-ghost">Open data folder</button>
            <button type="submit" class="btn btn-sm btn-primary">Save</button>
          </div>
        </form>

        <div class="divider my-2 text-xs">In use right now ({@app_settings.mode}, set by {@app_settings.mode_source})</div>
        <table class="table table-xs">
          <tbody>
            <tr><td class="whitespace-nowrap">Shipped data</td><td class="font-mono text-xs break-all">{@app_settings.paths.base}</td></tr>
            <tr><td class="whitespace-nowrap">Your data</td><td class="font-mono text-xs break-all">{@app_settings.paths.user}</td></tr>
            <tr><td class="whitespace-nowrap">Run history</td><td class="font-mono text-xs break-all">{@app_settings.paths.runs}</td></tr>
            <tr><td class="whitespace-nowrap">Your hook images</td><td class="font-mono text-xs break-all">{@app_settings.paths.user_hooks_dir}</td></tr>
            <tr><td class="whitespace-nowrap">Logs</td><td class="font-mono text-xs break-all">{@app_settings.paths.log_dir}</td></tr>
            <tr><td class="whitespace-nowrap">Settings file</td><td class="font-mono text-xs break-all">{@app_settings.config_file}</td></tr>
          </tbody>
        </table>
      <% end %>
      </div>

      <div class="modal-action">
        <button phx-click="settings_close" class="btn btn-sm">Close</button>
      </div>
    </div>
  </div>
<% end %>
