<%= if msg = @flash["info"] do %>
  <div class="fixed bottom-4 right-4 z-50 flex items-center gap-2 px-3 py-2 rounded-lg shadow-md bg-success/90 text-success-content text-xs cursor-pointer select-none"
       role="alert"
       phx-click="lv:clear-flash" phx-value-key="info">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
    <span><%= msg %></span>
  </div>
<% end %>

<%= if msg = @flash["error"] do %>
  <div class="fixed bottom-4 right-4 z-50 flex items-center gap-2 px-3 py-2 rounded-lg shadow-md bg-error/90 text-error-content text-xs cursor-pointer select-none"
       role="alert"
       phx-click="lv:clear-flash" phx-value-key="error">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
    <span><%= msg %></span>
  </div>
<% end %>

<div class="h-screen overflow-hidden flex">
  <nav class="flex flex-col items-center gap-1 w-12 shrink-0 py-3 bg-base-100 border-r border-base-300">
    <%!-- Runners --%>
    <.link navigate={~p"/mirror-dungeon"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :mirror_dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Mirror Dungeon Runner">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M12 3a6 6 0 0 0-6 6c0 3 2 5 2 8h8c0-3 2-5 2-8a6 6 0 0 0-6-6Z" />
        <path d="M9 21h6" />
        <path d="M10 17h4" />
      </svg>
    </.link>
    <.link navigate={~p"/luxcavation"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :luxcavation, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Luxcavation Runner">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <polygon points="6 3 20 12 6 21 6 3" />
      </svg>
    </.link>
    <.link navigate={~p"/shop-runner"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :shop_runner, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Shop Runner">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
      </svg>
    </.link>
    <.link navigate={~p"/rewards"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :rewards, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Rewards">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <rect x="3" y="8" width="18" height="4" rx="1" />
        <path d="M12 8v13" />
        <path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7" />
        <path d="M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8" />
        <path d="M16.5 8a2.5 2.5 0 0 0 0-5C13 3 12 8 12 8" />
      </svg>
    </.link>

    <div class="divider my-1"></div>

    <%!-- Config --%>
    <.link navigate={~p"/teams"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :teams, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Teams">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
        <circle cx="9" cy="7" r="4" />
        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
      </svg>
    </.link>
    <.link navigate={~p"/theme-pack-plans"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :theme_pack_plans, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Theme Pack Plans">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M11 4H4a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
        <path d="M17.5 3.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z" />
      </svg>
    </.link>
    <.link navigate={~p"/gift-plans"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :gift_plans, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Gift Plans">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="m3 8 4-4 4 4" />
        <path d="M7 4v16" />
        <path d="M13 6h8" />
        <path d="M13 12h8" />
        <path d="M13 18h5" />
      </svg>
    </.link>

    <div class="divider my-1"></div>

    <%!-- Inspectors / debug tools --%>
    <.link navigate={~p"/hooks"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :hooks, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Hook Editor">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <circle cx="12" cy="12" r="10" />
        <line x1="22" x2="18" y1="12" y2="12" />
        <line x1="6" x2="2" y1="12" y2="12" />
        <line x1="12" x2="12" y1="6" y2="2" />
        <line x1="12" x2="12" y1="22" y2="18" />
      </svg>
    </.link>
    <.link navigate={~p"/screenshots"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :screenshots, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Screenshots">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z" />
        <circle cx="12" cy="13" r="3" />
      </svg>
    </.link>
    <.link navigate={~p"/battle"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :battle, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Battle Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M14.5 17.5 3 6V3h3l11.5 11.5" />
        <path d="M13 19l6-6" />
        <path d="M16 16l4 4" />
        <path d="M19 21l2-2" />
      </svg>
    </.link>
    <.link navigate={~p"/dungeon"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :dungeon, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Dungeon Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <line x1="6" x2="6" y1="3" y2="15" />
        <circle cx="18" cy="6" r="3" />
        <circle cx="6" cy="18" r="3" />
        <path d="M18 9a9 9 0 0 1-9 9" />
      </svg>
    </.link>
    <.link navigate={~p"/gift-inspector"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :gift_inspector, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Gift Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <rect x="3" y="3" width="10" height="10" rx="1" />
        <circle cx="17" cy="17" r="4" />
        <path d="M20 20l2 2" />
      </svg>
    </.link>
    <.link navigate={~p"/theme-packs"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :theme_packs, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Theme Packs">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <rect x="3" y="3" width="7" height="7" rx="1" />
        <rect x="14" y="3" width="7" height="7" rx="1" />
        <rect x="3" y="14" width="7" height="7" rx="1" />
        <rect x="14" y="14" width="7" height="7" rx="1" />
      </svg>
    </.link>
    <.link navigate={~p"/events"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :events, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Event Inspector">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
      </svg>
    </.link>
    <.link navigate={~p"/transitions"}
           class={"tooltip tooltip-right btn btn-square btn-sm " <> if(assigns[:page] == :transitions, do: "btn-primary", else: "btn-ghost text-base-content/50")}
           data-tip="Transitions">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
        <rect width="8" height="8" x="3" y="3" rx="2" />
        <path d="M7 11v4a2 2 0 0 0 2 2h4" />
        <rect width="8" height="8" x="13" y="13" rx="2" />
      </svg>
    </.link>

    <label class="swap swap-rotate btn btn-ghost btn-square btn-sm mt-auto" title="Toggle theme">
      <input type="checkbox" id="theme-toggle-cb" />
      <svg class="swap-off h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
      </svg>
      <svg class="swap-on h-5 w-5 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"/>
      </svg>
    </label>
  </nav>

  <main class="p-3 flex-1 min-w-0 overflow-hidden flex flex-col">
    <%= @inner_content %>
  </main>
</div>
