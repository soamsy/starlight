<div class="flex flex-col h-full gap-3 overflow-hidden">
  <div class="grid grid-cols-[24fr_76fr] grid-rows-1 gap-2 flex-1 min-h-0">

    <%!-- Left: Plan List --%>
    <div class="card bg-base-100 shadow-lg flex flex-col overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="card-title text-lg">Plans</h2>
          <span class="badge badge-neutral badge-sm"><%= length(@plans) %></span>
          <button phx-click="new_plan" class="btn btn-primary btn-sm ml-auto">+ New</button>
        </div>

        <div class="overflow-y-auto flex-1 min-h-0">
          <table class="table table-xs table-pin-rows">
            <tbody>
              <%= for plan <- @plans do %>
                <tr phx-click="select_plan" phx-value-id={plan.id}
                    class={"cursor-pointer hover:bg-base-200 " <> if(@editing_id == plan.id, do: "bg-primary/10 border-l-2 border-primary", else: "")}>
                  <td class="font-mono text-xs"><%= plan.name %></td>
                  <td class="text-right whitespace-nowrap">
                    <button phx-click="duplicate_plan" phx-value-id={plan.id} class="btn btn-xs btn-ghost">Dup</button>
                    <button phx-click="delete_plan" phx-value-id={plan.id}
                            data-confirm={"Delete '#{plan.name}'?"}
                            class="btn btn-xs btn-ghost text-error">Del</button>
                  </td>
                </tr>
              <% end %>
              <%= if @plans == [] do %>
                <tr><td colspan="2" class="text-center text-base-content/40 py-4">No plans yet — create one.</td></tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <%!-- Right: Editor --%>
    <div class="card bg-base-100 shadow-lg flex flex-col overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3 overflow-y-auto">
        <%= if @editing_id do %>

          <input type="text" value={@name} phx-blur="rename_plan"
                 class="input input-bordered input-sm w-64 font-semibold" placeholder="Plan name" />

          <%!-- Mode schedule --%>
          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 text-xs text-base-content/60">
              <span class="font-medium">Mode schedule</span>
              <span>— click a floor to switch to hard from there on (one-way: normal → hard only)</span>
              <label class="ml-auto flex items-center gap-1 cursor-pointer">
                <input type="checkbox" checked={@extreme?} phx-click="toggle_extreme" class="checkbox checkbox-xs" />
                show extreme floors (6-15)
              </label>
            </div>
            <div class="flex gap-1 flex-wrap">
              <%= for floor <- 1..max_floor(@extreme?) do %>
                <% mode = StarlightBot.ThemePackPlans.Resolver.mode_for_floor(@plan_data["mode_schedule"], floor) %>
                <% breakpoint? = Enum.any?(@plan_data["mode_schedule"], &(&1["from_floor"] == floor)) %>
                <button phx-click="toggle_breakpoint" phx-value-floor={floor}
                        class={"btn btn-xs " <> if(mode == "hard", do: "btn-secondary", else: "btn-info btn-outline") <> if(breakpoint?, do: " ring ring-offset-1 ring-base-content/30", else: "")}
                        title={"Floor #{floor}: #{mode}"}>
                  <%= floor %>
                </button>
              <% end %>
            </div>
          </div>

          <div class="flex flex-col gap-1">
            <span class="text-xs text-base-content/60">
              <span class="font-medium">Pack search</span>
              <span>(on highlighted floors, once refreshes run out, search-replace the leftmost pack with the first unvisited Hunt pack that has a search hook)</span>
            </span>
            <div class="flex gap-1 flex-wrap">
              <%= for floor <- 1..max_floor(@extreme?) do %>
                <% search? = floor in @plan_data["search_floors"] %>
                <button phx-click="toggle_search_floor" phx-value-floor={floor}
                        class={"btn btn-xs " <> if(search?, do: "btn-warning", else: "btn-ghost border-base-300")}
                        title={"Floor #{floor}: " <> if(search?, do: "search when out of refreshes", else: "no search")}>
                  <%= floor %>
                </button>
              <% end %>
            </div>
          </div>

          <div class="divider my-0"></div>

          <%!-- Mode tabs --%>
          <div class="flex gap-1">
            <button phx-click="set_mode_tab" phx-value-mode="normal"
                    class={"btn btn-sm " <> if(@active_mode == "normal", do: "btn-primary", else: "btn-ghost")}>
              Normal
            </button>
            <button phx-click="set_mode_tab" phx-value-mode="hard"
                    class={"btn btn-sm " <> if(@active_mode == "hard", do: "btn-primary", else: "btn-ghost")}>
              Hard
            </button>
          </div>

          <%!-- Floor coverage strip --%>
          <div class="flex flex-col gap-1">
            <span class="text-xs text-base-content/60">
              Floor coverage — dashed = no Hunt/Bonus pack assigned yet, click to search that floor
            </span>
            <div class="flex gap-1 flex-wrap">
              <%= for floor <- floors_in_range(@plan_data["mode_schedule"], @active_mode, max_floor(@extreme?)) do %>
                <% covered? = floor_covered?(@plan_data, @theme_packs, @active_mode, floor) %>
                <button phx-click="set_floor_filter" phx-value-floor={floor}
                        class={"btn btn-xs " <>
                          cond do
                            @floor_filter == floor -> "btn-accent"
                            covered? -> "btn-success btn-outline"
                            true -> "btn-outline border-dashed text-base-content/50"
                          end}>
                  <%= floor %>
                </button>
              <% end %>
            </div>
          </div>

          <div id="priority-columns" phx-hook="PriorityClipboard" class="flex-1 min-h-0 flex flex-col gap-3 min-h-0">

            <%!-- Priority columns --%>
            <div class="grid grid-cols-[3fr_3fr_1fr] gap-2">
              <%= for priority <- priorities() do %>
                <div class="border border-base-300 rounded-lg p-2 flex flex-col gap-1 min-h-24 max-h-72 overflow-y-auto">
                  <div class="text-xs font-semibold text-base-content/70 flex items-center gap-1 flex-wrap">
                    <%= priority_label(priority) %>
                    <span class="text-base-content/40 cursor-help" title={priority_tooltip(priority)}>ⓘ</span>
                    <button type="button" phx-click="copy_priority" phx-value-priority={priority}
                            class="btn btn-ghost btn-2xs px-1 ml-auto" title={"Copy #{priority_label(priority)} list to clipboard"}>
                      ⧉
                    </button>
                    <button type="button" data-paste-priority={priority}
                            class="btn btn-ghost btn-2xs px-1" title={"Paste clipboard JSON, replacing the #{priority_label(priority)} list"}>
                      📥
                    </button>
                  </div>
                  <%= for pack <- packs_with_priority(@plan_data, @theme_packs, @active_mode, priority) do %>
                    <div class="flex flex-col gap-0.5 bg-base-200 rounded p-1">
                      <div class="flex items-center gap-1">
                        <img src={pack.image_path} class="w-6 h-6 rounded object-cover shrink-0" />
                        <span class="text-[11px] truncate flex-1" title={pack.name_en}><%= pack.name_en %></span>
                        <button phx-click="assign_priority" phx-value-pack_id={pack.id} phx-value-priority="fine"
                                class="btn btn-ghost btn-xs px-1" title="Reset to fine">✕</button>
                      </div>
                      <button phx-click="toggle_floor_editor" phx-value-pack_id={pack.id}
                              class="text-[10px] text-base-content/60 self-start hover:underline">
                        floors: <%= pack_floor_label(@plan_data, pack, @active_mode) %> ▾
                      </button>
                      <%= if @floor_editor_pack_id == pack.id do %>
                        <div class="flex flex-wrap gap-0.5 mt-0.5">
                          <% assigned = StarlightBot.ThemePackPlans.Resolver.floors_for(@plan_data, pack.id, @active_mode, pack) %>
                          <%= for floor <- StarlightBot.ThemePackPlans.Resolver.eligible_floors(pack, @active_mode) do %>
                            <button phx-click="toggle_pack_floor" phx-value-pack_id={pack.id} phx-value-floor={floor}
                                    class={"btn btn-2xs px-1.5 " <> if(floor in assigned, do: "btn-primary", else: "btn-outline")}>
                              <%= floor %>
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                  <%= if packs_with_priority(@plan_data, @theme_packs, @active_mode, priority) == [] do %>
                    <div class="text-[11px] text-base-content/30 italic">none</div>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="divider my-0"></div>

            <%!-- Assign panel --%>
            <div class="flex-1 min-h-0 flex flex-col gap-1">
              <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-base-content/70">
                  Assign a pack
                  <%= if @floor_filter, do: " — eligible for floor #{@floor_filter}" %>
                </span>
                <input type="text" placeholder="Search packs…" value={@filter} phx-keyup="filter_packs"
                       class="input input-bordered input-xs w-48 ml-auto" />
              </div>

              <div class="flex-1 min-h-0 flex flex-col gap-1 overflow-y-auto">
                <%= for pack <- fine_candidates(@plan_data, @theme_packs, @active_mode, @filter, @floor_filter) do %>
                  <div class="flex items-center gap-2 p-1 rounded hover:bg-base-200">
                    <img src={pack.image_path} class="w-6 h-6 rounded object-cover shrink-0" />
                    <span class="text-xs flex-1 truncate" title={pack.name_en}><%= pack.name_en %></span>
                    <span class="badge badge-ghost badge-xs">
                      <%= Enum.join(StarlightBot.ThemePackPlans.Resolver.eligible_floors(pack, @active_mode), ",") %>
                    </span>
                    <%= for priority <- priorities() do %>
                      <button phx-click="assign_priority" phx-value-pack_id={pack.id} phx-value-priority={priority}
                              class="btn btn-2xs btn-outline">
                        <%= priority_label(priority) %>
                      </button>
                    <% end %>
                  </div>
                <% end %>
                <%= if fine_candidates(@plan_data, @theme_packs, @active_mode, @filter, @floor_filter) == [] do %>
                  <div class="text-xs text-base-content/40 italic p-1">No matching packs.</div>
                <% end %>
              </div>
            </div>

          </div>

        <% else %>
          <div class="flex-1 flex items-center justify-center text-base-content/40 text-sm">
            Select or create a plan to edit.
          </div>
        <% end %>
      </div>
    </div>

  </div>
</div>
