<div class="flex flex-col h-full gap-3 overflow-hidden">
  <div class="flex items-center gap-3 shrink-0">
    <h1 class="text-lg font-bold">Battle Inspector</h1>
    <.tabs current={@tab} restore={not @tab_from_url?} />
    <%= if @nav.run_kind in [:mirror_dungeon, :luxcavation] do %>
      <div class="flex items-center gap-2 ml-auto">
        <span class="text-xs text-base-content/60"><%= run_label(@nav.run_kind) %>: <%= @nav.phase %></span>
        <%= cond do %>
          <% @nav.phase == :paused -> %>
            <button phx-click="resume_run" class="btn btn-sm btn-warning" disabled={@resume_pending?}>
              <%= if @resume_pending? do %>Resuming in 2s, alt-tab in…<% else %><.icon name="lucide-play" class="size-3.5" /> Resume<% end %>
            </button>
          <% @nav.pause_requested -> %>
            <button class="btn btn-sm" disabled>Pausing…</button>
          <% @nav.phase == :running -> %>
            <button phx-click="pause_run" class="btn btn-sm btn-warning">⏸ Pause</button>
          <% true -> %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3 shrink-0 flex-wrap">
    <%= if @tab == :screen do %>
      <button phx-click="take_screenshot" class="btn btn-sm btn-primary" disabled={@status == :loading}>
        📸 Take Screenshot
      </button>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" class="toggle toggle-sm toggle-accent" checked={@watch_tray?} phx-click="toggle_watch_tray" />
        <span class="text-sm">Watch tray</span>
      </label>
      <%= if @watch_tray? do %>
        <span class="text-xs text-base-content/60">
          <%= if @last_watched_at do %>
            last scan <%= Calendar.strftime(@last_watched_at, "%H:%M:%S") %> UTC
          <% else %>
            waiting for a runner to scan the skill tray…
          <% end %>
        </span>
      <% end %>
    <% end %>
    <%= if @tab == :active do %>
      <button phx-click="read_active_skills" class="btn btn-sm btn-primary">📸 Read active skills</button>
      <button phx-click="view_in_hook_editor" class="btn btn-sm btn-secondary" disabled={is_nil(@active_mat)}>View in hook editor</button>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" class="toggle toggle-sm toggle-accent" checked={@watch_active?} phx-click="toggle_watch_active" />
        <span class="text-sm">Watch tray</span>
      </label>
      <%= if @watch_active? do %>
        <span class="text-xs text-base-content/60">
          <%= if @last_active_at do %>
            last read <%= Calendar.strftime(@last_active_at, "%H:%M:%S") %> UTC
          <% else %>
            waiting for a playbook to read the active skills…
          <% end %>
        </span>
      <% end %>
      <span :if={@active_error} class="text-xs text-error"><%= @active_error %></span>
    <% end %>
    <%= if @tab == :chain do %>
      <button phx-click="preview_chain_drag" class="btn btn-sm btn-secondary" disabled={@chain_preview_status == :running}>
        🖱️ Preview Chain Drag (2s delay)
      </button>
    <% end %>
    <%= if @tab == :targets do %>
      <button phx-click="preview_target" phx-value-enemy="first" class="btn btn-sm btn-secondary" disabled={@target_preview_status == :running}>
        🎯 First skill to first enemy (2s delay)
      </button>
      <button phx-click="preview_target" phx-value-enemy="last" class="btn btn-sm btn-secondary" disabled={@target_preview_status == :running}>
        🎯 First skill to last enemy (2s delay)
      </button>
      <button phx-click="preview_target_everyone" class="btn btn-sm btn-secondary" disabled={@target_preview_status == :running}
              title="Every slot drags a random skill, top or bottom, to each enemy left to right, ending on the last enemy if there are more slots than enemies">
        🎲 Every slot to enemies left to right (2s delay)
      </button>
    <% end %>
    <%= if @frame_b64 do %>
      <span class="text-xs text-base-content/60">
        <%= if @battle_chain? do %>
          <%= @gear_hook %> detected
        <% else %>
          not a battle screen (no battle_chain or battle_focused)
        <% end %>
      </span>
    <% end %>
    <%= if @scan_error do %>
      <span class="text-xs text-error">scan error: <%= @scan_error %></span>
    <% end %>
    <%= if @chain_preview_status == :running or @target_preview_status == :running do %>
      <span class="text-xs text-warning">alt-tab into Limbus Company now…</span>
    <% end %>
    <%= if @chain_preview_error do %>
      <span class="text-xs text-error">chain preview error: <%= @chain_preview_error %></span>
    <% end %>
  </div>

  <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-3">
    <div class={"flex items-center justify-center bg-base-200 rounded-lg border border-base-300 shrink-0 " <> if(@tab != :screen, do: "hidden", else: "")} style="aspect-ratio: 16/9;">
      <%= if @frame_b64 do %>
        <canvas id="battle-inspector-canvas" phx-hook="BattleInspectorCanvas" phx-update="ignore"
                class="max-w-full max-h-full" style="aspect-ratio: 16/9;"></canvas>
      <% else %>
        <div class="text-base-content/40 text-sm">Take a screenshot to inspect the current battle screen</div>
      <% end %>
    </div>

    <div :if={@active_rows} class={"flex items-center justify-center bg-base-200 rounded-lg border border-base-300 shrink-0 " <> if(@tab != :active, do: "hidden", else: "")} style="aspect-ratio: 16/9;">
      <canvas id="active-skills-canvas" phx-hook="ActiveSkillsCanvas" phx-update="ignore"
              class="max-w-full max-h-full" style="aspect-ratio: 16/9;"></canvas>
    </div>
    <%= if @active_rows && @tab == :active do %>
      <div class="overflow-x-auto shrink-0">
        <table class="table table-xs w-auto">
          <thead><tr><th>slot</th><th>skill used</th></tr></thead>
          <tbody>
            <tr :for={{column, row} <- @active_rows}>
              <td><%= column + 1 %></td>
              <td><%= row %></td>
            </tr>
          </tbody>
        </table>
      </div>
    <% end %>

    <%= if @tray && @tab == :screen do %>
      <div class="grid grid-cols-2 gap-3 shrink-0">
        <div class="overflow-x-auto">
          <table class="table table-xs">
            <thead><tr><th colspan="2">Skill tray geometry</th></tr></thead>
            <tbody>
              <tr><td class="text-base-content/60">gear_start_x</td><td><%= @tray.gear_start_x %></td></tr>
              <tr><td class="text-base-content/60">tray_start_x</td><td><%= @tray.tray_start_x %></td></tr>
              <tr><td class="text-base-content/60">tray_end_x</td><td><%= @tray.tray_end_x %></td></tr>
              <tr><td class="text-base-content/60">skill_num</td><td><%= @tray.skill_num %></td></tr>
              <tr><td class="text-base-content/60">bin_width</td><td><%= Float.round(@tray.bin_width, 1) %></td></tr>
              <tr><td class="text-base-content/60">top_row</td><td class="font-mono text-xs"><%= format_row(@tray.top_row) %></td></tr>
              <tr><td class="text-base-content/60">bottom_row</td><td class="font-mono text-xs"><%= format_row(@tray.bottom_row) %></td></tr>
            </tbody>
          </table>
        </div>

        <div class="overflow-x-auto">
          <table class="table table-xs">
            <thead><tr><th>#</th><th>sinner</th><th>first action</th></tr></thead>
            <tbody>
              <%= for {sinner_id, i} <- Enum.with_index(@tray.sinner_of_slot) do %>
                <tr>
                  <td><%= i %></td>
                  <td>S<%= sinner_id %></td>
                  <td><.icon :if={i == 0 or sinner_id != Enum.at(@tray.sinner_of_slot, i - 1)} name="lucide-filled-star" class="size-3.5" /></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <%= if @bg_color do %>
          <div class="overflow-x-auto col-span-2">
            <table class="table table-xs">
              <thead><tr><th colspan="2">Background sample (exclusion/contrast guard)</th></tr></thead>
              <tbody>
                <tr>
                  <td class="text-base-content/60">strip</td>
                  <td><img src={"data:image/png;base64,#{@bg_strip_b64}"} class="w-6 border border-base-300" /></td>
                </tr>
                <tr>
                  <td class="text-base-content/60">avg color</td>
                  <td class="flex items-center gap-1">
                    <span class="inline-block w-3 h-3 rounded-sm border border-base-300"
                          style={"background-color: #{bgr_to_hex(@bg_color.bgr)}"}></span>
                    hue <%= @bg_color.hue %>, sat <%= round(@bg_color.saturation / 255 * 100) %>%, val <%= round(@bg_color.value / 255 * 100) %>%
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        <% end %>

        <div class="overflow-x-auto col-span-2">
          <div class="text-xs font-semibold text-base-content/60 mb-1">Top row</div>
          <table class="table table-xs">
            <thead>
              <tr>
                <th>#</th>
                <th>x-range</th><th>hue cell</th><th>ring</th><th>sin</th><th>conf</th>
                <th>tier cell</th><th>wedge</th><th>tier match</th><th>tier</th><th>wedge %</th>
              </tr>
            </thead>
            <tbody>
              <%= for row <- row_column_pairs(@tray, @top_sins, @bottom_sins) do %>
                <tr>
                  <td><%= row.index %></td>
                  <td><%= elem(row.top_x, 0) %>..<%= elem(row.top_x, 1) %></td>
                  <td><img src={"data:image/png;base64,#{row.top_sin.hue_cell_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.top_sin.mask_b64}"} class="h-8" /></td>
                  <td class="flex items-center gap-1">
                    <span class="inline-block w-3 h-3 rounded-sm border border-base-300"
                          style={"background-color: #{bgr_to_hex(row.top_sin.reference.bgr)}"}></span>
                    <%= row.top_sin.sin %>
                  </td>
                  <td><%= Float.round(row.top_sin.confidence, 2) %></td>
                  <td><img src={"data:image/png;base64,#{row.top_sin.tier_cell_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.top_sin.wedge_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.top_sin.tier_mask_b64}"} class="h-8" /></td>
                  <td><%= row.top_sin.tier %></td>
                  <td style={"background-color: #{tier_pct_color(row.top_sin.sin, row.top_sin.tier_pct)}"}>
                    <%= Float.round(row.top_sin.tier_pct * 100, 1) %>%
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="overflow-x-auto col-span-2">
          <div class="text-xs font-semibold text-base-content/60 mb-1">Bottom row</div>
          <table class="table table-xs">
            <thead>
              <tr>
                <th>#</th>
                <th>x-range</th><th>hue cell</th><th>ring</th><th>sin</th><th>conf</th>
                <th>tier cell</th><th>wedge</th><th>tier match</th><th>tier</th><th>wedge %</th>
              </tr>
            </thead>
            <tbody>
              <%= for row <- row_column_pairs(@tray, @top_sins, @bottom_sins) do %>
                <tr>
                  <td><%= row.index %></td>
                  <td><%= elem(row.bottom_x, 0) %>..<%= elem(row.bottom_x, 1) %></td>
                  <td><img src={"data:image/png;base64,#{row.bottom_sin.hue_cell_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.bottom_sin.mask_b64}"} class="h-8" /></td>
                  <td class="flex items-center gap-1">
                    <span class="inline-block w-3 h-3 rounded-sm border border-base-300"
                          style={"background-color: #{bgr_to_hex(row.bottom_sin.reference.bgr)}"}></span>
                    <%= row.bottom_sin.sin %>
                  </td>
                  <td><%= Float.round(row.bottom_sin.confidence, 2) %></td>
                  <td><img src={"data:image/png;base64,#{row.bottom_sin.tier_cell_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.bottom_sin.wedge_b64}"} class="h-8" /></td>
                  <td><img src={"data:image/png;base64,#{row.bottom_sin.tier_mask_b64}"} class="h-8" /></td>
                  <td><%= row.bottom_sin.tier %></td>
                  <td style={"background-color: #{tier_pct_color(row.bottom_sin.sin, row.bottom_sin.tier_pct)}"}>
                    <%= Float.round(row.bottom_sin.tier_pct * 100, 1) %>%
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
    <div class={"flex flex-col gap-1 shrink-0 " <> if(@tab != :chain, do: "hidden", else: "")}>
      <div class="text-xs font-semibold text-base-content/60">
        Chain drag preview — mouse-down snapshot with the computed trajectory overlaid, mouse released without dragging
      </div>
      <div class="flex items-center justify-center bg-base-200 rounded-lg border border-base-300 shrink-0" style="aspect-ratio: 16/9;">
        <%= if @chain_preview_ready? do %>
          <canvas id="chain-preview-canvas" phx-hook="ChainPreviewCanvas" phx-update="ignore"
                  class="max-w-full max-h-full" style="aspect-ratio: 16/9;"></canvas>
        <% else %>
          <div class="text-base-content/40 text-sm">Preview Chain Drag to see the computed trajectory against the dragged skill tray</div>
        <% end %>
      </div>
    </div>
    <div class={"flex flex-col gap-1 shrink-0 " <> if(@tab != :targets, do: "hidden", else: "")}>
      <div class="text-xs font-semibold text-base-content/60">
        Enemy target preview: last detection frame, every detected target and the chosen one
        <%= if @target_preview_outcome do %>
          <span class={if @target_preview_status == :error, do: "text-error", else: "text-base-content"}>(<%= @target_preview_outcome %>)</span>
        <% end %>
      </div>
      <div class="h-48 shrink-0 flex flex-col">
        <StarlightBotWeb.Live.LogLive.panel socket={@socket} id="battle-inspector-log" />
      </div>
      <div class="flex items-center justify-center bg-base-200 rounded-lg border border-base-300 shrink-0" style="aspect-ratio: 16/9;">
        <%= if @target_preview_ready? do %>
          <canvas id="target-preview-canvas" phx-hook="TargetPreviewCanvas" phx-update="ignore"
                  class="max-w-full max-h-full" style="aspect-ratio: 16/9;"></canvas>
        <% else %>
          <div class="text-base-content/40 text-sm">Use a 🎯 button to drag the first skill onto an enemy target</div>
        <% end %>
      </div>
    </div>
  </div>
</div>
