<div class="flex flex-col h-full gap-3 overflow-hidden">

  <%!-- Top section: both columns fill the remaining height --%>
  <div class="grid grid-cols-[30fr_28fr] grid-rows-1 gap-2 flex-1 min-h-0">

    <%!-- Left: Screenshot Panel --%>
    <div class="card bg-base-100 shadow-lg flex flex-col overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0">

        <div class="flex items-center gap-3 mb-2">
          <h2 class="card-title text-lg">Hook Editor</h2>
          <button phx-click="take_screenshot"
                  disabled={@screenshot_status in [:loading, :waiting]}
                  class="btn btn-primary btn-sm">
            <%= if @screenshot_status == :loading do %>
              <span class="loading loading-spinner loading-xs"></span> Capturing…
            <% else %>
              📷 Screenshot
            <% end %>
          </button>
          <button phx-click="take_screenshot_delayed"
                  disabled={@screenshot_status in [:loading, :waiting]}
                  class="btn btn-primary btn-sm btn-outline">
            <%= if @screenshot_status == :waiting do %>
              <span class="loading loading-spinner loading-xs"></span> 2s…
            <% else %>
              ⏱ 2s
            <% end %>
          </button>
          <button phx-click="save_screenshot"
                  disabled={is_nil(@screenshot_mat)}
                  class="btn btn-ghost btn-sm"
                  title="Save screenshot to screenshots/">
            💾
          </button>
          <button phx-click="save_raw_screenshot"
                  disabled={@screenshot_status in [:loading, :waiting]}
                  class="btn btn-ghost btn-sm"
                  title="Save a fresh capture at the game window's native resolution (no upscale to 1920×1080)">
            💾 Raw
          </button>
          <%= if @screenshot_status == :done do %>
            <span class="badge badge-success badge-sm">Ready</span>
          <% end %>
          <div class="tooltip tooltip-bottom" data-tip="Click and drag on the screenshot to select a region. Hold Shift for precision mode.">
            <span class="flex items-center justify-center w-5 h-5 rounded-full border border-base-content/30 text-base-content/40 text-xs cursor-default select-none">?</span>
          </div>

          <%!-- Canvas draw mode toggle --%>
          <div class="join">
            <button phx-click="set_canvas_mode" phx-value-mode="detect"
                    class={"btn btn-xs join-item #{if @canvas_mode == :detect, do: "btn-primary", else: "btn-ghost"}"}>
              Region
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="click"
                    class={"btn btn-xs join-item #{if @canvas_mode == :click, do: "btn-info", else: "btn-ghost"}"}>
              Click
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="scan"
                    class={"btn btn-xs join-item #{if @canvas_mode == :scan, do: "btn-warning", else: "btn-ghost"}"}>
              Scan
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="color"
                    class={"btn btn-xs join-item #{if @canvas_mode == :color, do: "btn-accent", else: "btn-ghost"}"}
                    title="Click the screenshot to sample a color for an hsv_range hook">
              🎨 Color
            </button>
          </div>

          <%!-- Selection info --%>
          <div class="flex items-center gap-2 min-h-5">
            <%= if @region do %>
              <span class="badge badge-error badge-xs">R</span>
              <span class="text-xs font-mono text-base-content/70">
                <%= @region.x %>,<%= @region.y %> <%= @region.w %>×<%= @region.h %>
              </span>
              <button phx-click="clear_region" class="btn btn-xs btn-ghost text-error">✕</button>
            <% end %>
            <%= if @click_region do %>
              <span class="badge badge-info badge-xs">C</span>
              <span class="text-xs font-mono text-info/80">
                <%= @click_region.x %>,<%= @click_region.y %> <%= @click_region.w %>×<%= @click_region.h %>
              </span>
              <button phx-click="clear_click_region" class="btn btn-xs btn-ghost text-info">✕</button>
            <% end %>
            <%= if @scan_region do %>
              <span class="badge badge-warning badge-xs">S</span>
              <span class="text-xs font-mono text-warning/80">
                <%= @scan_region.x %>,<%= @scan_region.y %> <%= @scan_region.w %>×<%= @scan_region.h %>
              </span>
              <button phx-click="clear_scan_region" class="btn btn-xs btn-ghost text-warning">✕</button>
            <% end %>
          </div>
        </div>

        <%!-- Canvas wrapper: fills remaining flex space, canvas fits 16:9 within it --%>
        <div class="flex-1 min-h-0 overflow-hidden" style="">
          <%= if @screenshot_status == :idle do %>
            <div class="h-full flex flex-col items-center justify-center text-base-content/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-sm">Take a screenshot to begin</p>
            </div>
          <% end %>
          <%!-- width: min(100%, height*16/9) keeps strict 16:9 regardless of which axis is tighter --%>
          <div class="relative bg-base-300 overflow-hidden"
               style="aspect-ratio: 16/9; width: min(100%, calc(100cqh * 16 / 9));">
            <canvas
              id="screenshot-canvas"
              phx-hook="ScreenshotCanvas"
              width="1920"
              height="1080"
              class="w-full h-full cursor-crosshair"
              style="display: block;"
            ></canvas>
          </div>
        </div>
      </div>
    </div>

    <%!-- Right: Hook Form (scrolls internally) --%>
    <div class="flex flex-col gap-3 min-h-0 overflow-y-auto">

      <%!-- Form Card --%>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body p-3">
          <div class="flex justify-between items-center mb-2">
            <h2 class="card-title text-base">
              <%= if @editing_name do %>
                <span class="font-mono text-primary"><%= @editing_name %></span>
              <% else %>
                New Hook
              <% end %>
            </h2>
            <button phx-click="new_hook" class="btn btn-xs btn-ghost">+ New</button>
          </div>

          <.form for={@form} phx-submit="save_hook" phx-change="validate_hook">

            <div class="flex gap-3 mb-2">
              <div class="flex-1 min-w-0">
                <%!-- Name --%>
                <div class="form-control mb-2">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Name
                      <span :if={field_dirty?(@form, @saved_params, :name)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <input
                    type="text"
                    name="hook[name]"
                    value={@form[:name].value}
                    placeholder="e.g. winrate_button"
                    class={"input input-bordered input-sm #{if @form[:name].errors != [], do: "input-error", else: if(field_dirty?(@form, @saved_params, :name), do: "input-warning")}"}
                  />
                  <%= if err = List.first(@form[:name].errors) do %>
                    <label class="label py-0"><span class="label-text-alt text-error"><%= elem(err, 0) %></span></label>
                  <% end %>
                </div>

                <div class="form-control">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Category
                      <span :if={field_dirty?(@form, @saved_params, :category)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <select name="hook[category]" class={"select select-bordered select-sm #{if field_dirty?(@form, @saved_params, :category), do: "select-warning"}"}>
                    <option value="" selected={to_string(@form[:category].value) == ""}>auto (from name)</option>
                    <%= for category <- StarlightBot.Hooks.categories() do %>
                      <option value={category} selected={to_string(@form[:category].value) == category}>
                        <%= category_label(category) %>
                      </option>
                    <% end %>
                  </select>
                </div>

                <%!-- Method --%>
                <div class="form-control">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Match Method
                      <span :if={field_dirty?(@form, @saved_params, :match_method)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <select name="hook[match_method]" class={"select select-bordered select-sm #{if field_dirty?(@form, @saved_params, :match_method), do: "select-warning"}"}>
                    <%= for method <- ~w(gray rgb binary_thresh hsv_range grayscale_detector sift sift_saturation) do %>
                      <option value={method} selected={to_string(@form[:match_method].value) == method}>
                        <%= method %>
                      </option>
                    <% end %>
                  </select>
                </div>
              </div>

              <%!-- Actions --%>
              <div class="flex flex-row items-start gap-1 shrink-0">
                <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                <%= if @editing_name do %>
                  <button type="button" phx-click="test_hook" phx-value-name={@editing_name}
                          class="btn btn-secondary btn-sm">🔍 Test</button>
                  <button type="button" phx-click="test_hook_region" phx-value-name={@editing_name}
                          class="btn btn-accent btn-sm" title="Screenshot only the hook's region (faster)">⚡ Region</button>
                  <button type="button" phx-click="open_template_editor" phx-value-name={@editing_name}
                          class="btn btn-warning btn-sm" title="Edit template mask">✏ Template</button>
                <% end %>
              </div>
            </div>

            <%!-- Confidence --%>
            <input :if={to_string(@form[:match_method].value) == "hsv_range"} type="hidden" name="hook[confidence]" value={@form[:confidence].value} />
            <div :if={to_string(@form[:match_method].value) != "hsv_range"} class="form-control mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Confidence
                  <span :if={field_dirty?(@form, @saved_params, :confidence)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
                <span class="label-text-alt font-mono text-primary"><%= :erlang.float_to_binary(@form[:confidence].value, [{:decimals, 2}]) %></span>
              </label>
              <input
                type="range"
                name="hook[confidence]"
                value={@form[:confidence].value}
                min="0" max="1" step="0.01"
                class={"range range-sm #{if field_dirty?(@form, @saved_params, :confidence), do: "range-warning", else: "range-primary"}"}
              />
              <div class="flex justify-between text-xs text-base-content/40 px-1 mt-0.5">
                <span>0.0</span><span>0.5</span><span>1.0</span>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">For grayscale_detector: how desaturated the region must be — 1.0 requires zero average saturation, 0.0 accepts any.</p>
            </div>

            <%!-- Region --%>
            <% region_dirty = Enum.any?([:region_x, :region_y, :region_w, :region_h], &field_dirty?(@form, @saved_params, &1)) %>
            <% image_will_update = not is_nil(@screenshot_mat) and not is_nil(@region) and not is_nil(@editing_name) %>
            <div class="mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Region (1920×1080 space)
                  <span :if={region_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
                <span :if={image_will_update} class="label-text-alt text-warning text-xs">image will be recropped</span>
              </label>
              <div class="grid grid-cols-4 gap-1">
                <%= for {label, field} <- [{"X", :region_x}, {"Y", :region_y}, {"W", :region_w}, {"H", :region_h}] do %>
                  <div>
                    <label class="label py-0"><span class="label-text-alt text-xs"><%= label %></span></label>
                    <input
                      type="number"
                      name={"hook[#{field}]"}
                      value={@form[field].value}
                      class={"input input-bordered input-xs w-full font-mono #{if field_dirty?(@form, @saved_params, field), do: "input-warning"}"}
                    />
                  </div>
                <% end %>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">Leave blank to search the full frame</p>
            </div>

            <%!-- Click Region --%>
            <% click_dirty = Enum.any?([:click_x, :click_y, :click_w, :click_h], &field_dirty?(@form, @saved_params, &1)) %>
            <div class="mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Click Region
                  <span :if={click_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <div class="grid grid-cols-4 gap-1">
                <%= for {label, field} <- [{"X", :click_x}, {"Y", :click_y}, {"W", :click_w}, {"H", :click_h}] do %>
                  <div>
                    <label class="label py-0"><span class="label-text-alt text-xs"><%= label %></span></label>
                    <input
                      type="number"
                      name={"hook[#{field}]"}
                      value={@form[field].value}
                      class={"input input-bordered input-xs w-full font-mono #{if field_dirty?(@form, @saved_params, field), do: "input-warning"}"}
                    />
                  </div>
                <% end %>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">Leave blank to click the center of the match result</p>
            </div>

            <%!-- Scan Region --%>
            <% scan_dirty = Enum.any?([:scan_x, :scan_y, :scan_w, :scan_h], &field_dirty?(@form, @saved_params, &1)) %>
            <div class="mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Scan Region
                  <span :if={scan_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <div class="grid grid-cols-4 gap-1">
                <%= for {label, field} <- [{"X", :scan_x}, {"Y", :scan_y}, {"W", :scan_w}, {"H", :scan_h}] do %>
                  <div>
                    <label class="label py-0"><span class="label-text-alt text-xs"><%= label %></span></label>
                    <input
                      type="number"
                      name={"hook[#{field}]"}
                      value={@form[field].value}
                      class={"input input-bordered input-xs w-full font-mono #{if field_dirty?(@form, @saved_params, field), do: "input-warning"}"}
                    />
                  </div>
                <% end %>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">When set, searches this wider area for the template instead of expecting it exactly at Region. Ignored by hsv_range hooks (they always scan Region).</p>
            </div>

            <%!-- Color (color_detector only) --%>
            <% range_dirty = Enum.any?([:color_h, :color_s, :color_v, :tol_h, :tol_s, :tol_v], &field_dirty?(@form, @saved_params, &1)) %>
            <% center_h = form_int(@form, :color_h, 0) %>
            <% center_s = form_int(@form, :color_s, 0) %>
            <% center_v = form_int(@form, :color_v, 0) %>
            <div class="mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  HSV Range
                  <span :if={range_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <div class="flex items-start gap-2">
                <div
                  class="w-8 h-8 rounded border border-base-300 shrink-0"
                  style={"background-color: #{color_swatch_css(center_h, center_s, center_v)}"}
                ></div>
                <div class="flex-1 space-y-2">
                  <%= for {label, channel, color_field, tol_field, max, tol_max} <- [{"H", :h, :color_h, :tol_h, 179, 90}, {"S", :s, :color_s, :tol_s, 255, 255}, {"V", :v, :color_v, :tol_v, 255, 255}] do %>
                    <% center = form_int(@form, color_field, 0) %>
                    <% tol = form_int(@form, tol_field, 0) %>
                    <% track =
                      case channel do
                        :h -> channel_gradient(:h, 0, 0)
                        :s -> channel_gradient(:s, center_h, center_v)
                        :v -> channel_gradient(:v, center_h, center_s)
                      end %>
                    <div>
                      <div class="flex items-center justify-between text-xs">
                        <span class="font-medium"><%= label %></span>
                        <span class="font-mono text-primary"><%= range_label(center, tol, channel) %></span>
                      </div>
                      <div class="relative h-3 rounded overflow-hidden border border-base-300" style={"background: #{track}"}>
                        <div
                          :for={box <- range_band_boxes(center, tol, channel)}
                          class="absolute inset-y-0 border-x-2 border-white bg-white/25"
                          style={box}
                        ></div>
                        <div class="absolute inset-y-0 w-0.5 bg-black/70" style={"left: #{Float.round(center / max * 100, 2)}%"}></div>
                      </div>
                      <div class="flex items-center gap-2 mt-1">
                        <input
                          type="number"
                          name={"hook[#{color_field}]"}
                          value={@form[color_field].value}
                          min="0" max={max}
                          title={"#{label} center"}
                          class={"input input-bordered input-xs w-16 font-mono #{if field_dirty?(@form, @saved_params, color_field), do: "input-warning"}"}
                        />
                        <span class="text-xs text-base-content/50">±</span>
                        <input
                          type="range"
                          name={"hook[#{tol_field}]"}
                          value={tol}
                          min="0" max={tol_max} step="1"
                          title={"#{label} tolerance"}
                          class={"range range-xs flex-1 #{if field_dirty?(@form, @saved_params, tol_field), do: "range-warning", else: "range-primary"}"}
                        />
                        <span class="text-xs font-mono w-8 text-right"><%= tol %></span>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">hsv_range matches pixels inside the shaded band on every channel at once. Sample a center with 🎨 Color mode above, then widen each channel; a tolerance of 0 matches that single value, and hue ±90 matches any hue. White is S near 0 and V near 255 with hue at any.</p>
            </div>

            <%!-- Min Cluster Size (color_detector only) --%>
            <div class="form-control mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Min Cluster Size
                  <span :if={field_dirty?(@form, @saved_params, :min_cluster_size)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <% cluster_size = form_int(@form, :min_cluster_size, 0) %>
              <div class="flex items-center gap-2">
                <input
                  type="range"
                  value={cluster_size}
                  min="0" max={max(250, cluster_size)} step="1"
                  oninput="const n = this.form.elements['hook[min_cluster_size]']; n.value = this.value; n.dispatchEvent(new Event('input', {bubbles: true}))"
                  class={"range range-sm flex-1 #{if field_dirty?(@form, @saved_params, :min_cluster_size), do: "range-warning", else: "range-primary"}"}
                />
                <input
                  type="number"
                  name="hook[min_cluster_size]"
                  value={@form[:min_cluster_size].value}
                  min="0"
                  class={"input input-bordered input-sm w-24 font-mono #{if field_dirty?(@form, @saved_params, :min_cluster_size), do: "input-warning"}"}
                />
              </div>
              <p class="text-xs text-base-content/40 mt-0.5">hsv_range hooks. Minimum pixel-area of a cluster to count as detected, for a 1920×1080 frame (scaled down for smaller captures).</p>
            </div>

            <%!-- Mask --%>
            <div class="form-control mb-2">
              <label class="label py-0.5 cursor-pointer justify-start gap-2">
                <input
                  type="checkbox"
                  name="hook[mask]"
                  value="true"
                  checked={@form[:mask].value == true}
                  class="checkbox checkbox-sm"
                />
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Ignore black pixels
                  <span :if={field_dirty?(@form, @saved_params, :mask)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <p class="text-xs text-base-content/40 mt-0.5 ml-7">Black areas of the template won't count against the match score — useful for glyph/icon templates with variable backgrounds</p>
            </div>

            <%!-- Notes --%>
            <div class="form-control mb-3">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Notes
                  <span :if={field_dirty?(@form, @saved_params, :notes)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <textarea
                name="hook[notes]"
                rows="2"
                placeholder="Which screen is this for?"
                class={"textarea textarea-bordered textarea-sm #{if field_dirty?(@form, @saved_params, :notes), do: "textarea-warning"}"}
              ><%= @form[:notes].value %></textarea>
            </div>
          </.form>

          <%!-- Test Result --%>
          <%= if @test_result do %>
            <div class={"alert mt-2 " <> if(@test_result.found, do: "alert-success", else: "alert-warning")}>
              <div class="w-full">
                <div class="flex items-center gap-2 mb-0.5">
                  <%= if @test_result.found do %>
                    <span class="font-semibold">✓ Match found</span>
                  <% else %>
                    <span class="font-semibold">✗ No match</span>
                  <% end %>
                  <%= if @test_result.mode == :region do %>
                    <span class="badge badge-accent badge-sm">⚡ region</span>
                  <% end %>
                  <%= if @test_result.mode == :all do %>
                    <span class="badge badge-warning badge-sm"><%= length(@test_result.matches) %> matches</span>
                  <% end %>
                </div>
                <%= if @test_result.mode == :all and @test_result.matches != [] do %>
                  <ul class="text-xs font-mono max-h-32 overflow-y-auto mb-1">
                    <%= for {m, i} <- Enum.with_index(@test_result.matches, 1) do %>
                      <li>#<%= i %> <strong><%= m.score %></strong> x=<%= m.rect.x %> y=<%= m.rect.y %> w=<%= m.rect.w %> h=<%= m.rect.h %></li>
                    <% end %>
                  </ul>
                <% end %>
                <p class="text-sm font-mono">Score: <strong><%= @test_result.score %></strong></p>
                <%= if @test_result.found do %>
                  <p class="text-xs font-mono">
                    x=<%= @test_result.rect.x %> y=<%= @test_result.rect.y %>
                    w=<%= @test_result.rect.w %> h=<%= @test_result.rect.h %>
                  </p>
                <% else %>
                  <p class="text-xs text-base-content/60">Try lowering confidence or checking the hook image</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%!-- Template preview (shown after a test run) --%>
      <%= if @template_b64 do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body p-3">
            <h3 class="font-semibold text-sm mb-1 text-base-content/60">Template</h3>
            <img
              src={"data:image/jpeg;base64,#{@template_b64}"}
              alt="hook template"
              class="max-w-full max-h-40 object-contain rounded border border-base-300"
              style="image-rendering: pixelated;"
            />
          </div>
        </div>
      <% end %>

      <%!-- Duplicate / Delete panel (shown when editing) --%>
      <%= if @editing_name do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body p-3">
            <h3 class="font-semibold text-sm mb-2">Duplicate / Delete</h3>
            <div class="flex gap-2 items-end">
              <div class="form-control flex-1">
                <label class="label py-0"><span class="label-text-alt text-xs">New name</span></label>
                <input
                  type="text"
                  value={@duplicate_name}
                  phx-keyup="set_duplicate_name"
                  placeholder={"#{@editing_name}_copy"}
                  class="input input-bordered input-xs"
                />
              </div>
              <button
                phx-click="duplicate_hook"
                phx-value-source={@editing_name}
                class="btn btn-ghost btn-xs"
              >Duplicate</button>
            </div>
            <div class="mt-2">
              <button
                phx-click="delete_hook"
                phx-value-name={@editing_name}
                data-confirm={"Delete hook '#{@editing_name}'?"}
                class="btn btn-error btn-outline btn-xs w-full"
              >🗑 Delete '<%= @editing_name %>'</button>
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%!-- Hook List — fixed at bottom, table scrolls internally --%>
  <div class="card bg-base-100 shadow-lg flex-none h-96">
    <div class="card-body p-3 flex flex-col">

      <div id="hooks-table-scroll" phx-hook="PreserveScroll" class="flex-1 overflow-x-auto overflow-y-auto max-h-80">
        <table class="table table-zebra table-xs">
          <thead>
            <tr>
              <% sort_icon = fn col ->
                cond do
                  @sort_by == col and @sort_dir == :asc -> " ↑"
                  @sort_by == col and @sort_dir == :desc -> " ↓"
                  true -> ""
                end
              end %>
              <th>Img</th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="notes">Notes<%= sort_icon.(:notes) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="name">Name<%= sort_icon.(:name) %></th>
              <th>Actions</th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="region">Region<%= sort_icon.(:region) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="click">Click<%= sort_icon.(:click) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="scan">Scan<%= sort_icon.(:scan) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="mask">Mask<%= sort_icon.(:mask) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="match_method">Method<%= sort_icon.(:match_method) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="confidence">Conf.<%= sort_icon.(:confidence) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="inserted_at">Created<%= sort_icon.(:inserted_at) %></th>
            </tr>
          </thead>
          <tbody>
            <%= for hook <- filtered_hooks(@hooks, @hooks_filter) |> sorted_hooks(@sort_by, @sort_dir) do %>
              <tr class={if @editing_name == hook.name, do: "bg-primary/10 border-l-2 border-primary"}>
                <td>
                  <% thumb = thumb_src(hook.name, Map.get(@hook_thumbnails, hook.name)) %>
                  <%= if thumb do %>
                    <img src={thumb} alt=""
                         class="w-8 h-8 object-contain rounded border border-base-300 bg-base-300" />
                  <% else %>
                    <span class="text-base-content/20">—</span>
                  <% end %>
                </td>
                <td class="text-xs text-base-content/60 max-w-xs"
                    id={"notes-cell-#{hook.name}"}
                    phx-hook="EditableNotes"
                    phx-update="ignore"
                    data-name={hook.name}
                    data-notes={hook.notes || ""}>
                  <span class="notes-display truncate block min-h-4 max-w-[16rem] cursor-text" title="Double-click to edit">
                    <%= if hook.notes in [nil, ""] do %>
                      <span class="italic text-base-content/30">double-click to add</span>
                    <% else %>
                      <%= hook.notes %>
                    <% end %>
                  </span>
                  <textarea class="notes-edit hidden textarea textarea-bordered textarea-xs w-48 font-mono leading-tight p-1"
                            rows="2"><%= hook.notes %></textarea>
                </td>
                <td class="font-mono text-xs"><%= hook.name %></td>
                <td>
                  <div class="flex gap-1">
                    <button phx-click="edit_hook" phx-value-name={hook.name}
                            class="btn btn-xs btn-ghost">Edit</button>
                    <button phx-click="test_hook" phx-value-name={hook.name}
                            class="btn btn-xs btn-outline btn-secondary">Test</button>
                    <%= if hook.region_x do %>
                      <button phx-click="test_hook_region" phx-value-name={hook.name}
                              class="btn btn-xs btn-outline btn-accent" title="Region-only capture">⚡</button>
                    <% end %>
                    <button phx-click="test_hook_all" phx-value-name={hook.name}
                            class="btn btn-xs btn-outline btn-warning"
                            title="Find every match on the screenshot already loaded">All</button>
                    <button phx-click="use_hook_regions"
                            phx-value-region-x={hook.region_x} phx-value-region-y={hook.region_y}
                            phx-value-region-w={hook.region_w} phx-value-region-h={hook.region_h}
                            phx-value-click-x={hook.click_x} phx-value-click-y={hook.click_y}
                            phx-value-click-w={hook.click_w} phx-value-click-h={hook.click_h}
                            phx-value-scan-x={hook.scan_x} phx-value-scan-y={hook.scan_y}
                            phx-value-scan-w={hook.scan_w} phx-value-scan-h={hook.scan_h}
                            class="btn btn-xs btn-outline btn-primary"
                            title="Load this hook's region, click region, and scan region into the canvas + form">Regions</button>
                    <button phx-click="delete_hook" phx-value-name={hook.name}
                            data-confirm={"Delete '#{hook.name}'?"}
                            class="btn btn-xs btn-ghost text-error">Del</button>
                  </div>
                </td>
                <td class="font-mono text-xs text-base-content/60">
                  <%= if hook.region_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.region_x %>,<%= hook.region_y %> <%= hook.region_w %>×<%= hook.region_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.region_x}
                              phx-value-y={hook.region_y}
                              phx-value-w={hook.region_w}
                              phx-value-h={hook.region_h}
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title={"Select as #{canvas_mode_label(@canvas_mode)} region"}>⊞</button>
                    </div>
                  <% else %>
                    full
                  <% end %>
                </td>
                <td class="font-mono text-xs text-info/70">
                  <%= if hook.click_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.click_x %>,<%= hook.click_y %> <%= hook.click_w %>×<%= hook.click_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.click_x}
                              phx-value-y={hook.click_y}
                              phx-value-w={hook.click_w}
                              phx-value-h={hook.click_h}
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title={"Select as #{canvas_mode_label(@canvas_mode)} region"}>⊞</button>
                    </div>
                  <% end %>
                </td>
                <td class="font-mono text-xs text-warning/70">
                  <%= if hook.scan_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.scan_x %>,<%= hook.scan_y %> <%= hook.scan_w %>×<%= hook.scan_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.scan_x}
                              phx-value-y={hook.scan_y}
                              phx-value-w={hook.scan_w}
                              phx-value-h={hook.scan_h}
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title={"Select as #{canvas_mode_label(@canvas_mode)} region"}>⊞</button>
                    </div>
                  <% end %>
                </td>
                <td class="text-center">
                  <%= if mask_on?(hook.mask) do %>
                    <span class="badge badge-warning badge-xs" title="Black pixels ignored">✓</span>
                  <% end %>
                </td>
                <td><span class="badge badge-outline badge-xs"><%= hook.match_method %></span></td>
                <td class="font-mono text-xs"><%= hook.confidence %></td>
                <td class="text-xs font-mono text-base-content/40 whitespace-nowrap">
                  <%= String.slice(to_string(hook.inserted_at || ""), 0, 16) %>
                </td>
              </tr>
            <% end %>
            <%= if Enum.empty?(filtered_hooks(@hooks, @hooks_filter)) do %>
              <tr>
                <td colspan="11" class="text-center text-base-content/40 py-4">
                  <%= if @hooks_filter != "", do: "No hooks match '#{@hooks_filter}'", else: "No hooks yet — take a screenshot and create one above" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between pt-2">
        <div role="tablist" class="tabs tabs-boxed tabs-sm">
          <%= for category <- StarlightBot.Hooks.categories() do %>
            <.link patch={~p"/hooks?#{[cat: category]}"} role="tab"
                   class={"tab gap-1 #{if category == @category, do: "tab-active"}"}>
              <%= category_label(category) %>
              <span class="badge badge-neutral badge-sm"><%= @category_counts[category] %></span>
            </.link>
          <% end %>
        </div>
        <input
          type="text"
          placeholder="Filter by name…"
          value={@hooks_filter}
          phx-keyup="filter_hooks"
          class="input input-bordered input-sm w-48"
        />
      </div>
    </div>
  </div>

</div>

<%!-- Template editor modal — always in DOM, opened via JS showModal() --%>
<dialog id="template-editor-modal" class="modal">
  <div class="modal-box w-auto max-w-2xl">
    <h3 class="font-bold text-lg mb-3">Edit Template</h3>

    <%!-- Tool controls --%>
    <div class="flex items-center gap-2 mb-3 flex-wrap">
      <div class="flex gap-1">
        <button data-te="paint"  class="btn btn-sm btn-primary">✏ Paint</button>
        <button data-te="erase"  class="btn btn-sm btn-outline">◻ Erase</button>
        <button data-te="square" class="btn btn-sm btn-outline">▣ Square</button>
        <button data-te="line"   class="btn btn-sm btn-outline">╱ Line</button>
        <button data-te="undo"   class="btn btn-sm btn-ghost" disabled>↩ Undo</button>
        <button data-te="reset"  class="btn btn-sm btn-ghost">↺ Reset</button>
      </div>
      <label class="flex items-center gap-1 text-sm select-none">
        Brush
        <input data-te="brush" type="range" min="2" max="30" value="10" class="range range-xs w-20" />
        <span data-te="brush-label" class="font-mono w-5 text-right">10</span>px
      </label>
      <button data-te="threshold-toggle" class="btn btn-sm btn-outline">👁 Threshold</button>
      <label data-te="threshold-row" style="display:none;" class="flex items-center gap-1 text-sm select-none">
        <input data-te="threshold-val" type="range" min="0" max="255" value="127" class="range range-xs w-20" />
        <span data-te="threshold-label" class="font-mono w-5 text-right">127</span>
      </label>
      <div class="flex gap-1">
        <button data-te="grayscale" class="btn btn-sm btn-ghost" title="Convert to grayscale">◑ Grayscale</button>
        <button data-te="brightness-down" class="btn btn-sm btn-ghost" title="Decrease brightness">🔅 −</button>
        <button data-te="brightness-up" class="btn btn-sm btn-ghost" title="Increase brightness">🔆 +</button>
      </div>
    </div>

    <%!-- Canvas --%>
    <div data-te="workspace" class="flex justify-center bg-base-300 rounded p-3 overflow-auto" style="max-height: 60vh; user-select: none;">
      <canvas
        id="template-editor-canvas"
        phx-hook="TemplateEditor"
        class="cursor-crosshair"
        style="image-rendering: pixelated;"
      ></canvas>
    </div>

    <div class="modal-action justify-between">
      <div class="flex gap-2">
        <%!-- Label wraps hidden file input so clicking the button triggers the OS picker --%>
        <label data-te="upload" class="btn btn-sm btn-ghost cursor-pointer" title="Replace template with an uploaded image (clears undo history)">
          📁 Upload
          <input data-te="file-input" type="file" accept="image/*" class="hidden" />
        </label>
        <button data-te="copy" class="btn btn-sm btn-ghost" title="Copy current canvas to clipboard">📋 Copy</button>
      </div>
      <div class="flex gap-2 items-center">
        <button data-te="save" class="btn btn-primary">💾 Save template</button>
        <form method="dialog"><button class="btn">Cancel</button></form>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
