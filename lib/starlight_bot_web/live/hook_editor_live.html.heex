<div class="flex flex-col h-full gap-3 overflow-hidden">

  <%!-- Top section: both columns fill the remaining height --%>
  <div class="grid grid-cols-[30fr_28fr] grid-rows-1 gap-2 flex-1 min-h-0">

    <%!-- Left: Screenshot Panel --%>
    <div class="card bg-base-100 shadow-lg flex flex-col overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0">

        <div class="flex items-center gap-3 mb-2">
          <h2 class="card-title text-lg">Hook Editor</h2>
          <button phx-click="take_screenshot"
                  disabled={@screenshot_status in [:loading, :waiting]}
                  class="btn btn-primary btn-sm">
            <%= if @screenshot_status == :loading do %>
              <span class="loading loading-spinner loading-xs"></span> Capturing…
            <% else %>
              📷 Screenshot
            <% end %>
          </button>
          <button phx-click="take_screenshot_delayed"
                  disabled={@screenshot_status in [:loading, :waiting]}
                  class="btn btn-primary btn-sm btn-outline">
            <%= if @screenshot_status == :waiting do %>
              <span class="loading loading-spinner loading-xs"></span> 2s…
            <% else %>
              ⏱ 2s
            <% end %>
          </button>
          <%= if @screenshot_status == :done do %>
            <span class="badge badge-success badge-sm">Ready</span>
          <% end %>
          <div class="tooltip tooltip-bottom" data-tip="Click and drag on the screenshot to select a region. Hold Shift for precision mode.">
            <span class="flex items-center justify-center w-5 h-5 rounded-full border border-base-content/30 text-base-content/40 text-xs cursor-default select-none">?</span>
          </div>

          <%!-- Canvas draw mode toggle --%>
          <div class="join">
            <button phx-click="set_canvas_mode" phx-value-mode="detect"
                    class={"btn btn-xs join-item #{if @canvas_mode == :detect, do: "btn-primary", else: "btn-ghost"}"}>
              Region
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="click"
                    class={"btn btn-xs join-item #{if @canvas_mode == :click, do: "btn-info", else: "btn-ghost"}"}>
              Click
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="scan"
                    class={"btn btn-xs join-item #{if @canvas_mode == :scan, do: "btn-warning", else: "btn-ghost"}"}>
              Scan
            </button>
            <button phx-click="set_canvas_mode" phx-value-mode="color"
                    class={"btn btn-xs join-item #{if @canvas_mode == :color, do: "btn-accent", else: "btn-ghost"}"}
                    title="Click the screenshot to sample a color for an hsv_range hook">
              🎨 Color
            </button>
          </div>

        </div>

        <%!-- Canvas wrapper: fills remaining flex space, canvas fits 16:9 within it --%>
        <div class="flex-1 min-h-0 overflow-hidden" style="container-type: size;">
          <%= if @screenshot_status == :idle do %>
            <div class="h-full flex flex-col items-center justify-center text-base-content/40">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <p class="text-sm">Take a screenshot to begin</p>
            </div>
          <% end %>
          <%!-- width: min(100%, height*16/9) keeps strict 16:9 regardless of which axis is tighter --%>
          <div class="relative bg-base-300 overflow-hidden"
               style="aspect-ratio: 16/9; width: min(100%, calc(100cqh * 16 / 9));">
            <canvas
              id="screenshot-canvas"
              phx-hook="ScreenshotCanvas"
              width="1920"
              height="1080"
              class="w-full h-full cursor-crosshair"
              style="display: block;"
            ></canvas>
          </div>
        </div>

        <%!-- Selection info --%>
        <div class="flex items-center justify-end gap-2 min-h-5 mt-2">
          <%= if @region do %>
            <span class="badge badge-error badge-xs">R</span>
            <span class="text-xs font-mono text-base-content/70">
              <%= @region.x %>,<%= @region.y %> <%= @region.w %>×<%= @region.h %>
            </span>
            <button phx-click="clear_region" class="btn btn-xs btn-ghost text-error">✕</button>
          <% end %>
          <%= if @click_region do %>
            <span class="badge badge-info badge-xs">C</span>
            <span class="text-xs font-mono text-info/80">
              <%= @click_region.x %>,<%= @click_region.y %> <%= @click_region.w %>×<%= @click_region.h %>
            </span>
            <button phx-click="clear_click_region" class="btn btn-xs btn-ghost text-info">✕</button>
          <% end %>
          <%= if @scan_region do %>
            <span class="badge badge-warning badge-xs">S</span>
            <span class="text-xs font-mono text-warning/80">
              <%= @scan_region.x %>,<%= @scan_region.y %> <%= @scan_region.w %>×<%= @scan_region.h %>
            </span>
            <button phx-click="clear_scan_region" class="btn btn-xs btn-ghost text-warning">✕</button>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Right: Hook Form (scrolls internally) --%>
    <div class="flex flex-col gap-3 min-h-0 overflow-y-auto">

      <%= if @editing_name && hook_for(@hooks, @editing_name) do %>
        <% hook = hook_for(@hooks, @editing_name) %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body p-3 gap-2">
            <h3 class="font-semibold text-sm">Source</h3>
            <p class="text-xs text-base-content/60"><%= source_help(hook) %></p>
            <div class="flex flex-wrap gap-2">
              <button :if={hook.source == :base and !Hooks.editable?(hook) and !hook.retired}
                      phx-click="override_hook" phx-value-name={hook.name} class="btn btn-primary btn-xs">Override this hook</button>
              <button :if={hook.source == :base and hook.retired}
                      phx-click="reapply_hook" phx-value-name={hook.name} class="btn btn-warning btn-xs"
                      data-confirm="Apply your old override on top of the new shipped version?">Re-apply my override</button>
              <button :if={hook.source == :base and hook.retired}
                      phx-click="delete_hook" phx-value-name={hook.name} class="btn btn-ghost btn-xs"
                      data-confirm="Discard your retired override?">Discard my override</button>
              <button :if={hook.source == :override}
                      phx-click="delete_hook" phx-value-name={hook.name} class="btn btn-outline btn-xs"
                      data-confirm="Drop your override and go back to the shipped hook?">Reset to shipped</button>
              <button :if={StarlightBot.Data.authoring?()}
                      phx-click="bump_version" phx-value-name={hook.name} class="btn btn-outline btn-warning btn-xs"
                      data-confirm="Bump the version? Every user override of this hook will be retired on update.">Bump version</button>
            </div>
          </div>
        </div>
      <% end %>

      <%!-- Form Card --%>
      <div class="card bg-base-100 shadow-lg">
        <div class="card-body p-3">
          <div class="flex justify-between items-center mb-2">
            <h2 class="card-title text-base">
              <%= if @editing_name do %>
                <span class="font-mono text-primary"><%= @editing_name %></span>
              <% else %>
                New Hook
              <% end %>
            </h2>
            <button phx-click="new_hook" class="btn btn-xs btn-ghost">+ New</button>
          </div>

          <% editing_hook = hook_for(@hooks, @editing_name) %>
          <div :if={editing_hook} class="mb-2 flex items-center gap-2">
            <span class={["badge badge-sm", source_badge_class(editing_hook)]}><%= source_label(editing_hook) %></span>
            <span :if={editing_hook.version} class="text-xs text-base-content/50 font-mono">v<%= editing_hook.version %></span>
          </div>
          <fieldset disabled={editing_hook && !Hooks.editable?(editing_hook)} class="contents">
          <.form for={@form} phx-submit="save_hook" phx-change="validate_hook">

            <div class="flex gap-3 mb-2">
              <div class="flex-1 min-w-0">
                <div class="grid grid-cols-2 gap-2 mb-2">
                <%!-- Name --%>
                <div class="form-control flex flex-col min-w-0">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Name
                      <span :if={field_dirty?(@form, @saved_params, :name)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <input
                    type="text"
                    name="hook[name]"
                    value={@form[:name].value}
                    placeholder="e.g. winrate_button"
                    class={"input input-bordered input-sm w-full #{if @form[:name].errors != [], do: "input-error", else: if(field_dirty?(@form, @saved_params, :name), do: "input-warning")}"}
                  />
                  <%= if err = List.first(@form[:name].errors) do %>
                    <label class="label py-0"><span class="label-text-alt text-error"><%= elem(err, 0) %></span></label>
                  <% end %>
                </div>

                <div class="form-control flex flex-col min-w-0">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Category
                      <span :if={field_dirty?(@form, @saved_params, :category)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <select name="hook[category]" class={"select select-bordered select-sm w-full #{if field_dirty?(@form, @saved_params, :category), do: "select-warning"}"}>
                    <option value="" selected={to_string(@form[:category].value) == ""}>auto (from name)</option>
                    <%= for category <- StarlightBot.Hooks.categories() do %>
                      <option value={category} selected={to_string(@form[:category].value) == category}>
                        <%= category_label(category) %>
                      </option>
                    <% end %>
                  </select>
                </div>
                </div>

                <%!-- Method --%>
                <div class="form-control">
                  <label class="label py-0.5">
                    <span class="label-text text-sm font-medium flex items-center gap-1">
                      Match Method
                      <span :if={field_dirty?(@form, @saved_params, :match_method)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                    </span>
                  </label>
                  <% method_tips = %{
                    "gray" => "Template match on grayscale. Ignores color; the usual choice for buttons and icons.",
                    "rgb" => "Template match on all three color channels. Use when color is what tells two elements apart.",
                    "binary_thresh" => "Thresholds both frame and template to black and white before matching. Good for high-contrast text and glyphs.",
                    "hsv_range" => "No template. Finds clusters of pixels within the HSV color range, tolerance and minimum cluster size set below. Always searches Region.",
                    "grayscale_detector" => "No template. Scores how desaturated Region is; Confidence 1.0 requires zero average saturation. Always searches Region.",
                    "sift" => "Feature matching on grayscale keypoints. Tolerates scale and small shifts; needs a textured template.",
                    "sift_saturation" => "Feature matching on the saturation channel instead of grayscale. Use when the element differs by color intensity rather than brightness."
                  } %>
                  <% selected_method = to_string(@form[:match_method].value) %>
                  <div class="flex items-center gap-1">
                    <select name="hook[match_method]" class={"select select-bordered select-sm #{if field_dirty?(@form, @saved_params, :match_method), do: "select-warning"}"}>
                      <%= for method <- ~w(gray rgb binary_thresh hsv_range grayscale_detector sift sift_saturation) do %>
                        <option value={method} selected={selected_method == method}>
                          <%= method %>
                        </option>
                      <% end %>
                    </select>
                    <span :if={method_tips[selected_method]} class="tooltip tooltip-bottom before:max-w-64 before:whitespace-normal before:text-left" data-tip={method_tips[selected_method]}>
                      <span class="badge badge-xs badge-ghost cursor-help">?</span>
                    </span>
                    <label :if={selected_method not in ["hsv_range", "grayscale_detector"]} class="flex items-center gap-2 cursor-pointer ml-3 whitespace-nowrap">
                      <input
                        type="checkbox"
                        name="hook[mask]"
                        value="true"
                        checked={@form[:mask].value == true}
                        class="checkbox checkbox-sm"
                      />
                      <span class="label-text text-sm font-medium flex items-center gap-1">
                        Ignore black pixels
                        <span :if={field_dirty?(@form, @saved_params, :mask)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                        <span class="tooltip tooltip-bottom before:max-w-64 before:whitespace-normal before:text-left" data-tip="Black areas of the template won't count against the match score. Useful for glyph/icon templates with variable backgrounds.">
                          <span class="badge badge-xs badge-ghost cursor-help">?</span>
                        </span>
                      </span>
                    </label>
                  </div>
                </div>
              </div>

              <%!-- Actions --%>
              <div class="flex flex-row items-start gap-1 shrink-0">
                <button type="submit" class="btn btn-primary btn-sm">💾 Save</button>
                <%= if @editing_name do %>
                  <button type="button" phx-click="test_hook" phx-value-name={@editing_name}
                          class="btn btn-secondary btn-sm">🔍 Test</button>
                  <.test_badge result={@test_result} name={@editing_name} />
                <% end %>
              </div>
            </div>

            <%!-- Confidence --%>
            <input :if={to_string(@form[:match_method].value) == "hsv_range"} type="hidden" name="hook[confidence]" value={@form[:confidence].value} />
            <div :if={to_string(@form[:match_method].value) != "hsv_range"} class="form-control mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Confidence
                  <span :if={field_dirty?(@form, @saved_params, :confidence)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
                <input
                  type="number"
                  name="hook[confidence]"
                  value={@form[:confidence].value}
                  min="0" max="1" step="0.01"
                  oninput="this.closest('.form-control').querySelector('input[type=range]').value = this.value"
                  class={"input input-bordered input-xs w-20 font-mono #{if field_dirty?(@form, @saved_params, :confidence), do: "input-warning"}"}
                />
              </label>
              <input
                type="range"
                name="hook[confidence]"
                value={@form[:confidence].value}
                oninput="this.closest('.form-control').querySelector('input[type=number]').value = this.value"
                min="0" max="1" step="0.01"
                class={"range range-sm #{if field_dirty?(@form, @saved_params, :confidence), do: "range-warning", else: "range-primary"}"}
              />
            </div>

            <%!-- Regions --%>
            <% image_will_update = not is_nil(@screenshot_mat) and not is_nil(@region) and not is_nil(@editing_name) %>
            <% is_hsv = to_string(@form[:match_method].value) == "hsv_range" %>
            <% no_template = to_string(@form[:match_method].value) in ["hsv_range", "grayscale_detector"] %>
            <% region_groups = [
              {"Region", "region", "tooltip-right", "The area the template was captured from, in 1920×1080 space. Also the default search area."},
              {"Click", "click", "tooltip-bottom", "Where clicks land. Leave blank to click the center of the match result."},
              {"Scan", "scan", "tooltip-bottom", "When set, searches this wider area for the template instead of expecting it exactly at Region. Ignored by hsv_range and grayscale_detector hooks (they always scan Region)."}
            ] %>
            <% region_groups = if no_template, do: Enum.reject(region_groups, fn {_, prefix, _, _} -> prefix == "scan" end), else: region_groups %>
            <div class="mb-2">
              <input :for={field <- [:scan_x, :scan_y, :scan_w, :scan_h]} :if={no_template} type="hidden" name={"hook[#{field}]"} value={@form[field].value} />
              <div id="region-groups" phx-hook="RegionDragDrop" class={"grid gap-3 #{if no_template, do: "grid-cols-2", else: "grid-cols-3"}"}>
                <%= for {title, prefix, placement, tip} <- region_groups do %>
                  <% fields = [{"X", :"#{prefix}_x"}, {"Y", :"#{prefix}_y"}, {"W", :"#{prefix}_w"}, {"H", :"#{prefix}_h"}] %>
                  <% group_dirty = Enum.any?(fields, fn {_, field} -> field_dirty?(@form, @saved_params, field) end) %>
                  <div data-region-drop={prefix} class="rounded">
                    <div class="label py-0.5">
                      <span class="label-text text-sm font-medium flex items-center gap-1">
                        <span data-region-drag={prefix} draggable="true" class="cursor-grab select-none text-base-content/40 hover:text-base-content" title={"Drag onto another region to copy #{title} into it"}>⠿</span>
                        <%= title %>
                        <span class={"tooltip #{placement} before:max-w-64 before:whitespace-normal before:text-left"} data-tip={tip}>
                          <span class="badge badge-xs badge-ghost cursor-help">?</span>
                        </span>
                        <span :if={group_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                        <button type="button" phx-click={if prefix == "region", do: "clear_region", else: "clear_#{prefix}_region"} class="btn btn-xs btn-ghost px-1 min-h-0 h-4 text-error" title={"Clear #{title}"}>✕</button>
                      </span>
                    </div>
                    <div class="grid grid-cols-2 gap-1">
                      <%= for {label, field} <- fields do %>
                        <div>
                          <label class="label py-0"><span class="label-text-alt text-xs"><%= label %></span></label>
                          <input
                            type="number"
                            name={"hook[#{field}]"}
                            value={@form[field].value}
                            class={"input input-bordered input-xs w-full font-mono #{if field_dirty?(@form, @saved_params, field), do: "input-warning"}"}
                          />
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
              <span :if={image_will_update} class="text-warning text-xs">image will be recropped</span>
            </div>

            <input
              :for={field <- [:color_h, :color_s, :color_v, :tol_h, :tol_s, :tol_v, :min_cluster_size]}
              :if={not is_hsv}
              type="hidden"
              name={"hook[#{field}]"}
              value={@form[field].value}
            />
            <%= if is_hsv do %>
            <%!-- Color (color_detector only) --%>
            <% range_dirty = Enum.any?([:color_h, :color_s, :color_v, :tol_h, :tol_s, :tol_v], &field_dirty?(@form, @saved_params, &1)) %>
            <% center_h = form_int(@form, :color_h, 0) %>
            <% center_s = form_int(@form, :color_s, 0) %>
            <% center_v = form_int(@form, :color_v, 0) %>
            <div class="mb-2">
              <label class="label py-0.5">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  HSV Range
                  <span :if={range_dirty} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <div class="flex items-start gap-2">
                <div class="flex-1 space-y-2">
                  <%= for {label, channel, color_field, tol_field, max, tol_max} <- [{"H", :h, :color_h, :tol_h, 179, 90}, {"S", :s, :color_s, :tol_s, 255, 255}, {"V", :v, :color_v, :tol_v, 255, 255}] do %>
                    <% center = form_int(@form, color_field, 0) %>
                    <% tol = form_int(@form, tol_field, 0) %>
                    <% track =
                      case channel do
                        :h -> channel_gradient(:h, 0, 0)
                        :s -> channel_gradient(:s, center_h, center_v)
                        :v -> channel_gradient(:v, center_h, center_s)
                      end %>
                    <div>
                      <div class="flex items-center gap-2 text-xs">
                        <span class="font-medium w-3"><%= label %></span>
                        <input
                          type="number"
                          name={"hook[#{color_field}]"}
                          value={@form[color_field].value}
                          min="0" max={max}
                          title={"#{label} center"}
                          class={"input input-bordered input-xs w-16 font-mono #{if field_dirty?(@form, @saved_params, color_field), do: "input-warning"}"}
                        />
                        <span class="text-base-content/50">±</span>
                        <input
                          type="range"
                          name={"hook[#{tol_field}]"}
                          value={tol}
                          min="0" max={tol_max} step="1"
                          title={"#{label} tolerance"}
                          class={"range range-xs flex-1 #{if field_dirty?(@form, @saved_params, tol_field), do: "range-warning", else: "range-primary"}"}
                        />
                        <span class="font-mono w-8 text-right"><%= tol %></span>
                      </div>
                      <div class="flex items-center gap-2 mt-1">
                        <div
                          id={"band-#{color_field}"}
                          phx-hook="ChannelBand"
                          data-input-name={"hook[#{color_field}]"}
                          data-max={max}
                          class="relative h-3 flex-1 rounded overflow-hidden border border-base-300 cursor-crosshair touch-none"
                          style={"background: #{track}"}
                        >
                          <div
                            :for={box <- range_band_boxes(center, tol, channel)}
                            class="absolute inset-y-0 border-x-2 border-white bg-white/25"
                            style={box}
                          ></div>
                          <div data-band-marker class="absolute inset-y-0 w-0.5 bg-black/70 pointer-events-none" style={"left: #{Float.round(center / max * 100, 2)}%"}></div>
                        </div>
                        <span class="text-xs font-mono text-primary"><%= range_label(center, tol, channel) %></span>
                      </div>
                    </div>
                  <% end %>
                  <% cluster_size = form_int(@form, :min_cluster_size, 0) %>
                  <% cluster_side = :math.sqrt(cluster_size) %>
                  <div>
                    <div class="flex items-center gap-2 text-xs">
                      <span class="font-medium flex items-center gap-1">
                        Min Cluster Size
                        <span :if={field_dirty?(@form, @saved_params, :min_cluster_size)} class="text-warning leading-none" title="unsaved change">●</span>
                      </span>
                      <input
                        type="number"
                        name="hook[min_cluster_size]"
                        value={@form[:min_cluster_size].value}
                        min="0"
                        title="Min cluster size"
                        class={"input input-bordered input-xs w-16 font-mono #{if field_dirty?(@form, @saved_params, :min_cluster_size), do: "input-warning"}"}
                      />
                    </div>
                    <input
                      type="range"
                      value={cluster_size}
                      min="0" max={max(250, cluster_size)} step="1"
                      title="Min cluster size"
                      oninput="const n = this.form.elements['hook[min_cluster_size]']; n.value = this.value; n.dispatchEvent(new Event('input', {bubbles: true}))"
                      class={"range range-xs w-full mt-1 #{if field_dirty?(@form, @saved_params, :min_cluster_size), do: "range-warning", else: "range-primary"}"}
                    />
                  </div>
                </div>
                <div class="flex flex-col items-center gap-1 shrink-0">
                  <div
                    class="w-[80px] h-[80px] rounded border border-base-300 flex items-center justify-center overflow-hidden"
                    style={"background: #{tolerance_gradient_css(center_h, center_s, center_v, form_int(@form, :tol_h, 0), form_int(@form, :tol_v, 0))}"}
                  >
                    <div
                      class="transition-all duration-500 ease-out"
                      style={"width: #{Float.round(min(cluster_side, 80.0), 2)}px; height: #{Float.round(min(cluster_side, 80.0), 2)}px; background-color: #{color_swatch_css(center_h, center_s, center_v)}; box-shadow: 0 0 0 1px rgba(0,0,0,0.6), 0 0 0 2px rgba(255,255,255,0.6)"}
                    ></div>
                  </div>
                  <div class="text-xs font-mono text-base-content/50 whitespace-nowrap"><%= round(cluster_side) %>×<%= round(cluster_side) %> px</div>
                </div>
              </div>
            </div>

            <% end %>

            <%!-- Mask --%>
            <input :if={no_template and @form[:mask].value == true} type="hidden" name="hook[mask]" value="true" />

            <%!-- Notes --%>
            <div class="form-control mb-3 flex-row items-start gap-2">
              <label class="label py-0.5 shrink-0">
                <span class="label-text text-sm font-medium flex items-center gap-1">
                  Notes
                  <span :if={field_dirty?(@form, @saved_params, :notes)} class="text-warning text-xs leading-none" title="unsaved change">●</span>
                </span>
              </label>
              <textarea
                name="hook[notes]"
                rows="1"
                placeholder="Which screen is this for?"
                class={"textarea textarea-bordered textarea-sm flex-1 min-w-0 min-h-0 #{if field_dirty?(@form, @saved_params, :notes), do: "textarea-warning"}"}
              ><%= @form[:notes].value %></textarea>
            </div>
          </.form>
          </fieldset>

        </div>
      </div>

      <%!-- Template preview --%>
      <%= if @template_b64 do %>
        <div class="card bg-base-100 shadow-lg">
          <div class="card-body p-3">
            <div class="flex gap-3">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h3 class="font-semibold text-sm text-base-content/60">
                    <%= if @region && @screenshot_mat, do: "Before", else: "Template" %>
                  </h3>
                  <div id="template-transfer" phx-hook="TemplateTransfer" data-name={@editing_name} class="ml-auto flex items-center gap-1">
                    <button type="button" phx-click="download_template" phx-value-name={@editing_name}
                            class="btn btn-ghost btn-xs btn-square" title="Download template">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" /></svg>
                    </button>
                    <button type="button" phx-click="copy_template" phx-value-name={@editing_name}
                            class="btn btn-ghost btn-xs btn-square" title="Copy template to clipboard">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2" /><path stroke-linecap="round" stroke-linejoin="round" d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" /></svg>
                    </button>
                    <button type="button" data-upload disabled={!deletable?(hook_for(@hooks, @editing_name))}
                            class="btn btn-ghost btn-xs btn-square"
                            title={if deletable?(hook_for(@hooks, @editing_name)), do: "Upload template image", else: "Shipped hook is read-only; override it first"}>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M17 8l-5-5-5 5M12 3v12" /></svg>
                    </button>
                    <button type="button" data-blacken disabled={!deletable?(hook_for(@hooks, @editing_name))}
                            class="btn btn-ghost btn-xs btn-square"
                            title={if deletable?(hook_for(@hooks, @editing_name)), do: "Replace template with a black and white checker", else: "Shipped hook is read-only; override it first"}>
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2" /></svg>
                    </button>
                    <input type="file" accept="image/*" class="hidden" data-file />
                  </div>
                </div>
                <img
                  src={"data:image/jpeg;base64,#{@template_b64}"}
                  alt="hook template"
                  class="max-w-full max-h-40 object-contain rounded border border-base-300"
                  style="image-rendering: pixelated;"
                />
              </div>
              <.after_preview mat={@screenshot_mat} region={@region} />
            </div>
          </div>
        </div>
      <% end %>

    </div>
  </div>

  <%!-- Hook List — fixed at bottom, table scrolls internally --%>
  <div class="card bg-base-100 shadow-lg flex-none h-96">
    <div class="card-body p-3 flex flex-col">

      <div id="hooks-table-scroll" phx-hook="PreserveScroll" class="flex-1 overflow-x-auto overflow-y-auto max-h-80">
        <table class="table table-zebra table-xs">
          <thead>
            <tr>
              <% sort_icon = fn col ->
                cond do
                  @sort_by == col and @sort_dir == :asc -> " ↑"
                  @sort_by == col and @sort_dir == :desc -> " ↓"
                  true -> ""
                end
              end %>
              <th>Img</th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="notes">Notes<%= sort_icon.(:notes) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="name">Name<%= sort_icon.(:name) %></th>
              <th>Actions</th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="region">Region<%= sort_icon.(:region) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="click">Click<%= sort_icon.(:click) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="scan">Scan<%= sort_icon.(:scan) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="mask">Mask<%= sort_icon.(:mask) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="match_method">Method<%= sort_icon.(:match_method) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="confidence">Conf.<%= sort_icon.(:confidence) %></th>
              <th class="cursor-pointer select-none whitespace-nowrap hover:text-primary"
                  phx-click="sort_hooks" phx-value-by="inserted_at">Created<%= sort_icon.(:inserted_at) %></th>
            </tr>
          </thead>
          <tbody>
            <%= for hook <- filtered_hooks(@hooks, @hooks_filter) |> sorted_hooks(@sort_by, @sort_dir) do %>
              <tr class={[@editing_name == hook.name && "bg-primary/10 border-l-2 border-primary", !Hooks.editable?(hook) && "opacity-60"]}>
                <td>
                  <% thumb = thumb_src(hook, Map.get(@hook_thumbnails, hook.name)) %>
                  <%= if thumb do %>
                    <img src={thumb} alt="" loading="lazy"
                         class="w-8 h-8 object-contain rounded border border-base-300 bg-base-300" />
                  <% else %>
                    <span class="text-base-content/20">—</span>
                  <% end %>
                </td>
                <td class="text-xs text-base-content/60 max-w-xs"
                    id={"notes-cell-#{hook.name}"}
                    phx-hook="EditableNotes"
                    phx-update="ignore"
                    data-name={hook.name}
                    data-notes={hook.notes || ""}>
                  <span class="notes-display truncate block min-h-4 max-w-[16rem] cursor-text" title="Double-click to edit">
                    <%= if hook.notes in [nil, ""] do %>
                      <span class="italic text-base-content/30">double-click to add</span>
                    <% else %>
                      <%= hook.notes %>
                    <% end %>
                  </span>
                  <textarea class="notes-edit hidden textarea textarea-bordered textarea-xs w-48 font-mono leading-tight p-1"
                            rows="2"><%= hook.notes %></textarea>
                </td>
                <td class="font-mono text-xs">
                  <%= hook.name %>
                  <span :if={hook.source != :base or hook.retired} class={["badge badge-xs ml-1", source_badge_class(hook)]}><%= source_label(hook) %></span>
                </td>
                <td>
                  <div class="flex gap-1">
                    <button phx-click="edit_hook" phx-value-name={hook.name}
                            class="btn btn-xs btn-ghost">Edit</button>
                    <button phx-click="test_hook" phx-value-name={hook.name}
                            class="btn btn-xs btn-outline btn-secondary">Test</button>
                    <.test_badge result={@test_result} name={hook.name} />
                    <button phx-click="test_hook_all" phx-value-name={hook.name}
                            class="btn btn-xs btn-outline btn-warning"
                            title="Find every match on the screenshot already loaded">All</button>
                    <button phx-click="duplicate_hook" phx-value-source={hook.name}
                            class="btn btn-xs btn-ghost">Dup</button>
                    <button phx-click="delete_hook" phx-value-name={hook.name}
                            data-confirm={"Delete '#{hook.name}'?"}
                            disabled={!deletable?(hook)}
                            class="btn btn-xs btn-ghost text-error">Del</button>
                  </div>
                </td>
                <td class="font-mono text-xs text-base-content/60">
                  <%= if hook.region_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.region_x %>,<%= hook.region_y %> <%= hook.region_w %>×<%= hook.region_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.region_x}
                              phx-value-y={hook.region_y}
                              phx-value-w={hook.region_w}
                              phx-value-h={hook.region_h}
                              phx-value-kind="detect"
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title="Apply as region region">⊞</button>
                    </div>
                  <% else %>
                    full
                  <% end %>
                </td>
                <td class="font-mono text-xs text-info/70">
                  <%= if hook.click_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.click_x %>,<%= hook.click_y %> <%= hook.click_w %>×<%= hook.click_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.click_x}
                              phx-value-y={hook.click_y}
                              phx-value-w={hook.click_w}
                              phx-value-h={hook.click_h}
                              phx-value-kind="click"
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title="Apply as click region">⊞</button>
                    </div>
                  <% end %>
                </td>
                <td class="font-mono text-xs text-warning/70">
                  <%= if hook.scan_x do %>
                    <div class="flex items-center gap-1">
                      <span><%= hook.scan_x %>,<%= hook.scan_y %> <%= hook.scan_w %>×<%= hook.scan_h %></span>
                      <button phx-click="use_hook_region"
                              phx-value-x={hook.scan_x}
                              phx-value-y={hook.scan_y}
                              phx-value-w={hook.scan_w}
                              phx-value-h={hook.scan_h}
                              phx-value-kind="scan"
                              class="btn btn-xs btn-ghost px-1 opacity-40 hover:opacity-100"
                              title="Apply as scan region">⊞</button>
                    </div>
                  <% end %>
                </td>
                <td class="text-center">
                  <%= if mask_on?(hook.mask) do %>
                    <span class="badge badge-warning badge-xs" title="Black pixels ignored">✓</span>
                  <% end %>
                </td>
                <td><span class="badge badge-outline badge-xs"><%= hook.match_method %></span></td>
                <td class="font-mono text-xs"><%= hook.confidence %></td>
                <td class="text-xs font-mono text-base-content/40 whitespace-nowrap">
                  <%= String.slice(to_string(hook.inserted_at || ""), 0, 16) %>
                </td>
              </tr>
            <% end %>
            <%= if Enum.empty?(filtered_hooks(@hooks, @hooks_filter)) do %>
              <tr>
                <td colspan="11" class="text-center text-base-content/40 py-4">
                  <%= if @hooks_filter != "", do: "No hooks match '#{@hooks_filter}'", else: "No hooks yet — take a screenshot and create one above" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="flex items-center justify-between pt-2">
        <div role="tablist" class="tabs tabs-boxed tabs-sm">
          <%= for category <- StarlightBot.Hooks.categories() do %>
            <.link patch={~p"/hooks?#{[cat: category]}"} role="tab"
                   class={"tab gap-1 #{if category == @category, do: "tab-active"}"}>
              <%= category_label(category) %>
              <span class="badge badge-neutral badge-sm"><%= @category_counts[category] %></span>
            </.link>
          <% end %>
        </div>
        <input
          type="text"
          placeholder="Filter by name…"
          value={@hooks_filter}
          phx-keyup="filter_hooks"
          class="input input-bordered input-sm w-48"
        />
      </div>
    </div>
  </div>

</div>
