<div class="flex flex-col h-full gap-3 overflow-hidden">
  <datalist id="gift-name-options">
    <option :for={gift <- @gifts} value={gift.name} />
  </datalist>

  <StarlightBotWeb.Layouts.flash_toasts flash={@flash} />
    <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3">
        <%= if @editing_id do %>
          <% issues = GiftPlans.issues(@plan_data, @gifts_by_name) %>

          <div class="flex items-center gap-2 flex-wrap">
            <.pane_tabs team_id={@team_id} pane="gifts" />
            <.plan_picker id="gift-plan-picker" items={@plans} current_id={@editing_id} name={@name} noun="plan" label="gift plan" />
            <span :if={issues != []} class="badge badge-warning badge-sm ml-auto" title={Enum.join(issues, "\n")}>
              <%= length(issues) %> issue(s)
            </span>
          </div>

          <div class="flex gap-1 flex-wrap items-center">
            <%= for tab <- tabs(), not accent_tab?(tab) do %>
              <button phx-click="set_tab" phx-value-tab={tab}
                      class={"btn btn-sm " <> if(@active_tab == tab, do: "btn-primary", else: "btn-ghost")}>
                <%= tab_label(tab) %>
              </button>
            <% end %>
            <button :for={tab <- Enum.filter(tabs(), &accent_tab?/1)} phx-click="set_tab" phx-value-tab={tab}
                    class={"btn btn-sm " <> if(@active_tab == tab, do: "btn-accent", else: "btn-accent btn-outline")}>
              <%= tab_label(tab) %>
            </button>
          </div>

          <div class="divider my-0"></div>

          <div class="flex-1 min-h-0 flex flex-col gap-3 overflow-hidden">

            <%= if @active_tab == :workflows do %>
              <% workflow = selected_workflow(assigns) %>
              <% schedule = @plan_data["floor_schedule"] %>
              <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-base-content/70">Floor schedule</span>
                <form phx-change="update_schedule" class="flex items-center overflow-x-auto pb-1">
                  <div :for={{row, index} <- Enum.with_index(schedule)} class="flex items-end shrink-0">
                    <% next = Enum.at(schedule, index + 1) %>
                    <div phx-click="select_workflow" phx-value-id={row["workflow"]}
                         class={"flex items-end gap-1.5 rounded-lg border px-1.5 py-1 shadow-sm cursor-pointer text-[11px] font-semibold text-base-content/70 " <>
                           if(workflow && row["workflow"] == workflow["id"], do: "border-primary bg-primary/15", else: "border-success/60 bg-success/10")}>
                      <div class="flex flex-col gap-0.5">
                        <span class="text-[10px] text-base-content/50 whitespace-nowrap">Start at</span>
                        <span :if={index == 0} class="h-5 flex items-center px-1">F1</span>
                        <select :if={index > 0} name={"rows[#{index}][from_floor]"} class="select select-bordered h-5 min-h-0 text-[11px] pl-1 pr-5 w-12">
                          <option :for={floor <- 1..15} value={floor} selected={row["from_floor"] == floor}>F<%= floor %></option>
                        </select>
                      </div>
                      <div class="flex flex-col gap-0.5 ml-2">
                        <span class="text-[10px] text-base-content/50">Use</span>
                        <select name={"rows[#{index}][workflow]"} class="select select-bordered h-5 min-h-0 text-[11px] pl-1 pr-6 w-22">
                          <option :for={wf <- @plan_data["workflows"]} value={wf["id"]} selected={row["workflow"] == wf["id"]}><%= wf["name"] %></option>
                        </select>
                      </div>
                      <button type="button" phx-click="remove_schedule_row" phx-value-index={index} class="btn btn-ghost btn-2xs text-error">✕</button>
                    </div>
                    <% covered = if next, do: Enum.map_join((row["from_floor"] + 1)..(next["from_floor"] - 1)//1, " ", &"F#{&1}"), else: if(row["from_floor"] < 15, do: "F#{row["from_floor"] + 1}+", else: "") %>
                    <div class="flex items-center shrink-0 h-5 mb-[5px]">
                      <div class="w-3 h-px bg-base-content/40"></div>
                      <span :if={covered != ""} class="px-1 text-[10px] font-semibold text-base-content/50 whitespace-nowrap"><%= covered %></span>
                      <div class="relative w-3 h-px bg-base-content/40">
                        <span class="absolute right-0 top-1/2 -translate-y-1/2 border-y-[4px] border-y-transparent border-l-[6px] border-l-base-content/40"></span>
                      </div>
                    </div>
                  </div>
                  <button type="button" phx-click="add_schedule_row" disabled={@plan_data["workflows"] == [] or Enum.any?(schedule, &(&1["from_floor"] >= 15))}
                          class="shrink-0 self-stretch rounded-lg border border-dashed border-base-content/30 px-3 text-[11px] text-base-content/60 hover:bg-base-200 disabled:opacity-40">
                    + Floor
                  </button>
                </form>
              </div>
              <div class="grid grid-cols-[16rem_1fr_13rem] gap-3 flex-1 min-h-0">

                <div class="flex flex-col gap-4 overflow-y-auto min-h-0 pr-1">
                  <div class="flex flex-col gap-1">
                    <% protected_lists = GiftPlans.protected_lists(@plan_data) %>
                    <span class="text-xs font-semibold text-base-content/70">
                      Protected lists <span class="text-base-content/40 font-normal" title="Never sold, never fusion fodder, on their protected floors. Mark lists protected and set floors in the Shop tab.">ⓘ</span>
                    </span>
                    <span class="text-[11px] text-base-content/60">
                      <%= if protected_lists == [], do: "None. Mark a list protected in the Shop tab.", else: Enum.map_join(protected_lists, ", ", & &1["name"]) %>
                    </span>
                    <div class="flex flex-wrap gap-1">
                      <span :for={entry <- GiftPlans.keep_gifts(@plan_data)} class="badge badge-ghost badge-xs" title={"Protected #{GiftPlans.protected_floors_label(@plan_data, entry)}"}>
                        <%= GiftPlans.entry_label(entry) %><span :if={GiftPlans.protected_floors(@plan_data, entry) != {1, nil}} class="text-base-content/50 ml-1"><%= GiftPlans.protected_floors_label(@plan_data, entry) %></span>
                      </span>
                    </div>
                  </div>

                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold text-base-content/70">Workflows</span>
                      <button phx-click="add_workflow" class="btn btn-primary btn-xs ml-auto">+ New</button>
                    </div>
                    <div id="workflow-list" phx-hook="SortableList" data-sort-event="reorder_workflows" class="flex flex-col gap-1">
                    <div :for={wf <- @plan_data["workflows"]} data-sort-id={wf["id"]}
                         phx-click="select_workflow" phx-value-id={wf["id"]}
                         class={"flex items-center gap-1 rounded px-2 py-1 cursor-pointer text-xs " <>
                           if(workflow && wf["id"] == workflow["id"], do: "bg-primary/10 border-l-2 border-primary", else: "hover:bg-base-200")}>
                      <span data-sort-handle class="cursor-grab text-base-content/40 select-none">⠿</span>
                      <span class="flex-1 truncate"><%= wf["name"] %></span>
                      <span class="text-[10px] text-base-content/40"><%= length(wf["steps"]) %> steps</span>
                      <button phx-click="duplicate_workflow" phx-value-id={wf["id"]} class="btn btn-ghost btn-2xs">Dup</button>
                      <button phx-click="delete_workflow" phx-value-id={wf["id"]} data-confirm={"Delete workflow '#{wf["name"]}'?"}
                              class="btn btn-ghost btn-2xs text-error">✕</button>
                    </div>
                    </div>
                  </div>

                  <%= if workflow do %>
                    <form phx-change="update_workflow" class="flex flex-col gap-2">
                      <label class="flex flex-col gap-0.5">
                        <span class="text-[11px] text-base-content/60">Name</span>
                        <input type="text" name="workflow[name]" value={workflow["name"]} phx-debounce="400"
                               class="input input-bordered input-xs" />
                      </label>
                    </form>
                    <% derived = uncaptured_protected(@plan_data, workflow, @gifts, @gifts_by_name) %>
                    <div :if={derived != []} class="flex flex-col gap-1">
                      <span class="text-[11px] text-base-content/60">Also protected by this workflow's fusions/upties</span>
                      <div class="flex flex-wrap gap-1">
                        <span :for={name <- derived} class="badge badge-ghost badge-xs"><%= name %></span>
                      </div>
                    </div>
                  <% end %>

                  <div :if={issues != []} class="flex flex-col gap-1 text-[11px] text-warning">
                    <span :for={issue <- issues}><%= issue %></span>
                  </div>

                  <form phx-change="import_source" phx-submit="import_workflows" class="flex flex-col gap-1 mt-auto">
                    <span class="text-[11px] text-base-content/60">Import workflows from another plan</span>
                    <select name="plan_id" class="select select-bordered select-xs">
                      <option value="">pick a plan</option>
                      <option :for={plan <- @plans} :if={plan.id != @editing_id} value={plan.id}
                              selected={@import_source && @import_source.id == plan.id}>
                        <%= plan.name %>
                      </option>
                    </select>
                    <%= if @import_source do %>
                      <select name="workflow" class="select select-bordered select-xs">
                        <option value="all">all workflows</option>
                        <option :for={wf <- @import_source.data["workflows"]} value={wf["id"]}><%= wf["name"] %> (and what it runs)</option>
                      </select>
                      <button type="submit" class="btn btn-xs">Import</button>
                    <% end %>
                  </form>
                </div>

                <div class="flex flex-col gap-2 overflow-y-auto min-h-0 pr-1">
                  <%= if workflow do %>
                    <.step_list steps={workflow["steps"]} scope="" workflow={workflow} plan_data={@plan_data}
                                expanded_step_id={@expanded_step_id} sinners={@sinners} add_target={add_target(assigns)} />
                    <div :if={workflow["steps"] == []} class="text-xs text-base-content/40 italic">
                      No steps yet. Add some from the palette on the right.
                    </div>
                  <% else %>
                    <div class="text-xs text-base-content/40 italic">Create a workflow to start adding steps.</div>
                  <% end %>
                </div>

                <div class="flex flex-col gap-3 overflow-y-auto min-h-0">
                  <% target = if workflow, do: add_target(assigns), else: "" %>
                  <div :if={target != ""} class="flex items-center gap-1 rounded bg-primary/10 border border-primary px-2 py-1 text-[11px]">
                    <span class="flex-1 min-w-0 truncate">Adding into <%= add_target_label(@plan_data, workflow, target) %></span>
                    <button phx-click="set_add_target" phx-value-scope={target} class="btn btn-2xs">top level</button>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-base-content/70">Add step</span>
                    <button :for={kind <- palette_kinds()} phx-click="add_step" phx-value-kind={kind} disabled={is_nil(workflow)}
                            class="btn btn-outline btn-xs justify-start">+ <%= GiftPlans.kind_label(kind) %></button>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-base-content/70"><%= GiftPlans.kind_label("workflow") %></span>
                    <% callable = if workflow, do: callable_workflows(@plan_data, workflow["id"]), else: [] %>
                    <button :for={wf <- callable} phx-click="add_step" phx-value-kind="workflow" phx-value-ref={wf["id"]}
                            class="btn btn-outline btn-xs justify-start truncate">+ <%= wf["name"] %></button>
                    <span :if={callable == []} class="text-[11px] text-base-content/40 italic">
                      No other workflow can run here without leading back to this one.
                    </span>
                  </div>
                  <div class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-base-content/70"><%= GiftPlans.kind_label("milestone") %></span>
                    <button :for={m <- @plan_data["milestones"]} phx-click="add_step" phx-value-kind="milestone" phx-value-ref={m["id"]}
                            disabled={is_nil(workflow)} class="btn btn-outline btn-xs justify-start truncate">+ <%= m["name"] %></button>
                    <span :if={@plan_data["milestones"] == []} class="text-[11px] text-base-content/40 italic">None. Define one in the Shop tab.</span>
                  </div>
                  <div :for={{lib, kind} <- library_kinds()} class="flex flex-col gap-1">
                    <span class="text-xs font-semibold text-base-content/70"><%= GiftPlans.kind_label(kind) %></span>
                    <button :for={d <- @plan_data["library"][lib]} phx-click="add_step" phx-value-kind={kind} phx-value-ref={d["id"]}
                            disabled={is_nil(workflow)} class="btn btn-outline btn-xs justify-start truncate">+ <%= d["name"] %></button>
                    <span :if={@plan_data["library"][lib] == []} class="text-[11px] text-base-content/40 italic">
                      None. Define one in the Shop tab.
                    </span>
                  </div>
                </div>
              </div>
            <% end %>

            <%= if @active_tab == :shop do %>
              <div class="grid grid-cols-[16rem_1fr] gap-3 flex-1 min-h-0">
                <div class="flex flex-col gap-4 overflow-y-auto min-h-0 pr-1">
                  <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold text-base-content/70">Milestones</span>
                      <button phx-click="add_milestone" class="btn btn-primary btn-xs ml-auto">+ New</button>
                    </div>
                    <div :for={m <- @plan_data["milestones"]}
                         phx-click="select_milestone" phx-value-id={m["id"]}
                         class={"flex items-center gap-1 rounded px-2 py-1 cursor-pointer text-xs " <>
                           if(@shop_lib == "milestones" && m["id"] == @selected_milestone_id, do: "bg-primary/10 border-l-2 border-primary", else: "hover:bg-base-200")}>
                      <span class="flex-1 truncate"><%= m["name"] %></span>
                      <button phx-click="move_milestone" phx-value-id={m["id"]} phx-value-dir="up" class="btn btn-ghost btn-2xs px-1">↑</button>
                      <button phx-click="move_milestone" phx-value-id={m["id"]} phx-value-dir="down" class="btn btn-ghost btn-2xs px-1">↓</button>
                      <button phx-click="delete_milestone" phx-value-id={m["id"]} data-confirm={"Delete milestone '#{m["name"]}'?"}
                              class="btn btn-ghost btn-2xs text-error">✕</button>
                    </div>
                    <div :if={@plan_data["milestones"] == []} class="text-[11px] text-base-content/40 italic">None yet.</div>
                    <span class="text-[11px] text-base-content/50">New fusions and upties are assigned to the top milestone.</span>
                  </div>
                  <.library_list lib="fusions" defs={@plan_data["library"]["fusions"]} selected_id={@shop_lib == "fusions" && @selected_def["fusions"]} />
                  <.library_list lib="upties" defs={@plan_data["library"]["upties"]} selected_id={@shop_lib == "upties" && @selected_def["upties"]} />
                  <.library_list lib="lists" defs={@plan_data["library"]["lists"]} selected_id={@shop_lib == "lists" && @selected_def["lists"]} roles={&list_roles(@plan_data, &1)} />
                </div>
                <div class="flex flex-col gap-3 overflow-y-auto min-h-0 pr-1">
                  <%= case @shop_lib do %>
                    <% "milestones" -> %>
                      <% milestone = selected_milestone(assigns) %>
                      <%= if milestone do %>
                        <% entries = Map.new(GiftPlans.milestone_entries(@plan_data, milestone["id"]), &{GiftPlans.entry_key(&1.ref), &1}) %>
                        <% letters = GiftPlans.group_letters(milestone) %>
                        <form phx-change="update_milestone" class="flex items-end gap-2">
                          <input type="hidden" name="milestone_id" value={milestone["id"]} />
                          <label class="flex flex-col gap-0.5">
                            <span class="text-[11px] text-base-content/60">Name</span>
                            <input type="text" name="name" value={milestone["name"]} phx-debounce="400" class="input input-bordered input-xs w-48" />
                          </label>
                        </form>
                        <span class="text-[11px] text-base-content/50">
                          Reached once every required entry is done, each group has enough entries done and none partway, and the condition below holds.
                          A fusion is done when its target is owned, an uptie when its gift is at the target level, a list gift when it's owned,
                          an included milestone when it's reached. An uptie whose gift is owned below target, or a fixed fusion with an ingredient owned,
                          is partway: it counts toward its group's total, and the group waits for it to finish.
                          Optional entries never hold the milestone back; "Work on Milestone" tries them last in each pass when the chance is there. Add entries from the fusions, upties and item lists below in the sidebar. Drag to set priority for "Work on Milestone",
                          and drag entries into or out of a group. Make a new group from an entry's dropdown.
                        </span>
                        <div id={"milestone-blocks-#{milestone["id"]}"} phx-hook="SortableList" data-sort-event="reorder_milestone_blocks"
                             data-sort-move-event="move_milestone_entry" data-sort-shared={"milestone-#{milestone["id"]}"}
                             data-sort-scope={milestone["id"]} class="flex flex-col gap-1">
                          <%= for block <- milestone["blocks"] || [] do %>
                            <%= if block["type"] == "group" do %>
                              <% members = Enum.flat_map(block["refs"], &List.wrap(entries[GiftPlans.entry_key(&1)])) %>
                              <% need = GiftPlans.group_min(milestone, block["letter"]) %>
                              <div data-sort-id={GiftPlans.block_key(block)} data-sort-stay class="border border-base-300 rounded-lg p-1.5 flex flex-col gap-1 bg-base-100">
                                <div class="flex items-center gap-2">
                                  <span data-sort-handle class="cursor-grab text-base-content/40 select-none px-1">⠿</span>
                                  <span class="text-[11px] font-medium text-base-content/70">Group <%= block["letter"] %>: at least</span>
                                  <form phx-change="set_group_min">
                                    <input type="hidden" name="milestone_id" value={milestone["id"]} />
                                    <input type="hidden" name="group" value={block["letter"]} />
                                    <input type="number" name="min" min="1" max={length(members)} value={need} phx-debounce="400" class="input input-bordered input-xs w-14" />
                                  </form>
                                  <span class="text-[11px] text-base-content/70">of <%= length(members) %></span>
                                  <span :if={length(members) == 1} class="badge badge-warning badge-xs">one entry, acts as required</span>
                                  <span :if={need > length(members)} class="badge badge-error badge-xs">can never be met</span>
                                </div>
                                <div id={"milestone-group-#{milestone["id"]}-#{block["letter"]}"} phx-hook="SortableList" data-sort-event="reorder_milestone_group"
                                     data-sort-move-event="move_milestone_entry" data-sort-shared={"milestone-#{milestone["id"]}"}
                                     data-sort-scope={"#{milestone["id"]}|#{block["letter"]}"} class="flex flex-col gap-1 pl-4">
                                  <.milestone_entry_row :for={entry <- members} entry={entry} milestone_id={milestone["id"]} letters={letters} gifts_by_name={@gifts_by_name} />
                                </div>
                              </div>
                            <% else %>
                              <.milestone_entry_row :for={entry <- List.wrap(entries[GiftPlans.block_key(block)])} entry={entry} milestone_id={milestone["id"]} letters={letters} gifts_by_name={@gifts_by_name} />
                            <% end %>
                          <% end %>
                        </div>
                        <div :if={map_size(entries) == 0} class="text-[11px] text-base-content/40 italic">No entries yet.</div>
                        <form :if={(subs = includable_milestones(@plan_data, milestone["id"])) != []} phx-change="include_milestone">
                          <input type="hidden" name="milestone_id" value={milestone["id"]} />
                          <select name="sub" class="select select-bordered select-xs">
                            <option value="" selected>+ include a milestone…</option>
                            <option :for={sub <- subs} value={sub["id"]}><%= sub["name"] %></option>
                          </select>
                        </form>
                        <div class="flex flex-col gap-1">
                          <span class="text-[11px] font-medium text-base-content/70">And only if</span>
                          <%= if milestone["condition"] do %>
                            <.condition_node node={milestone["condition"]} path="" values={%{"milestone_id" => milestone["id"]}}
                                             leaf={&gift_leaf(Map.merge(&1, %{plan_data: @plan_data, milestone_host: milestone["id"]}))} />
                          <% else %>
                            <button type="button" phx-click="cond_add" phx-value-milestone_id={milestone["id"]} phx-value-path="" phx-value-node="leaf"
                                    class="btn btn-ghost btn-xs self-start">+ Add condition</button>
                          <% end %>
                        </div>
                      <% else %>
                        <div class="text-xs text-base-content/40 italic">Create a milestone to edit it here.</div>
                      <% end %>
                    <% "fusions" -> %>
                      <%= if d = selected_definition(assigns, "fusions") do %>
                        <% target = d["target"] && @gifts_by_name[d["target"]] %>
                        <% fixed = GiftPlans.fixed_fusion?(d) %>
                        <form phx-change="lib_update" class="flex items-end gap-2">
                          <input type="hidden" name="lib" value="fusions" />
                          <input type="hidden" name="def_id" value={d["id"]} />
                          <label class="flex flex-col gap-0.5">
                            <span class="text-[11px] text-base-content/60">Name</span>
                            <input type="text" name="def[name]" value={d["name"]} phx-debounce="400" class="input input-bordered input-xs w-48" />
                          </label>
                          <label :if={fixed} class="flex items-center gap-1 cursor-pointer mb-1">
                            <input type="hidden" name="def[buy_missing]" value="false" />
                            <input type="checkbox" name="def[buy_missing]" value="true" checked={d["buy_missing"] != false} class="checkbox checkbox-xs" />
                            <span class="text-xs">buy missing ingredients from the shelf</span>
                          </label>
                        </form>
                        <.milestone_picker milestones={@plan_data["milestones"]} assigned={GiftPlans.assignments(@plan_data, GiftPlans.entry_ref("fusions", d["id"]))} lib="fusions" def_id={d["id"]} />
                        <.protected_floors_picker :if={d["target"]} plan_data={@plan_data} entry={d["target"]} />

                        <%= if fixed do %>
                          <%= if target do %>
                            <div class="flex items-center gap-2">
                              <img src={target.image_path} class="w-10 h-10 rounded object-cover" />
                              <div class="flex flex-col">
                                <span class="text-sm font-semibold"><%= target.name %></span>
                                <span class="text-[11px] text-base-content/60">Tier <%= target.tier %> · fixed recipe · done once owned</span>
                              </div>
                            </div>
                            <span class="text-[11px] text-base-content/60">
                              Ingredients. A missing one is bought from the shelf first (if allowed above), otherwise fused with its sub-fusion.
                              The target, every ingredient, and each sub-fusion's target are protected.
                            </span>
                            <div class="flex flex-col gap-1">
                              <%= for ingredient <- GiftPlans.ingredient_names(target, @gifts_by_id) do %>
                                <% ing = ingredient && @gifts_by_name[ingredient] %>
                                <% options = sub_fusion_options(@plan_data, d, ingredient) %>
                                <div class="flex items-center gap-2 bg-base-200 rounded px-1 py-0.5">
                                  <button type="button" phx-click="show_gift" phx-value-gift={ingredient} disabled={is_nil(ing)}
                                          class="flex items-center gap-2 flex-1 min-w-0 text-left cursor-pointer">
                                    <img :if={ing} src={ing.image_path} class="w-6 h-6 rounded object-cover" />
                                    <span :if={ing} class="badge badge-ghost badge-xs">T<%= ing.tier %></span>
                                    <span class="text-[11px] truncate"><%= ingredient || "unknown gift" %></span>
                                  </button>
                                  <form :if={ing} phx-change="set_sub_fusion">
                                    <input type="hidden" name="def_id" value={d["id"]} />
                                    <input type="hidden" name="ingredient" value={ingredient} />
                                    <select name="sub" class="select select-bordered select-xs">
                                      <option value="">buy only</option>
                                      <option :for={sub <- options} value={sub["id"]} selected={(d["sub_fusions"] || %{})[ingredient] == sub["id"]}>
                                        fuse via <%= sub["name"] %>
                                      </option>
                                    </select>
                                  </form>
                                  <button :if={ing && options == [] && GiftPlans.ingredient_ids(ing) == []} type="button"
                                          phx-click="create_sub_fusion" phx-value-def_id={d["id"]} phx-value-ingredient={ingredient}
                                          class="btn btn-ghost btn-2xs">+ tiered route</button>
                                </div>
                              <% end %>
                            </div>
                          <% else %>
                            <div class="text-xs text-base-content/50">Pick a target in the browser below: a gift with a fixed recipe.</div>
                          <% end %>
                        <% end %>

                        <%= if target && not fixed do %>
                          <div class="flex items-center gap-2">
                            <img src={target.image_path} class="w-10 h-10 rounded object-cover" />
                            <div class="flex flex-col">
                              <span class="text-sm font-semibold"><%= target.name %></span>
                              <span class="text-[11px] text-base-content/60">Tier <%= target.tier %> · <%= target.affinity %> · done once owned</span>
                            </div>
                          </div>

                          <div class="flex flex-col gap-1">
                            <span class="text-[11px] text-base-content/60">
                              Routes, tried in order. Each picks a combo from the valid pool and can buy missing ingredients up to a tier,
                              demand leftover unprotected items before fusing, and fuse sub-goals for its ingredient tiers.
                              Normal shops skip combos marked super only.
                            </span>
                            <div class="flex items-center gap-2">
                              <button type="button" phx-click="rt_copy" phx-value-def_id={d["id"]} class="btn btn-xs">Copy routes</button>
                              <button type="button" phx-click="rt_paste" phx-value-def_id={d["id"]} class="btn btn-xs"
                                      disabled={is_nil(@route_clipboard) or @route_clipboard.tier != target.tier}
                                      data-confirm="Replace all routes with the copied ones?">Paste routes</button>
                              <span :if={@route_clipboard} class="text-[11px] text-base-content/60">
                                Clipboard: <%= @route_clipboard.name %> (T<%= @route_clipboard.tier %>, <%= length(@route_clipboard.routes) %> route(s))
                              </span>
                            </div>
                            <div class="flex items-center gap-2">
                              <button type="button" phx-click="rt_use_default" phx-value-def_id={d["id"]} class="btn btn-xs"
                                      data-confirm={"Replace all routes with the tier #{target.tier} default?"}>Use T<%= target.tier %> default</button>
                              <button type="button" phx-click="rt_make_default" phx-value-def_id={d["id"]} class="btn btn-xs"
                                      data-confirm={"Make these routes the tier #{target.tier} default for new fusions in every plan?"}>Set as T<%= target.tier %> default</button>
                              <span class="text-[11px] text-base-content/60">
                                <%= case @route_defaults[target.tier] do %>
                                  <% nil -> %>No saved T<%= target.tier %> default
                                  <% routes -> %>T<%= target.tier %> default: <%= Enum.map_join(routes, ", ", &Routes.label/1) %>
                                <% end %>
                              </span>
                            </div>
                            <div class="flex items-center gap-2">
                              <span class="text-[11px] text-base-content/60">Routes for</span>
                              <div class="join">
                                <button :for={shop <- [:normal, :super]} type="button" phx-click="set_route_shop" phx-value-shop={shop}
                                        class={"btn btn-xs join-item " <> if(@route_shop == shop, do: "btn-primary", else: "btn-outline")}>
                                  <%= if shop == :normal, do: "Normal shop", else: "Super shop" %>
                                </button>
                              </div>
                            </div>
                            <.route_list def_id={d["id"]} routes={d["routes"] || []} tier={target.tier} shop={@route_shop} />
                          </div>
                        <% end %>
                        <div :if={is_nil(target) and not fixed} class="text-xs text-base-content/50">Pick a target in the browser below: a Tier 2 to 4 gift without a fixed recipe.</div>

                        <div class="divider my-0"></div>
                        <.gift_browser gifts={@gifts} gifts_by_id={@gifts_by_id} gift_filter={@gift_filter} gift_tier_filter={@gift_tier_filter}
                                      gift_affinity_filter={@gift_affinity_filter} gift_sort={@gift_sort}
                                      selected_gift_name={@selected_gift_name} uptie_view={@uptie_view} show_fusion_info={true}>
                          <:form :let={gift}>
                            <%= if (if fixed, do: fixed_target_eligible?(gift), else: fusion_target_eligible?(gift)) do %>
                              <button phx-click="set_fusion_target" phx-value-id={d["id"]} phx-value-gift={gift.name}
                                      class={"btn btn-sm " <> if(d["target"] == gift.name, do: "btn-primary", else: "btn-outline")}>
                                <%= if d["target"] == gift.name, do: "Current target", else: "Set as target" %>
                              </button>
                            <% else %>
                              <span class="text-[11px] text-base-content/50">
                                <%= if fixed,
                                      do: "Not a fixed fusion target (needs a fixed recipe).",
                                      else: "Not a tiered fusion target (needs Tier 2 to 4 and no fixed recipe)." %>
                              </span>
                            <% end %>
                          </:form>
                        </.gift_browser>
                      <% else %>
                        <div class="text-xs text-base-content/40 italic">Create a fusion definition to edit it here.</div>
                      <% end %>
                    <% "upties" -> %>
                      <%= if d = selected_definition(assigns, "upties") do %>
                        <form phx-change="lib_update" class="flex items-end gap-2 flex-wrap">
                          <input type="hidden" name="lib" value="upties" />
                          <input type="hidden" name="def_id" value={d["id"]} />
                          <label class="flex flex-col gap-0.5">
                            <span class="text-[11px] text-base-content/60">Name</span>
                            <input type="text" name="def[name]" value={d["name"]} phx-debounce="400" class="input input-bordered input-xs w-48" />
                          </label>
                          <label class="flex flex-col gap-0.5">
                            <span class="text-[11px] text-base-content/60">Target</span>
                            <select name="def[target_level]" class="select select-bordered select-xs">
                              <option value="2" selected={d["target_level"] == 2}>+2</option>
                              <option value="1" selected={d["target_level"] == 1}>+1</option>
                            </select>
                          </label>
                        </form>
                        <.milestone_picker milestones={@plan_data["milestones"]} assigned={GiftPlans.assignments(@plan_data, GiftPlans.entry_ref("upties", d["id"]))} lib="upties" def_id={d["id"]} />
                        <.protected_floors_picker :if={d["gift"]} plan_data={@plan_data} entry={d["gift"]} />
                        <%= if gift = d["gift"] && @gifts_by_name[d["gift"]] do %>
                          <div class="flex items-center gap-2">
                            <img src={gift.image_path} class="w-10 h-10 rounded object-cover" />
                            <div class="flex flex-col">
                              <span class="text-sm font-semibold"><%= gift.name %></span>
                              <span class="text-[11px] text-base-content/60">Tier <%= gift.tier %> · <%= uptie_cost_hint(gift, d) %> (estimates)</span>
                            </div>
                          </div>
                        <% else %>
                          <div class="text-xs text-base-content/50">Pick the gift to uptie in the browser below.</div>
                        <% end %>
                        <span class="text-[11px] text-base-content/50">
                          Upties this gift to +<%= d["target_level"] %> in one go. If the full cost can't be paid, the uptie step stops here instead of upgrading partway.
                        </span>
                        <div class="divider my-0"></div>
                        <.gift_browser gifts={@gifts} gifts_by_id={@gifts_by_id} gift_filter={@gift_filter} gift_tier_filter={@gift_tier_filter}
                                      gift_affinity_filter={@gift_affinity_filter} gift_sort={@gift_sort}
                                      selected_gift_name={@selected_gift_name} uptie_view={@uptie_view}>
                          <:form :let={gift}>
                            <button phx-click="set_uptie_gift" phx-value-id={d["id"]} phx-value-gift={gift.name}
                                    class={"btn btn-sm " <> if(gift.name == d["gift"], do: "btn-primary", else: "btn-outline")}>
                              <%= if gift.name == d["gift"], do: "Uptie target", else: "Uptie this gift" %>
                            </button>
                          </:form>
                        </.gift_browser>
                      <% else %>
                        <div class="text-xs text-base-content/40 italic">Create an uptie definition to edit it here.</div>
                      <% end %>
                    <% "lists" -> %>
                      <%= if d = selected_definition(assigns, "lists") do %>
                        <form phx-change="lib_update" class="flex items-end gap-2">
                          <input type="hidden" name="lib" value="lists" />
                          <input type="hidden" name="def_id" value={d["id"]} />
                          <label class="flex flex-col gap-0.5">
                            <span class="text-[11px] text-base-content/60">Name</span>
                            <input type="text" name="def[name]" value={d["name"]} phx-debounce="400" class="input input-bordered input-xs w-48" />
                          </label>
                          <label class="flex items-center gap-1 cursor-pointer mb-1">
                            <input type="checkbox" checked={d["protected"] == true} phx-click="toggle_list_protected" phx-value-id={d["id"]} class="checkbox checkbox-xs" />
                            <span class="text-xs">Protected</span>
                          </label>
                          <span class="text-[11px] text-base-content/50 mb-1">
                            Total if bought: <%= d["gifts"] |> Enum.map(&((@gifts_by_name[&1] && @gifts_by_name[&1].buying_cost) || 0)) |> Enum.sum() %> cost
                          </span>
                        </form>
                        <span class="text-[11px] text-base-content/50">
                          Buy steps take shelf matches in this order. On a protected list, every gift on it is protected from selling and fusing
                          on its protected floors; on other floors it can be sold or used as fusion material.
                          Protected floors belong to the gift, so every list, fusion and uptie with it shares them.
                          An "Any T3" entry matches every T3, and an "Any burn T2, T3" entry matches every burn gift of those tiers.
                          Any-tier and any-affinity entries can go on milestones as optional buys.
                        </span>
                        <div class="flex items-center gap-1">
                          <span class="text-[11px] text-base-content/60">Any tier:</span>
                          <% entries = d["gifts"] %>
                          <button :for={tier <- GiftPlans.shop_tiers()} phx-click="lib_toggle_gift" phx-value-lib="lists"
                                  phx-value-id={d["id"]} phx-value-gift={GiftPlans.tier_entry(tier)}
                                  class={"btn btn-2xs " <> if(GiftPlans.tier_entry(tier) in entries, do: "btn-secondary", else: "btn-outline")}>
                            T<%= tier %>
                          </button>
                        </div>
                        <form phx-submit="lib_add_affinity" class="flex items-center gap-1 flex-wrap">
                          <input type="hidden" name="def_id" value={d["id"]} />
                          <span class="text-[11px] text-base-content/60">Any affinity:</span>
                          <select name="affinity" class="select select-bordered select-xs">
                            <option value="">pick one</option>
                            <option :for={affinity <- affinities()} value={affinity}><%= affinity %></option>
                          </select>
                          <label :for={tier <- GiftPlans.shop_tiers()} class="flex items-center gap-0.5 cursor-pointer">
                            <input type="checkbox" name="tiers[]" value={tier} class="checkbox checkbox-xs" />
                            <span class="text-[11px]">T<%= tier %></span>
                          </label>
                          <button type="submit" class="btn btn-2xs btn-outline">+ add</button>
                          <span class="text-[11px] text-base-content/40">No tiers ticked means every tier.</span>
                        </form>
                        <.gift_clipboard lib="lists" definition={d} clipboard={@gift_clipboard} />
                        <.gift_order_list lib="lists" definition={d} gifts_by_name={@gifts_by_name} selected_gift_name={@selected_gift_name}>
                          <:extra :let={entry}>
                            <.milestone_picker :if={entry.gift || GiftPlans.pattern_entry?(entry.name)} milestones={@plan_data["milestones"]} assigned={GiftPlans.assignments(@plan_data, GiftPlans.entry_ref("lists", d["id"], entry.name))}
                                               lib="lists" def_id={d["id"]} gift={entry.name} />
                            <span :if={entry.gift} class="text-[10px] text-base-content/50">Buy <%= entry.gift.buying_cost || "?" %></span>
                            <.protected_floors_picker :if={d["protected"] == true} plan_data={@plan_data} entry={entry.name} />
                          </:extra>
                        </.gift_order_list>
                        <div class="divider my-0"></div>
                        <.gift_browser gifts={@gifts} gifts_by_id={@gifts_by_id} gift_filter={@gift_filter} gift_tier_filter={@gift_tier_filter}
                                      gift_affinity_filter={@gift_affinity_filter} gift_sort={@gift_sort}
                                      selected_gift_name={@selected_gift_name} uptie_view={@uptie_view}>
                          <:form :let={gift}>
                            <button phx-click="lib_toggle_gift" phx-value-lib="lists" phx-value-id={d["id"]} phx-value-gift={gift.name}
                                    class={"btn btn-sm " <> if(gift.name in d["gifts"], do: "btn-primary", else: "btn-outline")}>
                              <%= if gift.name in d["gifts"], do: "Remove from list", else: "Add to list" %>
                            </button>
                          </:form>
                        </.gift_browser>
                      <% else %>
                        <div class="text-xs text-base-content/40 italic">Pick a list on the left, or create one.</div>
                      <% end %>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%!-- ================= GRACE ================= --%>
            <%= if @active_tab == :loadout do %>
              <div class="flex flex-col gap-3 overflow-y-auto min-h-0 pr-1">
              <div class="flex items-end gap-3 flex-wrap">
                <form phx-change="set_affinity" class="flex flex-col gap-1">
                  <span class="text-xs font-medium text-base-content/70">Affinity</span>
                  <select name="affinity" class="select select-bordered">
                    <option value="">none</option>
                    <option :for={affinity <- affinities()} value={affinity} selected={@plan_data["affinity"] == affinity}><%= affinity %></option>
                  </select>
                </form>
                <div :if={GiftPlans.cabinet_order(@plan_data) != []} id="cabinet-gift-order" phx-hook="SortableList"
                     data-sort-event="reorder_cabinet_gifts" data-sort-scope="cabinet" data-sort-axis="x" class="flex items-center gap-2"
                     title="Starting gift pick order. The cabinet only allows as many picks as your graces give.">
                  <div :for={{name, index} <- Enum.with_index(GiftPlans.cabinet_order(@plan_data), 1)} data-sort-id={name}
                       class="flex items-center gap-2 rounded-lg border border-base-300 bg-base-200 p-2 min-h-14">
                    <span data-sort-handle class="cursor-grab text-base-content/40 select-none">⠿</span>
                    <span class="text-[10px] text-base-content/40"><%= index %></span>
                    <% gift = @gifts_by_name[name] %>
                    <img :if={gift} src={gift.image_path} class="w-10 h-10 rounded object-cover" />
                    <span class="text-xs font-semibold"><%= name %></span>
                  </div>
                </div>
              </div>

              <div class="divider my-0"></div>

              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-medium text-base-content/70">
                    Starter buffs to select at grace, on every run. Multi-select, pick an enhancement tier per grace.
                  </span>
                  <span class="badge badge-primary badge-sm ml-auto"><%= grace_total_cost(@plan_data) %> Starlight total</span>
                </div>
                <div class="grid grid-cols-5 grid-rows-2 gap-2">
                  <%= for grace <- graces() do %>
                    <% pick = grace_pick(@plan_data, grace.index) %>
                    <% level = if pick, do: pick["enhance"], else: 0 %>
                    <div phx-click="toggle_grace" phx-value-index={grace.index}
                         class={"cursor-pointer rounded-lg border p-2 flex flex-col gap-1 " <>
                           if(pick, do: "bg-primary/10 border-primary", else: "border-base-300 hover:bg-base-200")}>
                      <div class="flex items-center justify-between gap-1">
                        <span class="text-xs font-semibold"><%= grace.name %></span>
                        <div class="flex items-center gap-0.5 shrink-0">
                          <%= for enhance_level <- [0, 1, 2] do %>
                            <button type="button" phx-click="set_grace_enhance"
                                    phx-value-index={grace.index} phx-value-level={enhance_level}
                                    class={"btn btn-2xs " <> if(pick && level == enhance_level, do: "btn-secondary", else: "btn-outline")}>
                              <%= grace_enhance_icon(enhance_level) %>
                            </button>
                          <% end %>
                        </div>
                      </div>
                      <span class="badge badge-ghost badge-xs self-start"><%= grace_level_cost(grace, level) %> Starlight</span>
                      <p class="text-[11px] text-base-content/60 leading-snug"><%= grace_effect(grace, level) %></p>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="divider my-0"></div>

              <% picks = @plan_data["gift_search"] %>
              <% max = GiftPlans.gift_search_max() %>
              <div class="flex flex-col gap-3">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-medium text-base-content/70">
                    Gifts to pick on the gift search screen after the cabinet, on every run. Up to <%= max %>, Tier 3 and under.
                    Leave empty to skip gift search.
                  </span>
                  <span :if={picks != []} class="badge badge-warning badge-sm ml-auto whitespace-nowrap">
                    <%= GiftPlans.gift_search_starlight_cost(length(picks)) %> Starlight
                  </span>
                  <span class={"badge badge-primary badge-sm " <> if(picks == [], do: "ml-auto", else: "")}><%= length(picks) %> / <%= max %></span>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <%= for slot <- 0..(max - 1) do %>
                    <% name = Enum.at(picks, slot) %>
                    <% gift = name && @gifts_by_name[name] %>
                    <div class={"rounded-lg border p-2 flex items-center gap-2 min-h-14 " <>
                           if(name, do: "bg-primary/10 border-primary", else: "border-dashed border-base-300")}>
                      <%= if name do %>
                        <button type="button" phx-click="show_gift" phx-value-gift={name} class="flex items-center gap-2 flex-1 min-w-0 text-left cursor-pointer">
                          <img :if={gift} src={gift.image_path} class="w-10 h-10 rounded object-cover" />
                          <div class="flex flex-col flex-1 min-w-0">
                            <span class="text-xs font-semibold truncate" title={name}><%= name %></span>
                            <span :if={gift} class="text-[10px] text-base-content/60">
                              T<%= gift.tier %> · <%= GiftPlans.gift_search_tab(gift) %> tab
                            </span>
                          </div>
                        </button>
                        <span class="badge badge-warning badge-xs whitespace-nowrap"><%= GiftPlans.gift_search_slot_cost(slot) %> Starlight</span>
                        <button phx-click="toggle_search_gift" phx-value-gift={name} class="btn btn-ghost btn-2xs px-1">✕</button>
                      <% else %>
                        <span class="text-[11px] text-base-content/40 italic flex-1">Empty slot</span>
                        <span class="badge badge-ghost badge-xs whitespace-nowrap">+<%= GiftPlans.gift_search_slot_cost(slot) %> Starlight</span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <div class="divider my-0"></div>
                <.gift_browser gifts={searchable_gifts(@gifts)} gifts_by_id={@gifts_by_id} gift_filter={@gift_filter} gift_tier_filter={@gift_tier_filter}
                              gift_affinity_filter={@gift_affinity_filter} gift_sort={@gift_sort}
                              selected_gift_name={@selected_gift_name} uptie_view={@uptie_view}>
                  <:form :let={gift}>
                    <button phx-click="toggle_search_gift" phx-value-gift={gift.name}
                            disabled={gift.name not in picks and length(picks) >= max}
                            class={"btn btn-sm " <> if(gift.name in picks, do: "btn-primary", else: "btn-outline")}>
                      <%= cond do
                        gift.name in picks -> "Remove from gift search"
                        length(picks) >= max -> "Gift search is full"
                        true -> "Add to gift search (+#{GiftPlans.gift_search_slot_cost(length(picks))} Starlight)"
                      end %>
                    </button>
                  </:form>
                </.gift_browser>
              </div>

              <div class="divider my-0"></div>

              <% rows = @plan_data["mounting_trials"] %>
              <div class="flex flex-col gap-1">
                <span class="text-xs font-semibold text-base-content/70">Mounting Trials</span>
                <form phx-change="update_mounting" class="flex items-center overflow-x-auto pb-1">
                  <div :for={{row, index} <- Enum.with_index(rows)} class="flex items-end shrink-0">
                    <% next = Enum.at(rows, index + 1) %>
                    <div class="flex items-end gap-1.5 rounded-lg border border-success/60 bg-success/10 px-1.5 py-1 shadow-sm text-[11px] font-semibold text-base-content/70">
                      <div class="flex flex-col gap-0.5">
                        <span class="text-[10px] text-base-content/50 whitespace-nowrap">Start at</span>
                        <span :if={index == 0} class="h-5 flex items-center px-1">F1</span>
                        <select :if={index > 0} name={"rows[#{index}][from_floor]"} class="select select-bordered h-5 min-h-0 text-[11px] pl-1 pr-5 w-12">
                          <option :for={floor <- 1..15} value={floor} selected={row["from_floor"] == floor}>F<%= floor %></option>
                        </select>
                      </div>
                      <div class="flex flex-col gap-0.5 ml-2">
                        <span class="text-[10px] text-base-content/50">Pick</span>
                        <select name={"rows[#{index}][mode]"} class="select select-bordered h-5 min-h-0 text-[11px] pl-1 pr-6">
                          <option :for={mode <- GiftPlans.mounting_trials_modes()} value={mode} selected={row["mode"] == mode}><%= GiftPlans.mounting_trials_mode_label(mode) %></option>
                        </select>
                      </div>
                      <button type="button" phx-click="remove_mounting_row" phx-value-index={index} class="btn btn-ghost btn-2xs text-error">✕</button>
                    </div>
                    <% covered = if next, do: Enum.map_join((row["from_floor"] + 1)..(next["from_floor"] - 1)//1, " ", &"F#{&1}"), else: if(row["from_floor"] < 15, do: "F#{row["from_floor"] + 1}+", else: "") %>
                    <div class="flex items-center shrink-0 h-5 mb-[5px]">
                      <div class="w-3 h-px bg-base-content/40"></div>
                      <span :if={covered != ""} class="px-1 text-[10px] font-semibold text-base-content/50 whitespace-nowrap"><%= covered %></span>
                      <div class="relative w-3 h-px bg-base-content/40">
                        <span class="absolute right-0 top-1/2 -translate-y-1/2 border-y-[4px] border-y-transparent border-l-[6px] border-l-base-content/40"></span>
                      </div>
                    </div>
                  </div>
                  <button type="button" phx-click="add_mounting_row" disabled={Enum.any?(rows, &(&1["from_floor"] >= 15))}
                          class="shrink-0 self-stretch rounded-lg border border-dashed border-base-content/30 px-3 text-[11px] text-base-content/60 hover:bg-base-200 disabled:opacity-40">
                    + Floor
                  </button>
                </form>
                <span :if={rows == []} class="text-[11px] text-base-content/50 italic">No floors set; every floor uses best gift.</span>
              </div>
              </div>
            <% end %>

          </div>

        <% else %>
          <div class="flex items-center gap-3">
            <.pane_tabs team_id={@team_id} pane="gifts" />
            <.plan_picker id="gift-plan-picker" items={@plans} current_id={@editing_id} name={@name} noun="plan" label="gift plan" />
          </div>
          <div class="flex-1 flex items-center justify-center text-base-content/40 text-sm">
            Pick or create a gift plan for this team.
          </div>
        <% end %>
      </div>
    </div>
</div>
