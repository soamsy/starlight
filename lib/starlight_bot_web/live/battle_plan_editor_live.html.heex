<div class="flex flex-col h-full gap-2 overflow-hidden">
  <datalist id="hook-names">
    <%= for name <- @hook_names do %>
      <option value={name}></option>
    <% end %>
  </datalist>
  <StarlightBotWeb.Layouts.flash_toasts flash={@flash} />
    <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3 overflow-y-auto">
        <%= if @data do %>
          <div class="flex items-center gap-3">
            <.pane_tabs team_id={@team_id} pane="battle" />
            <.plan_picker id="battle-plan-picker" items={@plans} current_id={@editing_id} name={@name} noun="plan" label="battle plan" />
            <form phx-change="set_max_retries" class="flex items-center gap-1 text-xs"
                  title="How many times a lost battle is retried before the run gives up.">
              <span class="text-base-content/60">Retries per battle</span>
              <input type="number" name="max_retries" min="0" value={StarlightBot.BattlePlans.max_retries(@data)}
                     phx-debounce="300" class="input input-bordered input-xs w-16" />
            </form>
          </div>

          <% lineup_issues = StarlightBot.BattlePlans.lineup_issues(@data) %>
          <div :if={lineup_issues != []} role="alert" class="alert alert-warning alert-soft py-1.5 px-3 text-xs">
            <div class="flex flex-col">
              <span class="font-semibold">Lineups need setting up. Until then the bot leaves the in-game sinner order alone.</span>
              <span :for={issue <- lineup_issues}><%= issue %></span>
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <div class="flex items-center gap-1.5 flex-wrap">
              <%= for lineup <- StarlightBot.BattlePlans.lineups(@data) do %>
                <% used = StarlightBot.BattlePlans.venues_using(@data, lineup["id"]) %>
                <%= if @renaming_lineup_id == lineup["id"] do %>
                  <form phx-submit="rename_lineup" class="flex">
                    <input type="text" name="value" value={lineup["name"]} phx-blur="rename_lineup"
                           phx-keydown="cancel_rename_lineup" phx-key="Escape" phx-mounted={JS.focus()}
                           class="input input-bordered input-sm w-40 font-semibold" />
                  </form>
                <% else %>
                  <div id={"lineup-#{lineup["id"]}"} phx-hook="DblClickEvent" data-event="start_rename_lineup" data-id={lineup["id"]}
                       title={"Double-click to rename. Used on: " <> if(used == [], do: "nothing", else: Enum.map_join(used, ", ", &StarlightBot.BattlePlans.venue_label/1))}
                       class={"flex items-center rounded-lg border text-xs " <> if(@lineup_id == lineup["id"], do: "border-primary bg-primary/10", else: "border-base-300 hover:bg-base-200")}>
                    <button phx-click="select_lineup" phx-value-id={lineup["id"]} class="flex items-center gap-1.5 pl-1.5 pr-1 py-1">
                      <span class="inline-block w-5 text-center rounded-full text-[10px] font-semibold text-white" style={lineup_color(@data, lineup["id"], 0.9)}><%= playbook_tag(lineup) %></span>
                      <span class="font-medium"><%= lineup["name"] %></span>
                      <span class={"text-[10px] " <> if(lineup["sinners"] == [], do: "text-warning", else: "text-base-content/40")}><%= length(lineup["sinners"]) %> sin</span>
                    </button>
                    <button phx-click="delete_lineup" phx-value-id={lineup["id"]}
                            data-confirm={"Delete lineup '#{lineup["name"]}'?"}
                            title="Delete lineup"
                            class="btn btn-2xs btn-ghost text-error px-1">✕</button>
                  </div>
                <% end %>
              <% end %>
              <button phx-click="new_lineup" class="btn btn-xs btn-ghost">+ lineup</button>
            </div>

            <% lineup = StarlightBot.BattlePlans.find_lineup(@data, @lineup_id) %>
            <%= if lineup do %>
              <div class="flex flex-wrap gap-4 items-start">
                <div class="flex flex-col gap-2 pt-5">
                  <%= for row <- sinner_rows() do %>
                    <div class="grid grid-cols-6 gap-1 max-w-2xl">
                      <%= for sinner <- row do %>
                        <% pos = Enum.find_index(lineup["sinners"], &(&1 == sinner)) %>
                        <% profile = @profiles_by_id[StarlightBot.BattlePlans.profiles(@data)[sinner]] %>
                        <div class="flex flex-col gap-0.5 min-w-0">
                          <button type="button" phx-click="toggle_lineup_sinner" phx-value-sinner={sinner}
                                  class={"btn btn-xs relative " <> if(pos, do: "btn-primary", else: "btn-outline")}>
                            <%= sinner_label(sinner) %>
                            <span :if={pos} class={"absolute -top-2 -right-2 badge badge-xs " <> if(pos < StarlightBot.BattlePlans.front_line_size(), do: "badge-secondary", else: "badge-neutral")}><%= pos + 1 %></span>
                          </button>
                          <form phx-change="set_sinner_profile" class="flex items-center gap-0.5 min-w-0">
                            <input type="hidden" name="sinner" value={sinner} />
                            <img :if={profile && profile.locator_hook && Map.has_key?(@locator_thumbs, profile.locator_hook)}
                                 src={~p"/hooks/#{profile.locator_hook}/thumb.png?#{[v: @locator_thumbs[profile.locator_hook]]}"}
                                 title={"#{profile.name} (#{profile.locator_hook})"} class="h-5 w-auto rounded shrink-0" />
                            <select name="profile_id" title={if(profile, do: profile.name, else: "No profile: playbook checks for #{sinner_label(sinner)} are skipped")}
                                    class={"select select-bordered select-xs min-w-0 flex-1 text-[10px] " <> if(profile, do: "", else: "text-base-content/40")}>
                              <option value="" selected={is_nil(profile)}>(no profile)</option>
                              <option :for={p <- Map.get(@profiles_by_sinner, sinner, [])} value={p.id} selected={profile && profile.id == p.id}><%= p.name %></option>
                            </select>
                          </form>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                  <div class="flex items-center gap-2 text-xs">
                    <button type="button" phx-click="clear_lineup" class="btn btn-xs btn-ghost">Clear</button>
                    <span class="text-base-content/50">
                      <%= length(lineup["sinners"]) %> picked
                      <%= if length(lineup["sinners"]) > StarlightBot.BattlePlans.front_line_size() do %>
                        (<%= length(lineup["sinners"]) - StarlightBot.BattlePlans.front_line_size() %> backup)
                      <% end %>
                    </span>
                  </div>
                  <span class="text-xs text-base-content/60">
                    Click sinners in pick order. The first <%= StarlightBot.BattlePlans.front_line_size() %> go on the front line, the rest are backups.
                  </span>
                </div>
                <div class="flex flex-col gap-1">
                  <table class="text-[11px] border-separate border-spacing-0.5 self-start">
                    <thead>
                      <tr>
                        <th></th>
                        <%= for floor <- floors(@extreme?) do %>
                          <th class="font-normal text-base-content/50 w-8">F<%= floor %></th>
                        <% end %>
                        <%= unless @extreme? do %>
                          <th class="font-normal text-base-content/50 w-12">F6-15</th>
                        <% end %>
                      </tr>
                    </thead>
                    <tbody>
                    <%= for venue <- StarlightBot.BattlePlans.venues() do %>
                      <% entries = StarlightBot.BattlePlans.lineup_track(@data, venue) %>
                      <% lux? = StarlightBot.BattlePlans.lux_venue?(venue) %>
                      <tr>
                        <td class="pr-2 whitespace-nowrap text-base-content/70"><%= StarlightBot.BattlePlans.venue_label(venue) %></td>
                        <%= for floor <- if(lux?, do: [1], else: floors(@extreme?)) do %>
                          <% id = StarlightBot.BattlePlans.Resolver.lineup_id_at(entries, floor) %>
                          <% painted = StarlightBot.BattlePlans.find_lineup(@data, id) %>
                          <% start? = change_point?(entries, floor) %>
                          <td>
                            <button phx-click="paint_lineup" phx-value-venue={venue} phx-value-floor={floor}
                                    title={lineup_tooltip(@data, entries, floor)}
                                    style={if painted, do: lineup_color(@data, id, if(start?, do: 0.9, else: 0.25))}
                                    class={"w-8 h-6 rounded-full text-[10px] font-semibold " <> cond do
                                      is_nil(painted) -> "border border-dashed border-warning text-warning"
                                      start? -> "border-l-4 border-base-content/70 text-white"
                                      true -> "text-base-content/40"
                                    end}>
                              <%= cond do %>
                                <% is_nil(painted) -> %>?
                                <% start? -> %><%= playbook_tag(painted) %>
                                <% true -> %>··
                              <% end %>
                            </button>
                          </td>
                        <% end %>
                        <%= if not @extreme? and not lux? do %>
                          <% id = StarlightBot.BattlePlans.Resolver.lineup_id_at(entries, 6) %>
                          <% painted = StarlightBot.BattlePlans.find_lineup(@data, id) %>
                          <td>
                            <button phx-click="toggle_extreme"
                                    title={lineup_tooltip(@data, entries, 6) <> if(hidden_change_points?(entries), do: ", more change points above", else: "")}
                                    style={if painted, do: lineup_color(@data, id, if(change_point?(entries, 6), do: 0.9, else: 0.25))}
                                    class="w-12 h-6 rounded-full text-[10px] font-semibold">
                              <%= if painted, do: playbook_tag(painted), else: "?" %><%= if hidden_change_points?(entries), do: " •" %>
                            </button>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                  <div class="flex items-center gap-2 text-xs text-base-content/60">
                    <span>Click a floor to start <span class="font-semibold"><%= lineup["name"] %></span> there.</span>
                    <button phx-click="toggle_lineup_erase" title="Remove a change point"
                            class={"btn btn-2xs " <> if(@lineup_erase?, do: "btn-error", else: "btn-ghost text-error")}>eraser</button>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="divider my-0"></div>

          <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 text-xs text-base-content/60 flex-wrap">
              <span class="font-medium">Tracks</span>
              <span>Click a floor to start a playbook there. It applies until the next change point.</span>
              <label class="ml-auto flex items-center gap-1 cursor-pointer">
                <input type="checkbox" checked={@extreme?} phx-click="toggle_extreme" class="checkbox checkbox-xs" />
                floors 6-15
              </label>
            </div>

            <div class="flex items-center gap-1 flex-wrap text-xs">
              <span class="text-base-content/60">Painting:</span>
              <%= for pb <- @data["playbooks"] do %>
                <button phx-click="set_paint" phx-value-id={pb["id"]} title={"#{pb["name"]} (#{pb["kind"]})"}
                        class={"btn btn-2xs gap-1 " <> if(@paint == pb["id"], do: "ring ring-offset-1 ring-base-content/50", else: "btn-ghost")}>
                  <span class="inline-block w-2.5 h-2.5 rounded-sm" style={playbook_color(@data, pb["id"], 1)}></span>
                  <%= pb["name"] %>
                </button>
              <% end %>
              <button phx-click="set_paint" phx-value-id="erase" title="Remove a change point"
                      class={"btn btn-2xs " <> if(@paint == "erase", do: "btn-error", else: "btn-ghost text-error")}>eraser</button>
            </div>

            <div class="overflow-x-auto">
              <table class="text-[11px] border-separate border-spacing-0.5">
                <thead>
                  <tr>
                    <th></th>
                    <%= for floor <- floors(@extreme?) do %>
                      <th class="font-normal text-base-content/50 w-8">F<%= floor %></th>
                    <% end %>
                    <%= unless @extreme? do %>
                      <th class="font-normal text-base-content/50 w-12">F6-15</th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <%= for track <- StarlightBot.BattlePlans.tracks() do %>
                    <% entries = @data["tracks"][track] %>
                    <% lux? = StarlightBot.BattlePlans.lux_track?(track) %>
                    <tr :if={track == "lux_chain"}>
                      <td colspan="16" class="py-0.5"><div class="h-px"></div></td>
                    </tr>
                    <tr>
                      <td class="pr-2 whitespace-nowrap text-base-content/70"><%= track_label(track) %></td>
                      <%= for floor <- if(lux?, do: [1], else: floors(@extreme?)) do %>
                        <% id = StarlightBot.BattlePlans.Resolver.playbook_id_at(entries, floor) %>
                        <% start? = change_point?(entries, floor) %>
                        <td>
                          <button phx-click="paint_cell" phx-value-track={track} phx-value-floor={floor}
                                  title={if lux?, do: find_playbook(@data, id)["name"], else: run_tooltip(@data, entries, floor)}
                                  style={playbook_color(@data, id, if(start?, do: 0.9, else: 0.25))}
                                  class={"w-8 h-6 rounded text-[10px] font-semibold " <> if(start?, do: "border-l-4 border-base-content/70 text-white", else: "text-base-content/40")}>
                            <%= if start?, do: playbook_tag(find_playbook(@data, id)), else: "··" %>
                          </button>
                        </td>
                      <% end %>
                      <%= if not @extreme? and not lux? do %>
                        <% id = StarlightBot.BattlePlans.Resolver.playbook_id_at(entries, 6) %>
                        <td>
                          <button phx-click="toggle_extreme"
                                  title={run_tooltip(@data, entries, 6) <> if(hidden_change_points?(entries), do: ", more change points above", else: "")}
                                  style={playbook_color(@data, id, if(change_point?(entries, 6), do: 0.9, else: 0.25))}
                                  class="w-12 h-6 rounded text-[10px] font-semibold">
                            <%= playbook_tag(find_playbook(@data, id)) %><%= if hidden_change_points?(entries), do: " •" %>
                          </button>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="divider my-0"></div>

          <div class="grid grid-cols-[14rem_1fr] gap-3 flex-1 min-h-0">
            <div class="flex flex-col gap-2">
              <%= for kind <- ~w(chain focused) do %>
                <div class="flex flex-col gap-0.5">
                  <div class="flex items-center text-xs font-semibold text-base-content/70">
                    <%= String.capitalize(kind) %> playbooks
                    <button phx-click="new_playbook" phx-value-kind={kind} class="btn btn-2xs btn-ghost ml-auto">+ <%= kind %></button>
                  </div>
                  <%= for pb <- Enum.filter(@data["playbooks"], &(&1["kind"] == kind)) do %>
                    <% used = StarlightBot.BattlePlans.tracks_using(@data, pb["id"]) %>
                    <button phx-click="select_playbook" phx-value-id={pb["id"]}
                            class={"flex items-center gap-1.5 text-left text-xs rounded px-1.5 py-1 hover:bg-base-200 " <> if(@playbook_id == pb["id"], do: "bg-primary/10 border-l-2 border-primary", else: "")}>
                      <span class="inline-block w-5 text-center rounded text-[10px] font-semibold text-white" style={playbook_color(@data, pb["id"], 0.9)}><%= playbook_tag(pb) %></span>
                      <span class="flex-1 truncate"><%= pb["name"] %></span>
                      <span class="text-[10px] text-base-content/40" title={Enum.map_join(used, ", ", &track_label/1)}><%= length(used) %> tr</span>
                    </button>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="flex flex-col gap-2 min-w-0">
              <% playbook = find_playbook(@data, @playbook_id) %>
              <%= if playbook do %>
                <div class="flex items-center gap-2">
                  <input type="text" value={playbook["name"]} phx-blur="rename_playbook"
                         class="input input-bordered input-sm w-56 font-semibold" />
                  <span class="badge badge-sm badge-outline"><%= playbook["kind"] %></span>
                  <button phx-click="duplicate_playbook" phx-value-id={playbook["id"]} class="btn btn-xs btn-ghost ml-auto">Duplicate</button>
                  <button phx-click="delete_playbook" phx-value-id={playbook["id"]}
                          data-confirm={"Delete playbook '#{playbook["name"]}'?"}
                          class="btn btn-xs btn-ghost text-error">Delete</button>
                </div>

                <div class="flex items-center gap-1 text-xs flex-wrap">
                  <span class="text-base-content/60 mr-1">Turns (click to split):</span>
                  <% turns = ruler_turns(playbook) %>
                  <%= for turn <- turns do %>
                    <% boundary? = Enum.any?(playbook["phases"], &(&1["from_turn"] == turn)) %>
                    <button phx-click="split_phase" phx-value-turn={turn} disabled={turn == 1 or boundary?}
                            class={"btn btn-2xs w-7 " <> if(boundary?, do: "btn-primary", else: "btn-outline")}>
                      <%= turn %><%= if turn == List.last(turns), do: "+" %>
                    </button>
                  <% end %>
                </div>

                <%= for phase <- playbook["phases"] do %>
                  <% turn = phase["from_turn"] %>
                  <div class="border border-base-300 rounded-lg p-2 flex flex-col gap-1">
                    <div class="flex items-center text-xs font-semibold text-base-content/70">
                      <%= phase_range(playbook["phases"], phase) %>
                      <%= if turn > 1 do %>
                        <button phx-click="remove_phase" phx-value-turn={turn}
                                class="btn btn-2xs btn-ghost text-error ml-auto" title="Merge into the previous phase">remove phase</button>
                      <% end %>
                    </div>

                    <%= for {action, index} <- Enum.with_index(phase["actions"], 1) do %>
                      <.action_row action={action} index={index} turn={turn} sinner_options={@sinner_options} kind={playbook["kind"]} phase_actions={phase["actions"]} />
                    <% end %>

                    <form id={"add-#{playbook["id"]}-#{turn}-#{length(phase["actions"])}"} phx-change="add_action" class="flex items-center gap-2">
                      <input type="hidden" name="turn" value={turn} />
                      <select name="type" class="select select-bordered select-xs">
                        <option value="" selected>+ action</option>
                        <%= for type <- available_actions(playbook, phase["actions"]) do %>
                          <option value={type}><%= action_label(type) %></option>
                        <% end %>
                      </select>
                      <span class="text-[11px] text-base-content/50 italic">
                        <%= if ends_with_chain?(phase["actions"]) do %>
                          then: the chain drag starts the turn; fallback only if it didn't
                        <% else %>
                          then: fallback (enter, then p + enter if the turn didn't start)
                        <% end %>
                      </span>
                    </form>
                  </div>
                <% end %>
              <% end %>
              <%= if is_nil(playbook) do %>
                <div class="text-xs text-base-content/40 italic">Select a playbook to edit.</div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="flex items-center gap-3">
            <.pane_tabs team_id={@team_id} pane="battle" />
            <.plan_picker id="battle-plan-picker" items={@plans} current_id={@editing_id} name={@name} noun="plan" label="battle plan" />
          </div>
          <div class="flex-1 flex items-center justify-center text-base-content/40 text-sm">
            Pick or create a battle plan for this team.
          </div>
        <% end %>
      </div>
    </div>
</div>
