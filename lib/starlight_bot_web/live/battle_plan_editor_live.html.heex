<div id="battle-view-memory" phx-hook="ViewMemory" data-key={@editing_id && "starlight-battle-view-#{@editing_id}"} data-view={Jason.encode!(%{lineup: @lineup_id, playbook: @playbook_id, paint: @paint})} class="flex flex-col h-full gap-2 overflow-hidden">
  <datalist id="hook-names">
    <%= for name <- @hook_names do %>
      <option value={name}></option>
    <% end %>
  </datalist>
    <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3 overflow-y-auto">
        <%= if @data do %>
          <div class="flex flex-wrap items-start gap-3 lg:flex-nowrap">
          <div class="flex min-w-0 basis-full flex-col gap-2 lg:flex-1 lg:basis-0">
            <% lineup = StarlightBot.BattlePlans.find_lineup(@data, @lineup_id) %>
            <%= if lineup do %>
              <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-3 items-start">
                <div class="flex flex-col gap-1 min-w-0 lg:w-max lg:max-w-[45vw]">
                  <.lineup_list data={@data} lineup_id={@lineup_id} renaming_lineup_id={@renaming_lineup_id} reorder_rev={@reorder_rev} />
                  <div class="overflow-x-auto">
                  <table style={lineup_paint_style(@data, @lineup_id, @lineup_erase?)} class="text-[11px] border-separate border-spacing-0.5 self-start">
                    <thead>
                      <tr>
                        <th></th>
                        <%= for floor <- floors(@extreme?) do %>
                          <th class="font-normal text-base-content/50 w-8">
                            <button :if={@extreme? and floor == StarlightBot.BattlePlans.max_floor()} type="button" phx-click="toggle_extreme" title="Collapse floors 6-15"
                                    class="btn btn-2xs btn-ghost h-4 min-h-4 w-full px-0 text-[11px] font-normal text-base-content/50">F<%= floor %></button>
                            <span :if={not (@extreme? and floor == StarlightBot.BattlePlans.max_floor())}>F<%= floor %></span>
                          </th>
                        <% end %>
                        <%= unless @extreme? do %>
                          <th class="font-normal w-12">
                            <button type="button" phx-click="toggle_extreme" title="Show floors 6-15" class="btn btn-2xs btn-ghost h-4 min-h-4 w-full px-0 text-[11px] font-normal text-base-content/50">F6-F15</button>
                          </th>
                        <% end %>
                      </tr>
                    </thead>
                    <tbody>
                    <%= for venue <- StarlightBot.BattlePlans.venues() do %>
                      <% entries = StarlightBot.BattlePlans.lineup_track(@data, venue) %>
                      <% lux? = StarlightBot.BattlePlans.lux_venue?(venue) %>
                      <tr>
                        <td class="w-28 pr-2 whitespace-nowrap text-base-content/70"><%= StarlightBot.BattlePlans.venue_label(venue) %></td>
                        <%= for floor <- if(lux?, do: [1], else: floors(@extreme?)) do %>
                          <% id = StarlightBot.BattlePlans.Resolver.lineup_id_at(entries, floor) %>
                          <% painted = StarlightBot.BattlePlans.find_lineup(@data, id) %>
                          <% start? = change_point?(entries, floor) %>
                          <td>
                            <button phx-click="paint_lineup" phx-value-venue={venue} phx-value-floor={floor}
                                    title={lineup_tooltip(@data, entries, floor)}
                                    style={if painted, do: lineup_color(@data, id, if(start?, do: 0.9, else: 0.25))}
                                    class={"w-8 h-6 rounded-full text-[10px] font-semibold cursor-pointer hover:bg-[var(--paint)]! hover:ring-2 hover:ring-base-content/50 " <> cond do
                                      is_nil(painted) -> "border border-dashed border-warning text-warning"
                                      start? -> "border-l-4 border-base-content/70 text-white"
                                      true -> "text-base-content/40"
                                    end}>
                              <%= cond do %>
                                <% is_nil(painted) -> %>?
                                <% start? -> %><%= playbook_tag(painted) %>
                                <% true -> %>··
                              <% end %>
                            </button>
                          </td>
                        <% end %>
                        <td :if={lux?} colspan={length(floors(@extreme?)) + if(@extreme?, do: 0, else: 1) - 1} class="text-right align-middle">
                          <button phx-click="toggle_lineup_erase" title="Remove a change point"
                                  class={"btn btn-2xs gap-1 " <> if(@lineup_erase?, do: "btn-error", else: "btn-ghost text-error")}><.icon name="lucide-eraser" class="size-3 shrink-0" />eraser</button>
                        </td>
                        <%= if not @extreme? and not lux? do %>
                          <% id = StarlightBot.BattlePlans.Resolver.lineup_id_at(entries, 6) %>
                          <% painted = StarlightBot.BattlePlans.find_lineup(@data, id) %>
                          <td>
                            <button phx-click="toggle_extreme"
                                    title={lineup_tooltip(@data, entries, 6) <> if(hidden_change_points?(entries), do: ", more change points above", else: "")}
                                    style={if painted, do: lineup_color(@data, id, if(change_point?(entries, 6), do: 0.9, else: 0.25))}
                                    class="w-12 h-6 rounded-full text-[10px] font-semibold">
                              <%= if painted, do: playbook_tag(painted), else: "?" %><%= if hidden_change_points?(entries), do: " •" %>
                            </button>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                  </div>
                </div>
                <div class="flex flex-col gap-2 pt-10 w-2xl max-w-full">
                  <%= for row <- sinner_rows() do %>
                    <div class="grid grid-cols-6 gap-1 max-w-2xl">
                      <%= for sinner <- row do %>
                        <% pos = Enum.find_index(lineup["sinners"], &(&1 == sinner)) %>
                        <% chosen = for id <- Map.get(StarlightBot.BattlePlans.profiles(@data), sinner, []), p = @profiles_by_id[id], do: p %>
                        <div class="flex flex-col gap-0.5 min-w-0">
                          <button type="button" phx-click="toggle_lineup_sinner" phx-value-sinner={sinner}
                                  title={sinner_label(sinner)}
                                  style={sinner_slot_style(pos)}
                                  class={"btn btn-xs relative min-w-0 flex-nowrap gap-1 overflow-hidden px-1 " <> cond do
                                    is_nil(pos) -> "btn-outline"
                                    pos < StarlightBot.BattlePlans.front_line_size() -> "btn-error"
                                    true -> "btn-info"
                                  end}>
                            <img src={StarlightBot.SinnerProfiles.icon(sinner)} class="sinner-icon h-4 w-4 shrink-0 object-contain" /><span class="truncate"><%= sinner_label(sinner) %></span>
                            <span :if={pos} class={"ml-auto -mr-1 flex h-full min-w-6 shrink-0 items-center justify-center self-stretch border-l border-black/25 px-1 font-mono text-[11px] font-bold " <> if(pos == 0, do: "bg-primary text-primary-content", else: "bg-black/20 text-white")}><%= pos + 1 %></span>
                          </button>
                          <form phx-change="set_sinner_profile" class="flex items-center gap-0.5 min-w-0">
                            <input type="hidden" name="sinner" value={sinner} />
                            <div class="dropdown min-w-0 flex-1">
                              <input type="hidden" name="profile_ids" value={Enum.map_join(chosen, ",", & &1.id)} />
                              <div tabindex="0" role="button"
                                   title={if(chosen == [], do: "No profile: playbook checks for #{sinner_label(sinner)} are skipped", else: Enum.map_join(chosen, ", ", & &1.name))}
                                   class={"btn btn-outline btn-xs w-full min-w-0 flex-nowrap justify-start gap-0.5 px-1 font-normal text-[10px] overflow-hidden " <> if(chosen == [], do: "text-base-content/40", else: "")}>
                                <%= if chosen == [] do %>
                                  <span class="truncate">(no profile)</span>
                                <% else %>
                                  <%= for p <- chosen do %>
                                    <img :if={profile_thumb(p, @locator_thumbs)} src={profile_thumb(p, @locator_thumbs)} class="h-5 w-auto rounded shrink-0" />
                                    <span :if={!profile_thumb(p, @locator_thumbs)} class="truncate"><%= p.name %></span>
                                  <% end %>
                                  <span class="ml-auto min-w-0 truncate pl-1 text-base-content/40">+ add</span>
                                <% end %>
                              </div>
                              <div tabindex="0" class="dropdown-content z-30 mt-1 w-56 rounded-lg border border-base-300 bg-base-100 p-1 shadow-lg">
                                <button :for={p <- Map.get(@profiles_by_sinner, sinner, [])} type="button" data-value={p.id}
                                        onclick="const i = this.closest('.dropdown').querySelector('input'); const v = this.dataset.value; const ids = i.value.split(',').filter(Boolean); const at = ids.indexOf(v); if (at >= 0) ids.splice(at, 1); else ids.push(v); i.value = ids.join(','); i.dispatchEvent(new Event('input', {bubbles: true}))"
                                        class={"btn btn-xs h-auto min-h-7 w-full flex-nowrap justify-start gap-1.5 py-0.5 " <> if(Enum.any?(chosen, &(&1.id == p.id)), do: "btn-primary", else: "btn-ghost")}>
                                  <img :if={profile_thumb(p, @locator_thumbs)} src={profile_thumb(p, @locator_thumbs)} class="h-6 w-auto rounded shrink-0" />
                                  <span class="truncate"><%= p.name %></span>
                                </button>
                              </div>
                            </div>
                          </form>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                  <div class="flex items-center justify-between gap-2 max-w-2xl text-xs">
                    <span class="text-base-content/50">
                      <%= length(lineup["sinners"]) %> picked
                      <%= if length(lineup["sinners"]) > StarlightBot.BattlePlans.front_line_size() do %>
                        (<%= length(lineup["sinners"]) - StarlightBot.BattlePlans.front_line_size() %> backup)
                      <% end %>
                    </span>
                    <button type="button" phx-click="clear_lineup" class="btn btn-xs btn-ghost">Clear</button>
                  </div>
                </div>
              </div>
            <% else %>
              <.lineup_list data={@data} lineup_id={@lineup_id} renaming_lineup_id={@renaming_lineup_id} reorder_rev={@reorder_rev} />
            <% end %>
          </div>
            <div class="order-first ml-auto flex shrink-0 items-center gap-3 lg:order-none">
            <label class="flex items-center gap-1.5 cursor-pointer" title="Show the floors 6-15 columns">
              <input type="checkbox" checked={@extreme?} phx-click="toggle_extreme" class="toggle toggle-sm toggle-primary" />
              <span class={"badge badge-sm font-bold " <> if(@extreme?, do: "badge-primary", else: "badge-ghost text-base-content/50")}>F6-F15</span>
            </label>
            <.template_picker id="battle-template-picker" can_undo={@can_undo} can_redo={@can_redo} templates={@templates} editing={@editing_template} current_count={@tab_counts[:battle_plans]} status={@paste_status} selected={@template_id} plans={@plans} plan_id={@editing_id} editing_plan={@editing_plan} label="battle plan" />
            <button type="button" phx-click="toggle_help" class="btn btn-sm btn-outline gap-0 overflow-hidden px-0" title="How battle plans work">
              <span class="flex h-full items-center border-r border-current/30 bg-base-content/10 px-2 text-xs">guide</span>
              <span class="flex h-full items-center px-2">
                <.icon name="lucide-info" class="size-4" />
              </span>
            </button>
            </div>
          </div>

          <.read_only_banner container="battle-view-memory" allowed={read_only_events()} template_id={@template_id} templates={@templates} label="battle plan" />

          <% lineup_issues = StarlightBot.BattlePlans.lineup_issues(@data) %>
          <div :if={lineup_issues != []} role="alert" class="alert alert-warning alert-soft py-1.5 px-3 text-xs">
            <div class="flex flex-col">
              <span :for={issue <- lineup_issues}><%= issue %></span>
            </div>
          </div>

          <div class="divider my-0"></div>

          <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-3 flex-1 min-h-0">
            <div class="flex flex-col gap-3 self-start lg:max-w-[45vw] min-w-0">
            <div id="playbook-clipboard" phx-hook="ItemClipboard" class="flex w-0 min-w-full flex-col gap-2">
              <%= for kind <- ~w(chain focused) do %>
                <div class="flex flex-col gap-0.5">
                  <div class="flex min-h-8 items-center text-sm font-semibold text-base-content/70">
                    <%= String.capitalize(kind) %> playbooks
                    <button type="button" data-paste-event="paste_playbook" data-kind={kind} title={"Paste a #{kind} playbook from the clipboard"} class="btn btn-xs btn-ghost ml-auto">Paste</button>
                    <button phx-click="new_playbook" phx-value-kind={kind} class="btn btn-xs btn-ghost">+ <%= kind %></button>
                  </div>
                  <div id={"playbooks-#{kind}-#{@reorder_rev}"} phx-hook="SortableList" data-sort-event="reorder_playbooks" data-sort-scope={kind} class="flex flex-col gap-0.5">
                    <%= for pb <- Enum.filter(@data["playbooks"], &(&1["kind"] == kind)) do %>
                      <div id={"playbook-row-#{pb["id"]}"} data-sort-id={pb["id"]} phx-hook="DblClickEvent" data-event="start_rename_playbook" data-id={pb["id"]} title="Double-click to rename" class="group flex items-center">
                        <span data-sort-handle class="cursor-grab text-base-content/40 select-none px-0.5">⠿</span>
                        <%= if @renaming_playbook_id == pb["id"] do %>
                          <form phx-submit="rename_playbook" class="flex flex-1 min-w-0">
                            <input type="text" id={"rename-playbook-#{pb["id"]}"} name="value" value={pb["name"]} phx-blur="rename_playbook"
                                   phx-keydown="cancel_rename_playbook" phx-key="Escape" phx-hook="FocusSelect"
                                   class="input input-bordered input-xs w-full font-semibold" />
                          </form>
                        <% else %>
                          <button phx-click="select_playbook" phx-value-id={pb["id"]}
                                  class={"flex flex-1 min-w-0 items-center gap-1.5 text-left text-xs rounded px-1.5 py-1 hover:bg-base-200 " <> if(@playbook_id == pb["id"], do: "bg-primary/10 border-l-2 border-primary", else: "")}>
                            <span class="inline-block w-5 text-center rounded text-[10px] font-semibold text-white" style={playbook_color(@data, pb["id"], 0.9)}><%= playbook_tag(pb) %></span>
                            <span class="flex-1 truncate"><%= pb["name"] %></span>
                          </button>
                        <% end %>
                        <div class="flex shrink-0 items-center opacity-40 group-hover:opacity-100">
                          <button phx-click="copy_playbook" phx-value-id={pb["id"]} title="Copy this playbook to the clipboard as JSON" class="btn btn-2xs btn-ghost">Copy</button>
                          <button phx-click="delete_playbook" phx-value-id={pb["id"]} data-confirm={"Delete playbook '#{pb["name"]}'?"} title="Delete this playbook" class="btn btn-2xs btn-ghost text-error"><.icon name="lucide-x" class="size-3.5" /></button>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="overflow-x-auto">
              <table style={paint_style(@data, @paint)} class="text-[11px] border-separate border-spacing-0.5">
                <thead>
                  <tr>
                    <th></th>
                    <%= for floor <- floors(@extreme?) do %>
                      <th class="font-normal text-base-content/50 w-8">
                        <button :if={@extreme? and floor == StarlightBot.BattlePlans.max_floor()} type="button" phx-click="toggle_extreme" title="Collapse floors 6-15"
                                class="btn btn-2xs btn-ghost h-4 min-h-4 w-full px-0 text-[11px] font-normal text-base-content/50">F<%= floor %></button>
                        <span :if={not (@extreme? and floor == StarlightBot.BattlePlans.max_floor())}>F<%= floor %></span>
                      </th>
                    <% end %>
                    <%= unless @extreme? do %>
                      <th class="font-normal w-12">
                        <button type="button" phx-click="toggle_extreme" title="Show floors 6-15" class="btn btn-2xs btn-ghost h-4 min-h-4 w-full px-0 text-[11px] font-normal text-base-content/50">F6-F15</button>
                      </th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <%= for track <- StarlightBot.BattlePlans.tracks() do %>
                    <% entries = @data["tracks"][track] %>
                    <% lux? = StarlightBot.BattlePlans.lux_track?(track) %>
                    <tr :if={track == "lux_chain"}>
                      <td colspan="16" class="py-0.5"><div class="h-px"></div></td>
                    </tr>
                    <tr>
                      <td class="w-28 pr-2 whitespace-nowrap text-base-content/70"><%= track_label(track) %></td>
                      <%= for floor <- if(lux?, do: [1], else: floors(@extreme?)) do %>
                        <% id = StarlightBot.BattlePlans.Resolver.playbook_id_at(entries, floor) %>
                        <% start? = change_point?(entries, floor) %>
                        <td>
                          <button phx-click="paint_cell" phx-value-track={track} phx-value-floor={floor}
                                  id={"cell-#{track}-#{floor}"} phx-hook="RightClickEvent" data-event="erase_cell" data-track={track} data-floor={floor}
                                  title={if lux?, do: find_playbook(@data, id)["name"], else: run_tooltip(@data, entries, floor)}
                                  style={playbook_color(@data, id, if(start?, do: 0.9, else: 0.25))}
                                  class={"w-8 h-6 rounded text-[10px] font-semibold " <> if(paintable_track?(@data, @paint, track), do: "cursor-pointer hover:bg-[var(--paint)]! hover:text-white hover:ring-2 hover:ring-base-content/50 ", else: "") <> if(start?, do: "border-l-4 border-base-content/70 text-white", else: "text-base-content/40")}>
                            <%= if start?, do: playbook_tag(find_playbook(@data, id)), else: "··" %>
                          </button>
                        </td>
                      <% end %>
                      <%= if not @extreme? and not lux? do %>
                        <% id = StarlightBot.BattlePlans.Resolver.playbook_id_at(entries, 6) %>
                        <td>
                          <button phx-click="toggle_extreme"
                                  title={run_tooltip(@data, entries, 6) <> if(hidden_change_points?(entries), do: ", more change points above", else: "")}
                                  style={playbook_color(@data, id, if(change_point?(entries, 6), do: 0.9, else: 0.25))}
                                  class="w-12 h-6 rounded text-[10px] font-semibold">
                            <%= playbook_tag(find_playbook(@data, id)) %><%= if hidden_change_points?(entries), do: " •" %>
                          </button>
                        </td>
                      <% end %>
                      <td :if={track == "lux_chain"} rowspan="2" colspan={length(floors(@extreme?)) + if(@extreme?, do: 0, else: 1) - 1} class="text-right align-middle">
                        <button phx-click="set_paint" phx-value-id="erase" title="Remove a change point"
                                class={"btn btn-2xs gap-1 " <> if(@paint == "erase", do: "btn-error", else: "btn-ghost text-error")}><.icon name="lucide-eraser" class="size-3 shrink-0" />eraser</button>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
            </div>

            <div class="flex flex-col gap-2 min-w-0">
              <% playbook = find_playbook(@data, @playbook_id) %>
              <%= if playbook do %>
                <div class="flex items-center gap-2">
                  <input type="text" value={playbook["name"]} phx-blur="rename_playbook"
                         class="input input-bordered input-sm w-56 font-semibold" />
                  <span class="badge badge-sm badge-outline"><%= playbook["kind"] %></span>
                  <form phx-change="set_max_retries" class="flex items-center gap-1 text-xs"
                        title="How many times a lost battle is retried before the run gives up.">
                    <span class="text-base-content/60">Retries per battle</span>
                    <input type="number" name="max_retries" min="0" value={StarlightBot.BattlePlans.max_retries(playbook)}
                           phx-debounce="300" class="input input-bordered input-xs w-16" />
                  </form>
                </div>

                <.action_list container="root" playbook={playbook} sinner_options={sinner_options(@data, @profiles_by_id, @locator_thumbs)} open_editor_id={@open_editor_id}
                              schedule_tabs={@schedule_tabs} reorder_rev={@reorder_rev} />
              <% end %>
              <%= if is_nil(playbook) do %>
                <div class="text-xs text-base-content/40 italic">Select a playbook to edit.</div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="flex-1 flex flex-col gap-2 items-center justify-center text-base-content/40 text-sm">
            This team has no battle plan.
            <button type="button" phx-click="new_plan" class="btn btn-primary btn-sm">+ New battle plan</button>
          </div>
        <% end %>
      </div>
    </div>
  <%= if @show_help do %>
    <div class="modal modal-open" phx-window-keydown="toggle_help" phx-key="Escape">
      <div class="modal-box max-w-3xl max-h-[85vh] flex flex-col gap-3 text-sm">
        <h2 class="font-bold text-base">How battle plans work</h2>
        <div class="overflow-y-auto flex flex-col gap-3 pr-1">
          <section>
            <h4 class="font-semibold mb-1">Three parts</h4>
            <p><span class="font-medium">Lineups</span> choose which sinners fight and in what order. <span class="font-medium">Playbooks</span> choose what the bot does each turn. Both are painted onto a floor grid, so different floors and fights can use different ones.</p>
          </section>
          <section>
            <h4 class="font-semibold mb-1">Lineups</h4>
            <ul class="list-disc pl-5 flex flex-col gap-1">
              <li>Click sinners to add them in order. The first 7 are the front line (red), the rest are backups (blue).</li>
              <li>Pick a profile under each sinner so playbook checks for that sinner can run. Without one, those checks are skipped.</li>
              <li>The grid has a row per venue: MD Battle, MD Boss and Lux. Select a lineup, then click a floor to start it there. It carries on to later floors until the next change point. Cells marked <span class="font-mono text-warning">?</span> have no lineup yet.</li>
              <li>Until every venue has a lineup the bot leaves the in-game sinner order alone.</li>
            </ul>
          </section>
          <section>
            <h4 class="font-semibold mb-1">Playbooks</h4>
            <p>A <span class="font-medium">chain</span> playbook handles chain battles and a <span class="font-medium">focused</span> playbook handles focused battles with a single target. Each has its own set of actions.</p>
            <ul class="mt-1 list-disc pl-5 flex flex-col gap-1">
              <li>Select a playbook in the list, then click cells in the track grid to start it there. Tracks are normal, hard and Lux, each split into chain and focused. It runs until the next change point on that track.</li>
              <li>Right click a cell, or use the eraser, to remove a change point. Drag the handle to reorder playbooks.</li>
              <li><span class="font-medium">Floors 6-15</span> is collapsed into one column. Tick floors 6-15 at the top to paint them individually.</li>
              <li>Copy and Paste move a playbook through the clipboard as JSON. Duplicate makes a copy in place.</li>
            </ul>
          </section>
          <section>
            <h4 class="font-semibold mb-1">Actions</h4>
            <p>Actions run top to bottom and each one handles its slots, so later rows only see what is left. Hover an action name for what it does. <span class="font-medium">If</span> checks a condition once against a fresh frame and runs its then or else actions. <span class="font-medium">Remaining skills</span> at the bottom covers every slot nothing above captured.</p>
          </section>
          <section>
            <h4 class="font-semibold mb-1">Retries</h4>
            <p>Retries per battle is how many times a lost battle is retried before the run gives up. The Retry battle action respects it.</p>
          </section>
        </div>
        <div class="modal-action mt-0">
          <button phx-click="toggle_help" class="btn btn-sm">Close</button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="toggle_help"></div>
    </div>
  <% end %>
</div>
