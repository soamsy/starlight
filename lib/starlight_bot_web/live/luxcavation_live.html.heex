<div class="flex flex-col h-full gap-2 overflow-hidden">

  <%!-- Header --%>
  <div class="flex items-center gap-3 shrink-0">
    <h2 class="text-lg font-semibold">Luxcavation Runner</h2>

    <span class={"#{screen_badge_class(@current_screen)} font-mono"}>
      <%= screen_label(@current_screen) %>
    </span>

    <%= if label = phase_label(@phase) do %>
      <span class={"flex items-center gap-1 text-sm #{if @phase == :paused, do: "text-warning", else: "text-base-content/60"}"}>
        <%= if @phase != :paused do %>
          <span class="loading loading-spinner loading-xs"></span>
        <% end %>
        <%= label %>
      </span>
    <% end %>

    <div class="ml-auto">
      <%= if @phase != :idle do %>
        <button phx-click="cancel" class="btn btn-ghost btn-sm btn-error">Cancel</button>
      <% end %>
    </div>
  </div>

  <%!-- Body --%>
  <div class="flex gap-2 flex-1 min-h-0 overflow-hidden">

    <%!-- Left: form --%>
    <div class="w-80 shrink-0 flex flex-col gap-3 overflow-y-auto">

      <%= if @teams == [] do %>
        <div class="text-xs text-base-content/40 bg-base-200 rounded-xl p-3">
          No teams with a team-select hook configured yet — set one up on the
          <.link navigate={~p"/teams"} class="link">Teams</.link> page first.
        </div>
      <% end %>

      <div class="bg-warning/10 border border-warning/30 rounded-xl p-3 text-xs text-warning">
        Keep the Limbus Company window focused during a run — losing focus
        (alt-tab, clicking elsewhere) pauses it. Click Resume once you're
        back on the game window to continue.
      </div>

      <form
        id="lux-runner-form"
        phx-submit="run"
        phx-change="update_form"
        phx-hook="LocalStorageForm"
        data-storage-key="starlight-lux-runner-form"
        class="flex flex-col gap-3">
        <label class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Team</span>
          <select name="team_id" class="select select-sm select-bordered" disabled={@teams == []}>
            <%= for team <- @teams do %>
              <option value={team.id} selected={team.id == @team_id}><%= team.name %></option>
            <% end %>
          </select>
        </label>

        <div class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Lux Exp</span>
          <div class="flex items-end gap-2">
            <label class="flex flex-col gap-1 flex-1">
              <span class="text-xs text-base-content/40">Consecutive battles</span>
              <input type="number" name="exp_consecutive" min="0" max={max_consecutive()} value={@exp_consecutive}
                     class="input input-sm input-bordered" />
            </label>
            <label class="flex flex-col gap-1 flex-1">
              <span class="text-xs text-base-content/40">Repeats</span>
              <input type="number" name="exp_repeats" min="0" value={@exp_repeats} class="input input-sm input-bordered" />
            </label>
          </div>
          <span class="text-xs text-base-content/50">
            <%= @exp_consecutive %> x <%= @exp_repeats %> = <%= total_runs(@exp_consecutive, @exp_repeats) %> run(s)
          </span>
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Lux Thread</span>
          <div class="flex items-end gap-2">
            <label class="flex flex-col gap-1 flex-1">
              <span class="text-xs text-base-content/40">Consecutive battles</span>
              <input type="number" name="thread_consecutive" min="0" max={max_consecutive()} value={@thread_consecutive}
                     class="input input-sm input-bordered" />
            </label>
            <label class="flex flex-col gap-1 flex-1">
              <span class="text-xs text-base-content/40">Repeats</span>
              <input type="number" name="thread_repeats" min="0" value={@thread_repeats} class="input input-sm input-bordered" />
            </label>
          </div>
          <span class="text-xs text-base-content/50">
            <%= @thread_consecutive %> x <%= @thread_repeats %> = <%= total_runs(@thread_consecutive, @thread_repeats) %> run(s)
          </span>
        </div>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="collect_enkephalin" value="true" checked={@collect_enkephalin}
                 class="checkbox checkbox-sm" />
          <span class="text-sm">Collect enkephalin modules at start</span>
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="collect_xp" value="true" checked={@collect_xp}
                 class="checkbox checkbox-sm" />
          <span class="text-sm">Collect battle pass xp at end</span>
        </label>

        <%= if @collect_enkephalin do %>
          <label class="flex flex-col gap-1">
            <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Lunacy → enkephalin conversions</span>
            <select name="enkephalin_convert_count" class="select select-sm select-bordered">
              <%= for n <- 0..4 do %>
                <option value={n} selected={to_string(n) == to_string(@enkephalin_convert_count)}>
                  <%= n %>x (<%= enkephalin_cumulative_cost(n) %> lunacy)
                </option>
              <% end %>
            </select>
          </label>
        <% end %>

        <%= if @phase == :paused do %>
          <button
            type="button"
            phx-click="resume"
            disabled={@countdown != nil}
            class="btn btn-warning btn-sm">
            Resume
          </button>
        <% else %>
          <button
            type="submit"
            disabled={@teams == [] or @phase != :idle or @countdown != nil}
            class="btn btn-primary btn-sm">
            Run
          </button>
        <% end %>
      </form>

      <%!-- Enkephalin usage summary --%>
      <div class="bg-base-200 rounded-xl p-3 text-xs flex flex-col gap-1 shrink-0">
        <div class="font-semibold text-base-content/50 uppercase tracking-wide">Enkephalin usage</div>
        <div class="flex justify-between">
          <span>Exp (<%= total_runs(@exp_consecutive, @exp_repeats) %> runs x <%= exp_enkephalin_cost() %>)</span>
          <span class="font-mono"><%= enkephalin_modules(total_runs(@exp_consecutive, @exp_repeats), exp_enkephalin_cost()) %></span>
        </div>
        <div class="flex justify-between">
          <span>Thread (<%= total_runs(@thread_consecutive, @thread_repeats) %> runs x <%= thread_enkephalin_cost() %>)</span>
          <span class="font-mono"><%= enkephalin_modules(total_runs(@thread_consecutive, @thread_repeats), thread_enkephalin_cost()) %></span>
        </div>
        <div class="flex justify-between border-t border-base-content/10 pt-1 font-semibold">
          <span>Total modules</span>
          <span class="font-mono">
            <%= enkephalin_modules(total_runs(@exp_consecutive, @exp_repeats), exp_enkephalin_cost()) +
                enkephalin_modules(total_runs(@thread_consecutive, @thread_repeats), thread_enkephalin_cost()) %>
          </span>
        </div>
      </div>

      <%!-- Countdown overlay --%>
      <%= if @countdown do %>
        <div class="bg-warning/10 border border-warning/30 rounded-xl p-3 shrink-0 flex items-center justify-between gap-2">
          <div>
            <div class="text-xs text-warning font-semibold">Focus the game window now</div>
            <div class="font-mono text-sm text-base-content/70"><%= pending_action_label(@pending_action) %></div>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-2xl font-bold text-warning"><%= @countdown %></span>
            <button phx-click="cancel_pending" class="btn btn-ghost btn-xs text-base-content/40">✕</button>
          </div>
        </div>
      <% end %>

    </div>

    <%!-- Right: log --%>
    <div id="luxcavation-log" phx-hook="ScrollToBottom" class="flex-1 min-h-0 overflow-y-auto bg-base-200 rounded-xl p-3 font-mono text-xs flex flex-col gap-0.5">
      <%= if @log == [] do %>
        <div class="text-base-content/30 text-center py-4 select-none">Log empty</div>
      <% else %>
        <%= for entry <- Enum.reverse(@log) do %>
          <div class={"leading-snug #{log_kind_class(entry.kind)}"}>
            <%= entry.text %>
          </div>
        <% end %>
      <% end %>
    </div>

  </div>

</div>
