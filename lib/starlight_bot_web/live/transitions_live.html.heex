<div class="flex flex-col h-full gap-2 overflow-hidden">

  <%!-- Header --%>
  <div class="flex items-center gap-3 shrink-0">
    <h2 class="text-lg font-semibold">Transitions</h2>

    <span class={"#{screen_badge_class(@current_screen)} font-mono"}>
      <%= screen_label(@current_screen) %>
    </span>

    <%= if goal = @goal do %>
      <span class="text-xs text-base-content/40 font-mono">→ <%= goal %></span>
    <% end %>

    <%= if label = phase_label(@phase) do %>
      <span class="flex items-center gap-1 text-sm text-base-content/60">
        <span class="loading loading-spinner loading-xs"></span>
        <%= label %>
      </span>
    <% end %>

    <div class="ml-auto flex gap-2 items-center">

      <%!-- Stream controls --%>
      <button phx-click="toggle_stream"
              class="btn btn-sm btn-ghost btn-square"
              title={if @stream_running, do: "Pause preview", else: "Resume preview"}>
        <%= if @stream_running, do: "⏸", else: "▶" %>
      </button>

      <div class="w-px h-5 bg-base-content/15 mx-1"></div>

      <%= if @phase != :idle do %>
        <button phx-click="cancel" class="btn btn-ghost btn-sm btn-error">Cancel</button>
      <% end %>
      <button phx-click="test_type"
              disabled={@phase != :idle or @countdown != nil}
              title={"Types \"hello\" via keyboard injection, wherever focus currently is"}
              class="btn btn-ghost btn-sm">
        Type "hello"
      </button>
      <button phx-click="localize"
              disabled={@phase != :idle}
              class="btn btn-primary btn-sm">
        Localize
      </button>
    </div>
  </div>

  <%!-- Body --%>
  <div class="flex gap-2 flex-1 min-h-0 overflow-hidden">

    <%!-- Left: frame + log. relative so the floating hook comparison panel anchors here. --%>
    <div class="relative flex flex-col gap-2 flex-1 min-w-0 min-h-0">

      <%!-- Frame --%>
      <div class="shrink-0 bg-base-200 rounded-xl overflow-hidden flex items-center justify-center"
           style="height: 360px;">
        <%= if @frame_b64 do %>
          <img src={"data:image/jpeg;base64,#{@frame_b64}"}
               class="max-w-full max-h-full object-contain" alt="Current frame" />
        <% else %>
          <div class="text-base-content/30 text-sm select-none text-center">
            <p>No frame</p>
          </div>
        <% end %>
      </div>

      <%!-- Floating comparison panel: template vs what the last hook test saw --%>
      <%= if @focused_hook do %>
        <% result = Map.get(@hook_test_results, @focused_hook) %>
        <div class="absolute right-3 top-3 z-50 w-[380px] bg-base-100/95 backdrop-blur-sm rounded-2xl shadow-2xl border border-base-300 p-3 flex flex-col gap-2">

          <div class="flex items-center gap-2 min-w-0">
            <span class="text-sm font-mono font-bold text-primary truncate flex-1" title={@focused_hook}>
              <%= @focused_hook %>
            </span>
            <%= if result do %>
              <span class={"badge badge-sm font-mono #{if result.matched, do: "badge-success", else: "badge-ghost"}"}>
                <%= :erlang.float_to_binary(result.score, [{:decimals, 3}]) %>
              </span>
              <span class={"badge badge-sm #{if result.matched, do: "badge-success badge-outline", else: "badge-ghost"}"}>
                <%= if result.matched, do: "matched", else: "no match" %>
              </span>
            <% end %>
            <button phx-click="clear_focused_hook" class="btn btn-ghost btn-xs shrink-0 text-base-content/40">✕</button>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div class="flex flex-col gap-1">
              <div class="text-xs text-base-content/40 text-center select-none">template</div>
              <%= if result && result.template_b64 do %>
                <img src={"data:image/jpeg;base64,#{result.template_b64}"}
                     class="w-full h-40 object-contain bg-base-200 rounded-xl" />
              <% else %>
                <div class="w-full h-40 bg-base-200 rounded-xl flex items-center justify-center text-xs text-base-content/20 select-none">—</div>
              <% end %>
            </div>
            <div class="flex flex-col gap-1">
              <div class="text-xs text-base-content/40 text-center select-none">seen</div>
              <%= if result && result.actual_b64 do %>
                <img src={"data:image/jpeg;base64,#{result.actual_b64}"}
                     class="w-full h-40 object-contain bg-base-200 rounded-xl" />
              <% else %>
                <div class="w-full h-40 bg-base-200 rounded-xl flex items-center justify-center text-xs text-base-content/20 select-none">—</div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <%!-- Log --%>
      <StarlightBotWeb.Live.LogLive.panel socket={@socket} id="transitions-log" class="flex-1 min-h-0" />

    </div>

    <%!-- Right: transitions panel --%>
    <div class="w-56 shrink-0 flex flex-col gap-2 overflow-hidden">

      <div class="text-xs font-semibold text-base-content/50 uppercase tracking-wide shrink-0">
        Actions
      </div>

      <%!-- Countdown overlay --%>
      <%= if @countdown do %>
        <div class="bg-warning/10 border border-warning/30 rounded-xl p-3 shrink-0 flex items-center justify-between gap-2">
          <div>
            <div class="text-xs text-warning font-semibold">Alt-tab now</div>
            <div class="font-mono text-sm text-base-content/70"><%= pending_action_label(@pending_action) %></div>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-2xl font-bold text-warning"><%= @countdown %></span>
            <button phx-click="cancel_pending" class="btn btn-ghost btn-xs text-base-content/40">✕</button>
          </div>
        </div>
      <% end %>

      <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-1">

        <%= if @current_screen == nil do %>
          <div class="text-xs text-base-content/30 text-center py-8 select-none">
            Click Localize to identify current screen
          </div>

        <% else %>
          <%= if @actions != [] do %>
            <div class="text-xs font-semibold text-base-content/40 uppercase tracking-wide mb-1">
              On this screen
            </div>
            <%= for a <- @actions do %>
              <button
                phx-click="run_action"
                phx-value-name={a.name}
                disabled={@phase != :idle or @countdown != nil}
                title={"Runs in place — doesn't navigate away from #{@current_screen}"}
                class="btn btn-sm btn-outline w-full justify-start font-mono normal-case">
                ⚡ <%= a.name %>
              </button>
            <% end %>
          <% end %>

          <%= if @transitions == [] do %>
            <%= if @actions == [] do %>
              <div class="text-xs text-base-content/30 text-center py-8 select-none">
                No transitions or actions defined for<br/>
                <span class="font-mono"><%= @current_screen %></span>
              </div>
            <% end %>

          <% else %>
            <%= if @actions != [] do %>
              <div class="text-xs font-semibold text-base-content/40 uppercase tracking-wide mt-3 mb-1">
                Go elsewhere
              </div>
            <% end %>
            <%= for t <- @transitions do %>
              <button
                phx-click="run_transition"
                phx-value-name={t.name}
                disabled={@phase != :idle or @countdown != nil}
                class="btn btn-sm btn-outline w-full justify-start font-mono normal-case">
                → <%= t.name %>
              </button>
            <% end %>
          <% end %>

          <%= for {hops, screens} <- @hop_actions do %>
            <div class="text-xs font-semibold text-base-content/40 uppercase tracking-wide mt-3 mb-1">
              <%= hops %> hops away
            </div>
            <%= for screen <- screens do %>
              <button
                phx-click="run_to"
                phx-value-screen={screen}
                disabled={@phase != :idle or @countdown != nil}
                title={"Reachable in #{hops} steps — plans and runs them all automatically"}
                class="btn btn-sm btn-outline w-full justify-start font-mono normal-case opacity-80">
                ⇒ <%= screen %>
              </button>
            <% end %>
          <% end %>
        <% end %>

      </div>

    </div>

    <%!-- Right: hook selector panel --%>
    <div class="w-56 shrink-0 flex flex-col gap-1 overflow-hidden bg-base-200 rounded-xl p-2">

      <div class="flex items-center gap-1 mb-1 shrink-0">
        <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Hooks</span>
        <button phx-click="refresh_hooks" class="btn btn-ghost btn-xs ml-auto" title="Refresh list">⟳</button>
      </div>

      <input
        type="text"
        placeholder="Filter…"
        value={@hook_filter}
        phx-keyup="set_hook_filter"
        phx-debounce="150"
        class="input input-xs input-bordered w-full shrink-0 mb-1" />

      <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-0.5">
        <%= if @all_hooks == [] do %>
          <div class="text-xs text-base-content/30 text-center py-6 select-none">
            No hooks saved yet
          </div>
        <% else %>
          <%= for hook <- filtered_hooks(@all_hooks, @hook_filter) do %>
            <% result = Map.get(@hook_test_results, hook.name) %>
            <button
              phx-click="test_hook"
              phx-value-name={hook.name}
              class={"flex items-center gap-1.5 w-full px-2 py-1.5 rounded text-left transition-colors #{hook_row_class(result)} #{if @focused_hook == hook.name, do: "ring-1 ring-primary"}"}>
              <span class="text-xs font-mono truncate flex-1"><%= hook.name %></span>
              <%= if result do %>
                <span class={"text-xs font-mono #{if result.matched, do: "text-success", else: "text-error"}"}>
                  <%= if result.matched, do: "✓", else: "✗" %>
                </span>
              <% end %>
            </button>
          <% end %>
        <% end %>
      </div>

    </div>

    <%!-- Right: scripts panel --%>
    <div class="w-56 shrink-0 flex flex-col gap-1 overflow-hidden bg-base-200 rounded-xl p-2">

      <div class="flex items-center gap-1 mb-1 shrink-0">
        <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Scripts</span>
      </div>

      <div class="flex-1 min-h-0 overflow-y-auto flex flex-col gap-1">
        <%= if @scripts == [] do %>
          <div class="text-xs text-base-content/30 text-center py-6 select-none">
            No scripts registered
          </div>
        <% else %>
          <%= for script <- @scripts do %>
            <button
              phx-click="run_script"
              phx-value-name={script.name}
              disabled={@phase != :idle or @countdown != nil}
              title="Scripts localize and check their own preconditions — safe to run from any screen"
              class="btn btn-sm btn-outline w-full justify-start normal-case">
              ▶ <%= script.label %>
            </button>
          <% end %>
        <% end %>
      </div>

    </div>

  </div>

</div>
