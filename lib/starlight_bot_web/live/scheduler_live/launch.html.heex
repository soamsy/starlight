<form id="scheduler-launch-form" phx-submit="update_form" phx-change="update_form" class="flex flex-col gap-3">
  <StarlightBotWeb.Components.LaunchFields.launch_fields
    launch_mode={@form["launch_mode"]}
    steam_app_id={@form["steam_app_id"]}
    exe_path={@form["exe_path"]}
    launch_timeout_s={@form["launch_timeout_s"]}
    reset_event="reset_steam_app_id"
    launcher={@game_launcher}
    gamescope_resolution={@gamescope_resolution}
    gamescope_flags={@gamescope_flags}
    requirements={StarlightBot.LauncherDeps.requirements(@game_launcher, @form["launch_mode"])}
  />

  <span :if={@save_error} class="text-xs text-error">Not saved: {@save_error}</span>
</form>

<div class="divider my-5"></div>

<div class="flex flex-wrap items-start gap-6">
  <form phx-change="cursor_speed_set" class="flex min-w-60 flex-1 flex-col gap-1">
    <span class="flex items-baseline justify-between">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Cursor speed</span>
      <span class="font-mono text-xs">{:erlang.float_to_binary(@cursor_speed, decimals: 2)}x</span>
    </span>
    <input type="range" name="cursor_speed" min="0.2" max="2.0" step="0.05" value={@cursor_speed} class="range range-sm range-primary" />
  </form>
  <form phx-change="hesitation_mult_set" class="flex min-w-60 flex-1 flex-col gap-1">
    <span class="flex items-baseline justify-between">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Hesitation duration</span>
      <span class="font-mono text-xs">{:erlang.float_to_binary(@hesitation_mult, decimals: 2)}x</span>
    </span>
    <input type="range" name="hesitation_mult" min="0.5" max="2.0" step="0.05" value={@hesitation_mult} class="range range-sm range-primary" />
  </form>
</div>
