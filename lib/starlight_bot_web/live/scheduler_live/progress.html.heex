<div class="flex flex-col gap-1 text-sm">
  <% rows = for {_label, _done, target, _unit, _cost} = row <- progress_rows(@settings, @progress), target > 0, do: row %>
  <span :if={!@settings.enabled} class="py-4 text-center text-sm text-base-content/50">Enable runners to track today's progress</span>
  <div :if={@settings.enabled} class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1.5">
    <%= for {label, done, target, unit, cost} <- rows do %>
      <span class={["badge badge-sm font-semibold", term_badge_class(label)]}>{label}</span>
      <div class="flex flex-col gap-0.5">
        <progress class="progress progress-success" value={min(done, target)} max={target}></progress>
        <span class="font-mono text-xs text-base-content/60">{done} / {target} {unit}</span>
      </div>
      <span class="flex items-center justify-end gap-1 font-mono">
        <span class="text-base-content/60">{done * cost} /</span> {target * cost}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
      </span>
    <% end %>
    <%= if rows != [] do %>
      <% net = modules_net(rows, @charger, @convert_count) %>
      <span class="col-span-2 border-t border-base-content/10 pt-1 font-semibold">Modules spent</span>
      <span class="flex items-center justify-end gap-1 border-t border-base-content/10 pt-1 font-mono font-semibold">
        <span class="font-normal text-base-content/60">{progress_modules(rows, :done)} /</span> {progress_modules(rows, :target)}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
      </span>
      <span class="col-span-2 flex items-center gap-2">
        <span class="badge badge-sm badge-success badge-soft font-semibold">CHARGE</span>
        <span :if={!@charger.enabled} class="badge badge-sm badge-warning gap-1 font-semibold">turn on the enkephalin scheduler</span>
      </span>
      <span class={["flex items-center justify-end gap-1 font-mono", !@charger.enabled && "text-base-content/30 line-through"]}>
        +{charge_modules()}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class={["h-4 w-4", !@charger.enabled && "opacity-30"]} />
      </span>
      <%= if @convert_count > 0 do %>
        <span class="col-span-2 flex items-center gap-2">
          <span class="badge badge-sm badge-accent badge-soft font-semibold">LUNACY</span>
          <span class="font-mono text-xs text-base-content/60">{@convert_count}x conversion</span>
        </span>
        <span class="flex items-center justify-end gap-1 font-mono">
          ~+{lunacy_modules(@convert_count)}
          <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
        </span>
      <% end %>
      <span class="col-span-2 border-t border-base-content/10 pt-1 font-semibold">
        {if net >= 0, do: "Daily surplus", else: "Daily deficit"}
      </span>
      <span class={["flex items-center justify-end gap-1 border-t border-base-content/10 pt-1 font-mono font-semibold", if(net >= 0, do: "text-success", else: "text-error")]}>
        <span :if={@convert_count > 0}>~</span>{signed(net)}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
      </span>
    <% end %>
  </div>
  <span :if={@settings.enabled && rows == []} class="text-xs text-base-content/50">No daily targets set</span>
  <div :if={@settings.enabled || @charger.enabled} class="flex items-end justify-between gap-3 text-xs">
    <span :if={@charger.enabled} class="text-base-content/60">Enkephalin {StarlightBotWeb.Layouts.last_charged_label(@charger.last_converted_at, @now)}</span>
    <span :if={!@charger.enabled}></span>
    <StarlightBotWeb.Components.SchedulerControls.scheduler_controls blocked={@blocked} section={:hold} />
  </div>
  <%= if @activity do %>
    <span class="flex items-center gap-1 text-xs text-base-content/60">
      <span class="loading loading-spinner loading-xs"></span>
      <%= @activity %>
    </span>
  <% end %>
</div>
