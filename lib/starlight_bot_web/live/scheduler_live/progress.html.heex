<div class="flex flex-col gap-1 bg-base-200 rounded-xl p-3 text-sm">
  <% rows = for {_label, _done, target, _unit, _cost} = row <- progress_rows(@settings, @progress), target > 0, do: row %>
  <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Today's progress</span>
  <span :if={!@settings.enabled} class="py-4 text-center text-sm text-base-content/50">Enable runners to track today's progress</span>
  <div :if={@settings.enabled} class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1.5">
    <%= for {label, done, target, unit, cost} <- rows do %>
      <span class={["badge badge-sm font-semibold", term_badge_class(label)]}>{label}</span>
      <div class="flex flex-col gap-0.5">
        <progress class="progress progress-success" value={min(done, target)} max={target}></progress>
        <span class="font-mono text-xs text-base-content/60">{done} / {target} {unit}</span>
      </div>
      <span class="flex items-center justify-end gap-1 font-mono">
        <span class="text-base-content/60">{done * cost} /</span> {target * cost}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
      </span>
    <% end %>
    <%= if rows != [] do %>
      <span class="col-span-2 border-t border-base-content/10 pt-1 font-semibold">Modules spent</span>
      <span class="flex items-center justify-end gap-1 border-t border-base-content/10 pt-1 font-mono font-semibold">
        <span class="font-normal text-base-content/60">{progress_modules(rows, :done)} /</span> {progress_modules(rows, :target)}
        <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
      </span>
    <% end %>
  </div>
  <span :if={@settings.enabled && rows == []} class="text-xs text-base-content/50">No daily targets set</span>
  <span :if={@charger.enabled} class="text-xs text-base-content/60">Enkephalin {StarlightBotWeb.Layouts.last_charged_label(@charger.last_converted_at, @now)}</span>
  <span class="text-xs text-base-content/70 text-right">{@outlook}</span>
  <div :if={@settings.enabled || @charger.enabled} class="text-xs"><StarlightBotWeb.Components.SchedulerControls.scheduler_controls blocked={@blocked} /></div>
  <%= if @retry_after_ms && !@blocked do %>
    <span class="text-xs text-warning">Retrying in <%= div(@retry_after_ms, 60_000) + 1 %> min</span>
  <% end %>
  <%= if @activity do %>
    <span class="flex items-center gap-1 text-xs text-base-content/60">
      <span class="loading loading-spinner loading-xs"></span>
      <%= @activity %>
    </span>
  <% end %>
</div>
