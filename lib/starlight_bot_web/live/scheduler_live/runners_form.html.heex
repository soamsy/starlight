<form id="scheduler-form" phx-submit="update_form" phx-change="update_form" class="flex flex-col gap-3">
  <div class="flex flex-col gap-1">
    <div class="grid grid-cols-3 gap-2">
      <label class="join w-full" title="EXP waves">
        <span class="join-item flex items-center justify-center px-2 bg-info text-info-content text-xs font-semibold"><img src={~p"/images/icons/exp.webp"} alt="EXP" class="size-5" /></span>
        <span class="input input-sm input-bordered join-item flex w-full min-w-0 items-center gap-1"><input type="number" min="0" name="exp_waves" phx-debounce="500" value={@form["exp_waves"]} class="grow min-w-0 w-full" /><span class="whitespace-nowrap text-base-content/40">waves</span></span>
      </label>
      <label class="join w-full" title="Thread waves">
        <span class="join-item flex items-center justify-center px-2 bg-secondary text-secondary-content text-xs font-semibold"><img src={~p"/images/icons/thread.webp"} alt="Thread" class="size-5" /></span>
        <span class="input input-sm input-bordered join-item flex w-full min-w-0 items-center gap-1"><input type="number" min="0" name="thread_waves" phx-debounce="500" value={@form["thread_waves"]} class="grow min-w-0 w-full" /><span class="whitespace-nowrap text-base-content/40">waves</span></span>
      </label>
      <label class="join w-full" title="MD runs">
        <span class="join-item flex items-center justify-center px-2 bg-primary text-primary-content text-xs font-semibold">MD</span>
        <span class="input input-sm input-bordered join-item flex w-full min-w-0 items-center gap-1"><input type="number" min="0" name="md_runs" phx-debounce="500" value={@form["md_runs"]} class="grow min-w-0 w-full" /><span class="whitespace-nowrap text-base-content/40">runs</span></span>
      </label>
    </div>
  </div>

  <div class="flex flex-col gap-1">
    <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
      Daily window
      <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="While the game isn't mid-run, runs start inside this window until the day's targets are done. A game day resets at 9 PM UTC.">
        <.icon name="lucide-info" class="size-3.5 cursor-help" />
      </span>
    </span>
    <div class="flex items-center gap-2">
      <label class="input input-sm input-bordered flex flex-1 min-w-0 items-center gap-1">
        <input type="time" name="window_start" phx-debounce="500" value={@form["window_start"]} class="grow min-w-0" />
        <span :if={latest_start_label(@form)} class="whitespace-nowrap text-base-content/40">~ {latest_start_label(@form)}</span>
        <span :if={latest_start_label(@form)} class="tooltip tooltip-top normal-case before:w-64 before:whitespace-normal before:text-left" data-tip="The window start shifts later by up to 15 minutes each day, so runs don't begin at exactly the same time.">
          <.icon name="lucide-info" class="size-3.5 cursor-help text-base-content/40" />
        </span>
      </label>
      <span class="text-base-content/40">to</span>
      <input type="time" name="window_end" phx-debounce="500" value={@form["window_end"]} class="input input-sm input-bordered flex-1 min-w-0" />
    </div>
  </div>

  <% timeline = timeline(@form, @now, @blocked) %>
  <%= if timeline do %>
    <div class="flex flex-col gap-1">
      <div id="window-drag-runners" phx-hook="WindowDrag" data-start={String.slice(@form["window_start"], 0, 5)} data-end={String.slice(@form["window_end"], 0, 5)} class="relative h-6 rounded bg-base-200 touch-none select-none">
        <%= for {from, to} <- timeline.windows do %>
          <div data-window class="absolute inset-y-0 bg-success/20 tooltip" style={"left: #{from / 14.4}%; width: #{(to - from) / 14.4}%"} data-tip={"Window #{String.slice(@form["window_start"], 0, 5)} to #{String.slice(@form["window_end"], 0, 5)}"}></div>
        <% end %>
        <% {span_from, span_to} = timeline.start_span %>
        <div class="absolute inset-y-0 bg-success/50 tooltip" style={"left: #{span_from / 14.4}%; width: #{(span_to - span_from) / 14.4}%"} data-tip={"Start shifts between #{timeline_clock(span_from)} and #{timeline_clock(rem(span_to, 1440))}"}></div>
        <%= if timeline.blocked do %>
          <% {block_from, block_to} = timeline.blocked %>
          <div class="absolute inset-y-0 bg-warning/40 tooltip" style={"left: #{block_from / 14.4}%; width: #{max(block_to - block_from, 0) / 14.4}%"} data-tip={"Held until #{timeline_clock(rem(block_to, 1440))}"}></div>
        <% end %>
        <div class="absolute inset-y-1 w-1 -ml-0.5 rounded-full bg-success tooltip" style={"left: #{timeline.planned / 14.4}%"} data-tip={"Today's start #{timeline_clock(timeline.planned)}"}></div>
        <div class="absolute inset-y-0 w-px border-l border-dashed border-base-content/40 tooltip" style={"left: #{timeline.reset / 14.4}%"} data-tip={"Game day resets #{timeline_clock(timeline.reset)} (9 PM UTC)"}></div>
        <div data-handle="start" class="absolute -inset-y-0.5 z-10 w-2 -ml-1 cursor-ew-resize rounded bg-success/70 hover:bg-success"></div>
        <div data-handle="end" class="absolute -inset-y-0.5 z-10 w-2 -ml-1 cursor-ew-resize rounded bg-success/70 hover:bg-success"></div>
        <div class="absolute -inset-y-0.5 w-0.5 -ml-px bg-primary tooltip" style={"left: #{timeline.now / 14.4}%"} data-tip={"Now #{timeline_clock(timeline.now)}"}></div>
      </div>
      <div class="relative h-3 text-[10px] text-base-content/50 font-mono">
        <%= for hour <- [0, 6, 12, 18, 24] do %>
          <span class={["absolute", hour == 24 && "-translate-x-full", hour not in [0, 24] && "-translate-x-1/2"]} style={"left: #{hour / 0.24}%"}>{String.pad_leading(to_string(hour), 2, "0")}:00</span>
        <% end %>
      </div>
    </div>
  <% end %>

  <label class="flex cursor-pointer items-center gap-2 text-sm">
    <input type="hidden" name="close_game_when_done" value="false" />
    <input type="checkbox" name="close_game_when_done" value="true" checked={@form["close_game_when_done"] == "true"} class="toggle toggle-sm toggle-primary" />
    <span>Close Limbus when goals are met</span>
  </label>

  <span :if={@save_error} class="text-xs text-error">Not saved: {@save_error}</span>
</form>
