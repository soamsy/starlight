<div :if={@outlook} class={["alert mb-4 flex items-center justify-between gap-3 px-3 py-2 text-sm", if(@blocked, do: "alert-warning", else: "alert-info")]}>
  <span class="min-w-0 flex-1 font-medium">{@outlook}</span>
  <div :if={@settings.enabled || @charger.enabled} class="shrink-0 text-xs"><StarlightBotWeb.Components.SchedulerControls.scheduler_controls blocked={@blocked} pending={@pending} starting={@activity != nil} section={:start} /></div>
</div>
