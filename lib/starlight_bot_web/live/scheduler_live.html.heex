<div class="flex flex-col gap-3">
  <div class="flex flex-col gap-1 bg-base-200 rounded-xl p-3 text-sm">
    <% rows = for {_label, _done, target, _unit, _cost} = row <- progress_rows(@settings, @progress), target > 0, do: row %>
    <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Today's progress</span>
    <div class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1.5">
      <%= for {label, done, target, unit, cost} <- rows do %>
        <span class={["badge badge-sm font-semibold", term_badge_class(label)]}>{label}</span>
        <div class="flex flex-col gap-0.5">
          <progress class="progress progress-success" value={min(done, target)} max={target}></progress>
          <span class="font-mono text-xs text-base-content/60">{done} / {target} {unit}</span>
        </div>
        <span class="flex items-center justify-end gap-1 font-mono">
          <span class="text-base-content/60">{done * cost} /</span> {target * cost}
          <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
        </span>
      <% end %>
      <%= if rows != [] do %>
        <span class="col-span-2 border-t border-base-content/10 pt-1 font-semibold">Modules spent</span>
        <span class="flex items-center justify-end gap-1 border-t border-base-content/10 pt-1 font-mono font-semibold">
          <span class="font-normal text-base-content/60">{progress_modules(rows, :done)} /</span> {progress_modules(rows, :target)}
          <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
        </span>
      <% end %>
    </div>
    <span :if={rows == []} class="text-xs text-base-content/50">No daily targets set</span>
    <span class="text-xs text-base-content/70 text-right">{@outlook}</span>
    <%= if @retry_after_ms do %>
      <span class="text-xs text-warning">Retrying in <%= div(@retry_after_ms, 60_000) + 1 %> min</span>
    <% end %>
    <%= if @activity do %>
      <span class="flex items-center gap-1 text-xs text-base-content/60">
        <span class="loading loading-spinner loading-xs"></span>
        <%= @activity %>
      </span>
    <% end %>
  </div>

  <form id="scheduler-form" phx-submit="update_form" phx-change="update_form" class="flex flex-col gap-3">
    <label class="flex items-center gap-2">
      <input type="checkbox" name="enabled" value="true" checked={@form["enabled"] == "true"} class="toggle toggle-sm toggle-success" />
      <span class="text-sm">Enabled</span>
    </label>

    <div class="flex flex-col gap-1">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Daily targets</span>
      <div class="grid grid-cols-3 gap-2">
        <label class="flex flex-col gap-0.5">
          <span class="text-xs text-base-content/60">EXP waves</span>
          <input type="number" min="0" name="exp_waves" phx-debounce="500" value={@form["exp_waves"]} class="input input-sm input-bordered w-full" />
        </label>
        <label class="flex flex-col gap-0.5">
          <span class="text-xs text-base-content/60">Thread waves</span>
          <input type="number" min="0" name="thread_waves" phx-debounce="500" value={@form["thread_waves"]} class="input input-sm input-bordered w-full" />
        </label>
        <label class="flex flex-col gap-0.5">
          <span class="text-xs text-base-content/60">MD runs</span>
          <input type="number" min="0" name="md_runs" phx-debounce="500" value={@form["md_runs"]} class="input input-sm input-bordered w-full" />
        </label>
      </div>
    </div>

    <div class="flex flex-col gap-1">
      <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
        Daily window
        <span class="tooltip tooltip-right normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="While the game isn't mid-run, runs start inside this window until the day's targets are done. A game day resets at 9 PM UTC.">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 cursor-help">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
          </svg>
        </span>
      </span>
      <div class="flex items-center gap-2">
        <label class="input input-sm input-bordered flex flex-1 min-w-0 items-center gap-1">
          <input type="time" name="window_start" phx-debounce="500" value={@form["window_start"]} class="grow min-w-0" />
          <span :if={latest_start_label(@form)} class="whitespace-nowrap text-base-content/40">- {latest_start_label(@form)}</span>
          <span :if={latest_start_label(@form)} class="tooltip tooltip-top normal-case before:w-64 before:whitespace-normal before:text-left" data-tip="The window start shifts later by up to 15 minutes each day, so runs don't begin at exactly the same time.">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 cursor-help text-base-content/40">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
          </span>
        </label>
        <span class="text-base-content/40">to</span>
        <input type="time" name="window_end" phx-debounce="500" value={@form["window_end"]} class="input input-sm input-bordered flex-1 min-w-0" />
      </div>
    </div>

    <% timeline = timeline(@form, @now, @blocked) %>
    <%= if timeline do %>
      <div class="flex flex-col gap-1">
        <div class="relative h-6 rounded bg-base-200">
          <%= for {from, to} <- timeline.windows do %>
            <div class="absolute inset-y-0 bg-success/20" style={"left: #{from / 14.4}%; width: #{(to - from) / 14.4}%"}></div>
          <% end %>
          <% {span_from, span_to} = timeline.start_span %>
          <div class="absolute inset-y-0 bg-success/50 tooltip" style={"left: #{span_from / 14.4}%; width: #{(span_to - span_from) / 14.4}%"} data-tip={"Start shifts between #{timeline_clock(span_from)} and #{timeline_clock(rem(span_to, 1440))}"}></div>
          <%= if timeline.blocked do %>
            <% {block_from, block_to} = timeline.blocked %>
            <div class="absolute inset-y-0 bg-warning/40 tooltip" style={"left: #{block_from / 14.4}%; width: #{max(block_to - block_from, 0) / 14.4}%"} data-tip={"Held until #{timeline_clock(rem(block_to, 1440))}"}></div>
          <% end %>
          <div class="absolute inset-y-1 w-1 -ml-0.5 rounded-full bg-success tooltip" style={"left: #{timeline.planned / 14.4}%"} data-tip={"Today's start #{timeline_clock(timeline.planned)}"}></div>
          <div class="absolute inset-y-0 w-px border-l border-dashed border-base-content/40 tooltip" style={"left: #{timeline.reset / 14.4}%"} data-tip={"Game day resets #{timeline_clock(timeline.reset)} (9 PM UTC)"}></div>
          <div class="absolute -inset-y-0.5 w-0.5 -ml-px bg-primary tooltip" style={"left: #{timeline.now / 14.4}%"} data-tip={"Now #{timeline_clock(timeline.now)}"}></div>
        </div>
        <div class="relative h-3 text-[10px] text-base-content/50 font-mono">
          <%= for hour <- [0, 6, 12, 18, 24] do %>
            <span class={["absolute", hour == 24 && "-translate-x-full", hour not in [0, 24] && "-translate-x-1/2"]} style={"left: #{hour / 0.24}%"}>{String.pad_leading(to_string(hour), 2, "0")}:00</span>
          <% end %>
        </div>
        <span class="text-xs text-base-content/60">Window {String.slice(@form["window_start"], 0, 5)} to {String.slice(@form["window_end"], 0, 5)}, today's start {timeline_clock(timeline.planned)}, game day resets {timeline_clock(timeline.reset)}</span>
      </div>
    <% end %>

    <StarlightBotWeb.Components.LaunchFields.launch_fields
      launch_mode={@form["launch_mode"]}
      steam_app_id={@form["steam_app_id"]}
      exe_path={@form["exe_path"]}
      launch_timeout_s={@form["launch_timeout_s"]}
      reset_event="reset_steam_app_id"
    />

    <span :if={@save_error} class="text-xs text-error">Not saved: {@save_error}</span>
  </form>
</div>
