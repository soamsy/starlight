<div class="flex flex-col gap-3">
  <div class="flex flex-col gap-1 bg-base-200 rounded-xl p-3 text-sm">
    <span><%= plan_label(@now, @settings) %></span>
    <%= if @settings.last_fired_on do %>
      <span class="text-xs text-base-content/50">Last scheduled run started on <%= @settings.last_fired_on %></span>
    <% end %>
    <%= if @retry_after_ms do %>
      <span class="text-xs text-warning">Retrying in <%= div(@retry_after_ms, 60_000) + 1 %> min</span>
    <% end %>
    <%= if @activity do %>
      <span class="flex items-center gap-1 text-xs text-base-content/60">
        <span class="loading loading-spinner loading-xs"></span>
        <%= @activity %>
      </span>
    <% end %>
  </div>

  <form id="scheduler-form" phx-submit="update_form" phx-change="update_form" class="flex flex-col gap-3">
    <label class="flex items-center gap-2">
      <input type="checkbox" name="enabled" value="true" checked={@form["enabled"] == "true"} class="toggle toggle-sm toggle-success" />
      <span class="text-sm">Enabled</span>
    </label>

    <div class="flex items-end gap-3">
      <div class="flex flex-col gap-1">
        <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Runner</span>
        <div class="join">
          <input type="radio" name="runner" value="luxcavation" aria-label="LUX" checked={@form["runner"] == "luxcavation"} class="join-item btn btn-sm" />
          <input type="radio" name="runner" value="mirror_dungeon" aria-label="MD" checked={@form["runner"] == "mirror_dungeon"} class="join-item btn btn-sm" />
        </div>
      </div>

      <div class="flex flex-col gap-1 flex-1">
        <span class="flex items-center gap-1 text-xs font-semibold text-base-content/50 uppercase tracking-wide">
          Daily window
          <span class="tooltip tooltip-bottom normal-case font-normal before:w-64 before:whitespace-normal before:text-left" data-tip="Starts at a random time in the first half of the window, once a day. An end before the start runs past midnight.">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 cursor-help">
              <circle cx="12" cy="12" r="10" />
              <path d="M12 16v-4" />
              <path d="M12 8h.01" />
            </svg>
          </span>
        </span>
        <div class="flex items-center gap-2">
          <input type="time" name="window_start" phx-debounce="500" value={@form["window_start"]} class="input input-sm input-bordered flex-1 min-w-0" />
          <span class="text-base-content/40">to</span>
          <input type="time" name="window_end" phx-debounce="500" value={@form["window_end"]} class="input input-sm input-bordered flex-1 min-w-0" />
        </div>
      </div>
    </div>

    <% terms = module_terms(@form["runner"], @lux_action, @md_action, @lux_then_md?) %>
    <div class="flex flex-col gap-1.5 bg-base-200 rounded-xl p-3 text-sm">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Enkephalin per scheduled run</span>
      <%= if terms do %>
        <div class="grid grid-cols-[auto_1fr_auto] items-center gap-x-3 gap-y-1">
          <%= for {label, runs, cost} <- terms do %>
            <span class={["badge badge-sm font-semibold", term_badge_class(label)]}>{label}</span>
            <span class="font-mono text-base-content/60">{runs} × {cost}</span>
            <span class="flex items-center justify-end gap-1 font-mono">
              {runs * cost}
              <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
            </span>
          <% end %>
          <span class="col-span-2 border-t border-base-content/10 pt-1 font-semibold">Total</span>
          <span class="flex items-center justify-end gap-1 border-t border-base-content/10 pt-1 font-mono font-semibold">
            {modules_total(terms)}
            <img src={~p"/images/icons/enkephalin.webp"} alt="modules" class="h-4 w-4" />
          </span>
        </div>
      <% else %>
        <span class="text-warning text-xs">Runner isn't set up yet</span>
      <% end %>
    </div>


    <div class="flex flex-wrap items-end gap-3">
    <label class="flex flex-col gap-1">
      <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">If Limbus isn't open</span>
      <select name="launch_mode" class="select select-sm select-bordered">
        <option value="steam" selected={@form["launch_mode"] == "steam"}>Launch through Steam</option>
        <option value="exe" selected={@form["launch_mode"] == "exe"}>Launch an executable</option>
        <option value="none" selected={@form["launch_mode"] == "none"}>Don't launch, wait for it</option>
      </select>
    </label>

    <%= if @form["launch_mode"] == "steam" do %>
      <label class="flex flex-col gap-1">
        <span class="text-xs text-base-content/40">Steam app id</span>
        <div class="flex items-center gap-1">
          <input type="text" name="steam_app_id" phx-debounce="500" value={@form["steam_app_id"]} class="input input-sm input-bordered font-mono w-24" />
          <button type="button" phx-click="reset_steam_app_id" disabled={@form["steam_app_id"] == Scheduler.default_steam_app_id()} class="tooltip tooltip-left btn btn-ghost btn-square btn-sm text-base-content/60" data-tip="Reset to default">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
              <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
              <path d="M21 3v5h-5" />
              <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
              <path d="M8 16H3v5" />
            </svg>
          </button>
        </div>
      </label>
    <% else %>
      <input type="hidden" name="steam_app_id" value={@form["steam_app_id"]} />
    <% end %>

    <%= if @form["launch_mode"] == "exe" do %>
      <label class="flex flex-col gap-1">
        <span class="text-xs text-base-content/40">Executable path</span>
        <input type="text" name="exe_path" phx-debounce="500" value={@form["exe_path"]} class="input input-sm input-bordered font-mono" />
      </label>
    <% else %>
      <input type="hidden" name="exe_path" value={@form["exe_path"]} />
    <% end %>

    <label class="flex flex-col gap-1">
      <span class="text-xs text-base-content/40">Launch timeout (seconds)</span>
      <input type="number" name="launch_timeout_s" phx-debounce="500" min="1" value={@form["launch_timeout_s"]} class="input input-sm input-bordered w-24" />
    </label>
    </div>

    <span :if={@save_error} class="text-xs text-error">Not saved: {@save_error}</span>
  </form>
</div>
