<div class="flex flex-col h-full min-h-0 gap-2 overflow-hidden">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 shrink-0">
    <h2 :if={not @embedded?} class="text-lg font-semibold">Log</h2>
    <span id={"#{@lines_dom_id}-count"} phx-update="ignore" class="badge badge-ghost badge-sm font-mono">0 lines</span>

    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" class="toggle toggle-xs" checked={@show_steps} phx-click="toggle_steps" /> steps
    </label>
    <label class="flex items-center gap-1.5 text-sm cursor-pointer select-none">
      <input type="checkbox" class="toggle toggle-xs toggle-error" checked={@errors_only} phx-click="toggle_errors" /> errors only
    </label>

    <form :if={not @embedded?} phx-change="select_log">
      <select name="path" class="select select-xs font-mono">
        <option value="" selected={@viewing == nil}>current session</option>
        <option :for={path <- @log_files} :if={path != @file_path} value={path} selected={path == @viewing}>{log_label(path)}</option>
      </select>
    </form>

    <%= if @machine_filter do %>
      <span class="badge badge-primary badge-outline gap-1 font-mono max-w-xs">
        <span class="truncate">only {@machine_filter_label}</span>
        <button class="hover:text-error" phx-click="clear_machine_filter" title="Show every machine"><.icon name="lucide-x" class="size-3.5" /></button>
      </span>
    <% end %>

    <span :if={not @embedded?} class="ml-auto text-xs text-base-content/50 font-mono select-all truncate">
      <%= if @viewing || @file_path do %>
        {@viewing || @file_path}
      <% else %>
        not writing to a file
      <% end %>
    </span>
  </div>

  <details id={"#{@lines_dom_id}-machines"} phx-mounted={JS.ignore_attributes("open")} class="shrink-0 bg-base-200 rounded-xl px-3 py-1.5 text-xs">
    <summary class="cursor-pointer select-none font-mono truncate">
      <span class="text-base-content/50">machines ({length(@machines)}):</span> {machine_summary(@machines)}
    </summary>
    <div class="flex flex-col gap-0.5 pt-1.5 font-mono">
      <button
        :for={row <- @machines}
        class={"flex items-center gap-2 text-left rounded px-1 hover:bg-base-300 #{if row.pid == @machine_filter, do: "bg-base-300"}"}
        style={"padding-left: #{0.25 + row.depth * 1.25}rem"}
        phx-click="filter_machine"
        phx-value-pid={pid_text(row.pid)}
        title="Show only this machine's lines"
      >
        <span class={"badge badge-xs #{machine_state_class(row.state)}"}>{row.state}</span>
        <span :if={row.label} class="text-base-content/50">{row.label}</span>
        <span class="truncate">{row.current}</span>
        <span :if={row.waiting} class="text-base-content/60 truncate">{row.waiting}</span>
        <span class="ml-auto text-base-content/40 shrink-0">{row.remaining} queued</span>
      </button>
    </div>
  </details>

  <%= if not @embedded? and trimmed?(@oldest_seq) do %>
    <div class="text-xs text-base-content/50 shrink-0">
      Only the last {@memory_limit} lines are kept in memory. Older lines are in the log file.
    </div>
  <% end %>

  <div class="relative flex-1 min-h-0 rounded-xl overflow-hidden">
  <div class="log-pane opacity-92 absolute inset-0 rounded-xl pointer-events-none"></div>
  <div id={@lines_dom_id} phx-hook="LogVirtual" class="relative h-full"
       data-count-id={"#{@lines_dom_id}-count"}
       data-show-steps={to_string(@show_steps)}
       data-errors-only={to_string(@errors_only)}
       data-machine={@machine_filter && pid_text(@machine_filter)}>
    <div id={"#{@lines_dom_id}-scroll"} phx-update="ignore" class="relative h-full overflow-y-auto px-2 font-mono text-xs"></div>
  </div>
  </div>
</div>
