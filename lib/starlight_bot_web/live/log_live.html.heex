<div class="flex flex-col h-full gap-2 overflow-hidden">
  <div class="flex items-center gap-3 shrink-0">
    <h2 class="text-lg font-semibold">Log</h2>
    <span class="badge badge-ghost font-mono">{@shown} lines shown</span>
    <%= if older_available?(@oldest_seq) do %>
      <button class="btn btn-xs" phx-click="load_older">Load older</button>
    <% end %>
    <span class="ml-auto text-xs text-base-content/50 font-mono select-all">
      <%= if @file_path do %>
        {@file_path}
      <% else %>
        not writing to a file
      <% end %>
    </span>
  </div>

  <%= if trimmed?(@oldest_seq) do %>
    <div class="text-xs text-base-content/50 shrink-0">
      Only the last {@memory_limit} lines are kept in memory. Older lines are in the log file.
    </div>
  <% end %>

  <div id="full-log" phx-update="stream"
       class="flex-1 min-h-0 overflow-y-auto bg-base-200 rounded-xl p-3 font-mono text-xs flex flex-col-reverse gap-0.5">
    <div :for={{dom_id, entry} <- @streams.entries} id={dom_id} class={"leading-snug whitespace-pre-wrap break-all #{log_kind_class(entry.kind)}"}><span class="text-base-content/40">{LogStore.format_time(entry.at)}</span> {entry.text}</div>
  </div>
</div>
