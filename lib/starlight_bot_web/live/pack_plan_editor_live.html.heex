<div class="flex flex-col h-full gap-3 overflow-hidden">
  <StarlightBotWeb.Layouts.flash_toasts flash={@flash} />
    <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3 overflow-y-auto">
        <div class="flex items-center gap-3">
          <.pane_tabs team_id={@team_id} pane="packs" counts={@tab_counts} />
            <.template_picker :if={@editing_id} id="pack-template-picker" templates={@templates} editing={@editing_template} current_count={@tab_counts[:pack_plans]} status={@paste_status} label="pack plan" />
          <button :if={is_nil(@editing_id)} type="button" phx-click="new_plan" class="btn btn-primary btn-sm">+ New pack plan</button>
        </div>
        <%= if @editing_id do %>

          <div id="priority-columns" phx-hook="PriorityClipboard" class="flex-1 min-h-0 flex flex-col gap-3 min-h-0">

            <%!-- Priority columns --%>
            <div class="grid grid-cols-2 gap-2">
              <%= for priority <- priorities() do %>
                <div class="border border-base-300 rounded-lg p-2 flex flex-col gap-1 min-h-24 max-h-72 overflow-y-auto">
                  <%= for mode <- modes() do %>
                    <%= if mode == "normal" do %>
                      <div class="text-xs font-semibold text-base-content/70 flex items-center gap-1 flex-wrap">
                        <%= priority_label(priority) %>
                        <button type="button" phx-click="toggle_help" class="text-base-content/40 hover:text-base-content cursor-pointer" title="How pack plans work">ⓘ</button>
                        <button type="button" phx-click="copy_priority" phx-value-priority={priority} phx-value-mode={mode}
                                class="btn btn-ghost btn-xs btn-square ml-auto" title={"Copy normal #{priority_label(priority)} list to clipboard"}>
                          <.copy_icon />
                        </button>
                        <button type="button" data-paste-priority={priority} data-paste-mode={mode}
                                class="btn btn-ghost btn-xs btn-square" title={"Paste clipboard JSON, replacing the normal #{priority_label(priority)} list"}>
                          <.paste_icon />
                        </button>
                      </div>
                    <% else %>
                      <div class="text-[10px] font-semibold uppercase tracking-wide text-base-content/60 flex items-center gap-1 border-t border-base-300 pt-1 mt-1">
                        Hard
                        <button type="button" phx-click="copy_priority" phx-value-priority={priority} phx-value-mode={mode}
                                class="btn btn-ghost btn-xs btn-square ml-auto" title={"Copy hard #{priority_label(priority)} list to clipboard"}>
                          <.copy_icon />
                        </button>
                        <button type="button" data-paste-priority={priority} data-paste-mode={mode}
                                class="btn btn-ghost btn-xs btn-square" title={"Paste clipboard JSON, replacing the hard #{priority_label(priority)} list"}>
                          <.paste_icon />
                        </button>
                      </div>
                    <% end %>
                    <div id={"priority-list-#{priority}-#{mode}"} phx-hook={if priority == "hunt", do: "SortableList"}
                         data-sort-event="reorder_hunt" data-sort-scope={mode} class="flex flex-col gap-0.5">
                      <%= for pack <- packs_with_priority(@plan_data, @theme_packs, mode, priority) do %>
                        <div id={"priority-#{priority}-#{mode}-#{pack.id}"} data-sort-id={pack.id} class="flex flex-col bg-base-200 rounded pr-1">
                          <div class="flex items-center gap-1">
                            <%= if priority == "hunt" do %>
                              <span data-sort-handle class="cursor-grab text-base-content/40 px-0.5" title="Drag to reorder">⠿</span>
                            <% end %>
                            <img src={pack.image_path} class="w-6 h-6 rounded-l object-cover shrink-0" />
                            <span class="text-[11px] truncate flex-1" title={pack.name_en}><%= pack.name_en %></span>
                            <% assigned = StarlightBot.PackPlans.Resolver.floors_for(@plan_data, pack.id, mode, pack) %>
                            <div class="flex gap-0.5 shrink-0">
                              <%= for floor <- StarlightBot.PackPlans.Resolver.eligible_floors(pack, mode) do %>
                                <button phx-click="toggle_pack_floor" phx-value-pack_id={pack.id} phx-value-floor={floor} phx-value-mode={mode}
                                        class={"btn h-5 min-h-0 px-1 text-[10px] " <> if(floor in assigned, do: "btn-primary", else: "btn-outline")}>
                                  <%= floor %>
                                </button>
                              <% end %>
                            </div>
                            <%= if priority == "hunt" do %>
                              <% favorite? = StarlightBot.PackPlans.Resolver.favorite?(@plan_data, pack.id, mode) %>
                              <button phx-click="toggle_favorite" phx-value-pack_id={pack.id} phx-value-mode={mode}
                                      class={"btn btn-ghost h-5 min-h-0 px-1 text-[11px] whitespace-nowrap " <> if(favorite?, do: "text-warning", else: "text-base-content/40")}
                                      title={if favorite?, do: "Favorite: while any favorite is in play, only favorites are hunted, refreshed for and searched for. Click to make it a normal Hunt pack.", else: "Mark as favorite: while any favorite is in play, only favorites are hunted, refreshed for and searched for"}>
                                <%= if favorite?, do: "★ favorite", else: "☆" %>
                              </button>
                            <% end %>
                            <button phx-click="assign_priority" phx-value-pack_id={pack.id} phx-value-priority="fine" phx-value-mode={mode}
                                    class="btn btn-ghost h-5 min-h-0 px-1 text-[11px]" title="Reset to fine">✕</button>
                          </div>
                        </div>
                      <% end %>
                    </div>
                    <%= if packs_with_priority(@plan_data, @theme_packs, mode, priority) == [] do %>
                      <div class="text-[11px] text-base-content/30 italic">none</div>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>

            <div class="divider my-0"></div>

            <%!-- Assign panel --%>
            <% floor_count = max_floor(@extreme?) %>
            <% overflow? = overflow?(@extreme?) %>
            <% hard_col = hard_column(@plan_data, floor_count, overflow?) %>
            <% extreme_disabled? = extreme_disabled?(@plan_data) %>
            <% path = likely_path(@plan_data, @theme_packs, floor_count) %>
            <% rows = chart_rows(@plan_data, @theme_packs, @filter, @floor_filter, floor_count) %>
            <div class="flex-1 min-h-0 flex flex-col gap-1">
              <div class="flex items-center gap-3">
                <span class="text-xs font-medium text-base-content/70">
                  Assign a pack
                  <%= if @floor_filter, do: " (eligible for F#{@floor_filter})" %>
                </span>
                <label class={"flex items-center gap-1 text-xs " <> if(extreme_disabled?, do: "opacity-50 cursor-not-allowed", else: "cursor-pointer")}
                       title={if(extreme_disabled?, do: "Requires F1-F5 to be hard mode", else: "Turn on superposition and continue into extreme floors F6-15 after beating the F5 boss")}>
                  <input type="checkbox" class="toggle toggle-xs toggle-warning" phx-click="toggle_extreme_mode"
                         checked={StarlightBot.PackPlans.Resolver.extreme?(@plan_data)} disabled={extreme_disabled?} />
                  Extreme mode
                </label>
                <input type="text" placeholder="Search packs…" value={@filter} phx-keyup="filter_packs"
                       class="input input-bordered input-xs w-48 ml-auto" />
              </div>
              <div id="assign-waterfall" phx-hook="DragScroll"
                   class="group/pan flex-1 min-h-0 grid content-start gap-x-2 gap-y-0.5 overflow-auto data-[pan=ready]:cursor-grab data-[pan=active]:cursor-grabbing"
                   style={"grid-template-columns: auto repeat(#{floor_count}, minmax(#{if @extreme?, do: "calc(6rem + 100px)", else: "6rem"}, 1fr))#{if overflow?, do: " 5rem"}"}>
                <div class="col-span-full grid grid-cols-subgrid sticky top-0 bg-base-100 z-10 border-b border-base-300">
                  <span class="row-start-2 col-start-1 sticky left-0 z-20 bg-base-100 text-[10px] text-base-content/40 px-1 whitespace-nowrap self-end" data-no-pan><span class="invisible group-data-[pan]/pan:visible">drag chart to pan ⇆</span></span>
                  <span class="row-start-1 col-start-1 sticky left-0 z-20 bg-base-100 text-[10px] font-medium text-base-content/50 px-1 whitespace-nowrap self-center text-right" data-no-pan>likely path ▸</span>
                  <%= for floor <- 1..floor_count do %>
                    <% hard? = StarlightBot.PackPlans.Resolver.mode_for_floor(@plan_data["mode_schedule"], floor) == "hard" %>
                    <div class="row-start-1 relative flex items-center gap-1 py-1 pr-3 min-w-0" style={"grid-column: #{floor + 1}"}>
                      <%= if hard? and Enum.any?(@plan_data["mode_schedule"], &(&1["from_floor"] == floor)) do %>
                        <span class="tooltip tooltip-bottom shrink-0 text-warning cursor-help" data-tip="Switching to hard mode at this floor">
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
                            <path d="M12 9v4" />
                            <path d="M12 17h.01" />
                          </svg>
                        </span>
                      <% end %>
                      <%= case path[floor] do %>
                        <% {pack, rest} -> %>
                          <% mode = if(hard?, do: "hard", else: "normal") %>
                          <% favorite? = StarlightBot.PackPlans.Resolver.favorite?(@plan_data, pack.id, mode) %>
                          <% others = length(rest) %>
                          <button type="button" phx-click="toggle_path_floor" phx-value-floor={floor} data-no-pan
                               class={"flex-1 min-w-0 flex items-center gap-1 rounded-full border pl-0.5 pr-1 py-0.5 text-[10px] shadow-sm cursor-pointer text-left " <> if(hard?, do: "border-warning bg-warning/15", else: "border-success/60 bg-success/10")}
                               title={"F#{floor}: #{pack.name_en}" <> if(favorite?, do: " (favorite)", else: "") <> if(others > 0, do: ", then #{others} more in Hunt order. Click to list them.", else: ". Click to see next in priority.")}>
                            <img src={pack.image_path} class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                            <span class="truncate font-medium flex-1"><%= if favorite?, do: "★ " %><%= pack.name_en %></span>
                            <%= if others > 0 do %>
                              <span class="shrink-0 rounded-full bg-base-content/10 px-1 text-[9px] text-base-content/60">+<%= others %></span>
                            <% end %>
                          </button>
                          <%= if @path_floor == floor do %>
                            <% candidates = [pack | rest] %>
                            <% {favorites, backups} = Enum.split_with(candidates, &StarlightBot.PackPlans.Resolver.favorite?(@plan_data, &1.id, mode)) %>
                            <div class="absolute left-0 top-full mt-1 z-30 w-full min-w-56 rounded-lg border border-base-300 bg-base-100 p-1 shadow-xl flex flex-col gap-0.5"
                                 data-no-pan phx-click-away="close_path_floor">
                              <span class="px-1 text-[9px] uppercase tracking-wide text-warning">★ Favorites (hunted first)</span>
                              <div id={"path-fav-#{floor}"} phx-hook="SortableList" data-sort-event="path_reorder" data-sort-move-event="path_move"
                                   data-sort-shared={"path-#{floor}"} data-sort-scope={"#{mode}:fav"} data-sort-highlight class="flex flex-col gap-0.5 min-h-5 rounded">
                                <%= for {alt, index} <- Enum.with_index(favorites) do %>
                                  <.path_row alt={alt} index={index} total={length(candidates)} mode={mode} hard?={hard?} favorite?={true} />
                                <% end %>
                                <span :if={favorites == []} class="px-1.5 text-[10px] italic text-base-content/40">drop here to favorite</span>
                              </div>
                              <span class="px-1 pt-1 text-[9px] uppercase tracking-wide text-base-content/50">Not favorite<%= if favorites != [], do: " (backup)" %></span>
                              <div id={"path-rest-#{floor}"} phx-hook="SortableList" data-sort-event="path_reorder" data-sort-move-event="path_move"
                                   data-sort-shared={"path-#{floor}"} data-sort-scope={"#{mode}:rest"} data-sort-highlight class="flex flex-col gap-0.5 min-h-5 rounded">
                                <%= for {alt, index} <- Enum.with_index(backups, length(favorites)) do %>
                                  <.path_row alt={alt} index={index} total={length(candidates)} mode={mode} hard?={hard?} favorite?={false} />
                                <% end %>
                                <span :if={backups == []} class="px-1.5 text-[10px] italic text-base-content/40">none</span>
                              </div>
                              <span :if={others == 0} class="px-1 pt-1 text-[10px] italic text-base-content/40">Next in priority: none</span>
                            </div>
                          <% end %>
                        <% nil -> %>
                          <div class="flex-1 min-w-0 rounded-full border border-dashed border-base-content/20 px-1.5 py-0.5 text-[10px] italic text-base-content/30 truncate">
                            no Hunt pack
                          </div>
                      <% end %>
                      <%= if floor < floor_count do %>
                        <span class="absolute top-1/2 -right-2 w-5 h-px bg-base-content/40"></span>
                        <span class="absolute top-1/2 -right-2 -translate-y-1/2 border-y-[4px] border-y-transparent border-l-[6px] border-l-base-content/40"></span>
                      <% end %>
                    </div>
                  <% end %>
                  <%= for floor <- 1..floor_count do %>
                    <% hard? = StarlightBot.PackPlans.Resolver.mode_for_floor(@plan_data["mode_schedule"], floor) == "hard" %>
                    <% breakpoint? = Enum.any?(@plan_data["mode_schedule"], &(&1["from_floor"] == floor)) %>
                    <% searchable? = StarlightBot.PackPlans.Resolver.searchable_floor?(floor) %>
                    <% search? = searchable? and floor in @plan_data["search_floors"] %>
                    <div class={"row-start-2 flex items-center justify-between gap-1 px-1 py-1 rounded-t " <> if(hard?, do: "bg-warning/15", else: "")}
                         style={"grid-column: #{floor + 1}; " <> if(extreme_disabled? and floor >= 6, do: disabled_stripes_style(), else: "")}
                         title={if(extreme_disabled? and floor >= 6, do: "Extreme floors only matter when the plan goes hard from F1")}>
                      <div class="flex items-center gap-0.5">
                        <%= if floor == 6 do %>
                          <button phx-click="toggle_extreme" class="text-[11px] px-1 rounded text-base-content/50 hover:bg-base-200" title="Collapse F6-15 into one column">◂</button>
                        <% end %>
                        <button phx-click="set_floor_filter" phx-value-floor={floor}
                                class={"text-[11px] font-semibold px-1.5 rounded " <> if(@floor_filter == floor, do: "bg-success text-success-content", else: "text-base-content/70 hover:bg-base-200")}
                                title={"Only show packs that can appear on F#{floor}"}>
                          F<%= floor %>
                        </button>
                      </div>
                      <div class="flex items-center gap-0.5">
                        <%= if floor <= 5 do %>
                        <button phx-click="toggle_breakpoint" phx-value-floor={floor}
                                class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(breakpoint?, do: "btn-warning", else: "btn-ghost border-base-300")}
                                title={if breakpoint?, do: "Hard from F#{floor} on. Click to stay normal.", else: "Switch to hard from F#{floor} on"}>
                          go hard
                        </button>
                        <% end %>
                        <button phx-click="toggle_search_floor" phx-value-floor={floor} disabled={not searchable?}
                                class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(search?, do: "btn-error", else: "btn-ghost border-base-300")}
                                title={if(searchable?, do: "Once refreshes run out, search-replace the leftmost pack with the highest unvisited favorite (or Hunt pack when there are no favorites) that has a search hook", else: "Pack search is unavailable on F11+")}>
                          search
                        </button>
                      </div>
                    </div>
                  <% end %>
                  <%= if overflow? do %>
                    <button phx-click="toggle_extreme"
                            class={"row-start-2 flex items-center justify-center text-[11px] font-semibold text-base-content/60 rounded-t hover:bg-base-200 " <> if(hard_col, do: "bg-warning/15", else: "")}
                            style={"grid-column: #{floor_count + 2}; " <> if(extreme_disabled?, do: disabled_stripes_style(), else: "")}
                            title={"Expand extreme floors F6-15" <> if(extreme_disabled?, do: " (they only matter when the plan goes hard from F1)", else: "")}>
                      F6-15 ▸
                    </button>
                  <% end %>
                  <%= if extreme_disabled? do %>
                    <div class="row-start-2 self-end relative z-[1] pointer-events-none" style="grid-column: 7 / -1">
                      <span class={"absolute top-full inset-x-0 mt-3 px-1 font-bold leading-tight text-center text-base-content/60 " <> if(@extreme?, do: "text-2xl", else: "text-sm")}>
                        N/A until F1 starts hard
                      </span>
                    </div>
                  <% end %>
                </div>
                <%= for row <- rows do %>
                  <% pack = row.pack %>
                  <% current = StarlightBot.PackPlans.Resolver.priority_for(@plan_data, pack.id, row.mode) %>
                  <% row_favorite? = current == "hunt" and StarlightBot.PackPlans.Resolver.favorite?(@plan_data, pack.id, row.mode) %>
                  <div class="group col-span-full grid grid-cols-subgrid items-center rounded hover:bg-base-200">
                    <%= if hard_col do %>
                      <div class="self-stretch -my-px bg-warning/10" style={"grid-row: 1; grid-column: #{hard_col + 1} / -1"}></div>
                    <% end %>
                    <%= if extreme_disabled? do %>
                      <div class="self-stretch -my-px" style={"grid-row: 1; grid-column: 7 / -1; " <> disabled_stripes_style()}></div>
                    <% end %>
                    <div class="sticky left-0 z-[5] flex gap-1 px-1 bg-base-100 group-hover:bg-base-200 cursor-default" style="grid-row: 1; grid-column: 1" data-no-pan>
                      <%= for priority <- priorities() do %>
                        <%= if current == priority do %>
                          <button phx-click="assign_priority" phx-value-pack_id={pack.id} phx-value-priority="fine" phx-value-mode={row.mode}
                                  class={"btn btn-xs h-5 min-h-0 px-1.5 text-[10px] " <> priority_button_class(priority)} title={"Remove from #{row.mode} #{priority_label(priority)}"}>
                            <%= priority_label(priority) %>
                          </button>
                        <% else %>
                          <button phx-click="assign_priority" phx-value-pack_id={pack.id} phx-value-priority={priority} phx-value-mode={row.mode}
                                  class="btn btn-xs h-5 min-h-0 px-1.5 text-[10px] btn-outline">
                            <%= priority_label(priority) %>
                          </button>
                        <% end %>
                      <% end %>
                      <%= if current == "hunt" do %>
                        <button type="button" phx-click="toggle_favorite" phx-value-pack_id={pack.id} phx-value-mode={row.mode}
                                class={"btn btn-ghost btn-xs h-5 min-h-0 px-1 text-xs " <> if(row_favorite?, do: "text-warning", else: "text-base-content/40")}
                                title={if row_favorite?, do: "Favorite. Click to make it a normal Hunt pack.", else: "Mark as favorite: while any favorite is in play, only favorites are hunted, refreshed for and searched for"}>
                          <%= if row_favorite?, do: "★", else: "☆" %>
                        </button>
                      <% end %>
                    </div>
                    <div id={"bar-#{row.mode}-#{pack.id}"} phx-hook="PriorityRightClick" data-pack-id={pack.id} data-priority="banned" data-mode={row.mode}
                         class={"grid grid-cols-subgrid min-w-0 rounded border bg-base-200 overflow-hidden " <> if(row_favorite?, do: "border-warning ring-1 ring-warning/60", else: "border-base-300")}
                         style={"grid-row: 1; " <> span_style(row, floor_count, overflow?)}
                         title={"#{pack.name_en} (#{row.mode} floors #{Enum.join(row.floors, ",")}). Click: toggle Hunt. Right click: toggle Banned."}>
                      <%= for col <- highlight_columns(@plan_data, row, floor_count, overflow?) do %>
                        <div class={"-mx-1 " <> priority_fill_class(current)} style={"grid-row: 1; grid-column: #{col}"}></div>
                      <% end %>
                      <div class="relative pointer-events-none flex items-center gap-1.5 px-1 min-w-0" style="grid-row: 1; grid-column: 1 / -1">
                        <img src={pack.image_path} class="w-5 h-5 rounded-sm object-cover shrink-0" draggable="false" />
                        <span class={"text-xs flex-1 truncate " <> if(row_favorite?, do: "font-semibold", else: "")}><%= pack.name_en %><%= if row_favorite? do %> <span class="text-warning">★</span><% end %></span>
                      </div>
                      <%= for {col, _floors, _label} <- span_cells(row, floor_count, overflow?) do %>
                        <div phx-click="toggle_priority" phx-value-pack_id={pack.id} phx-value-priority="hunt" phx-value-mode={row.mode}
                             class="relative z-[1] -mx-1 cursor-pointer hover:bg-base-content/10"
                             style={"grid-row: 1; grid-column: #{col}"}></div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= if rows == [] do %>
                  <div class="col-span-full text-xs text-base-content/40 italic p-1">No matching packs.</div>
                <% end %>
              </div>
            </div>

          </div>

        <% else %>
          <div class="flex-1 flex items-center justify-center text-base-content/40 text-sm">
            Pick or create a plan for this team.
          </div>
        <% end %>
      </div>
    </div>
  <%= if @show_help do %>
    <div class="modal modal-open" phx-window-keydown="toggle_help" phx-key="Escape">
      <div class="modal-box max-w-2xl max-h-[85vh] flex flex-col gap-3 text-sm">
        <h3 class="font-bold text-base">How theme pack plans work</h3>
        <div class="overflow-y-auto flex flex-col gap-3 pr-1">
          <section>
            <h4 class="font-semibold">Priorities</h4>
            <p><span class="font-medium">Hunt</span>: picked immediately if shown, highest in the list first (drag to reorder). If none are shown and refreshes remain, the bot keeps refreshing to find one.</p>
            <p><span class="font-medium">Banned</span>: never picked voluntarily. Only taken if nothing else is shown and no refreshes are left.</p>
            <p>Anything not in either list is Fine: acceptable filler, picked when nothing better is shown.</p>
          </section>
          <section>
            <h4 class="font-semibold">Favorites</h4>
            <p>Star a Hunt pack to make it a favorite. While any favorite is in play, only favorites are hunted, refreshed for and searched for. The other Hunt packs become a backup once refreshes and search run out.</p>
          </section>
          <section>
            <h4 class="font-semibold">Normal and hard</h4>
            <p>Each priority has a separate list for normal and hard floors. Use "go hard" on a floor header to switch to hard from that floor on. Hard columns are tinted.</p>
          </section>
          <section>
            <h4 class="font-semibold">Search</h4>
            <p>The "search" toggle on a floor makes the bot, once refreshes run out, replace the leftmost pack with the highest unvisited favorite (or Hunt pack when there are no favorites) that has a search hook. Unavailable on F11 and later.</p>
          </section>
          <section>
            <h4 class="font-semibold">Extreme mode</h4>
            <p>Turns on superposition and continues into extreme floors F6-15 after beating the F5 boss. Requires F1-F5 to be hard.</p>
          </section>
        </div>
        <div class="modal-action mt-0">
          <button phx-click="toggle_help" class="btn btn-sm">Close</button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="toggle_help"></div>
    </div>
  <% end %>
</div>
