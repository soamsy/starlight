<div id="pack-plan-editor" class="flex flex-col h-full gap-3 overflow-hidden">
    <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-3 overflow-y-auto">
        <div class="flex items-center gap-3">
          <div :if={@editing_id} class="join items-center">
            <span class="text-xs text-base-content/70 mr-2">View:</span>
            <%= for {view, label} <- [{"plan", "plan"}, {"normal", "all normal"}, {"hard", "all hard"}, {"extreme", "extreme"}] do %>
              <button type="button" phx-click="set_view" phx-value-view={view}
                      class={"btn btn-xs join-item capitalize " <> view_button_class(view, @view)}><%= label %></button>
            <% end %>
          </div>
          <label :if={@editing_id} class="input input-bordered input-xs flex w-48 items-center gap-1.5">
            <.icon name="lucide-search" class="size-3.5 shrink-0 text-base-content/50" />
            <input type="text" placeholder="Search packs…" value={@filter} phx-keyup="filter_packs" class="grow min-w-0" />
          </label>
          <span :if={@editing_id && @floor_filter} class="badge badge-accent badge-outline">Eligible for F<%= @floor_filter %></span>
          <%= if @editing_id do %>
            <%= with {warning, detail} <- view_warning(@plan_data, @view) do %>
              <span class="badge badge-accent badge-outline gap-1 cursor-help" title={detail}>
                <%= warning %>
              </span>
            <% end %>
          <% end %>
          <div :if={@editing_id} class="ml-auto flex items-center gap-3">
            <.template_picker id="pack-template-picker" templates={@templates} editing={@editing_template} current_count={@tab_counts[:pack_plans]} status={@paste_status} selected={@template_id} plans={@plans} plan_id={@editing_id} editing_plan={@editing_plan} label="pack plan" />
          <button type="button" phx-click="toggle_help" class="btn btn-sm btn-outline gap-0 overflow-hidden px-0" title="How pack plans work">
            <span class="flex h-full items-center border-r border-current/30 bg-base-content/10 px-2 text-xs">guide</span>
            <span class="flex h-full items-center px-2">
              <.icon name="lucide-info" class="size-4" />
            </span>
          </button>
          </div>
          <button :if={is_nil(@editing_id)} type="button" phx-click="new_plan" class="btn btn-primary btn-sm">+ New pack plan</button>
        </div>
        <.read_only_banner :if={@editing_id} container="pack-plan-editor" allowed={read_only_events()} template_id={@template_id} templates={@templates} label="pack plan" />
        <%= if @editing_id do %>

          <div class="flex-1 min-h-0 flex flex-col gap-3 min-h-0">

            <%!-- Assign panel --%>
            <% extreme? = @view == "extreme" %>
            <% floor_count = max_floor(extreme?) %>
            <% overflow? = overflow?(extreme?) %>
            <% hard_col = hard_column(@plan_data, floor_count, overflow?) %>
            <% extreme_disabled? = extreme_disabled?(@plan_data) %>
            <% path = likely_path(@plan_data, @theme_packs, floor_count, @view) %>
            <% run_odds = run_odds(@plan_data, @theme_packs, floor_count, @view, @grace_picks) %>
            <% rows = chart_rows(@plan_data, @theme_packs, @filter, @floor_filter, floor_count, @view) %>
            <div class="flex-1 min-h-0 flex flex-col gap-1">
              <div id="assign-waterfall" phx-hook="DragScroll"
                   class="group/pan flex-1 min-h-0 grid content-start gap-x-2 gap-y-0.5 overflow-auto data-[pan=ready]:cursor-grab data-[pan=active]:cursor-grabbing"
                   style={"grid-template-columns: auto repeat(#{floor_count}, minmax(#{if extreme?, do: "calc(6rem + 100px)", else: "6rem"}, 1fr))#{if overflow?, do: " 9rem"}"}>
                <div class="col-span-full grid grid-cols-subgrid sticky top-0 bg-base-100 z-10 border-b border-base-300">
                  <span class="row-start-2 col-start-1 sticky left-0 z-20 bg-base-100 text-[10px] text-base-content/40 px-1 whitespace-nowrap self-end" data-no-pan><span class="invisible group-data-[pan]/pan:visible">drag chart to pan ⇆</span></span>
                  <button type="button" phx-click="toggle_odds" title="How the percentages are calculated" class="row-start-1 col-start-1 sticky left-0 z-20 bg-base-100 text-[10px] font-medium text-base-content/50 hover:text-base-content px-1 whitespace-nowrap self-center text-right cursor-pointer flex items-center justify-end gap-1" data-no-pan>
                    likely path ▸
                    <span class="inline-flex h-3.5 w-3.5 items-center justify-center rounded-full border border-current text-[9px] italic leading-none">i</span>
                  </button>
                  <%= for floor <- 1..floor_count do %>
                    <% hard? = StarlightBot.PackPlans.Resolver.mode_for_floor(@plan_data["mode_schedule"], floor) == "hard" %>
                    <% path_hard? = path_mode(@plan_data, floor, @view) == "hard" %>
                    <div class="row-start-1 relative flex items-center gap-1 py-1 pr-3 min-w-0" style={"grid-column: #{floor + 1}"}>
                      <%= if hard? and Enum.any?(@plan_data["mode_schedule"], &(&1["from_floor"] == floor)) do %>
                        <span class="tooltip tooltip-bottom shrink-0 text-warning cursor-help" data-tip="Switching to hard mode at this floor">
                          <.icon name="lucide-triangle-exclamation-point" class="size-4" />
                        </span>
                      <% end %>
                      <%= if floor == 6 and extreme_disabled? do %>
                        <span class="tooltip tooltip-bottom shrink-0 text-error cursor-help" data-tip="Run stops after F5. Enable go extreme on F6 to continue">
                          <.icon name="lucide-octagon" class="size-4" />
                        </span>
                      <% end %>
                      <% mode = path_mode(@plan_data, floor, @view) %>
                      <% others = max(length(path_candidates(path[floor])) - 1, 0) %>
                      <% pill_odds = if path[floor], do: run_odds[floor] %>
                      <%= case path[floor] do %>
                        <% {pack, _rest} -> %>
                          <% favorite? = StarlightBot.PackPlans.Resolver.favorite?(@plan_data, pack.id, mode, floor) %>
                          <button type="button" phx-click={if @path_floor == floor, do: "close_path_floor", else: "toggle_path_floor"} phx-value-floor={floor} data-no-pan aria-haspopup="true" aria-expanded={to_string(@path_floor == floor)}
                               class={"group/pill flex-1 min-w-0 flex items-center gap-1 rounded-full border pl-0.5 pr-1 py-0.5 text-[10px] shadow-sm cursor-pointer text-left transition hover:shadow-md hover:brightness-95 " <> if(@path_floor == floor, do: "ring-2 ring-primary/60 ", else: "") <> if(path_hard?, do: "border-warning bg-warning/15", else: "border-success/60 bg-success/10")}
                               title={"F#{floor}: #{pack.name_en}" <> if(favorite?, do: " (favorite)", else: "") <> if(others > 0, do: ", then #{others} more in Hunt order. Click to list them.", else: ". Click to see next in priority.")}>
                            <img src={pack.image_path} class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                            <span class="truncate font-medium flex-1"><.icon :if={favorite?} name="lucide-filled-star" class="size-3 inline" /> <%= pack.name_en %></span>
                            <span :if={odds_percent(pill_odds, pack.id)} class="shrink-0 font-mono text-[9px] text-base-content/70" title={odds_summary(pill_odds)}><%= odds_percent(pill_odds, pack.id) %></span>
                            <%= if others > 0 do %>
                              <span class="shrink-0 rounded-full bg-base-content/10 px-1 text-[9px] text-base-content/60">+<%= others %></span>
                            <% end %>
                            <.icon name="lucide-chevron-down" class={"size-3 shrink-0 text-base-content/50 transition-transform group-hover/pill:text-base-content " <> if(@path_floor == floor, do: "rotate-180", else: "")} />
                          </button>
                        <% nil -> %>
                          <button type="button" phx-click={if @path_floor == floor, do: "close_path_floor", else: "toggle_path_floor"} phx-value-floor={floor} data-no-pan aria-haspopup="true" aria-expanded={to_string(@path_floor == floor)}
                                  class={"group/pill flex-1 min-w-0 flex items-center gap-1 rounded-full border border-dashed px-1.5 py-0.5 text-[10px] italic text-left cursor-pointer transition hover:border-base-content/50 hover:text-base-content/60 " <> if(@path_floor == floor, do: "ring-2 ring-primary/60 border-base-content/50 text-base-content/60", else: "border-base-content/20 text-base-content/30")}
                                  title={"F#{floor}: no Hunt pack. Click to add one."}>
                            <span class="truncate flex-1">no Hunt pack</span>
                            <.icon name="lucide-chevron-down" class={"size-3 shrink-0 transition-transform " <> if(@path_floor == floor, do: "rotate-180", else: "")} />
                          </button>
                      <% end %>
                      <%= if @path_floor == floor do %>
                          <% candidates = floor_candidates(@plan_data, @theme_packs, floor, mode) %>
                          <% odds = run_odds[floor] %>
                          <% {favorites, backups} = Enum.split_with(candidates, &StarlightBot.PackPlans.Resolver.favorite?(@plan_data, &1.id, mode, floor)) %>
                          <div class="absolute left-0 top-full mt-2 z-30 w-full min-w-56 rounded-lg border border-base-content/30 bg-base-200 p-1.5 shadow-2xl ring-4 ring-base-content/10 flex flex-col gap-0.5"
                               data-no-pan phx-click-away="close_path_floor">
                            <span class="absolute -top-[5px] left-5 h-2 w-2 rotate-45 border-l border-t border-base-content/30 bg-base-200"></span>
                            <div class="flex items-center justify-between">
                              <span class="px-1 text-[9px] uppercase tracking-wide text-warning cursor-help" title={odds_summary(odds)}><.icon name="lucide-filled-star" class="size-3" /> Favorites (hunted first)</span>
                              <button type="button" phx-click="path_clear_floor" phx-value-floor={floor} data-confirm={"Clear every hunted pack from F#{floor} in #{mode} mode?"}
                                      class="btn btn-ghost btn-xs h-4 min-h-0 px-1 text-[9px] text-error"
                                      title={"Remove every hunted pack from F#{floor} in #{mode} mode"}>Clear F<%= floor %></button>
                            </div>
                            <div id={"path-fav-#{floor}"} phx-hook="SortableList" data-sort-event="path_reorder" data-sort-move-event="path_move"
                                 data-sort-shared={"path-#{floor}"} data-sort-scope={"#{mode}:#{floor}:fav"} data-sort-highlight class="flex flex-col gap-0.5 min-h-5 rounded">
                              <%= for {alt, index} <- Enum.with_index(favorites) do %>
                                <.path_row alt={alt} index={index} total={length(candidates)} mode={mode} floor={floor} hard?={path_hard?} favorite?={true} percent={odds_percent(odds, alt.id)} />
                              <% end %>
                              <span :if={favorites == []} class="px-1.5 text-[10px] italic text-base-content/40">drop here to favorite</span>
                            </div>
                            <span class="px-1 pt-1 text-[9px] uppercase tracking-wide text-base-content/50">Not favorite<%= if favorites != [], do: " (backup)" %></span>
                            <div id={"path-rest-#{floor}"} phx-hook="SortableList" data-sort-event="path_reorder" data-sort-move-event="path_move"
                                 data-sort-shared={"path-#{floor}"} data-sort-scope={"#{mode}:#{floor}:rest"} data-sort-highlight class="flex flex-col gap-0.5 min-h-5 rounded">
                              <%= for {alt, index} <- Enum.with_index(backups, length(favorites)) do %>
                                <.path_row alt={alt} index={index} total={length(candidates)} mode={mode} floor={floor} hard?={path_hard?} favorite?={false} percent={odds_percent(odds, alt.id)} />
                              <% end %>
                              <span :if={backups == []} class="px-1.5 text-[10px] italic text-base-content/40">none</span>
                            </div>
                            <span :if={others == 0} class="px-1 pt-1 text-[10px] italic text-base-content/40">Next in priority: none</span>
                            <% matches = if @path_query != "" or @path_browse, do: path_matches(@plan_data, @theme_packs, floor, mode, @path_query), else: [] %>
                            <div id={"path-picker-#{floor}"} phx-hook="PathPicker" class="contents">
                            <form phx-submit="path_add" phx-change="path_query" class="relative flex items-center pt-1">
                              <input type="hidden" name="floor" value={floor} />
                              <input type="text" name="query" value={@path_query} phx-debounce="100" autocomplete="off" placeholder="Add pack to Hunt…" phx-mounted={Phoenix.LiveView.JS.focus()} phx-keydown="path_key" phx-key="Escape"
                                     class="input input-bordered input-xs w-full pr-6" />
                              <button :if={@path_query != ""} type="button" phx-click="path_query_clear"
                                      class="absolute right-1 top-1/2 mt-0.5 -translate-y-1/2 text-base-content/50 hover:text-base-content text-xs leading-none px-1" title="Clear search"><.icon name="lucide-x" class="size-3.5" /></button>
                            </form>
                            <div :if={@path_query != "" or @path_browse} class="flex flex-col gap-0.5 max-h-40 overflow-y-auto">
                              <%= for option <- matches do %>
                                <button type="button" data-path-option phx-click="path_add" phx-value-floor={floor} phx-value-pack_id={option.id}
                                        class={"flex items-center gap-1 rounded-full border px-1 py-0.5 text-[10px] text-left cursor-pointer hover:bg-base-200 group/opt border-base-300 aria-selected:border-primary/60 aria-selected:bg-primary/10"}>
                                  <img src={option.image_path} class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                                  <span class="truncate flex-1"><%= option.name_en %></span>
                                  <span class="hidden group-aria-selected/opt:inline shrink-0 text-[9px] text-base-content/40">↵</span>
                                </button>
                              <% end %>
                              <span :if={matches == []} class="px-1.5 text-[10px] italic text-base-content/40">no matching pack</span>
                            </div>
                            </div>
                          </div>
                        <% end %>
                      <%= if floor < floor_count do %>
                        <span class="absolute top-1/2 -right-2 w-5 h-px bg-base-content/40"></span>
                        <span class="absolute top-1/2 -right-2 -translate-y-1/2 border-y-[4px] border-y-transparent border-l-[6px] border-l-base-content/40"></span>
                      <% end %>
                    </div>
                  <% end %>
                  <%= for floor <- 1..floor_count do %>
                    <% hard? = StarlightBot.PackPlans.Resolver.mode_for_floor(@plan_data["mode_schedule"], floor) == "hard" %>
                    <% breakpoint? = Enum.any?(@plan_data["mode_schedule"], &(&1["from_floor"] == floor)) %>
                    <% searchable? = StarlightBot.PackPlans.Resolver.searchable_floor?(floor) %>
                    <% search? = searchable? and floor in @plan_data["search_floors"] %>
                    <div class={"row-start-2 flex items-center justify-between gap-1 px-1 py-1 rounded-t " <> if(hard?, do: "bg-warning/15", else: "")}
                         style={"grid-column: #{floor + 1}; " <> if(extreme_disabled? and floor >= 6, do: disabled_stripes_style(), else: "")}
                         title={if(extreme_disabled? and floor >= 6, do: "Extreme floors only run when the plan goes extreme")}>
                      <div class="flex items-center gap-0.5">
                        <%= if floor == 6 do %>
                          <button phx-click="set_view" phx-value-view="hard" class="text-[11px] px-1 rounded text-base-content/50 hover:bg-base-200" title="Collapse F6-15 into one column">◂</button>
                        <% end %>
                        <button phx-click="set_floor_filter" phx-value-floor={floor}
                                class={"text-[11px] font-semibold px-1.5 rounded " <> if(@floor_filter == floor, do: "bg-success text-success-content", else: "text-base-content/70 hover:bg-base-200")}
                                title={"Only show packs that can appear on F#{floor}"}>
                          F<%= floor %>
                        </button>
                      </div>
                      <div class="flex items-center gap-0.5">
                        <%= if floor <= 5 do %>
                        <button phx-click="toggle_breakpoint" phx-value-floor={floor}
                                class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(breakpoint?, do: "btn-warning", else: "btn-ghost border-base-300")}
                                title={if breakpoint?, do: "Hard from F#{floor} on. Click to stay normal.", else: "Switch to hard from F#{floor} on"}>
                          go hard
                        </button>
                        <% end %>
                        <%= if floor == 6 do %>
                        <button phx-click="toggle_extreme_mode"
                                class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(extreme_disabled?, do: "btn-ghost border-base-300", else: "btn-secondary")}
                                title={if extreme_disabled?, do: "Go hard from F1 and continue into extreme floors F6-15 with superposition after beating the F5 boss", else: "Extreme is on. Click to stop after the F5 boss."}>
                          go extreme
                        </button>
                        <% end %>
                        <button phx-click="toggle_search_floor" phx-value-floor={floor} disabled={not searchable?}
                                class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(search?, do: "btn-error", else: "btn-ghost border-base-300")}
                                title={if(searchable?, do: "Once refreshes run out, search-replace the leftmost pack with the highest unvisited favorite (or Hunt pack when there are no favorites) that has a search hook", else: "Pack search is unavailable on F11+")}>
                          search
                        </button>
                      </div>
                    </div>
                  <% end %>
                  <%= if overflow? do %>
                    <div class={"row-start-2 flex items-center justify-center gap-1 rounded-t " <> if(hard_col, do: "bg-warning/15", else: "")}
                         style={"grid-column: #{floor_count + 2}; " <> if(extreme_disabled?, do: disabled_stripes_style(), else: "")}>
                      <button phx-click="set_view" phx-value-view="extreme"
                              class="text-[11px] font-semibold text-base-content/60 px-1 rounded hover:bg-base-200"
                              title="Expand extreme floors F6-15">
                        F6-15 ▸
                      </button>
                      <button phx-click="toggle_extreme_mode"
                              class={"btn btn-xs h-4 min-h-0 px-1 text-[9px] " <> if(extreme_disabled?, do: "btn-ghost border-base-300", else: "btn-secondary")}
                              title={if extreme_disabled?, do: "Go hard from F1 and continue into extreme floors F6-15 with superposition after beating the F5 boss", else: "Extreme is on. Click to stop after the F5 boss."}>
                        go extreme
                      </button>
                    </div>
                  <% end %>
                  <%= if extreme_disabled? do %>
                    <div class="row-start-2 self-end relative z-[1] pointer-events-none" style="grid-column: 7 / -1">
                      <span class={"absolute top-full inset-x-0 mt-3 px-1 font-bold leading-tight text-center text-base-content/60 " <> if(extreme?, do: "text-2xl", else: "text-sm")}>
                        Go extreme on F6 to enable
                      </span>
                    </div>
                  <% end %>
                </div>
                <%= for row <- rows do %>
                  <% pack = row.pack %>
                  <div class="group col-span-full grid grid-cols-subgrid items-center rounded hover:bg-base-200">
                    <%= if hard_col do %>
                      <div class="self-stretch -my-px bg-warning/10" style={"grid-row: 1; grid-column: #{hard_col + 1} / -1"}></div>
                    <% end %>
                    <%= if extreme_disabled? do %>
                      <div class="self-stretch -my-px" style={"grid-row: 1; grid-column: 7 / -1; " <> disabled_stripes_style()}></div>
                    <% end %>
                    <div class="sticky left-0 z-[5] flex gap-1 px-1 bg-base-100 group-hover:bg-base-200 cursor-default" style="grid-row: 1; grid-column: 1" data-no-pan>
                      <%= for {status, label, active_class, title} <- [{"favorite", :star, "btn-warning", "favorite"}, {"hunt", "hunt", "btn-success", "hunt"}, {"banned", "banned", "btn-error", "banned"}] do %>
                        <% all? = row_status?(@plan_data, pack.id, row.mode, row.floors, status) %>
                        <button type="button" phx-click="set_row_status" phx-value-pack_id={pack.id} phx-value-mode={row.mode} phx-value-floors={Enum.join(row.floors, ",")} phx-value-status={status}
                                class={"btn btn-xs h-5 min-h-0 px-1.5 text-[10px] " <> if(all?, do: active_class, else: "btn-outline")}
                                title={if all?, do: "Clear #{title} on every #{row.mode} floor", else: "Make every #{row.mode} floor #{title}"}>
                          <%= if label == :star do %><.icon name="lucide-filled-star" class="size-3" /><% else %><%= label %><% end %>
                        </button>
                      <% end %>
                    </div>
                    <div id={"bar-#{row.mode}-#{pack.id}"} phx-hook="PriorityRightClick" data-pack-id={pack.id} data-mode={row.mode}
                         class="grid grid-cols-subgrid min-w-0 rounded border border-base-300 bg-base-200 overflow-hidden"
                         style={"grid-row: 1; " <> span_style(row, floor_count, overflow?)}
                         title={"#{pack.name_en} (#{row.mode} floors #{Enum.join(row.floors, ",")}). Click a floor: toggle Hunt there. Star a hunted floor to favorite it. Right click a floor: toggle Banned there."}>
                      <div class="relative pointer-events-none flex items-center gap-1.5 px-1 min-w-0" style="grid-row: 1; grid-column: 1 / -1">
                        <img src={pack.image_path} class="w-5 h-5 rounded-sm object-cover shrink-0" draggable="false" />
                        <span class="text-xs flex-1 truncate"><%= pack.name_en %></span>
                      </div>
                      <%= for {col, cell_floors, label} <- span_cells(row, floor_count, overflow?) do %>
                        <% status = cell_status(@plan_data, row, cell_floors) %>
                        <div phx-click="toggle_cell" phx-value-action="hunt" phx-value-pack_id={pack.id} phx-value-mode={row.mode} phx-value-floors={Enum.join(cell_floors, ",")}
                             data-floors={Enum.join(cell_floors, ",")} title={"#{label}: click toggles Hunt, right click toggles Banned"}
                             class={"relative z-[1] -mx-1 flex items-center justify-end cursor-pointer " <> cell_fill_class(status)}
                             style={"grid-row: 1; grid-column: #{col}"}>
                          <button :if={status in ~w(hunt favorite)} type="button" phx-click="toggle_cell" phx-value-action="favorite" phx-value-pack_id={pack.id} phx-value-mode={row.mode} phx-value-floors={Enum.join(cell_floors, ",")}
                                  class={"px-1 text-xs leading-none cursor-pointer " <> if(status == "favorite", do: "text-warning", else: "text-base-content/50 hover:text-warning")}
                                  title={if status == "favorite", do: "#{label}: favorite. Click to make it a normal Hunt pack.", else: "#{label}: mark as favorite. While any favorite is in play on a floor, only favorites are hunted, refreshed for and searched for."}>
                            <.icon name={if status == "favorite", do: "lucide-filled-star", else: "lucide-star"} class="size-3.5" />
                          </button>
                          <button :if={status == "none"} type="button" phx-click="toggle_cell" phx-value-action="banned" phx-value-pack_id={pack.id} phx-value-mode={row.mode} phx-value-floors={Enum.join(cell_floors, ",")}
                                  class="px-1 leading-none cursor-pointer text-base-content/40 hover:text-error"
                                  title={"#{label}: ban this pack"}>
                            <.icon name="lucide-octagon" class="size-3.5" />
                          </button>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= if rows == [] do %>
                  <div class="col-span-full text-xs text-base-content/40 italic p-1">No matching packs.</div>
                <% end %>
              </div>
            </div>

          </div>

        <% else %>
          <div class="flex-1 flex items-center justify-center text-base-content/40 text-sm">
            Pick or create a plan for this team.
          </div>
        <% end %>
      </div>
    </div>
  <%= if @show_odds do %>
    <% odds_floors = if @editing_id, do: Enum.map(run_odds(@plan_data, @theme_packs, max_floor(@view == "extreme"), @view, @grace_picks), fn {floor, odds} -> {floor, path_mode(@plan_data, floor, @view), odds} end) |> Enum.sort(), else: [] %>
    <div class="modal modal-open" phx-window-keydown="toggle_odds" phx-key="Escape">
      <div class="modal-box max-w-4xl max-h-[88vh] flex flex-col gap-3 text-sm">
        <h2 class="font-bold text-base">How the likely path percentages are calculated</h2>
        <div class="overflow-y-auto flex flex-col gap-4 pr-1">
          <section class="flex flex-col gap-2">
            <p>Each look at the theme pack screen shows <span class="font-mono">n</span> packs drawn at random from the <span class="font-mono">N</span> packs eligible on that floor. A refresh redraws all of them. The bot takes the best-ranked wanted pack it sees, refreshes if none are shown, and only uses backups on the last look.</p>
            <div class="rounded-lg bg-base-200 p-2 font-mono text-xs flex flex-col gap-1">
              <span><span class="text-base-content/50">N</span> = packs eligible on the floor (banned ones still appear)</span>
              <span><span class="text-base-content/50">n</span> = packs shown = 3 + 1 for each of Star of the Beginning, Interstellar Travel, Perfected Possibility (max 5), one fewer on F5 where a pinned pack takes a slot</span>
              <span><span class="text-base-content/50">L</span> = looks = refreshes + 1, refreshes = 1, or 3 + enhance level with Interstellar Travel</span>
              <span><span class="text-base-content/50">K</span> = wanted packs (favorites, or all hunted if none are favorites)</span>
            </div>
            <div class="rounded-lg border border-base-300 p-2 font-mono text-xs flex flex-col gap-1">
              <span><span class="text-warning">miss</span> q = C(N−K, n) / C(N, n) <span class="text-base-content/50">chance one look shows no wanted pack</span></span>
              <span><span class="text-warning">rank i, one look</span> = C(N−i, n−1) / C(N, n) <span class="text-base-content/50">pack i shown, none ranked above it shown</span></span>
              <span><span class="text-warning">rank i, final</span> = one look × (1 − q<sup>L</sup>) / (1 − q) <span class="text-base-content/50">first look that hits, summed over L looks</span></span>
              <span><span class="text-info">backup j, final</span> = q<sup>L−1</sup> × C(N−K−j, n−1) / C(N, n) <span class="text-base-content/50">every look missed, backup j best on the last</span></span>
            </div>
            <p class="text-xs">The game removes packs you already took from later floors. So each floor is computed once for every combination of earlier picks that could have happened, with the taken packs removed from the pool and from the ranking, and the results are averaged by how likely each combination is. <span class="font-semibold">Still available</span> is the chance a pack was not taken earlier. <span class="font-semibold">Final</span> is the chance it is this floor's pick across all of those branches, which is why it can differ from the fresh-run number times availability: when a higher-ranked pack was taken earlier, the pool is smaller and everyone below it moves up.</p>
            <p class="text-xs text-base-content/60">When several wanted packs appear on the same look, the pick goes to the highest ranked one, so the one-look chance of rank i already excludes everything above it. Final chances over all ranks add up to 1 − q<sup>L</sup>. Assumes each look is a uniform draw of distinct packs, independent of earlier looks.</p>
          </section>
          <section :for={{floor, mode, odds} <- odds_floors} class="rounded-lg border border-base-300 p-2 flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-semibold">F<%= floor %></span>
              <span class={"badge badge-sm " <> if(mode == "hard", do: "badge-warning", else: "badge-success")}><%= mode %></span>
              <span class="font-mono text-xs text-base-content/70">N=<%= odds.pool %> n=<%= odds.shown %> L=<%= odds.looks %> (<%= odds.refreshes %> refreshes) K=<%= odds.wanted_count %> backups=<%= odds.backup_count %></span>
              <span :if={odds.hunting?} class="ml-auto font-mono text-xs">any wanted: <span class="font-semibold"><%= odds_pct(odds.any) %></span></span>
            </div>
            <%= cond do %>
              <% not odds.hunting? -> %>
                <p class="text-xs italic text-base-content/50">No hunted pack on this floor, nothing to calculate.</p>
              <% odds.searching? -> %>
                <p class="text-xs">Search is on for this floor. After refreshes run out the bot finds the top priority pack that is still available in pack search, so that pack is counted as 100% and backups are never used. A pack already taken on an earlier floor is skipped, so the next one inherits its share.</p>
                <div :for={row <- Enum.filter(odds.rows, &(&1.kind == :wanted))} class="flex items-center gap-1 text-xs">
                  <img src={row.pack.image_path} class="w-4 h-4 rounded-full object-cover" />
                  <span class="truncate"><%= row.pack.name_en %></span>
                  <span class="ml-auto font-mono text-base-content/50">still available <%= odds_pct(row.available) %></span>
                  <span class="w-12 text-right font-mono font-semibold"><%= odds_pct(row.final) %></span>
                </div>
              <% true -> %>
                <% segments = odds_bar(odds) %>
                <div class="flex h-4 w-full overflow-hidden rounded-full border border-base-300">
                  <div :for={segment <- segments} style={"width: #{segment.prob * 100}%; " <> odds_segment_style(segment, odds.wanted_count)} title={"#{segment.label}: #{odds_pct(segment.prob)}"}></div>
                </div>
                <div class="font-mono text-xs flex flex-col gap-0.5">
                  <span class="font-sans text-base-content/50">Fresh run, nothing taken yet on earlier floors:</span>
                  <span>q = C(<%= odds.pool - odds.wanted_count %>,<%= odds.shown %>) / C(<%= odds.pool %>,<%= odds.shown %>) = <%= odds_decimal(odds.miss) %></span>
                  <span>q<sup><%= odds.looks %></sup> = <%= odds_decimal(:math.pow(odds.miss, odds.looks)) %> chance every look misses, so <%= odds_pct(odds.any) %> to find a wanted pack</span>
                  <span :if={odds.wanted_count > 0}>(1 − q<sup><%= odds.looks %></sup>) / (1 − q) = <%= odds_decimal(odds.scale) %></span>
                </div>
                <table class="table table-xs">
                  <thead>
                    <tr><th>Pack</th><th>Rank</th><th>With no earlier picks</th><th class="text-right">Still available</th><th class="text-right">Final</th></tr>
                  </thead>
                  <tbody>
                    <tr :for={row <- odds.rows}>
                      <td>
                        <span class="flex items-center gap-1">
                          <img src={row.pack.image_path} class="w-4 h-4 rounded-full object-cover shrink-0" />
                          <span class="truncate"><%= row.pack.name_en %></span>
                          <span :if={row.kind == :backup} class="badge badge-xs badge-info">backup</span>
                        </span>
                      </td>
                      <td class="font-mono"><%= row.rank %></td>
                      <td class="font-mono">
                        <%= if row.kind == :wanted do %>
                          <%= odds_choose(row.choose) %> / C(<%= odds.pool %>,<%= odds.shown %>) = <%= odds_pct(row.per_look) %> × <%= odds_decimal(odds.scale) %> = <%= odds_pct(row.fresh) %>
                        <% else %>
                          q<sup><%= odds.looks - 1 %></sup> (<%= odds_decimal(odds.last_miss) %>) × <%= odds_choose(row.choose) %> / C(<%= odds.pool %>,<%= odds.shown %>) = <%= odds_pct(row.fresh) %>
                        <% end %>
                      </td>
                      <td class="text-right font-mono"><%= odds_pct(row.available) %></td>
                      <td class="text-right font-mono font-semibold"><%= odds_pct(row.final) %></td>
                    </tr>
                    <tr class="text-base-content/50">
                      <td colspan="4">None of the above (default or fallback pick)</td>
                      <td class="text-right font-mono"><%= odds_pct(odds.fallback) %></td>
                    </tr>
                  </tbody>
                </table>
            <% end %>
          </section>
        </div>
        <div class="modal-action mt-0">
          <button phx-click="toggle_odds" class="btn btn-sm">Close</button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="toggle_odds"></div>
    </div>
  <% end %>
  <%= if @show_help do %>
    <div class="modal modal-open" phx-window-keydown="toggle_help" phx-key="Escape">
      <div class="modal-box max-w-3xl max-h-[85vh] flex flex-col gap-3 text-sm">
        <h2 class="font-bold text-base">How the bot chooses a theme pack</h2>
        <div class="overflow-y-auto flex flex-col gap-3 pr-1">
          <section>
            <h4 class="font-semibold mb-2">Priority</h4>
            <div class="grid grid-cols-4 gap-2 text-xs">
              <div class="flex flex-col gap-1 rounded-lg border border-warning/50 bg-warning/15 p-2">
                <span class="font-semibold text-warning"><.icon name="lucide-filled-star" class="size-3" /> Favorite</span>
                <span>1st pick. Seen: take it. Not seen: refresh.</span>
                <span class="text-base-content/60">Click the star on a Hunt floor</span>
                <span class="mt-auto pt-1 text-[11px] italic text-base-content/70">Two seen? Higher in list wins.</span>
              </div>
              <div class="flex flex-col gap-1 rounded-lg border border-success/50 bg-success/15 p-2">
                <span class="font-semibold text-success">Hunt</span>
                <span>2nd pick. Backup once refreshes and search run out. No favorites: acts as Favorite.</span>
                <span class="text-base-content/60">Click a floor</span>
                <span class="mt-auto pt-1 text-[11px] italic text-base-content/70">Two seen? Higher in list wins.</span>
              </div>
              <div class="flex flex-col gap-1 rounded-lg border border-base-300 bg-base-200 p-2">
                <span class="font-semibold">Acceptable</span>
                <span>Fallback after Hunt. Everything you left alone.</span>
                <span class="text-base-content/60">Default</span>
              </div>
              <div class="flex flex-col gap-1 rounded-lg border border-error/50 bg-error/15 p-2">
                <span class="font-semibold text-error">Banned</span>
                <span>Avoid. Taken only when every pack shown is banned.</span>
                <span class="text-base-content/60">Right click a floor</span>
              </div>
            </div>
            <p class="mt-2">To reorder a floor's list, click its pack on the likely path row, then drag the rows in the dropdown.</p>
            <div class="mt-2 flex items-start gap-2">
              <span class="shrink-0 pt-0.5 text-base-content/60">&rarr;</span>
              <div class="relative w-56 shrink-0">
                <span class="flex items-center gap-1 rounded-full border border-success/60 bg-success/10 pl-0.5 pr-1 py-0.5 text-[10px] shadow-sm ring-2 ring-primary/60">
                  <img src="/images/theme_packs/thm_3.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                  <span class="truncate font-medium flex-1">Flat-broke Gamblers</span>
                  <span class="shrink-0 rounded-full bg-base-content/10 px-1 text-[9px] text-base-content/60">+2</span>
                  <.icon name="lucide-chevron-down" class="size-3 shrink-0 rotate-180 text-base-content/50" />
                </span>
                <div class="relative mt-2 flex flex-col gap-0.5 rounded-lg border border-base-content/30 bg-base-200 p-1.5 shadow-2xl">
                  <span class="absolute -top-[5px] left-5 h-2 w-2 rotate-45 border-l border-t border-base-content/30 bg-base-200"></span>
                  <span class="px-1 text-[9px] uppercase tracking-wide text-base-content/50">Hunt</span>
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/30 pl-1 pr-1 py-0.5 text-[10px]" style="opacity: 1">
                    <span class="text-base-content/50">⠿</span>
                    <img src="/images/theme_packs/thm_3.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate flex-1">Flat-broke Gamblers</span>
                    <span class="shrink-0 text-[9px] text-base-content/60">1</span>
                    <span class="shrink-0 leading-none text-base-content/50"><.icon name="lucide-x" class="size-3.5" /></span>
                  </div>
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/30 pl-1 pr-1 py-0.5 text-[10px]" style="opacity: 0.75">
                    <span class="text-base-content/50">⠿</span>
                    <img src="/images/theme_packs/thm_12.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate flex-1">The Unchanging</span>
                    <span class="shrink-0 text-[9px] text-base-content/60">2</span>
                    <span class="shrink-0 leading-none text-base-content/50"><.icon name="lucide-x" class="size-3.5" /></span>
                  </div>
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/30 pl-1 pr-1 py-0.5 text-[10px]" style="opacity: 0.55">
                    <span class="text-base-content/50">⠿</span>
                    <img src="/images/theme_packs/thm_10.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate flex-1">Falling Flowers</span>
                    <span class="shrink-0 text-[9px] text-base-content/60">3</span>
                    <span class="shrink-0 leading-none text-base-content/50"><.icon name="lucide-x" class="size-3.5" /></span>
                  </div>
                </div>
              </div>
              <span class="pt-6 text-base-content/70">Top of the list is picked first.</span>
            </div>
          </section>
          <section>
            <h4 class="font-semibold">Normal, hard, extreme</h4>
            <div class="mt-2 grid grid-cols-6 gap-1 text-xs">
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1">
                  <span class="text-[11px] font-semibold text-base-content/70">F1</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] pointer-events-none btn-ghost border-base-300">go hard</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1">
                  <span class="text-[11px] font-semibold text-base-content/70">F2</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] pointer-events-none btn-ghost border-base-300">go hard</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1">
                  <span class="text-[11px] font-semibold text-base-content/70">F3</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] pointer-events-none btn-ghost border-base-300">go hard</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1 bg-warning/15">
                  <span class="text-[11px] font-semibold text-base-content/70">F4</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] pointer-events-none btn-warning">go hard</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1 bg-warning/15">
                  <span class="text-[11px] font-semibold text-base-content/70">F5</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] pointer-events-none btn-ghost border-base-300">go hard</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-t px-1 py-1 bg-warning/15">
                  <span class="text-[11px] font-semibold text-base-content/70">F6</span>
                  <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-ghost border-base-300">go extreme</span>
                </div>
            </div>
            <div class="mt-2 flex flex-col gap-1">
              <p><span class="font-medium">Hard</span>: <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-warning pointer-events-none">go hard</span> on a floor makes it and everything after hard. Normal and hard have different theme packs, so priorities on one don't affect the other.</p>
              <p><span class="font-medium">Extreme</span>: <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-ghost border-base-300 pointer-events-none">go extreme</span> on F6 continues into F6-15 after the F5 boss. Makes F1 <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-warning pointer-events-none">go hard</span>.</p>
            </div>
          </section>
          <section>
            <h4 class="font-semibold">Search</h4>
            <p>When <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-error pointer-events-none">search</span> is on, never resort to backups. Find the top priority pack in pack search after exhausting refreshes. Costs <span class="inline-flex items-center gap-1 rounded-full bg-base-300 px-1.5 py-0.5 text-[10px] font-medium align-middle"><img src="/images/icons/starlight.webp" alt="Starlight" class="h-3 w-3" />starlight</span> for the run if used.</p>
          </section>
        </div>
        <div class="modal-action mt-0">
          <button phx-click="toggle_help" class="btn btn-sm">Close</button>
        </div>
      </div>
      <div class="modal-backdrop" phx-click="toggle_help"></div>
    </div>
  <% end %>
</div>
