<div id="team-editor" phx-hook="TeamNavMemory" data-team={@editing_id} data-pane={@pane} class="flex flex-col h-full gap-2 overflow-hidden">
  <div class="grid grid-cols-1 grid-rows-[minmax(0,1fr)_minmax(0,2fr)] min-[1200px]:grid-cols-[24fr_76fr] min-[1200px]:grid-rows-1 gap-2 flex-1 min-h-0">

    <%!-- Left: Team List --%>
    <div class="card bg-base-100 shadow-lg flex flex-col overflow-hidden" style="backdrop-filter: none">
      <div class="card-body p-3 flex flex-col flex-1 min-h-0">
        <div class="flex items-center gap-3 mb-2">
          <h2 class="card-title text-lg">Teams</h2>
          <span class="badge badge-neutral badge-sm"><%= length(@teams) %></span>
          <.link patch={profiles_toggle_path(@editing_id, @pane)}
                 class={"btn btn-sm " <> if(@pane == "profiles", do: "btn-primary", else: "btn-outline")}>Sinner Profiles</.link>

          <%= cond do %>
            <% @phase == :idle -> %>
              <button type="button" phx-click="prepare_lineups"
                      title="Select each team in the Lux EXP team select and set its sinner order to the first lineup, then return home"
                      class="btn btn-sm btn-outline">Prepare Lineups</button>
            <% @run_kind == :prepare_lineups -> %>
              <button type="button" phx-click="cancel_run" class="btn btn-sm btn-error btn-outline">Cancel</button>
              <span class="flex items-center gap-1 text-sm text-base-content/60">
                <span class="loading loading-spinner loading-xs"></span> Running…
              </span>
            <% true -> %>
              <div class="tooltip tooltip-bottom" data-tip={running_label(@run_kind)}>
                <button type="button" disabled class="btn btn-sm btn-outline">Prepare Lineups</button>
              </div>
              <span class="loading loading-spinner loading-xs text-base-content/60"></span>
          <% end %>
        </div>

        <div class="@container overflow-y-auto flex-1 min-h-0">
          <table id="team-list" phx-hook="SortableList" data-sort-event="reorder_teams" class="table table-xs table-pin-rows">
            <thead>
              <tr>
                <th>Name</th>
                <th>Team</th>
                <th></th>
                <th></th>
              </tr>
            </thead>
            <%= for team <- @teams do %>
              <tbody id={"team-row-#{team.id}"} data-sort-id={team.id}>
                <% selected? = @editing_id == team.id %>
                <tr phx-click="click_team" phx-value-id={team.id}
                    class={"cursor-pointer hover:bg-base-200 " <> if(selected?, do: "bg-primary/10 border-l-2 border-primary", else: "")}>
                  <td class="font-mono text-xs">
                    <span data-sort-handle class="cursor-grab text-base-content/40 pr-1" title="Drag to reorder">⠿</span><%= team.name %>
                  </td>
                  <td class="text-xs text-base-content/60 @max-[26rem]:w-full @max-[26rem]:max-w-0 @max-[26rem]:min-w-14">
                    <span class="inline-flex flex-wrap items-center gap-x-2 @max-[26rem]:hidden">
                      <img :for={hook <- team.hooks} src={Teams.hook_icon(hook) || Teams.default_hook_icon()} title={Teams.hook_label(hook)} class="size-4 object-contain" />
                      <img :if={team.hooks == []} src={Teams.default_hook_icon()} class="size-4 object-contain" />
                      <% icons = profile_icons(team.profile_ids, @profiles_by_id, @locator_thumbs) %>
                      <img :for={icon <- icons} src={icon.src} title={icon.name} class="h-4 w-auto rounded object-contain" />
                    </span>
                    <span class="hidden whitespace-nowrap overflow-hidden text-ellipsis @max-[26rem]:block" title={Enum.map_join(team.hooks, ", ", &Teams.hook_label/1)}>
                      <img :for={hook <- team.hooks} src={Teams.hook_icon(hook) || Teams.default_hook_icon()}
                           class="inline-block size-4 object-contain align-middle mr-1" />
                      <img :if={team.hooks == []} src={Teams.default_hook_icon()} class="inline-block size-4 object-contain align-middle" />
                      <img :for={icon <- profile_icons(team.profile_ids, @profiles_by_id, @locator_thumbs)} src={icon.src} title={icon.name}
                           class="inline-block h-4 w-auto rounded object-contain align-middle mr-1" />
                    </span>
                  </td>
                  <td>
                    <div class="join">
                      <button :for={{pane, label} <- [{"battle", "Battle"}, {"packs", "Packs"}, {"gifts", "Gifts"}]}
                              type="button" phx-click={JS.patch(~p"/teams?team=#{team.id}&pane=#{pane}")} title={label}
                              class={"btn btn-xs btn-square join-item " <> if(selected? and @pane == pane, do: "btn-primary", else: "btn-ghost text-base-content/50")}>
                        <.pane_icon pane={pane} class="h-3.5 w-3.5" />
                      </button>
                    </div>
                  </td>
                  <td>
                    <%= if team.missing != [] do %>
                      <div class="tooltip" data-tip={"Missing: " <> Enum.map_join(team.missing, ", ", &missing_label/1)}>
                        <span class="badge badge-warning badge-xs">!</span>
                      </div>
                    <% end %>
                  </td>
                </tr>
                <tr :if={selected? and @expanded?} class="bg-base-200/40 border-l-2 border-primary">
                  <td colspan="4" class="p-2">
                    <div class="flex flex-col gap-2">
                      <div class="flex items-start gap-2">
                        <.form for={@form} class="w-1/2" phx-change="validate_team" phx-submit="validate_team">
                          <input type="text" name="team[name]" value={@form[:name].value} placeholder="Team name"
                                 class={"input input-bordered input-sm w-full font-semibold " <> if(@form[:name].errors != [], do: "input-error", else: "")} />
                          <%= if err = List.first(@form[:name].errors) do %>
                            <span class="text-xs text-error"><%= elem(err, 0) %></span>
                          <% end %>
                        </.form>
                        <button type="button" phx-click="duplicate_team" phx-value-id={team.id}
                                title="Copy this team, keeping its hook and plans"
                                class="btn btn-sm btn-ghost ml-auto">Dup</button>
                        <button :if={TeamTemplates.writable?()} type="button" phx-click="new_team_template" phx-value-id={team.id}
                                title="Add a template holding a copy of this team's hooks and active plans"
                                class="btn btn-sm btn-ghost">New template from</button>
                        <button type="button" phx-click="delete_team" phx-value-id={team.id}
                                data-confirm={"Delete '#{team.name}'?"}
                                class="btn btn-sm btn-ghost text-error">Del</button>
                      </div>

                      <div class="flex flex-col gap-1">
                        <div class="flex items-center text-xs">
                          <span class="font-medium">Team Selectors</span>
                          <div class="ml-auto" phx-click-away={@editing_hooks? && "close_edit_hooks"}>
                            <button id="edit-hooks-button" type="button" phx-click="toggle_edit_hooks"
                                    class="btn btn-xs btn-outline btn-primary gap-1">
                              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" /><path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" /></svg>
                              Edit
                            </button>
                        <div :if={@editing_hooks?} id="edit-hooks-popup" popover="manual" phx-hook="AnchoredPopup" data-anchor="edit-hooks-button" class="z-30 rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg">
                          <div class="columns-3 gap-3">
                            <div :for={{group, hooks} <- @team_hooks} data-group={group} class="break-inside-avoid mb-2">
                              <div class="px-1 pb-0.5 text-[10px] font-semibold uppercase tracking-wide text-base-content/50"><%= group %></div>
                              <button :for={h <- hooks} type="button" phx-click="toggle_team_hook" phx-value-hook={h}
                                      class={"btn btn-xs w-full justify-start font-mono " <> if(h in @hooks, do: "btn-primary", else: "btn-ghost")}>
                                <img :if={Teams.hook_icon(h)} src={Teams.hook_icon(h)} class="size-4 object-contain" /><%= Teams.hook_label(h) %>
                              </button>
                            </div>
                          </div>
                        </div>
                          </div>
                        </div>
                        <div id="team-hooks" phx-hook="SortableList" data-sort-event="reorder_team_hooks" class="flex flex-col gap-1">
                          <%= for {hook, index} <- Enum.with_index(@hooks) do %>
                            <div id={"team-hook-#{index}-#{hook}"} data-sort-id={index} class="flex items-center gap-1">
                              <span data-sort-handle class="cursor-grab text-base-content/40 px-0.5" title="Drag to reorder">⠿</span>
                              <span class="text-xs text-base-content/50 w-5 text-right"><%= index + 1 %>.</span>
                              <div class="flex-1">
                                <.hook_picker groups={@team_hooks} used={@hooks} event="replace_team_hook" index={index} label={Teams.hook_label(hook)} icon={Teams.hook_icon(hook)} class="btn-ghost" />
                              </div>
                              <button type="button" phx-click="remove_team_hook" phx-value-index={index}
                                      class="btn btn-ghost btn-xs text-error">✕</button>
                            </div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </td>
                </tr>
              </tbody>
            <% end %>
            <tbody :if={@teams == []}>
              <tr>
                <td colspan="4" class="text-center text-base-content/40 py-4">No teams yet. Create one.</td>
              </tr>
            </tbody>
          </table>
          <div id="new-team-menu" class="hidden mt-2 rounded-box border border-base-300 bg-base-100 p-1 flex flex-col gap-0.5">
            <button type="button" phx-click={JS.push("new_team") |> JS.hide(to: "#new-team-menu")} class="btn btn-ghost btn-sm justify-start font-mono">Blank team</button>
            <div :for={template <- @team_templates} class="flex items-center gap-1 rounded hover:bg-base-200">
              <button type="button" phx-click={JS.push("new_team", value: %{template: template.id}) |> JS.hide(to: "#new-team-menu")}
                      title={"Create a team from the template '#{template.name}'"}
                      class="flex-1 min-w-0 flex items-center gap-1.5 px-2 py-1 text-left">
                <span class="min-w-0 truncate font-mono text-xs"><%= template.name %></span>
                <img :for={hook <- template.hooks} src={Teams.hook_icon(hook) || Teams.default_hook_icon()} class="size-4 shrink-0 object-contain" />
              </button>
              <button :if={TeamTemplates.writable?()} type="button" phx-click="delete_team_template" phx-value-id={template.id}
                      data-confirm={"Delete the template '#{template.name}'?"} class="btn btn-xs btn-ghost text-error">Del</button>
            </div>
          </div>
          <button type="button" phx-click={JS.toggle(to: "#new-team-menu")} class="btn btn-primary btn-sm w-full mt-2">+ New Team ▾</button>
        </div>
      </div>
    </div>

    <%= cond do %>
    <% @pane == "profiles" -> %>
    <%= live_render(@socket, StarlightBotWeb.Live.SinnerProfilesLive, id: "sinner-profiles", container: {:div, class: "flex flex-col min-h-0 min-w-0"}) %>
    <% @editing_id -> %>
    <div class="flex flex-col min-h-0 min-w-0">
      <div :if={@pane == "stats"} class="card bg-base-100 shadow-lg flex-1 min-h-0 overflow-y-auto">
        <div class="card-body p-3 gap-3">
          <.pane_tabs team_id={@editing_id} pane="stats" counts={@tab_counts} />
          <% budget = starlight_budget(@gift_plans, @pack_plans, @theme_packs, @selected_ids, @budget_inputs) %>
          <h3 class="font-medium text-sm">Expected Starlight</h3>
          <form phx-change="budget_change" class="flex flex-col max-w-3xl rounded-xl border border-base-300 bg-base-200 shadow-md divide-y divide-base-300 font-mono">
            <div class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2" title="Every run starts with this">
              <span class="text-success text-center">+</span>
              <span class="font-sans text-sm">Base</span>
              <span class="text-sm text-success text-right"><%= budget.income.base %></span>
            </div>
            <div class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2" title="Sinners this team doesn't lock in, so they rest a full 5 charges. Rest bonus is 1 per charge. Also sets the multiplier.">
              <span class="text-success text-center">+</span>
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-sans text-sm w-24">Rest bonus</span>
                <input type="range" name="free_sinners" min="0" max={StarlightBudget.max_free_sinners()} step="1" value={@budget_inputs.free_sinners}
                       class="range range-success range-xs w-40" />
                <span class="text-xs text-base-content/60"><%= @budget_inputs.free_sinners %> free × <%= StarlightBudget.rest_per_free_sinner() %></span>
                <label class="flex items-center gap-1 font-sans text-xs text-base-content/60 cursor-pointer" title="On: free sinners are 12 minus the first lineup. Moving the slider turns this off and saves your value for the team.">
                  <input type="checkbox" name="estimate" checked={@budget_inputs.estimate?} class="checkbox checkbox-success checkbox-xs" />
                  Estimate from lineup
                </label>
              </div>
              <span class="text-sm text-success text-right"><%= budget.income.sinner_bonus %></span>
            </div>
            <div class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2">
              <span class="text-success text-center">+</span>
              <div class="flex flex-col gap-1">
                <span class="font-sans text-sm">Exploration</span>
                <div class="flex flex-wrap items-stretch gap-1.5">
                  <span class="self-center text-base-content/40">⌊(</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center" title={floor_breakdown(budget.floors)}>
                    <span class="text-[10px] font-sans text-base-content/50">
                      Floor clears<%= if not budget.has_pack_plan?, do: " (no plan, all normal)" %>
                    </span>
                    <span class="text-sm"><%= budget.floor_total %></span>
                  </div>
                  <span class="self-center text-base-content/40">+</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center"
                       title={"#{StarlightBudget.railway_bonus()} per cleared Line theme pack. Expected Line packs per floor from the pack plan odds: #{railway_breakdown(budget.railway_by_floor)}"}>
                    <span class="text-[10px] font-sans text-base-content/50">
                      Railway (avg <%= :erlang.float_to_binary(budget.railway_packs, decimals: 2) %> packs)
                    </span>
                    <span class="text-sm"><%= :erlang.float_to_binary(budget.railway_packs * StarlightBudget.railway_bonus(), decimals: 1) %></span>
                  </div>
                  <span class="self-center text-base-content/40">) ×</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center" title="min(2, 1 + 0.017 × rest bonus), rounded down after multiplying">
                    <span class="text-[10px] font-sans text-base-content/50">Rest mult</span>
                    <span class="text-sm"><%= :erlang.float_to_binary(budget.rest_multiplier, decimals: 3) %></span>
                  </div>
                  <span class="self-center text-base-content/40">⌋</span>
                </div>
              </div>
              <span class="text-sm text-success text-right"><%= budget.income.exploration %></span>
            </div>
            <div phx-click="toggle_encounter_info" role="button" title="Click for how this is calculated"
                 class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60">
              <span class="text-success text-center">+</span>
              <span class="font-sans text-sm">
                Encounter rewards
                <span class="text-xs text-base-content/50">(avg <%= encounter_decimal(budget.encounter_pulls) %> starlight grabs)</span>
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-success text-right"><%= StarlightBudget.format(budget.income.encounters) %></span>
            </div>
            <div phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} title="Open the gift loadout"
                 class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60">
              <span class="text-error text-center">−</span>
              <span class="flex items-center gap-1.5 font-sans text-sm">
                Graces
                <img :for={grace <- budget.graces} src={"/images/graces/grace_#{grace.index}.webp"} title={grace.title} class="w-5 h-5 object-contain" />
              </span>
              <span class="text-sm text-error text-right"><%= if budget.has_gift_plan?, do: budget.costs.grace, else: "—" %></span>
            </div>
            <div phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} title="Open the gift loadout"
                 class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60">
              <span class="text-error text-center">−</span>
              <span class="flex items-center gap-1.5 font-sans text-sm">
                Gift search (<%= budget.gift_searches %>)
                <img :for={name <- budget.gift_search_names} :if={@gifts_by_name[name]} src={@gifts_by_name[name].image_path} title={name}
                     class="w-4 h-4 rounded object-cover bg-slate-500/40 ring-1 ring-slate-400/40" />
              </span>
              <span class="text-sm text-error text-right"><%= if budget.has_gift_plan?, do: budget.costs.gift_search, else: "—" %></span>
            </div>
            <div phx-click="toggle_search_info" role="button"
                 class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-200"
                 title={"Click for how this is calculated. 20 for the first search in the run, 10 more for each after. A floor only searches when every refresh misses. Searches in a run: #{search_breakdown(budget)}"}>
              <span class="text-error text-center">−</span>
              <span class="font-sans text-sm">
                Pack search
                <span class="text-xs text-base-content/50">(avg <%= :erlang.float_to_binary(budget.pack_searches, decimals: 2) %> of <%= budget.max_pack_searches %> floors)</span>
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-error text-right"><%= StarlightBudget.format(budget.costs.pack_search) %></span>
            </div>
            <div class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 rounded-b-xl border-t-2 " <> if(budget.net >= 0, do: "!border-success", else: "!border-error")}>
              <span class="text-center text-base-content/60">=</span>
              <span class="font-sans text-sm font-semibold">Expected starlight</span>
              <span class={"flex items-center justify-end gap-1 text-lg font-bold " <> if(budget.net >= 0, do: "text-success", else: "text-error")}>
                <img src={~p"/images/icons/starlight.webp"} alt="Starlight" class="h-5 w-5" />
                <%= StarlightBudget.format(budget.net) %>
              </span>
            </div>
          </form>
          <div :if={@show_encounter_info} class="modal modal-open" phx-window-keydown="toggle_encounter_info" phx-key="Escape">
            <div class="modal-box max-w-3xl max-h-[85vh] flex flex-col gap-3 text-sm">
              <h2 class="font-bold text-base">How the encounter reward starlight is calculated</h2>
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">1. How many encounter reward screens a floor gives</h4>
                  <p class="text-xs text-base-content/60">Every floor traverses 2 events, 1 shop and 1 boss. The boss always gives an encounter reward, except the F5 boss when the run stops there. A theme pack with more than 4 nodes adds floating nodes: on F1 they are all regular encounters, on F2 and later two thirds are regular and one third focused. Each kind rolls its own chance of giving a reward. The number of floating nodes is the expected value over the theme pack odds from the pack plan.</p>
                  <div class="rounded-lg bg-base-200 p-2 font-mono text-xs flex flex-col gap-0.5">
                    <span>screens = boss + regular nodes × regular chance + focused nodes × focused chance</span>
                    <span class="text-base-content/50">regular chance: F1 7.5%, F2 10%, F3 10%, F4 12.5%, F5 12.5%</span>
                    <span class="text-base-content/50">focused chance: F2 20%, F3 20%, F4 25%, F5 25%</span>
                  </div>
                </section>
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">2. How often a screen ends in starlight</h4>
                  <p class="text-xs text-base-content/60">A screen shows 3 of the 5 rewards, so there are 10 possible layouts. The bot takes the highest priority reward on the screen. With starlight at position p in the gift plan's encounter reward order, it is picked in the layouts that contain it and none of the options above it: C(5 − p, 2) of the 10. Position 1 wins 6 of 10 layouts, position 2 wins 3, position 3 wins 1, and position 4 or 5 never win. Starlight pays 8 to 14, 11 on average.</p>
                </section>
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">3. Per floor</h4>
                  <table class="table table-xs font-mono">
                    <thead>
                      <tr><th>Floor</th><th class="text-right">Floating</th><th class="text-right">Boss</th><th class="text-right">Regular</th><th class="text-right">Focused</th><th class="text-right">Screens</th><th class="text-right">Starlight pos</th><th class="text-right">Picked</th><th class="text-right">Starlight</th></tr>
                    </thead>
                    <tbody>
                      <tr :for={row <- budget.encounter_floors}>
                        <td>F<%= row.floor %></td>
                        <td class="text-right"><%= encounter_decimal(row.floating) %></td>
                        <td class="text-right"><%= encounter_decimal(row.screens.boss) %></td>
                        <td class="text-right"><%= encounter_decimal(row.screens.regular) %></td>
                        <td class="text-right"><%= encounter_decimal(row.screens.focused) %></td>
                        <td class="text-right"><%= encounter_decimal(row.screens.total) %></td>
                        <td class="text-right"><%= row.position || "none" %></td>
                        <td class="text-right"><%= encounter_pct(row.chance) %></td>
                        <td class="text-right text-success"><%= encounter_decimal(row.starlight, 1) %></td>
                      </tr>
                      <tr class="font-semibold">
                        <td colspan="5">Total</td>
                        <td class="text-right"><%= encounter_decimal(budget.encounter_screens) %></td>
                        <td colspan="2"></td>
                        <td class="text-right text-success"><%= encounter_decimal(budget.encounter_starlight, 1) %></td>
                      </tr>
                    </tbody>
                  </table>
                  <p class="text-xs">Average starlight grabs per run: <span class="font-mono font-semibold"><%= encounter_decimal(budget.encounter_pulls) %></span> from <%= encounter_decimal(budget.encounter_screens) %> encounter reward screens.</p>
                  <p class="text-xs text-base-content/60">Starlight = screens × picked × 11. The starlight position follows the gift plan's encounter reward order for each floor, or the default order when no gift plan is selected. The F5 boss only counts when the pack plan goes extreme. Assumes the route never takes risky nodes. Simplification: on F5 one fewer theme pack is assumed to be shown than the graces give, to account for one of the theme packs typically being from the latest event.</p>
                </section>
              </div>
              <div class="modal-action mt-0">
                <button type="button" phx-click="toggle_encounter_info" class="btn btn-sm">Close</button>
              </div>
            </div>
            <div class="modal-backdrop" phx-click="toggle_encounter_info"></div>
          </div>
          <div :if={@show_search_info} class="modal modal-open" phx-window-keydown="toggle_search_info" phx-key="Escape">
            <div class="modal-box max-w-2xl max-h-[85vh] flex flex-col gap-3 text-sm">
              <h2 class="font-bold text-base">How the pack search cost is calculated</h2>
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <p>Pack search is only used on floors where search is turned on in the pack plan, and only when it is needed. The bot refreshes first. It searches only if every look, including the last one after the refreshes run out, shows none of your wanted packs. A floor where a refresh finds your pack costs nothing.</p>
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">1. Chance each search floor needs a search</h4>
                  <p class="text-xs text-base-content/60">q<sup>L</sup>, where q is the chance one look misses every wanted pack and L is looks (refreshes + 1). It depends on the packs shown, the refreshes from your graces, and which wanted packs were already taken on earlier floors.</p>
                  <div :if={budget.search_floors == []} class="text-xs italic text-base-content/50">No search floors in this pack plan, so no search cost.</div>
                  <div :for={floor <- budget.search_floors} class="flex items-center gap-2 font-mono text-xs">
                    <span class="w-8">F<%= floor %></span>
                    <div class="h-2 flex-1 rounded-full bg-base-300 overflow-hidden"><div class="h-full bg-error/70" style={"width: #{budget.search_by_floor[floor] * 100}%"}></div></div>
                    <span class="w-12 text-right"><%= search_pct(budget.search_by_floor[floor]) %></span>
                  </div>
                </section>
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">2. How many searches a whole run needs</h4>
                  <p class="text-xs text-base-content/60">Every combination of earlier outcomes is followed through the floors and weighted by how likely it is, which gives the chance of exactly 0, 1, 2 or more searches.</p>
                  <div :for={{count, prob} <- Enum.sort(budget.search_counts)} class="flex items-center gap-2 font-mono text-xs">
                    <span class="w-24"><%= count %> <%= if count == 1, do: "search", else: "searches" %></span>
                    <div class="h-2 flex-1 rounded-full bg-base-300 overflow-hidden"><div class="h-full bg-primary/70" style={"width: #{prob * 100}%"}></div></div>
                    <span class="w-12 text-right"><%= search_pct(prob) %></span>
                    <span class="w-16 text-right text-error">cost <%= search_cost(count) %></span>
                  </div>
                </section>
                <section class="flex flex-col gap-1">
                  <h4 class="font-semibold">3. Average cost</h4>
                  <p class="text-xs text-base-content/60">The first search costs 20 and each one after costs 10 more, so k searches cost 20k + 10·k(k−1)/2. The cost grows faster than the count, so the average cost is each count's cost weighted by its chance, not the cost of the average count.</p>
                  <div class="rounded-lg bg-base-200 p-2 font-mono text-xs flex flex-col gap-1">
                    <span><%= Enum.map_join(Enum.sort(budget.search_counts), " + ", fn {count, prob} -> "#{search_pct(prob)} × #{search_cost(count)}" end) %></span>
                    <span class="font-semibold">= <%= :erlang.float_to_binary(budget.search_average_cost, decimals: 1) %> average cost, shown as <%= StarlightBudget.format(budget.costs.pack_search) %></span>
                    <span class="text-base-content/50">Average searches per run: <%= :erlang.float_to_binary(budget.pack_searches, decimals: 2) %></span>
                  </div>
                </section>
                <p class="text-xs text-base-content/60">Search floors count only through floor 5. When search finds the pack, the top available wanted pack is credited at 100% on that floor. Simplification: on F5 one fewer theme pack is assumed to be shown than the graces give, to account for one of the theme packs not playing nice on refresh.</p>
              </div>
              <div class="modal-action mt-0">
                <button type="button" phx-click="toggle_search_info" class="btn btn-sm">Close</button>
              </div>
            </div>
            <div class="modal-backdrop" phx-click="toggle_search_info"></div>
          </div>
        </div>
      </div>
      <div :for={pane <- ~w(battle packs gifts)} class={"flex-1 min-h-0 min-w-0 flex-col " <> if(pane == @pane, do: "flex", else: "hidden")}>
        <%= live_render(@socket, pane_view(pane), id: "pane-#{pane}-#{@editing_id}", session: %{"team_id" => @editing_id}, container: {:div, class: "flex flex-col flex-1 min-h-0 min-w-0"}) %>
      </div>
    </div>
    <% true -> %>
    <div class="card bg-base-100 shadow-lg flex items-center justify-center text-sm text-base-content/40">
      Select a team, or click + New Team.
    </div>
    <% end %>

  </div>
</div>
