<div id="team-editor" class="flex flex-col h-full gap-2 overflow-hidden">
  <div class="flex flex-col flex-1 min-h-0 min-w-0">

    <%= cond do %>
    <% @pane == "profiles" -> %>
    <%= live_render(@socket, StarlightBotWeb.Live.SinnerProfilesLive, id: "sinner-profiles", container: {:div, class: "flex flex-col flex-1 min-h-0 min-w-0"}) %>
    <% @editing_id -> %>
    <div class="flex flex-col flex-1 min-h-0 min-w-0">
      <div :if={@pane == "stats"} class="card bg-base-100 shadow-lg flex-1 min-h-0 overflow-hidden">
        <div class="card-body p-3 gap-3 flex-col xl:flex-row min-h-0 overflow-y-auto xl:overflow-hidden">
          <% budget = starlight_budget(@gift_plans, @pack_plans, @theme_packs, @selected_ids, @budget_inputs) %>
          <div class="w-full max-w-3xl min-w-0 shrink-0 xl:shrink xl:min-h-0 xl:overflow-y-auto flex flex-col gap-3">
          <h3 class="font-medium text-sm">Expected Starlight</h3>
          <form phx-change="budget_change" class="flex flex-col max-w-3xl rounded-xl border border-base-300 bg-base-200 shadow-md divide-y divide-base-300 font-mono">
            <div class="grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2">
              <span class="text-success text-center">+</span>
              <span class="font-sans text-sm">Base</span>
              <span class="text-sm text-success text-right"><%= budget.income.base %></span>
            </div>
            <div id="info-row-exploration" phx-click="show_info" phx-value-pane="exploration" role="button" class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :exploration, do: "bg-base-300/60", else: "")}>
              <span class="text-success text-center">+</span>
              <div class="flex flex-col gap-1">
                <span class="font-sans text-sm">Exploration</span>
                <div class="flex flex-wrap items-stretch gap-1.5">
                  <span class="self-center text-base-content/40">⌊(</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center" title={floor_breakdown(budget.floors)}>
                    <span class="text-[10px] font-sans text-base-content/50">
                      Floor clears<%= if not budget.has_pack_plan?, do: " (no plan, all normal)" %>
                    </span>
                    <span class="text-sm"><%= budget.floor_total %></span>
                  </div>
                  <span class="self-center text-base-content/40">+</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center"
                       title={"#{StarlightBudget.railway_bonus()} per cleared Line theme pack. Expected Line packs per floor from the pack plan odds: #{railway_breakdown(budget.railway_by_floor)}"}>
                    <span class="text-[10px] font-sans text-base-content/50">
                      Railway (avg <%= :erlang.float_to_binary(budget.railway_packs, decimals: 2) %> packs)
                    </span>
                    <span class="text-sm"><%= :erlang.float_to_binary(budget.railway_packs * StarlightBudget.railway_bonus(), decimals: 1) %></span>
                  </div>
                  <span class="self-center text-base-content/40">) ×</span>
                  <div class="rounded-lg border border-base-300 px-2 py-1 flex flex-col justify-center" title="min(2, 1 + 0.017 × rest bonus), rounded down after multiplying">
                    <span class="text-[10px] font-sans text-base-content/50">Rest mult</span>
                    <span class="text-sm"><%= :erlang.float_to_binary(budget.rest_multiplier, decimals: 3) %></span>
                  </div>
                  <span class="self-center text-base-content/40">⌋</span>
                </div>
              </div>
              <span class="text-sm text-success text-right"><%= budget.income.exploration %></span>
            </div>
            <div id="info-row-rest" phx-click="show_info" phx-value-pane="rest" role="button" class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :rest, do: "bg-base-300/60", else: "")}>
              <span class="text-success text-center">+</span>
              <div class="flex flex-col gap-2">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <span class="font-sans text-sm w-24 text-left">
                  Rest bonus
                  <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
                </span>
                <input type="range" onclick="event.stopPropagation()" name="free_sinners" min="0" max={StarlightBudget.max_free_sinners()} step="1" value={@budget_inputs.free_sinners}
                       class="range range-success range-xs w-40" />
                <span class="text-xs text-base-content/60"><%= @budget_inputs.free_sinners %> free × <%= StarlightBudget.rest_per_free_sinner() %></span>
                <label onclick="event.stopPropagation()" class="flex items-center gap-1 font-sans text-xs text-base-content/60 cursor-pointer" title="On: free sinners are 12 minus the first lineup. Moving the slider turns this off and saves your value for the team.">
                  <input type="checkbox" name="estimate" checked={@budget_inputs.estimate?} class="checkbox checkbox-success checkbox-xs" />
                  Estimate from lineup
                </label>
              </div>
              <div class="grid grid-cols-6 gap-2 w-fit" title={"#{@budget_inputs.free_sinners} of #{StarlightBudget.max_free_sinners()} sinners fully rested"}>
                <div :for={i <- 1..StarlightBudget.max_free_sinners()} class="flex flex-col items-center">
                  <span class={"font-display text-2xl font-semibold leading-none mb-1 " <> if(i <= @budget_inputs.free_sinners, do: "text-yellow-400", else: "text-base-content/30")}>
                    +<%= if i <= @budget_inputs.free_sinners, do: StarlightBudget.rest_per_free_sinner(), else: 0 %>
                  </span>
                  <span class="h-0.5 w-3 rounded-t-sm bg-base-content/30"></span>
                  <div class="flex flex-col-reverse gap-0.5 rounded border border-base-content/30 p-0.5">
                    <span :for={_ <- 1..StarlightBudget.rest_per_free_sinner()}
                          class={"h-1 w-5 rounded-[1px] " <> if(i <= @budget_inputs.free_sinners, do: "bg-yellow-400", else: "bg-base-300")}></span>
                  </div>
                </div>
              </div>
              </div>
              <span class="text-sm text-success text-right"><%= budget.income.sinner_bonus %></span>
            </div>
            <div id="info-row-encounter" phx-click="show_info" phx-value-pane="encounter" role="button"
                 class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :encounter, do: "bg-base-300/60", else: "")}>
              <span class="text-success text-center">+</span>
              <span class="font-sans text-sm">
                Encounter rewards
                <span class="text-xs text-base-content/50">(avg <%= encounter_decimal(budget.encounter_pulls) %> starlight grabs)</span>
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-success text-right"><%= StarlightBudget.format(budget.income.encounters) %></span>
            </div>
            <div id="info-row-search" phx-click="show_info" phx-value-pane="search" role="button"
                 class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :search, do: "bg-base-300/60", else: "")}>
              <span class="text-error text-center">−</span>
              <span class="font-sans text-sm">
                Pack search
                <span class="text-xs text-base-content/50">(avg <%= :erlang.float_to_binary(budget.pack_searches, decimals: 2) %> of <%= budget.max_pack_searches %> floors)</span>
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-error text-right"><%= StarlightBudget.format(budget.costs.pack_search) %></span>
            </div>
            <div id="info-row-grace" phx-click="show_info" phx-value-pane="grace" role="button"
                 class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :grace, do: "bg-base-300/60", else: "")}>
              <span class="text-error text-center">−</span>
              <span class="flex items-center gap-1.5 font-sans text-sm">
                Graces
                <img :for={grace <- budget.graces} src={"/images/graces/grace_#{grace.index}.webp"} title={grace.title} class="w-5 h-5 object-contain" />
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-error text-right"><%= if budget.has_gift_plan?, do: budget.costs.grace, else: "—" %></span>
            </div>
            <div id="info-row-gift_search" phx-click="show_info" phx-value-pane="gift_search" role="button"
                 class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 cursor-pointer hover:bg-base-300/60 " <> if(@info_pane == :gift_search, do: "bg-base-300/60", else: "")}>
              <span class="text-error text-center">−</span>
              <span class="flex items-center gap-1.5 font-sans text-sm">
                Gift search (<%= budget.gift_searches %>)
                <img :for={name <- budget.gift_search_names} :if={@gifts_by_name[name]} src={@gifts_by_name[name].image_path} title={name}
                     class="w-4 h-4 rounded object-cover bg-slate-500/40 ring-1 ring-slate-400/40" />
                <span class="ml-0.5 inline-flex h-3 w-3 items-center justify-center rounded-full border border-current align-middle text-[8px] italic leading-none">i</span>
              </span>
              <span class="text-sm text-error text-right"><%= if budget.has_gift_plan?, do: budget.costs.gift_search, else: "—" %></span>
            </div>
            <div class={"grid grid-cols-[1.25rem_1fr_5rem] items-center gap-x-3 px-3 py-2 rounded-b-xl border-t-2 " <> if(budget.net >= 0, do: "!border-success", else: "!border-error")}>
              <span class="text-center text-base-content/60">=</span>
              <span class="font-sans text-sm font-semibold">Expected starlight</span>
              <span class={"flex items-center justify-end gap-1 text-lg font-bold " <> if(budget.net >= 0, do: "text-success", else: "text-error")}>
                <img src={~p"/images/icons/starlight.webp"} alt="Starlight" class="h-5 w-5" />
                <%= StarlightBudget.format(budget.net) %>
              </span>
            </div>
          </form>
          </div>
          <aside :if={@info_pane == :grace} id="info-pane-grace" phx-hook="InfoArrow" data-row="info-row-grace" class="relative w-full max-w-3xl xl:w-fit xl:self-start min-w-0 shrink-0 flex flex-col rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <button type="button" phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} class="btn btn-primary btn-sm gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"/><path d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"/></svg>
              Edit in gift loadout
            </button>
          </aside>
          <aside :if={@info_pane == :gift_search} id="info-pane-gift_search" phx-hook="InfoArrow" data-row="info-row-gift_search" class="relative w-full max-w-3xl xl:w-fit xl:self-start min-w-0 shrink-0 flex flex-col rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <button type="button" phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} class="btn btn-primary btn-sm gap-1.5">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"/><path d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"/></svg>
              Edit in gift loadout
            </button>
          </aside>
          <aside :if={@info_pane == :rest} id="info-pane-rest" phx-hook="InfoArrow" data-row="info-row-rest" class="relative w-full max-w-3xl xl:max-w-[40rem] xl:flex-1 xl:self-start xl:max-h-full min-w-0 shrink-0 xl:shrink xl:min-h-0 flex flex-col gap-3 text-sm rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <div class="flex flex-col gap-3 min-h-0 flex-1">
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <p>How much starlight you get by switching your team up regularly.</p>
                <p>For every run an identity is not used, it gets <span class="font-semibold text-yellow-400">+1</span> rest bonus, up to <span class="font-semibold text-yellow-400">+5</span>. Then when you use the identity, this bonus not only flat out gives you extra starlight for the number (<span class="font-semibold text-yellow-400">+60</span> if everyone's fully rested) but also pumps up the multiplier for exploration starlight, so the value of being fully rested isn't just <span class="font-semibold text-yellow-400">+5</span>, it's often something like <span class="font-semibold text-yellow-400">+8</span> or <span class="font-semibold text-yellow-400">+9</span> per sinner for a normal run.</p>
                <p>The idea is it encourages players to use more than one team, and if you really want the full +60, you gotta cycle. The bot accounts for this when you set up multiple teams on the md run page.</p>
                <p>But, if you just wanna spam the same team repeatedly, you can still take advantage of rest bonus. Take your team, copy-paste it in limbus under different names, and change the backup units to be unique across every instance. The backups aren't load-bearing, so they should be chipping in rest bonus. This is also how starlight positive/neutral/negative is usually communicated as a definition: if a team demands 6 identities, the other 6 free ones are assumed to be cycled.</p>
              </div>
            </div>
          </aside>
          <aside :if={@info_pane == :exploration} id="info-pane-exploration" phx-hook="InfoArrow" data-row="info-row-exploration" class="relative w-full max-w-3xl xl:max-w-[40rem] xl:flex-1 xl:self-start xl:max-h-full min-w-0 shrink-0 xl:shrink xl:min-h-0 flex flex-col gap-3 text-sm rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <div class="flex flex-col gap-3 min-h-0 flex-1">
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <p>How much starlight your floor choices get you.</p>
                <p>Floors give starlight equal to the floor number, and you multiply by 4 if you're on a hard floor:</p>
                <table class="table table-xs font-mono">
                  <thead>
                    <tr><th></th><th class="text-right">F1</th><th class="text-right">F2</th><th class="text-right">F3</th><th class="text-right">F4</th><th class="text-right">F5</th><th class="text-right">Total</th></tr>
                  </thead>
                  <tbody>
                    <tr><td class="font-sans">Normal</td><td class="text-right">1</td><td class="text-right">2</td><td class="text-right">3</td><td class="text-right">4</td><td class="text-right">5</td><td class="text-right font-semibold">15</td></tr>
                    <tr><td class="font-sans">Hard</td><td class="text-right">4</td><td class="text-right">8</td><td class="text-right">12</td><td class="text-right">16</td><td class="text-right">20</td><td class="text-right font-semibold">60</td></tr>
                  </tbody>
                </table>
                <p>Refraction railway packs (the Line ones) give +5 starlight each. So a run that routes Line 2 and Line 1 at the end nets +10. Also, the RR packs only show up in hard mode, so an F5 normal earning you 5 starlight vs an RR F5 pack earning you 25 starlight actually sees a +20 difference.</p>
                <p>All of this is added up, and multiplied by the rest multiplier (1x-2x, where 2x is if everyone's rested)</p>
              </div>
            </div>
          </aside>
          <aside :if={@info_pane == :encounter} id="info-pane-encounter" phx-hook="InfoArrow" data-row="info-row-encounter" class="relative w-full max-w-3xl xl:max-w-[40rem] xl:flex-1 xl:self-start xl:max-h-full min-w-0 shrink-0 xl:shrink xl:min-h-0 flex flex-col gap-3 text-sm rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <div class="flex flex-col gap-3 min-h-0 flex-1">
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <p>Over-simplified calculation of how much starlight you'll get from encounter rewards. Heavily dependent on putting starlight as a priority in your gift plan. <button type="button" phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} class="btn btn-primary btn-xs h-5 min-h-0 gap-1 px-1.5 align-middle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3"><path d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"/><path d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"/></svg>Edit in gift loadout</button></p>
                <p>Basically, assume you'll see 4-6 encounter rewards per run (4 guaranteed from F1-F4 boss nodes), and 60% of the time that encounter reward will have a starlight option. If you prioritize it, you might be seeing an extra 10-30 starlight per run, but it can botch the run if you skimp out on getting cost from rewards that would've gone to your tier 4 fusions. Most plans default to leaving it lower priority than cost for this reason. Prioritize it if you have a good reason to.</p>
              </div>
            </div>
          </aside>
          <aside :if={@info_pane == :search} id="info-pane-search" phx-hook="InfoArrow" data-row="info-row-search" class="relative w-full max-w-3xl xl:max-w-[40rem] xl:flex-1 xl:self-start xl:max-h-full min-w-0 shrink-0 xl:shrink xl:min-h-0 flex flex-col gap-3 text-sm rounded-xl border border-base-300 bg-base-200 p-3">
            <span data-arrow class="hidden xl:block absolute -left-[7px] top-6 h-3.5 w-3.5 -translate-y-1/2 rotate-45 border-b border-l border-base-300 bg-base-200"></span>
            <div class="flex flex-col gap-3 min-h-0 flex-1">
              <div class="overflow-y-auto flex flex-col gap-4 pr-1">
                <p>Average starlight you'll spend on pack search with this team. Calculated from the percentage chance of finding your top packs, as seen on the <button type="button" phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=packs")} class="btn btn-primary btn-xs h-5 min-h-0 gap-1 px-1.5 align-middle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3"><path d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"/><path d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"/></svg>Theme pack planner</button>.</p>
                <div class="flex flex-col gap-1 rounded-lg border border-base-300 bg-base-100 p-2 w-64">
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/10 pl-0.5 pr-1 py-0.5 text-[10px]">
                    <img src="/images/theme_packs/thm_3.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate font-medium flex-1">Flat-broke Gamblers</span>
                    <span class="shrink-0 font-mono text-[11px] font-bold text-success">42%</span>
                  </div>
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/10 pl-0.5 pr-1 py-0.5 text-[10px]">
                    <img src="/images/theme_packs/thm_12.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate font-medium flex-1">The Unchanging</span>
                    <span class="shrink-0 font-mono text-[11px] font-bold text-success">31%</span>
                  </div>
                  <div class="flex items-center gap-1 rounded-full border border-success/60 bg-success/10 pl-0.5 pr-1 py-0.5 text-[10px]">
                    <img src="/images/theme_packs/thm_10.webp" class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                    <span class="truncate font-medium flex-1">Falling Flowers</span>
                    <span class="shrink-0 font-mono text-[11px] font-bold text-success">18%</span>
                  </div>
                </div>
                <p>To keep this number low, be sure your graces give you extra refreshes and theme pack selections, i.e. use graces <span class="badge badge-ghost badge-sm gap-1 align-middle"><img src="/images/graces/grace_0.webp" alt="" class="h-3.5 w-3.5 rounded-full object-cover" />1</span> and <span class="badge badge-ghost badge-sm gap-1 align-middle"><img src="/images/graces/grace_2.webp" alt="" class="h-3.5 w-3.5 rounded-full object-cover" />3</span>. You can also simply not <span class="btn btn-xs h-4 min-h-0 px-1 text-[9px] btn-error pointer-events-none">search</span>, but honestly it's easier to comp teams when you know what you'll be fighting, and you'll still be starlight neutral/positive if you do it right. <button type="button" phx-click={JS.patch(~p"/teams?team=#{@editing_id}&pane=gifts") |> JS.dispatch("click", to: "#gift-loadout-btn")} class="btn btn-primary btn-xs h-5 min-h-0 gap-1 px-1.5 align-middle"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3"><path d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z"/><path d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z"/></svg>Edit in gift loadout</button></p>
                <div class="relative mt-2 flex flex-col gap-4 rounded-l-xl border-y-2 border-l-2 border-error/70 pb-3 pl-3 pt-5">
                  <span class="badge badge-error badge-sm absolute -top-3 -left-0.5 rounded-b-none rounded-tl-xl font-semibold uppercase">Your current plan</span>
                <section class="flex flex-col gap-2">
                  <p>Chance of searching on each floor:</p>
                  <div :for={row <- budget.search_rows} class="flex items-center gap-2 font-mono text-xs">
                    <span class="w-6">F<%= row.floor %></span>
                    <span class="badge badge-error badge-xs font-sans font-semibold">MISS</span>
                    <%= if row.pack do %>
                      <span class={"flex w-44 shrink-0 items-center gap-1 rounded-full border pl-0.5 pr-1 py-0.5 text-[10px] font-sans " <> if(row.searching?, do: "border-success/60 bg-success/10", else: "border-base-content/20 bg-base-200 opacity-50 grayscale")}>
                        <img src={row.pack.image_path} class="w-4 h-4 rounded-full object-cover shrink-0" draggable="false" />
                        <span class="truncate font-medium flex-1"><%= row.pack.name_en %></span>
                      </span>
                    <% else %>
                      <span class="flex w-44 shrink-0 items-center rounded-full border border-dashed border-base-content/20 px-1.5 py-0.5 text-[10px] italic text-base-content/30 font-sans">no Hunt pack</span>
                    <% end %>
                    <div class="h-2 flex-1 rounded-full bg-base-300 overflow-hidden"><div class="h-full bg-error/70" style={"width: #{row.chance * 100}%"}></div></div>
                    <span class="w-12 text-right"><%= search_pct(row.chance) %></span>
                  </div>
                </section>
                <section class="flex flex-col gap-2">
                  <p>How likely you'll hit 0, 1, 2, or more searches on a run:</p>
                  <div :for={{count, prob} <- Enum.sort(budget.search_counts)} class="flex items-center gap-2 font-mono text-xs">
                    <span class="w-24"><%= count %> <%= if count == 1, do: "search", else: "searches" %></span>
                    <div class="h-2 flex-1 rounded-full bg-base-300 overflow-hidden"><div class="h-full bg-primary/70" style={"width: #{prob * 100}%"}></div></div>
                    <span class="w-12 text-right"><%= search_pct(prob) %></span>
                    <span class="w-16 text-right text-error">cost <%= search_cost(count) %></span>
                  </div>
                </section>
                <table class="table table-xs">
                  <thead>
                    <tr><th>Average searches per run</th><th>Weighted average cost</th></tr>
                  </thead>
                  <tbody>
                    <tr class="font-mono">
                      <td><%= :erlang.float_to_binary(budget.pack_searches, decimals: 2) %></td>
                      <td><%= :erlang.float_to_binary(budget.search_average_cost, decimals: 1) %></td>
                    </tr>
                  </tbody>
                </table>
                </div>
                <p class="text-xs text-base-content/60">* F5 is assumed to have 1 less pack than the graces give, since Limbus usually keeps a new event pack pinned as available on that floor (which no one wants for speedrunning).</p>
              </div>
            </div>
          </aside>
        </div>
      </div>
      <div :for={pane <- ~w(battle packs gifts)} class={"flex-1 min-h-0 min-w-0 flex-col " <> if(pane == @pane, do: "flex", else: "hidden")}>
        <%= live_render(@socket, pane_view(pane), id: "pane-#{pane}-#{@editing_id}", session: %{"team_id" => @editing_id, "tab" => @gift_view.tab, "milestone" => @gift_view.milestone}, container: {:div, class: "flex flex-col flex-1 min-h-0 min-w-0"}) %>
      </div>
    </div>
    <% true -> %>
    <div class="card bg-base-100 shadow-lg flex flex-1 items-center justify-center text-sm text-base-content/40">
      Select a team from the selector in the top bar, or create one.
    </div>
    <% end %>
  </div>
</div>
