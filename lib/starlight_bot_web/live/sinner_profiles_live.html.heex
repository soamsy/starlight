<div class="flex flex-col h-full gap-2 overflow-hidden">
  <datalist id="locator-hook-names">
    <%= for name <- @locator_names do %>
      <option value={name}></option>
    <% end %>
  </datalist>
  <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
    <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-2">
      <div class="flex items-center gap-3">
        <h2 class="card-title text-lg">Sinner Profiles</h2>
        <span class="badge badge-neutral badge-sm"><%= length(@profiles) %></span>
        <span class="min-w-0 shrink-[4] truncate text-xs text-base-content/50">A profile's uptie and base locator hooks find the sinner in the battle skill tray.</span>
        <form phx-change="search" phx-submit="search" class="ml-auto min-w-0 shrink">
          <input type="search" name="q" value={@search} placeholder="Search profiles..." phx-debounce="150"
                 autocomplete="off" class="input input-bordered input-sm w-64 min-w-0 max-w-full" />
        </form>
        <button phx-click="new_profile" class="btn btn-primary btn-sm">+ New</button>
      </div>

      <div class="grid flex-1 min-h-0 gap-2 grid-cols-2 auto-rows-[20rem] overflow-y-auto lg:grid-cols-3 lg:auto-rows-[minmax(18rem,1fr)] xl:grid-cols-4 xl:auto-rows-[minmax(16rem,1fr)] 3xl:grid-cols-6 3xl:grid-rows-2 3xl:auto-rows-auto 3xl:overflow-hidden">
        <%= for {sinner, group} <- grouped_profiles(@profiles, @search) do %>
          <section class="flex flex-col min-h-0 rounded-lg border border-base-300">
            <header class="flex items-center gap-2 px-2 py-1 border-b border-base-300 bg-base-200/50 rounded-t-lg">
              <img :if={sinner} src={StarlightBot.SinnerProfiles.icon(sinner)} class="sinner-icon h-5 w-5 object-contain" />
              <span class="text-sm font-semibold truncate"><%= if sinner, do: sinner_label(sinner), else: "No sinner" %></span>
              <span class="badge badge-neutral badge-sm ml-auto"><%= length(group) %></span>
            </header>
            <div class="flex-1 min-h-0 overflow-y-auto p-1 flex flex-col gap-1">
              <%= for profile <- group do %>
                <form phx-change="save_profile" class="flex gap-1.5 rounded-md bg-base-200/40 p-1.5">
                  <div class="flex shrink-0 gap-0.5 self-stretch">
                    <button :for={{kind, label, hook} <- [{"base", "Base", profile.base_locator_hook}, {"uptie", "Uptie", profile.locator_hook}]}
                            type="button" phx-click="capture_locator" phx-value-id={profile.id} phx-value-kind={kind}
                            title={"Capture #{label} png from live battle (#{hook || "no hook set"})"}
                            class="w-9 rounded bg-base-200 hover:ring-2 hover:ring-primary overflow-hidden">
                      <img :if={@profile_thumbs[profile.id][kind]} src={"data:image/png;base64,#{@profile_thumbs[profile.id][kind]}"} class="h-full w-full object-contain" />
                    </button>
                  </div>
                  <div class="flex min-w-0 flex-1 flex-col gap-1">
                  <input type="hidden" name="profile_id" value={profile.id} />
                  <div class="flex items-center gap-1">
                    <input type="text" name="name" value={profile.name} phx-debounce="blur"
                           disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                           phx-mounted={if profile.id == @focus_id, do: JS.focus()}
                           class="input input-bordered input-xs min-w-0 flex-1" />
                    <button type="button" phx-click="delete_profile" phx-value-id={profile.id}
                            disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                            data-confirm={delete_message(profile, @profile_usage)}
                            class="btn btn-xs btn-ghost text-error px-1">Del</button>
                  </div>
                  <div class="flex items-center gap-1">
                    <details id={"locator-dropdown-#{profile.id}"} phx-hook="FloatingDropdown" class="dropdown">
                      <summary title={"Locator hooks: " <> (profile.locator_hook || "none") <> ", " <> (profile.base_locator_hook || "none")}
                               class={"btn btn-xs btn-square " <> if(locator_missing?(profile, @locator_names), do: "btn-error btn-outline", else: "btn-ghost")}>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                      </summary>
                      <div popover="manual" class="dropdown-content z-30 mt-1 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg flex flex-col gap-2">
                        <div :for={{kind, label, field, hook} <- [{"base", "Base", "base_locator_hook", profile.base_locator_hook}, {"uptie", "Uptie", "locator_hook", profile.locator_hook}]}
                             class="flex items-center gap-1">
                          <span class="w-10 text-xs text-base-content/60"><%= label %></span>
                          <button type="button" phx-click="reset_locator" phx-value-id={profile.id} phx-value-kind={kind}
                                  data-confirm="Reset the hook image to the placeholder?"
                                  title="Reset hook image to the placeholder circle" class="btn btn-xs btn-ghost px-1">Reset</button>
                          <input type="text" name={field} value={hook} list="locator-hook-names" phx-debounce="blur"
                                 disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                                 placeholder="hook name"
                                 class={"input input-bordered input-xs w-64 font-mono " <> if(hook && hook not in @locator_names, do: "input-error", else: "")} />
                        </div>
                      </div>
                    </details>
                    <button type="button" phx-click="test_profile" phx-value-id={profile.id} class="btn btn-xs btn-ghost px-1">Test</button>
                    <details id={"affinity-dropdown-#{profile.id}"} phx-hook="FloatingDropdown" class="dropdown ml-auto">
                      <summary title={"Defense skill 1 affinity: " <> (profile.defense_affinity || "none")}
                               class="btn btn-xs btn-ghost gap-1 px-1">
                        <span class="text-xs text-base-content/60">DEF</span>
                        <img :if={profile.defense_affinity} src={"/images/sin/#{profile.defense_affinity}.webp"} class="h-5 w-5 object-contain" />
                        <span :if={is_nil(profile.defense_affinity)} class="text-base-content/40">?</span>
                      </summary>
                      <div popover="manual" class="dropdown-content z-30 mt-1 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg"><div class="grid grid-cols-4 gap-1">
                        <label :for={option <- StarlightBot.SinnerProfiles.sins()} title={option}
                               class="btn btn-sm btn-ghost px-1 has-[:checked]:btn-primary has-[:disabled]:opacity-50">
                          <input type="radio" name="defense_affinity" value={option} checked={profile.defense_affinity == option}
                                 disabled={!StarlightBot.SinnerProfiles.writable?(profile)} class="hidden" />
                          <img src={"/images/sin/#{option}.webp"} class="h-6 w-6 object-contain" />
                        </label>
                      </div></div>
                    </details>
                    <details id={"sinner-dropdown-#{profile.id}"} phx-hook="FloatingDropdown" class="dropdown">
                      <summary title={"Sinner: " <> if(profile.sinner, do: sinner_label(profile.sinner), else: "none")}
                               class="btn btn-xs btn-ghost px-1">
                        <img :if={profile.sinner} src={StarlightBot.SinnerProfiles.icon(profile.sinner)} class="sinner-icon h-5 w-5 object-contain" />
                        <span :if={is_nil(profile.sinner)} class="text-base-content/40">?</span>
                      </summary>
                      <div popover="manual" class="dropdown-content z-30 mt-1 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg"><div class="grid grid-cols-4 gap-1">
                        <label :for={option <- StarlightBot.SinnerProfiles.sinners()} title={sinner_label(option)}
                               class="btn btn-sm btn-ghost px-1 has-[:checked]:btn-primary has-[:disabled]:opacity-50">
                          <input type="radio" name="sinner" value={option} checked={profile.sinner == option}
                                 disabled={!StarlightBot.SinnerProfiles.writable?(profile)} class="hidden" />
                          <img src={StarlightBot.SinnerProfiles.icon(option)} class="sinner-icon h-6 w-6 object-contain" />
                        </label>
                      </div></div>
                    </details>
                  </div>
                  <p :if={@profile_tests[profile.id]} class="text-xs text-base-content/60"><%= @profile_tests[profile.id] %></p>
                  </div>
                </form>
              <% end %>
              <p :if={group == []} class="text-center text-xs text-base-content/40 py-4">None</p>
            </div>
          </section>
        <% end %>
      </div>
    </div>
  </div>

  <%= if @picking_sinner do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold mb-3">New profile for which sinner?</h3>
        <div class="grid grid-cols-6 gap-2">
          <%= for sinner <- StarlightBot.SinnerProfiles.sinners() do %>
            <button phx-click="create_profile" phx-value-sinner={sinner} class="btn btn-sm h-14 text-xs leading-tight">
              <%= sinner_label(sinner) %>
            </button>
          <% end %>
        </div>
        <div class="modal-action">
          <button phx-click="cancel_new" class="btn btn-sm">Cancel</button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @capture do %>
    <div class="modal modal-open">
      <div class="modal-box max-w-3xl">
        <h3 class="font-bold">Pick <%= @capture.profile.name %> (<%= if @capture.kind == "base", do: "Base", else: "Uptie" %>)</h3>
        <p class="text-xs text-base-content/60 mb-3">
          Click the slot that shows this sinner. Its crop replaces <span class="font-mono"><%= @capture.hook_name %></span>.
        </p>
        <div class="flex flex-wrap gap-3">
          <%= for candidate <- @capture.candidates do %>
            <button phx-click="pick_capture" phx-value-column={candidate.column}
                    class="flex flex-col items-center gap-1 p-2 rounded border border-base-300 hover:border-primary">
              <img src={"data:image/png;base64,#{candidate.png_b64}"} class="h-20" style="image-rendering: pixelated" />
              <span class="text-xs">Slot <%= candidate.column + 1 %></span>
            </button>
          <% end %>
        </div>
        <div class="modal-action">
          <button phx-click="cancel_capture" class="btn btn-sm">Cancel</button>
        </div>
      </div>
    </div>
  <% end %>
</div>
