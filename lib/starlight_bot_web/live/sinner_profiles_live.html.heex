<div class="flex flex-col h-full gap-2 overflow-hidden">
  <StarlightBotWeb.Layouts.flash_toasts flash={@flash} />
  <datalist id="locator-hook-names">
    <%= for name <- @locator_names do %>
      <option value={name}></option>
    <% end %>
  </datalist>
  <div class="card bg-base-100 shadow-lg flex flex-col flex-1 min-h-0 overflow-hidden">
    <div class="card-body p-3 flex flex-col flex-1 min-h-0 gap-2">
      <div class="flex items-center gap-3">
        <h2 class="card-title text-lg">Sinner Profiles</h2>
        <span class="badge badge-neutral badge-sm"><%= length(@profiles) %></span>
        <span class="text-xs text-base-content/50">A profile's locator hook finds the sinner in the battle skill tray.</span>
        <form phx-change="search" phx-submit="search" class="ml-auto">
          <input type="search" name="q" value={@search} placeholder="Search profiles..." phx-debounce="150"
                 autocomplete="off" class="input input-bordered input-sm w-64" />
        </form>
        <button phx-click="new_profile" class="btn btn-primary btn-sm">+ New</button>
      </div>

      <div class="overflow-y-auto flex-1 min-h-0">
        <table class="table table-xs table-pin-rows">
          <thead>
            <tr><th>Profile</th><th>Used by</th><th></th></tr>
          </thead>
          <tbody>
            <%= for profile <- visible_profiles(@profiles, @search) do %>
              <tr>
                <td>
                  <form phx-change="save_profile" class="flex items-center gap-2">
                    <input type="hidden" name="profile_id" value={profile.id} />
                    <%= if @profile_thumbs[profile.id] do %>
                      <img src={"data:image/png;base64,#{@profile_thumbs[profile.id]}"} class="h-8 w-12 rounded shrink-0 object-contain" title={profile.locator_hook} />
                    <% else %>
                      <div class="h-8 w-12 rounded bg-base-200 shrink-0" title={profile.locator_hook}></div>
                    <% end %>
                    <details class="dropdown">
                      <summary title={"Locator hook: " <> (profile.locator_hook || "none")}
                               class={"btn btn-xs btn-square " <> if(is_nil(profile.locator_hook) or profile.locator_hook not in @locator_names, do: "btn-error btn-outline", else: "btn-ghost")}>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
                      </summary>
                      <div class="dropdown-content z-30 mt-1 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg">
                        <input type="text" name="locator_hook" value={profile.locator_hook} list="locator-hook-names" phx-debounce="blur"
                               disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                               placeholder="hook name"
                               class={"input input-bordered input-xs w-72 font-mono " <> if(profile.locator_hook && profile.locator_hook not in @locator_names, do: "input-error", else: "")} />
                      </div>
                    </details>
                    <button type="button" phx-click="capture_locator" phx-value-id={profile.id} class="btn btn-xs btn-ghost"
                            title="Capture sinner png from live battle">Capture</button>
                    <button type="button" phx-click="reset_locator" phx-value-id={profile.id} class="btn btn-xs btn-ghost"
                            data-confirm="Reset the hook image to the placeholder?"
                            title="Reset hook image to the placeholder circle">Reset</button>
                    <button type="button" phx-click="test_profile" phx-value-id={profile.id} class="btn btn-xs btn-ghost">Test</button>
                    <input type="text" name="name" value={profile.name} phx-debounce="blur"
                           disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                           phx-mounted={if profile.id == @focus_id, do: JS.focus()}
                           class="input input-bordered input-xs w-48" />
                    <details class="dropdown">
                      <summary title={"Sinner: " <> if(profile.sinner, do: sinner_label(profile.sinner), else: "none")}
                               class="btn btn-xs btn-ghost px-1">
                        <img :if={profile.sinner} src={StarlightBot.SinnerProfiles.icon(profile.sinner)} class="sinner-icon h-5 w-5 object-contain" />
                        <span :if={is_nil(profile.sinner)} class="text-base-content/40">?</span>
                      </summary>
                      <div class="dropdown-content z-30 mt-1 w-max rounded-lg border border-base-300 bg-base-100 p-2 shadow-lg"><div class="grid grid-cols-6 gap-1">
                        <label :for={sinner <- StarlightBot.SinnerProfiles.sinners()} title={sinner_label(sinner)}
                               class="btn btn-sm btn-ghost px-1 has-[:checked]:btn-primary has-[:disabled]:opacity-50">
                          <input type="radio" name="sinner" value={sinner} checked={profile.sinner == sinner}
                                 disabled={!StarlightBot.SinnerProfiles.writable?(profile)} class="hidden" />
                          <img src={StarlightBot.SinnerProfiles.icon(sinner)} class="sinner-icon h-6 w-6 object-contain" />
                        </label>
                        </div>
                      </div>
                    </details>
                  </form>
                </td>
                <td class="text-center"><%= Map.get(@profile_usage, profile.id, 0) %></td>
                <td class="text-right whitespace-nowrap">
                  <button phx-click="delete_profile" phx-value-id={profile.id}
                          disabled={!StarlightBot.SinnerProfiles.writable?(profile)}
                          data-confirm={"Delete '#{profile.name}'?"}
                          class="btn btn-xs btn-ghost text-error">Del</button>
                </td>
              </tr>
              <%= if @profile_tests[profile.id] do %>
                <tr><td colspan="3" class="text-xs text-base-content/60 pl-4"><%= @profile_tests[profile.id] %></td></tr>
              <% end %>
            <% end %>
            <%= if @profiles == [] do %>
              <tr><td colspan="3" class="text-center text-base-content/40 py-4">No sinner profiles yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <%= if @picking_sinner do %>
    <div class="modal modal-open">
      <div class="modal-box">
        <h3 class="font-bold mb-3">New profile for which sinner?</h3>
        <div class="grid grid-cols-6 gap-2">
          <%= for sinner <- StarlightBot.SinnerProfiles.sinners() do %>
            <button phx-click="create_profile" phx-value-sinner={sinner} class="btn btn-sm h-14 text-xs leading-tight">
              <%= sinner_label(sinner) %>
            </button>
          <% end %>
        </div>
        <div class="modal-action">
          <button phx-click="cancel_new" class="btn btn-sm">Cancel</button>
        </div>
      </div>
    </div>
  <% end %>

  <%= if @capture do %>
    <div class="modal modal-open">
      <div class="modal-box max-w-3xl">
        <h3 class="font-bold">Pick <%= @capture.profile.name %></h3>
        <p class="text-xs text-base-content/60 mb-3">
          Click the slot that shows this sinner. Its crop replaces <span class="font-mono"><%= @capture.profile.locator_hook %></span>.
        </p>
        <div class="flex flex-wrap gap-3">
          <%= for candidate <- @capture.candidates do %>
            <button phx-click="pick_capture" phx-value-column={candidate.column}
                    class="flex flex-col items-center gap-1 p-2 rounded border border-base-300 hover:border-primary">
              <img src={"data:image/png;base64,#{candidate.png_b64}"} class="h-20" style="image-rendering: pixelated" />
              <span class="text-xs">Slot <%= candidate.column + 1 %></span>
            </button>
          <% end %>
        </div>
        <div class="modal-action">
          <button phx-click="cancel_capture" class="btn btn-sm">Cancel</button>
        </div>
      </div>
    </div>
  <% end %>
</div>
