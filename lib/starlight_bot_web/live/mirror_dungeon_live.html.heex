<div class="flex flex-col h-full gap-2 overflow-hidden">

  <%!-- Header --%>
  <div class="flex items-center gap-3 shrink-0">
    <h2 class="text-lg font-semibold">Mirror Dungeon Runner</h2>

    <span class={"#{screen_badge_class(@current_screen)} font-mono"}>
      <%= screen_label(@current_screen) %>
    </span>

    <button phx-click="localize" disabled={@phase != :idle} class="btn btn-ghost btn-xs">
      Localize
    </button>

    <span class="badge badge-ghost font-mono">Floor <%= current_floor(@run_memory) %></span>

    <%= if cost = current_cost(@run_memory) do %>
      <span class="badge badge-ghost font-mono">Cost <%= cost %></span>
    <% end %>

    <span class={mode_badge_class(current_mode(@run_memory))}><%= current_mode(@run_memory) %></span>

    <%= if progress = run_progress(@run_memory) do %>
      <span class="badge badge-ghost font-mono">Run <%= progress.current %> / <%= progress.total %></span>
    <% end %>

    <%= if ms = elapsed_ms(@run_clock, @now_ms) do %>
      <span class={"badge font-mono " <> if(@run_clock.running?, do: "badge-ghost", else: "badge-outline text-base-content/50")}
            title="Counts only while the bot is running, not while paused">
        Elapsed <%= format_elapsed(ms) %>
      </span>
    <% end %>

    <%= if label = phase_label(@phase) do %>
      <span class={"flex items-center gap-1 text-sm #{if @phase == :paused, do: "text-warning", else: "text-base-content/60"}"}>
        <%= if @phase != :paused do %>
          <span class="loading loading-spinner loading-xs"></span>
        <% end %>
        <%= label %>
      </span>
    <% end %>

  </div>

  <%!-- Body --%>
  <div class="flex gap-2 flex-1 min-h-0 overflow-hidden">

    <%!-- Left: form --%>
    <div class="w-80 shrink-0 flex flex-col gap-3 overflow-y-auto">

      <%= if @teams == [] do %>
        <div class="text-xs text-base-content/40 bg-base-200 rounded-xl p-3">
          No teams with a team-select hook configured yet — set one up on the
          <.link navigate={~p"/teams"} class="link">Teams</.link> page first.
        </div>
      <% end %>

      <div class="bg-base-200 rounded-xl p-3 flex flex-col gap-1 shrink-0">
        <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">
          Ego gift inventory (<%= map_size(ego_gifts(@run_memory)) %>)
        </span>
        <%= if map_size(ego_gifts(@run_memory)) == 0 do %>
          <div class="text-xs text-base-content/30">None picked up yet</div>
        <% else %>
          <div class="flex flex-wrap gap-1">
            <%= for {gift_id, gift} <- ego_gifts(@run_memory) do %>
              <span class="badge badge-sm badge-outline" title={gift_id}>
                <%= gift.name %><%= if gift.uptie > 0, do: " UT#{gift.uptie}" %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>

      <form
        id="mirror-dungeon-runner-form"
        phx-submit="run"
        phx-change="update_form"
        class="flex flex-col gap-3">
        <div class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">
            <%= if length(@picks) > 1, do: "Team cycle (★ runs next, moves on after a completed run, stays on a failed one)", else: "Team" %>
          </span>
          <input type="hidden" name="start_index" value={@start_index} />
          <div id="team-cycle" phx-hook="SortableList" data-sort-event="reorder_cycle" class="flex flex-col gap-1">
          <%= for {pick, index} <- Enum.with_index(@picks) do %>
            <div data-sort-id={index}
                 class={"flex items-center gap-1 rounded " <> if(length(@picks) > 1 and index == @start_index, do: "bg-primary/10 ring-1 ring-primary", else: "")}>
              <span :if={length(@picks) > 1 and not cycle_locked?(@phase, @other_running?)} data-sort-handle class="cursor-grab text-base-content/40 px-0.5" title="Drag to reorder">⠿</span>
              <button :if={length(@picks) > 1} type="button" phx-click="set_cycle_start" phx-value-index={index}
                      disabled={cycle_locked?(@phase, @other_running?)}
                      title={if cycle_locked?(@phase, @other_running?), do: "Locked while a run is active", else: "Start the cycle with this team"}
                      class={"btn btn-ghost btn-xs px-1 " <> if(index == @start_index, do: "text-primary", else: "text-base-content/30")}>
                <%= if index == @start_index, do: "★", else: "☆" %>
              </button>
              <span :if={length(@picks) > 1} class="text-xs text-base-content/50 w-5 text-right"><%= index + 1 %>.</span>
              <select name="team_ids[]" class="select select-sm select-bordered flex-1 min-w-0" disabled={@teams == [] or cycle_locked?(@phase, @other_running?)}>
                <%= for team <- @teams do %>
                  <option value={team.id} selected={team.id == pick.id}><%= team.name %></option>
                <% end %>
              </select>
              <select name="team_hooks[]" class="select select-sm select-bordered w-24 shrink-0" disabled={@teams == [] or cycle_locked?(@phase, @other_running?)}>
                <%= for hook <- team_hooks(@teams, pick.id) do %>
                  <option value={hook} selected={hook == pick.hook}><%= Teams.hook_label(hook) %></option>
                <% end %>
              </select>
              <button :if={length(@picks) > 1 and not cycle_locked?(@phase, @other_running?)} type="button" phx-click="remove_cycle_team" phx-value-index={index}
                      class="btn btn-ghost btn-xs text-error">✕</button>
            </div>
          <% end %>
          </div>
          <button :if={@teams != [] and not cycle_locked?(@phase, @other_running?)} type="button" phx-click="add_cycle_team" class="btn btn-ghost btn-xs self-start">+ team</button>
        </div>

        <label class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Mirror Dungeon runs</span>
          <input type="number" name="run_count" min="0" value={@run_count} class="input input-sm input-bordered" />
        </label>

        <label class="flex flex-col gap-1">
          <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Rewards</span>
          <select name="rewards" class="select select-sm select-bordered">
            <option value="none" selected={@rewards == "none"}>Don't claim rewards (dry run)</option>
            <option value="claim" selected={@rewards == "claim"}>Claim rewards</option>
            <option value="weekly" selected={@rewards == "weekly"}>Claim rewards with weekly bonuses</option>
          </select>
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="collect_enkephalin" value="true" checked={@collect_enkephalin}
                 class="checkbox checkbox-sm" />
          <span class="text-sm">Collect enkephalin modules before each run</span>
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="collect_xp" value="true" checked={@collect_xp}
                 class="checkbox checkbox-sm" />
          <span class="text-sm">Collect battle pass xp after all runs</span>
        </label>

        <label class="flex items-center gap-2">
          <input type="checkbox" name="capture_ego_gifts" value="true" checked={@capture_ego_gifts}
                 class="checkbox checkbox-sm" />
          <span class="text-sm">Save ego gift captures to EgoGiftML</span>
        </label>

        <%= if @collect_enkephalin do %>
          <label class="flex flex-col gap-1">
            <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Lunacy → enkephalin conversions</span>
            <select name="enkephalin_convert_count" class="select select-sm select-bordered">
              <%= for n <- 0..EnkephalinCharger.max_convert_count() do %>
                <option value={n} selected={to_string(n) == to_string(@enkephalin_convert_count)}>
                  <%= n %>x (<%= LuxcavationLive.enkephalin_cumulative_cost(n) %> lunacy)
                </option>
              <% end %>
            </select>
          </label>
        <% end %>

        <%= if @other_running? do %>
          <span class="text-xs text-warning">Luxcavation is running. Cancel it there before starting this.</span>
        <% end %>

        <%= if @phase == :paused and not @other_running? do %>
          <button
            type="button"
            phx-click="resume"
            disabled={@countdown != nil}
            class="btn btn-warning btn-sm">
            Resume
          </button>
        <% else %>
          <button
            type="submit"
            disabled={@teams == [] or @phase != :idle or @countdown != nil or @other_running?}
            class="btn btn-primary btn-sm">
            Run
          </button>
        <% end %>

        <%= if @phase == :running and not @other_running? do %>
          <button
            type="button"
            phx-click="pause"
            disabled={@pause_requested}
            class="btn btn-warning btn-outline btn-sm">
            <%= if @pause_requested, do: "Pausing…", else: "Pause" %>
          </button>
        <% end %>

        <%= if @phase != :idle and not @other_running? do %>
          <button type="button" phx-click="cancel" class="btn btn-ghost btn-sm btn-error">Cancel</button>
        <% end %>
      </form>

      <%!-- Countdown overlay --%>
      <%= if @countdown do %>
        <div class="bg-warning/10 border border-warning/30 rounded-xl p-3 shrink-0 flex items-center justify-between gap-2">
          <div>
            <div class="text-xs text-warning font-semibold">Focus the game window now</div>
            <div class="font-mono text-sm text-base-content/70"><%= pending_action_label(@pending_action) %></div>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-2xl font-bold text-warning"><%= @countdown %></span>
            <button phx-click="cancel_pending" class="btn btn-ghost btn-xs text-base-content/40">✕</button>
          </div>
        </div>
      <% end %>

    </div>

    <%!-- Right: log --%>
    <StarlightBotWeb.Live.LogLive.panel socket={@socket} id="mirror-dungeon-log" class="flex-1 min-h-0" />

    <%!-- Right: run times --%>
    <div class="w-56 shrink-0 bg-base-200 rounded-xl p-3 flex flex-col gap-2 min-h-0 overflow-y-auto">
      <div class="flex items-center justify-between">
        <span class="text-xs font-semibold text-base-content/50 uppercase tracking-wide">Run times</span>
        <button type="button" phx-click="toggle_screen_times" class="btn btn-ghost btn-xs">By screen</button>
      </div>
      <.run_times runs={run_times(@run_splits, @run_clock, @now_ms, @run_memory)} live_last?={@run_clock != nil and @run_clock.running?} />
    </div>

    <.screen_times
      :if={@show_screen_times}
      segments={screen_segments(@screen_source, @screen_times, @history_segments, @run_clock, @now_ms)}
      view={@screen_view}
      source={@screen_source}
      filter={@screen_filter}
      history_runs={@history_runs}
    />

  </div>

</div>
